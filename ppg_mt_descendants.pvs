% The descendant address domain is the disjoint union of its root and
% its direct child subtrees. This finite partition is used to transfer
% counts and products to the reconstructed rose tree.

ppg_mt_descendants[C, V: TYPE]: THEORY
BEGIN
  IMPORTING ppg_mt_real_tree[C, V], ppg_address_prefix, ppg_finite_bind[Addr, Addr]
  T: VAR GTree
  u, v, w, r: VAR Addr
  k: VAR nat

  valid_append_reverse: LEMMA gt_valid?(T) AND T`dom(append(u, reverse(r))) IMPLIES T`dom(u)

  prefix_mem: THEOREM gt_valid?(T) AND T`dom(w) AND addrPrefix(u, w) IMPLIES T`dom(u)

  descendants(T, v): finite_set[Addr] = intersection(T`dom, {w: Addr | addrPrefix(v, w)})

  descendants_member: LEMMA descendants(T, v)(w) IFF T`dom(w) AND addrPrefix(v, w)

  descendants_root: LEMMA descendants(T, null) = T`dom

  descendants_leaf: LEMMA T`dom(v) AND
    (FORALL (w: Addr): T`dom(w) IMPLIES length(w) <= length(v))
    IMPLIES descendants(T, v) = singleton(v)

  child_prefix: LEMMA childSet(T, v)(u) IMPLIES addrPrefix(v, u)

  child_descendant: LEMMA gt_valid?(T) AND T`dom(w) AND addrPrefix(v, w) AND v /= w IMPLIES
    EXISTS (u: Addr): childSet(T, v)(u) AND addrPrefix(u, w)

  descendant_child_iff: LEMMA gt_valid?(T) AND T`dom(v) IMPLIES
    (descendants(T, v)(w) IFF w = v OR
      EXISTS (u: Addr): childSet(T, v)(u) AND descendants(T, u)(w))

  descendants_step: LEMMA gt_valid?(T) AND T`dom(v) IMPLIES
    descendants(T, v) = add(v, biUnion(childSet(T, v), LAMBDA (u: Addr): descendants(T, u)))

  descendants_children_disjoint: LEMMA
    disjointFamily(childSet(T, v), LAMBDA (u: Addr): descendants(T, u))

  root_not_in_children: LEMMA
    NOT biUnion(childSet(T, v), LAMBDA (u: Addr): descendants(T, u))(v)

END ppg_mt_descendants
