% Reconstruction and canonicalization preserve every label count.
% The count distinguishing two occurrence times therefore also distinguishes
% their canonical rose trees. Node-product weights are preserved as well.
%
% Lean counterpart: PPGraphMoserTardosInjectivityBridge.lean.

ppg_mt_injectivity_bridge[C, V: TYPE]: THEORY
BEGIN
  IMPORTING ppg_mt_reconstruction_count[C, V], ppg_mt_reconstruction_weight[C, V],
    ppg_mt_real_witness[C, V]
  vars: VAR CertVars
  Clog: VAR [nat -> C]
  t, t1, t2: VAR nat
  a: VAR C
  p: VAR [C -> nonneg_real]
  realWitness_count: LEMMA countLabel(a)(realWitness(vars, Clog, t)) = count_label(tau_C(vars, Clog, t), a)
  tauC_canonicalize_toWTree_ne_of_lt: THEOREM 0 < t1 AND 0 < t2 AND t1 < t2 AND Clog(t1) = Clog(t2)
    IMPLIES realWitness(vars, Clog, t1) /= realWitness(vars, Clog, t2)
  realWitness_weight_product: THEOREM weight(p)(realWitness(vars, Clog, t)) =
    products.sum(tau_C(vars, Clog, t)`dom, LAMBDA (w: Addr): p(tau_C(vars, Clog, t)`lab(w)))
END ppg_mt_injectivity_bridge
