% Equal first-hit counts have equal nonnegative integrals under the
% original measure. This statement applies to arbitrary paths and to
% infinite as well as finite measures.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_finite_lumping_expectation[State,Abstract,Omega: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  abstractUniverse:{U:finite_set[Abstract]|FORALL(a:Abstract):U(a)},
  (IMPORTING ppg_nasa_sigma[Omega]) S:MeasurableSpace,
  (IMPORTING measure_integration@measure_def[Omega,asNasa(S)])
  originalMeasure:measure_type]: THEORY
BEGIN
  IMPORTING ppg_finite_lumping_paths[State,Abstract,Omega,universe,abstractUniverse,S],
    ppg_general_hit_markov[State,Omega,universe,S,originalMeasure] AS concreteMean,
    ppg_general_hit_markov[Abstract,Omega,abstractUniverse,S,originalMeasure] AS reducedMean
  M: VAR ppg_finite_drift[State,universe].Model
  N: VAR ppg_finite_drift[Abstract,abstractUniverse].Model
  p: VAR [State->Abstract]
  X: VAR ppg_filtration[Omega,State,S].Process

  enn_function_eq: LEMMA FORALL(f,g:[Omega->ppg_enn_sup.ENN]):
    f=g IFF (FORALL(omega:Omega):f(omega)=g(omega))

  hit_function_projection: LEMMA Compatible(M,N,p) IMPLIES
    (LAMBDA(omega:Omega):ppg_finite_process_stopping[State,Omega,universe,S].hitCount(M,X,omega))=
    (LAMBDA(omega:Omega):ppg_finite_process_stopping[Abstract,Omega,abstractUniverse,S].hitCount(
      N,projectProcess(p,X),omega))

  expectedHitCount_projection: THEOREM Compatible(M,N,p) IMPLIES
    concreteMean.generalExpectedHitCount(M,X)=
      reducedMean.generalExpectedHitCount(N,projectProcess(p,X))

END ppg_finite_lumping_expectation
