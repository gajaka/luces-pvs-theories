% A finite coordinate isomorphism is a witness of real vector-space dimension.
ppg_finite_dimension[T, Index: TYPE]: THEORY
BEGIN
  Vector: TYPE = [T -> real]
  Coefficients: TYPE = [Index -> real]
  space: VAR set[Vector]
  I: VAR finite_set[Index]
  encode: VAR [Vector -> Coefficients]
  decode: VAR [Coefficients -> Vector]
  n: VAR nat
  CoordinateIsomorphism(space, I, encode, decode): bool =
    (FORALL (a: Coefficients): space(decode(a))) AND
    (FORALL (x: Vector): space(x) IMPLIES decode(encode(x)) = x) AND
    (FORALL (a: Coefficients, k: Index): I(k) IMPLIES encode(decode(a))(k) = a(k)) AND
    (FORALL (a, b: Coefficients): (FORALL (k: Index): I(k) IMPLIES a(k) = b(k)) IMPLIES decode(a) = decode(b)) AND
    (FORALL (x, y: Vector, r: real):
      encode(LAMBDA (t: T): x(t) + r * y(t)) =
        (LAMBDA (k: Index): encode(x)(k) + r * encode(y)(k))) AND
    (FORALL (a, b: Coefficients, r: real):
      decode(LAMBDA (k: Index): a(k) + r * b(k)) =
        (LAMBDA (t: T): decode(a)(t) + r * decode(b)(t)))
  HasFiniteDimension(space, n): bool =
    EXISTS I, encode, decode: card(I) = n AND CoordinateIsomorphism(space, I, encode, decode)
END ppg_finite_dimension
