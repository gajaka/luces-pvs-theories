% Fixing the coordinates outside a finite set reduces a dependent
% product sum to one coordinate sum at a time. Signed real factors are
% allowed; the identity uses finite distributivity alone.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Algorithm 1.1.
ppg_dependent_product_sum[V,Value: TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_resampling_state_finite[V,Value,variables,domains] AS depFinite

  State: TYPE = ppg_finite_resampling_core[V,Value,variables,domains].State

  IMPORTING ppg_finite_sum[State] AS depStates,
    ppg_finite_sum[Value] AS depValues,
    ppg_finite_point_sum[State] AS depStatePoint,
    ppg_finite_point_sum[Value] AS depValuePoint,
    ppg_finite_product[V] AS depProducts,
    ppg_real_product[V] AS depProductAlgebra,
    ppg_finite_fubini[State,Value] AS depFubini,
    ppg_finite_induction[V]

  Factors: TYPE = [V->[Value->real]]

  f: VAR Factors
  F: VAR finite_set[V]
  base,t: VAR State
  v: VAR V
  x: VAR Value

  setValue(base,v,x): State = IF domains(v)(x) THEN base WITH [v:=x] ELSE base ENDIF

  agreeOutside(F,base,t): bool = FORALL(v:V):NOT F(v) IMPLIES t(v)=base(v)

  partialProduct(f,F,t): real = depProducts.product(F,LAMBDA(v:V):f(v)(t(v)))

  slice(f,F,base)(t): real = IF agreeOutside(F,base,t) THEN partialProduct(f,F,t) ELSE 0 ENDIF

  sliceSum(f,F,base): real = depStates.fsum(depFinite.allStates,slice(f,F,base))

  domainSums(f)(v): real = depValues.fsum(domains(v),f(v))

  agree_empty: LEMMA agreeOutside(emptyset[V],base,t) IFF t=base

  agree_remove_outside: LEMMA F(v) AND domains(v)(x) AND
    agreeOutside(remove(v,F),setValue(base,v,x),t) IMPLIES agreeOutside(F,base,t)

  agree_remove_value: LEMMA F(v) AND domains(v)(x) AND
    agreeOutside(remove(v,F),setValue(base,v,x),t) IMPLIES t(v)=x

  agree_remove_back: LEMMA F(v) AND domains(v)(x) AND
    agreeOutside(F,base,t) AND t(v)=x IMPLIES
      agreeOutside(remove(v,F),setValue(base,v,x),t)

  agree_remove: LEMMA F(v) AND domains(v)(x) IMPLIES
    (agreeOutside(remove(v,F),setValue(base,v,x),t) IFF
      agreeOutside(F,base,t) AND t(v)=x)

  partial_product_remove: LEMMA F(v) IMPLIES
    partialProduct(f,F,t)=f(v)(t(v))*partialProduct(f,remove(v,F),t)

  slice_value: LEMMA slice(f,F,base)(t)=
    (IF agreeOutside(F,base,t) THEN partialProduct(f,F,t) ELSE 0 ENDIF)

  slice_empty: LEMMA slice(f,emptyset[V],base)=
    (LAMBDA(t:State):IF t=base THEN 1 ELSE 0 ENDIF)

  slice_sum_empty: LEMMA sliceSum(f,emptyset[V],base)=1

  slice_row_term: LEMMA F(v) AND domains(v)(x) IMPLIES
    f(v)(x)*slice(f,remove(v,F),setValue(base,v,x))(t)=
      (IF x=t(v) THEN f(v)(x)*
        (IF agreeOutside(F,base,t) THEN partialProduct(f,remove(v,F),t) ELSE 0 ENDIF)
       ELSE 0 ENDIF)

  slice_row_sum: LEMMA F(v) IMPLIES
    depValues.fsum(domains(v),LAMBDA(x:Value):
      f(v)(x)*slice(f,remove(v,F),setValue(base,v,x))(t))=slice(f,F,base)(t)

  slice_row_function: LEMMA F(v) IMPLIES
    (LAMBDA(t:State):depValues.fsum(domains(v),LAMBDA(x:Value):
      f(v)(x)*slice(f,remove(v,F),setValue(base,v,x))(t)))=slice(f,F,base)

  scaled_slice_sum_function: LEMMA
    (LAMBDA(x:Value):depStates.fsum(depFinite.allStates,LAMBDA(t:State):
      f(v)(x)*slice(f,remove(v,F),setValue(base,v,x))(t)))=
    (LAMBDA(x:Value):f(v)(x)*sliceSum(f,remove(v,F),setValue(base,v,x)))

  slice_sum_step: LEMMA F(v) IMPLIES
    sliceSum(f,F,base)=depValues.fsum(domains(v),LAMBDA(x:Value):
      f(v)(x)*sliceSum(f,remove(v,F),setValue(base,v,x)))

  constant_slice_rows: LEMMA FORALL(r:real):
    (FORALL(b:State):sliceSum(f,remove(v,F),b)=r) IMPLIES
    (LAMBDA(x:Value):f(v)(x)*sliceSum(f,remove(v,F),setValue(base,v,x)))=
      (LAMBDA(x:Value):f(v)(x)*r)

  slice_sum_product: THEOREM sliceSum(f,F,base)=depProducts.product(F,domainSums(f))

  agree_full: LEMMA agreeOutside(variables,base,t)

  full_slice: LEMMA slice(f,variables,base)=
    (LAMBDA(t:State):depProducts.product(variables,LAMBDA(v:V):f(v)(t(v))))

  dependent_product_sum: THEOREM FORALL(base:State):
    depStates.fsum(depFinite.allStates,
      LAMBDA(t:State):depProducts.product(variables,LAMBDA(v:V):f(v)(t(v))))=
        depProducts.product(variables,domainSums(f))

END ppg_dependent_product_sum
