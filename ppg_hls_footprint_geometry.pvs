% Private and shared footprints partition the variables read by two events.
% Their disjointness is set-theoretic; event equivalences use the existing
% MT coordinate-locality predicate.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", Section 2. Kun He, Qian Li and Xiaoming Sun,
% "Moser-Tardos Algorithm: Beyond Shearer's Bound", Lemma 3.4.
% Pure support for the first eight results of PPGraphHLSFootprintBlocks.lean.
ppg_hls_footprint_geometry[C,V,Value:TYPE,domain:[V->set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_mt_semantics[C,V,Value,domain]

  vars: VAR CertVars
  bad: VAR [C,MTState->bool]
  i,j: VAR C
  sigma,tau: VAR MTState

  sourcePrivate(vars,i,j): finite_set[V] = difference(vars(i),vars(j))

  sharedVariables(vars,i,j): finite_set[V] = intersection(vars(i),vars(j))

  targetPrivate(vars,i,j): finite_set[V] = difference(vars(j),vars(i))

  source_shared_disjoint: THEOREM disjoint?(sourcePrivate(vars,i,j),sharedVariables(vars,i,j))

  shared_target_disjoint: THEOREM disjoint?(sharedVariables(vars,i,j),targetPrivate(vars,i,j))

  source_target_disjoint: THEOREM disjoint?(sourcePrivate(vars,i,j),targetPrivate(vars,i,j))

  private_union_shared_disjoint: THEOREM disjoint?(union(sourcePrivate(vars,i,j),
    targetPrivate(vars,i,j)),sharedVariables(vars,i,j))

  source_footprint_eq_blocks: THEOREM vars(i)=union(sourcePrivate(vars,i,j),sharedVariables(vars,i,j))

  target_footprint_eq_blocks: THEOREM vars(j)=union(sharedVariables(vars,i,j),targetPrivate(vars,i,j))

  source_bad_depends_blocks: THEOREM mt_wf(vars,bad) AND
    (FORALL(a:V):union(sourcePrivate(vars,i,j),sharedVariables(vars,i,j))(a)
      IMPLIES sigma(a)=tau(a)) IMPLIES (bad(i,sigma) IFF bad(i,tau))

  target_bad_depends_blocks: THEOREM mt_wf(vars,bad) AND
    (FORALL(a:V):union(sharedVariables(vars,i,j),targetPrivate(vars,i,j))(a)
      IMPLIES sigma(a)=tau(a)) IMPLIES (bad(j,sigma) IFF bad(j,tau))

END ppg_hls_footprint_geometry
