% A child's depth layer contributes to the next layer of its parent.
% Footprint separation at every depth is therefore inherited by children
% and implies independence of the set of immediate child labels.
% The exact reconstruction identity supplies this property for MT trees.
%
% Wesley Pegden, "An extension of the Moser-Tardos algorithmic local
% lemma", Theorem 1.4. https://arxiv.org/abs/1102.2853
% Lean counterpart: the DepthIndependent results in PPGraphMoserTardosPegden.lean.
% DepthIndependent is depthSeparated; no distinctness of repeated labels
% within a depth multiset is assumed in these declarations.
ppg_pegden_depth[C,V:TYPE]: THEORY
BEGIN
  IMPORTING ppg_pegden_polynomial[C,V],ppg_mt_depth_independence_bridge[C,V]
  vars: VAR CertVars
  t,c: VAR WTree
  cs: VAR list[WTree]
  d,n: VAR nat
  a,b: VAR C
  T: VAR GTree
  Clog: VAR [nat->C]

  mem_labelsAtDepthChildren_of_mem: THEOREM member(c,cs) AND labelsAtDepth(c,d)(a)>0 IMPLIES
    labelsAtDepthChildren(cs,d)(a)>0

  depthIndependent_child: THEOREM depthSeparated(vars,t) AND member(c,roseChildren(t)) IMPLIES
    depthSeparated(vars,c)

  child_label_depth_one: LEMMA member(c,roseChildren(t)) IMPLIES
    labelsAtDepth(t,1)(roseLabel(c))>0

  labelSet_depth_one: LEMMA labelSet(t)(a) IMPLIES labelsAtDepth(t,1)(a)>0

  depthIndependent_labelSet: THEOREM depthSeparated(vars,t) IMPLIES PegdenIndependent(vars,labelSet(t))

  toWTree_depthIndependent: THEOREM gt_valid?(T) AND T`dom(null) AND SameDepthIndependent(vars,T) IMPLIES
    depthSeparated(vars,toWTree(T,null))

  tauC_toWTree_depthIndependent: THEOREM depthSeparated(vars,toWTree(tau_C(vars,Clog,n),null))

END ppg_pegden_depth
