% Evaluating the input singleton expansion gives the next-state
% indicator for the actual update function. This identity holds
% pointwise, with arbitrary rational input weights and arbitrary paths.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_finite_update_indicators[State,Input,Omega: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)}]: THEORY
BEGIN
  IMPORTING ppg_finite_update[State,Input,universe,inputs],
    ppg_finite_process_values[State,Omega,universe] AS states,
    ppg_finite_process_values[Input,Omega,inputs] AS draws,
    ppg_finite_sum[Input] AS realInputSum

  R: VAR Rule
  X: VAR [Omega->State]
  Y: VAR [Omega->Input]
  t: VAR State
  omega: VAR Omega

  updateIndicator(R,X,Y,t): [Omega->real] =
    states.stateIndicator(LAMBDA(omega:Omega):R`update(X(omega),Y(omega)),t)

  inputExpansion(R,X,Y,t): [Omega->real] = LAMBDA(omega:Omega):
    realInputSum.fsum(inputs,LAMBDA(a:Input):
      (IF R`update(X(omega),a)=t THEN 1 ELSE 0 ENDIF)*draws.stateIndicator(Y,a)(omega))

  omega_function_eq: LEMMA FORALL(f,g:[Omega->real]):
    f=g IFF (FORALL(omega:Omega):f(omega)=g(omega))

  input_coefficients: LEMMA
    (LAMBDA(a:Input):
      (IF R`update(X(omega),a)=t THEN 1 ELSE 0 ENDIF)*draws.stateIndicator(Y,a)(omega))=
    (LAMBDA(a:Input):IF a=Y(omega) THEN
      (IF R`update(X(omega),a)=t THEN 1 ELSE 0 ENDIF) ELSE 0 ENDIF)

  next_indicator_expansion: THEOREM updateIndicator(R,X,Y,t)=inputExpansion(R,X,Y,t)

END ppg_finite_update_indicators
