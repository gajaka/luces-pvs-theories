% A finite label partition commutes with the nonnegative count integral.
% This gives the sum of per-label expectations for both fixed initialization
% and initialization from slot zero. In the latter case the initial state
% remains a function of the table throughout the integration.
%
% Lean counterparts: PPGraphMoserTardosResamplingCount.lean and
% PPGraphMoserTardosRandomInitExpectation.lean.

ppg_mt_expected_decomposition[C,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces)]: THEORY
BEGIN
  IMPORTING ppg_mt_time_expectation[C,V,Value,domain,spaces,laws],
    ppg_mt_count_decomposition[C,V,Value,domain],
    ppg_event_partition_integral[LogSpace,C,NativeTableSigma(spaces),logMeasure]
  vars: VAR CertVars
  bad: VAR NativeBad
  fallback,a: VAR C
  enumeration: VAR FullEnumeration
  initial: VAR MTState
  omega: VAR LogSpace
  n: VAR nat

  fixedLabelEvents(vars,bad,fallback,enumeration,initial)(a:C): [nat->(NativeTableSigma(spaces))] =
    fixedSelected(vars,bad,fallback,enumeration,initial,a)

  randomLabelEvents(vars,bad,fallback,enumeration)(a:C): [nat->(NativeTableSigma(spaces))] =
    randomSelected(vars,bad,fallback,enumeration,a)

  fixed_prefix_partition: LEMMA partitionPrefixes(labelUniverse(enumeration),
    fixedRun(vars,bad,fallback,enumeration,initial),fixedLabelEvents(vars,bad,fallback,enumeration,initial))

  random_running_prefix: LEMMA countPrefix(randomRun(vars,bad,fallback,enumeration),omega,n)=
    countPrefix(runEvents(vars,bad,fallback,enumeration,initialStateFromLog(omega)),omega,n)

  random_selected_prefix: LEMMA countPrefix(randomSelected(vars,bad,fallback,enumeration,a),omega,n)=
    countPrefix(selectedEvents(vars,bad,fallback,enumeration,initialStateFromLog(omega),a),omega,n)

  random_selected_prefix_function: LEMMA
    (LAMBDA(a:C):countPrefix(randomSelected(vars,bad,fallback,enumeration,a),omega,n))=
    (LAMBDA(a:C):countPrefix(selectedEvents(vars,bad,fallback,enumeration,initialStateFromLog(omega),a),omega,n))

  random_prefix_partition: LEMMA partitionPrefixes(labelUniverse(enumeration),
    randomRun(vars,bad,fallback,enumeration),randomLabelEvents(vars,bad,fallback,enumeration))

  fixed_expected_integrals: LEMMA
    (LAMBDA(a:C):expectedResamplingCount(vars,bad,fallback,enumeration,initial,a))=
    (LAMBDA(a:C):lintegral(LAMBDA(omega:LogSpace):eventCount(fixedLabelEvents(vars,bad,fallback,enumeration,initial)(a),omega)))

  random_expected_integrals: LEMMA
    (LAMBDA(a:C):randomInitExpectedResamplingCount(vars,bad,fallback,enumeration,a))=
    (LAMBDA(a:C):lintegral(LAMBDA(omega:LogSpace):eventCount(randomLabelEvents(vars,bad,fallback,enumeration)(a),omega)))

  ETLog_eq_sum_expectedResamplingCount: THEOREM ETLog(vars,bad,fallback,enumeration,initial)=
    ppg_nonneg_tsum[C].esum(labelUniverse(enumeration),LAMBDA(a:C):expectedResamplingCount(vars,bad,fallback,enumeration,initial,a))

  randomInitETLog_eq_sum_expectedResamplingCount: THEOREM randomInitETLog(vars,bad,fallback,enumeration)=
    ppg_nonneg_tsum[C].esum(labelUniverse(enumeration),LAMBDA(a:C):randomInitExpectedResamplingCount(vars,bad,fallback,enumeration,a))

END ppg_mt_expected_decomposition
