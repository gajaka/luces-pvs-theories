% Finite label sums commute with finite initial time ranges.
ppg_sum_swap_nat[T: TYPE]: THEORY
BEGIN
  IMPORTING ppg_nat_range, ppg_nonneg_order[T],
    ppg_monoid_sum[T,nonneg_real,0,LAMBDA(a,b:nonneg_real):a+b] AS tSum,
    ppg_monoid_sum[nat,nonneg_real,0,LAMBDA(a,b:nonneg_real):a+b] AS nSum
  A: VAR finite_set[T]
  q: VAR [T,nat->nonneg_real]
  f: VAR [nat->nonneg_real]
  n: VAR nat

  nat_sum_zero: LEMMA nSum.sum(natRange(0),f)=0

  nat_sum_succ: LEMMA nSum.sum(natRange(n+1),f)=nSum.sum(natRange(n),f)+f(n)

  row_prefix_function_succ: LEMMA
    (LAMBDA(t:T):nSum.sum(natRange(n+1),LAMBDA(k:nat):q(t,k)))=
    (LAMBDA(t:T):nSum.sum(natRange(n),LAMBDA(k:nat):q(t,k))+q(t,n))

  swap_nat_prefix: THEOREM nSum.sum(natRange(n),LAMBDA(k:nat):tSum.sum(A,LAMBDA(t:T):q(t,k)))=
    tSum.sum(A,LAMBDA(t:T):nSum.sum(natRange(n),LAMBDA(k:nat):q(t,k)))

END ppg_sum_swap_nat
