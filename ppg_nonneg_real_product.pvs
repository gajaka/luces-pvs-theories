% The real finite product agrees with the nonnegative product on nonnegative factors.
ppg_nonneg_real_product[T:TYPE]: THEORY
BEGIN
  IMPORTING ppg_finite_product[T], ppg_nonneg_folds[T]
  S: VAR finite_set[T]
  f: VAR [T->nonneg_real]
  product_nonneg_embed: LEMMA product(S,LAMBDA(t:T):f(t)) = products.sum(S,f)
END ppg_nonneg_real_product
