% Only the input carrier is enumerated. The state carrier may be
% infinite. A rule gives rational input masses, a deterministic update
% and a good-state test; its kernel sums masses over update fibers.
%
% Michael Mitzenmacher and Eli Upfal, Probability and Computing,
% second edition, Chapter 2, Cambridge University Press, 2017.
ppg_finite_input_update[State,Input: TYPE,
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)}]: THEORY
BEGIN
  IMPORTING ppg_rational_sum[Input] AS inputCoreRational,
    ppg_finite_sum[Input] AS inputCoreReal,
    ppg_monoid_sum[Input,rat,0,LAMBDA(a,b:rat):a+b] AS inputCoreSum

  Rule: TYPE = [# mass:[Input->rat],update:[State,Input->State],good:pred[State] #]

  R: VAR Rule
  s,t,s0: VAR State
  a: VAR Input
  n: VAR nat
  omega: VAR [nat->Input]
  F: VAR finite_set[Input]
  f,g: VAR [Input->rat]

  Valid(R): bool = (FORALL(a:Input):0<=R`mass(a)) AND inputCoreSum.sum(inputs,R`mass)=1

  kernel(R,s,t): rat = inputCoreSum.sum(inputs,
    LAMBDA(a:Input):IF R`update(s,a)=t THEN R`mass(a) ELSE 0 ENDIF)

  rational_sum_mono: LEMMA (FORALL(a:Input):F(a) IMPLIES f(a)<=g(a)) IMPLIES
    inputCoreSum.sum(F,f)<=inputCoreSum.sum(F,g)

  mass_nonnegative: LEMMA Valid(R) IMPLIES 0<=R`mass(a)

  kernel_nonnegative: LEMMA Valid(R) IMPLIES 0<=kernel(R,s,t)

  iidTrajectory(R,s0,n): RECURSIVE [[nat->Input]->State] =
    IF n=0 THEN LAMBDA(omega:[nat->Input]):s0
    ELSE LAMBDA(omega:[nat->Input]):
      R`update(iidTrajectory(R,s0,n-1)(omega),omega(n-1)) ENDIF
    MEASURE n

  trajectory_zero: LEMMA iidTrajectory(R,s0,0)(omega)=s0

  trajectory_step: LEMMA iidTrajectory(R,s0,n+1)(omega)=
    R`update(iidTrajectory(R,s0,n)(omega),omega(n))

END ppg_finite_input_update
