     |measure_integration|)
    (|nativeMass| CONST-DECL "nnreal" |ppg_probability_premeasure_extension|
     NIL)
    (|nativeExtended| CONST-DECL "extended_nnreal"
     |ppg_probability_premeasure_extension| NIL)
    (|extension| CONST-DECL "Probability"
     |ppg_probability_premeasure_extension| NIL)
    (|x_eq| CONST-DECL "bool" |extended_nnreal| |extended_nnreal|)
    (|to_measure| CONST-DECL "measure_type" |generalized_measure_def|
     |measure_integration|))
   SHOSTAK)))

