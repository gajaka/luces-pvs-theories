% An accepted drift witness bounds this concrete IID execution from
% the supplied initial state. Finite expected hitting time gives an
% eventual good state almost everywhere; normalization gives mass one.
%
% Johannes Lengler, "Drift Analysis", arXiv:1712.00964.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_finite_iid_hitting[State,Input: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)},
  (IMPORTING ppg_finite_update[State,Input,universe,inputs])
  R:{R:Rule|Valid(R)},s0:State]: THEORY
BEGIN
  IMPORTING ppg_finite_input_history[Input] AS iidHitHistory,
    ppg_finite_iid_law[State,Input,universe,inputs,R] AS iidHitLaw,
    ppg_finite_iid_trajectory[State,Input,universe,inputs] AS iidHitTrajectory,
    ppg_finite_iid_execution[State,Input,universe,inputs,R,s0] AS iidHitRun,
    ppg_finite_update[State,Input,universe,inputs] AS iidHitRule,
    ppg_finite_process_hitting[State,iidHitHistory.Sample,universe,
      iidHitHistory.ambientSigma,iidHitLaw.iidMeasure,iidHitTrajectory.inputFiltration] AS iidHitTheorems,
    ppg_finite_process_expectation[State,iidHitHistory.Sample,universe,
      iidHitHistory.ambientSigma,iidHitLaw.iidMeasure,iidHitTrajectory.inputFiltration] AS iidHitExpectation,
    ppg_finite_expectation[iidHitHistory.Sample,iidHitHistory.ambientSigma,
      iidHitLaw.iidMeasure] AS iidHitMass,
    measure_integration@measure_theory[iidHitHistory.Sample,asNasa(iidHitHistory.ambientSigma),
      iidHitLaw.iidMeasure] AS iidHitAE,
    ppg_probability_finite_view[iidHitHistory.Sample,iidHitHistory.ambientSigma] AS iidHitFiniteView,
    ppg_enn_sup

  W: VAR iidHitExpectation.AcceptedWitness(iidHitRule.model(R))
  omega: VAR iidHitHistory.Sample

  probability_mass_one: LEMMA iidHitMass.mass(fullset[iidHitHistory.Sample])=1

  initial_state: LEMMA iidHitRun.iidRealized(0)(omega)=s0

  iid_expectedHitCount_le: THEOREM
    ele(iidHitTheorems.expectedHitCount(iidHitRule.model(R),iidHitRun.iidRealized),
      ennFinite(iidHitTheorems.potentialAt(iidHitRule.model(R),W,s0)/
        iidHitExpectation.positiveRate(iidHitRule.model(R),W)))

  iid_expectedHitCount_lt_top: THEOREM FORALL(W:iidHitExpectation.AcceptedWitness(iidHitRule.model(R))):
    ennFinite?(iidHitTheorems.expectedHitCount(iidHitRule.model(R),iidHitRun.iidRealized))

  iid_ae_exists_good: THEOREM FORALL(W:iidHitExpectation.AcceptedWitness(iidHitRule.model(R))):
    iidHitAE.ae?(iidHitTheorems.successEvent(iidHitRule.model(R),iidHitRun.iidRealized))

  iid_measure_success_eq_one: THEOREM FORALL(W:iidHitExpectation.AcceptedWitness(iidHitRule.model(R))):
    iidHitMass.mass(iidHitTheorems.measurableSuccess(iidHitRule.model(R),iidHitRun.iidRealized))=1

END ppg_finite_iid_hitting
