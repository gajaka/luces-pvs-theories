% The two orientation rectangles are disjoint. Their product masses
% therefore add, giving the average of the two original event masses.
% The carrier U and its sigma algebra are arbitrary.
% Paul R. Halmos, Measure Theory, Springer, 1974, product measures.
% Kun He, Qian Li and Xiaoming Sun, Moser-Tardos Algorithm: Beyond
% Shearer's Bound, Lemma 3.4. arXiv:2111.06527.
ppg_hls_coin_choice[U:TYPE,
  (IMPORTING ppg_measurable_space[U]) SU:MeasurableSpace]: THEORY
BEGIN
  IMPORTING ppg_hls_fair_orientation,
    ppg_probability_pair[OrientationCoin,U,OrientationSigma,SU] AS coinProduct,
    ppg_measurable_space[[OrientationCoin,U]] AS choiceSets,
    ppg_probability_set_laws[[OrientationCoin,U],coinProduct.JointSpace] AS choiceMass

  A,B: VAR set[U]

  keepBlock(A): set[[OrientationCoin,U]] =
    cross_product(singleton[OrientationCoin](orientationKeep),A)

  flipBlock(B): set[[OrientationCoin,U]] =
    cross_product(singleton[OrientationCoin](orientationFlip),B)

  coinChoice(A,B): set[[OrientationCoin,U]] = union(keepBlock(A),flipBlock(B))

  keep_block_measurable: LEMMA SU(A) IMPLIES coinProduct.JointSpace(keepBlock(A))

  flip_block_measurable: LEMMA SU(B) IMPLIES coinProduct.JointSpace(flipBlock(B))

  choice_blocks_disjoint: LEMMA disjoint?(keepBlock(A),flipBlock(B))

  measurableSet_coinChoice: THEOREM SU(A) AND SU(B) IMPLIES
    coinProduct.JointSpace(coinChoice(A,B))

  MA,MB: VAR (SU)
  mu: VAR ppg_probability_measure[U,SU].Probability

  choiceEvent(MA,MB): (coinProduct.JointSpace) = coinChoice(MA,MB)

  keep_block_mass: LEMMA coinProduct.productLaw(fairOrientation,mu)(keepBlock(MA))=mu(MA)/2

  flip_block_mass: LEMMA coinProduct.productLaw(fairOrientation,mu)(flipBlock(MB))=mu(MB)/2

  measureReal_coinChoice: THEOREM
    coinProduct.productLaw(fairOrientation,mu)(choiceEvent(MA,MB))=mu(MA)/2+mu(MB)/2

END ppg_hls_coin_choice
