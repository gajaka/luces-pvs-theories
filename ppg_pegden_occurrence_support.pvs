% A shape outside the smaller Pegden family cannot occur. The support
% statement is structural and does not depend on a probability law.
%
% Wesley Pegden, "An extension of the Moser-Tardos algorithmic local
% lemma", Theorem 1.4. https://arxiv.org/abs/1102.2853
% Lean counterpart: witnessOccurrence_eq_empty_of_not_mem_family in
% PPGraphMoserTardosPegden.lean.
ppg_pegden_occurrence_support[C,V,Value:TYPE,domain:[V->set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_pegden_occurrence[C,V,Value,domain],ppg_pegden_family[C,V],
    ppg_mt_label_partition[C,V,Value,domain]
  vars: VAR CertVars
  bad: VAR [C,MTState->bool]
  fallback,a: VAR C
  enumeration: VAR LabelEnumeration
  W: VAR WTree

  pegden_label_universe_full: LEMMA fullUniverse(labelUniverse(enumeration))

  witnessOccurrence_eq_empty_of_not_mem_family: THEOREM
    NOT pegdenFamily(vars,labelUniverse(enumeration),a)(W) IMPLIES
      witnessOccurrence(vars,bad,fallback,enumeration,a,W)=emptyset[LogSpace]

END ppg_pegden_occurrence_support
