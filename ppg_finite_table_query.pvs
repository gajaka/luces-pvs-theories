% The next query contains one unused slot per variable. It is disjoint
% from the consumed block. Agreement on this query block fixes the whole
% next fixed draw and hence every one of its point events.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Section 2.
ppg_finite_table_query[V,Value:TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_finite_table_core[V,Value,variables,domains] AS queryTable,
    ppg_finite_table_consumed[V,variables] AS queryConsumed

  State: TYPE = queryTable.State

  ResamplingLog: TYPE = queryTable.ResamplingLog

  Counter: TYPE = queryTable.Counter

  Slot: TYPE = [nat,V]

  plainDomain: MACRO [V->set[Value]] = LAMBDA(v:V):domains(v)

  IMPORTING ppg_mt_random_process[bool,V,Value,plainDomain] AS querySlots

  c: VAR Counter
  j: VAR nat
  v: VAR V
  omega1,omega2: VAR ResamplingLog
  a: VAR State

  queryBlock(c): finite_set[Slot] = image[V,Slot](LAMBDA(v:V):(c(v)+1,v),variables)

  QueryAgreement(c,omega1,omega2): bool = FORALL(slot:Slot):
    queryBlock(c)(slot) IMPLIES omega1(slot)=omega2(slot)

  query_member: LEMMA queryBlock(c)((j,v)) IFF j=c(v)+1

  consumed_query_disjoint: THEOREM disjoint?(queryConsumed.consumedBlock(c),queryBlock(c))

  next_fixed_draw_agrees: LEMMA QueryAgreement(c,omega1,omega2) IMPLIES
    querySlots.drawFrom(omega1,LAMBDA(v:V):c(v)+1)=querySlots.drawFrom(omega2,LAMBDA(v:V):c(v)+1)

  fixed_query_event_depends: THEOREM QueryAgreement(c,omega1,omega2) IMPLIES
    (querySlots.drawFrom(omega1,LAMBDA(v:V):c(v)+1)=a IFF
      querySlots.drawFrom(omega2,LAMBDA(v:V):c(v)+1)=a)

END ppg_finite_table_query
