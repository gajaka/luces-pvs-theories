% The eight syntax constructors of Nat.Partrec.Code in Mathlib.
% Execution is defined separately from this datatype and its numbering.
%
% Mario Carneiro, Mathlib Computability.PartrecCode.
ppg_partrec_code: DATATYPE
BEGIN
  codeZero: codeZero?

  codeSucc: codeSucc?

  codeLeft: codeLeft?

  codeRight: codeRight?

  codePair(pairFirst, pairSecond: ppg_partrec_code): codePair?

  codeComp(compFirst, compSecond: ppg_partrec_code): codeComp?

  codePrec(precFirst, precSecond: ppg_partrec_code): codePrec?

  codeRfind(rfindBody: ppg_partrec_code): codeRfind?
END ppg_partrec_code
