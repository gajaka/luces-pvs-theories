% Changing the list carrier only composes the function being folded.
ppg_list_fold_map[T, U, R: TYPE, unit: R,
  op: {f: [R, R -> R] | identity?(f)(unit) AND associative?(f) AND commutative?(f)}]: THEORY
BEGIN
  IMPORTING ppg_list_fold[T, R, unit, op] AS domain,
    ppg_list_fold[U, R, unit, op] AS codomain
  xs: VAR list[T]
  h: VAR [T -> U]
  f: VAR [U -> R]
  fold_map: LEMMA codomain.fold(map(h)(xs), f) = domain.fold(xs, LAMBDA (x: T): f(h(x)))
END ppg_list_fold_map
