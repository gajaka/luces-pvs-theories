% Original table coordinates and auxiliary orientation coins occupy
% the two tags of V + finite_set[C]. Their values also retain their
% actual tags, so the data and Boolean carriers need no common value.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Section 3.1. https://arxiv.org/abs/2111.06527
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_hls_augmented_space[C,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces)]: THEORY
BEGIN
  IMPORTING ppg_hls_fair_orientation,
    ppg_probability_tagged_left,ppg_probability_tagged_right,
    ppg_subtype_measure_congruence,ppg_subtype_probability_congruence,ppg_probability_space_congruence,
    ppg_subtype_map_congruence,
    ppg_mt_native_spaces[C,V,Value,domain] AS originalNative,
    ppg_mt_coordinate_laws[C,V,Value,domain] AS originalCoins,
    ppg_mt_random_process[C,V,Value,domain] AS originalSlots,
    ppg_mt_log_probability[C,V,Value,domain,spaces,laws] AS originalLaw

  AugVariable: TYPE = union[V,finite_set[C]]

  AugValue: TYPE = union[Value,bool]

  dataDomain(v:V): MACRO set[AugValue] =
    ppg_probability_tagged_left[Value,bool,domain(v),spaces(v),laws(v)].taggedDomain

  coinDomain: MACRO set[AugValue] =
    ppg_probability_tagged_right[Value,bool,fullset[bool],OrientationSigma,fairOrientation].taggedDomain

  augmentedDomain(a:AugVariable): MACRO set[AugValue] =
    IF inl?(a) THEN dataDomain(left(a)) ELSE coinDomain ENDIF

  data_domain_characterization: LEMMA FORALL(v:V,z:AugValue):
    dataDomain(v)(z) IFF inl?(z) AND domain(v)(left(z))

  coin_domain_characterization: LEMMA FORALL(z:AugValue):
    coinDomain(z) IFF inr?(z)

  data_space_domain: LEMMA FORALL(v:V):dataDomain(v)=
    ppg_probability_tagged_left[Value,bool,domain(v),spaces(v),laws(v)].taggedDomain

  coin_space_domain: LEMMA coinDomain=
    ppg_probability_tagged_right[Value,bool,fullset[bool],OrientationSigma,fairOrientation].taggedDomain

  dataSpace(v:V): MACRO ppg_measurable_space[(dataDomain(v))].MeasurableSpace =
    ppg_probability_tagged_left[Value,bool,domain(v),spaces(v),laws(v)].taggedSpace

  orientationSpace: MACRO ppg_measurable_space[(coinDomain)].MeasurableSpace =
    ppg_probability_tagged_right[Value,bool,fullset[bool],OrientationSigma,fairOrientation].taggedSpace

  dataLaw(v:V): MACRO ppg_probability_measure[(dataDomain(v)),dataSpace(v)].Probability =
    ppg_probability_tagged_left[Value,bool,domain(v),spaces(v),laws(v)].taggedLaw

  orientationLaw: MACRO ppg_probability_measure[(coinDomain),orientationSpace].Probability =
    ppg_probability_tagged_right[Value,bool,fullset[bool],OrientationSigma,fairOrientation].taggedLaw

  augmentedSpaces(a:AugVariable): MACRO ppg_measurable_space[(augmentedDomain(a))].MeasurableSpace =
    IF inl?(a)
      THEN (dataSpace(left(a))::ppg_measurable_space[(augmentedDomain(a))].MeasurableSpace)
      ELSE (orientationSpace::ppg_measurable_space[(augmentedDomain(a))].MeasurableSpace) ENDIF

  augmentedLaws(a:AugVariable): MACRO ppg_probability_measure[(augmentedDomain(a)),augmentedSpaces(a)].Probability =
    IF inl?(a)
      THEN (dataLaw(left(a))::ppg_probability_measure[(augmentedDomain(a)),augmentedSpaces(a)].Probability)
      ELSE (orientationLaw::ppg_probability_measure[(augmentedDomain(a)),augmentedSpaces(a)].Probability) ENDIF

  augmented_domain_left: LEMMA FORALL(v:V):augmentedDomain(inl(v))=dataDomain(v)

  augmented_domain_right: LEMMA FORALL(F:finite_set[C]):augmentedDomain(inr(F))=coinDomain

  augmented_space_left: LEMMA FORALL(v:V):augmentedSpaces(inl(v))=dataSpace(v)

  augmented_space_right: LEMMA FORALL(F:finite_set[C]):augmentedSpaces(inr(F))=orientationSpace

  augmented_law_left: LEMMA FORALL(v:V):augmentedLaws(inl(v))=dataLaw(v)

  augmented_law_right: LEMMA FORALL(F:finite_set[C]):augmentedLaws(inr(F))=orientationLaw

  IMPORTING ppg_mt_native_spaces[C,AugVariable,AugValue,augmentedDomain] AS augmentedNative,
    ppg_mt_coordinate_laws[C,AugVariable,AugValue,augmentedDomain] AS augmentedCoins,
    ppg_mt_random_process[C,AugVariable,AugValue,augmentedDomain] AS augmentedSlots,
    ppg_mt_log_probability[C,AugVariable,AugValue,augmentedDomain,augmentedSpaces,augmentedLaws] AS augmentedLaw

  IMPORTING ppg_mt_coordinate_probability_adapter[C,V,Value,domain,spaces,laws] AS originalTypes,
    ppg_mt_coordinate_probability_adapter[C,AugVariable,AugValue,augmentedDomain,augmentedSpaces,augmentedLaws] AS augmentedTypes

  augmented_table_sigma: LEMMA FORALL(p:[nat,AugVariable]):
    ppg_measurable_space[(augmentedSlots.TableDomain(p))].sigma?(
      augmentedCoins.TableSpaces(augmentedSpaces)(p))

  original_table_sigma: LEMMA FORALL(p:[nat,V]):
    ppg_measurable_space[(originalSlots.TableDomain(p))].sigma?(
      originalCoins.TableSpaces(spaces)(p))

  CoinIndex: TYPE = [finite_set[C],nat]

  orientationDomain(p:CoinIndex): set[bool] = fullset[bool]

  orientationSpaces(p:CoinIndex): ppg_measurable_space[(orientationDomain(p))].MeasurableSpace =
    OrientationSigma

  orientationLaws(p:CoinIndex): ppg_probability_measure[(orientationDomain(p)),orientationSpaces(p)].Probability =
    fairOrientation

  IMPORTING ppg_measurable_cylinder[CoinIndex,bool,orientationDomain,orientationSpaces] AS orientationTables,
    ppg_probability_infinite_product[CoinIndex,bool,orientationDomain,orientationSpaces,orientationLaws] AS orientationProduct,
    ppg_measurable_cylinder[[nat,AugVariable],AugValue,augmentedSlots.TableDomain,
      augmentedCoins.TableSpaces(augmentedSpaces)] AS augmentationTables,
    ppg_measurable_cylinder[[nat,V],Value,originalSlots.TableDomain,
      originalCoins.TableSpaces(spaces)] AS originalTables

  AugTable: TYPE = augmentedSlots.LogSpace

  OriginalTable: TYPE = originalSlots.LogSpace

  CoinTable: TYPE = orientationTables.FullBlock

  AugSigma: MACRO ppg_measurable_space[AugTable].MeasurableSpace = augmentedNative.NativeTableSigma(augmentedSpaces)

  OriginalSigma: MACRO ppg_measurable_space[OriginalTable].MeasurableSpace = originalNative.NativeTableSigma(spaces)

  CoinSigma: MACRO ppg_measurable_space[CoinTable].MeasurableSpace = orientationTables.tableSigma

  originalTable(eta:AugTable): OriginalTable = LAMBDA(p:[nat,V]):
    left(eta((p`1,inl(p`2))))

  auxiliaryCoins(eta:AugTable): CoinTable = LAMBDA(p:(fullset[CoinIndex])):
    right(eta((p`2,inr(p`1))))

  originalFullProjection(eta:AugTable): originalTables.FullBlock =
    LAMBDA(p:(fullset[[nat,V]])):originalTable(eta)(p)

  originalAddress(p:[nat,V]): [nat,AugVariable] = (p`1,inl(p`2))

  coinAddress(p:CoinIndex): [nat,AugVariable] = (p`2,inr(p`1))

  originalDecoder: [p:[nat,V]->[(augmentedSlots.TableDomain(originalAddress(p)))->(originalSlots.TableDomain(p))]] =
    LAMBDA(p:[nat,V]):ppg_probability_tagged_left[Value,bool,domain(p`2),spaces(p`2),laws(p`2)].decode

  coinDecoder: [p:CoinIndex->[(augmentedSlots.TableDomain(coinAddress(p)))->(orientationDomain(p))]] =
    LAMBDA(p:CoinIndex):ppg_probability_tagged_right[Value,bool,fullset[bool],OrientationSigma,fairOrientation].decode

  original_decoder_measurable: LEMMA FORALL(p:[nat,V]):
    ppg_measurable_map[(augmentedSlots.TableDomain(originalAddress(p))),(originalSlots.TableDomain(p))].measurable(
      augmentedCoins.TableSpaces(augmentedSpaces)(originalAddress(p)),originalCoins.TableSpaces(spaces)(p),originalDecoder(p))

  coin_decoder_measurable: LEMMA FORALL(p:CoinIndex):
    ppg_measurable_map[(augmentedSlots.TableDomain(coinAddress(p))),(orientationDomain(p))].measurable(
      augmentedCoins.TableSpaces(augmentedSpaces)(coinAddress(p)),orientationSpaces(p),coinDecoder(p))

  IMPORTING ppg_probability_infinite_projection[[nat,AugVariable],[nat,V],AugValue,Value,
    augmentedSlots.TableDomain,originalSlots.TableDomain,
    augmentedCoins.TableSpaces(augmentedSpaces),originalCoins.TableSpaces(spaces),
    augmentedCoins.coinLaw(augmentedSpaces,augmentedLaws),originalCoins.coinLaw(spaces,laws),
    originalAddress,originalDecoder] AS originalProjection,
    ppg_probability_infinite_projection[[nat,AugVariable],CoinIndex,AugValue,bool,
    augmentedSlots.TableDomain,orientationDomain,
    augmentedCoins.TableSpaces(augmentedSpaces),orientationSpaces,
    augmentedCoins.coinLaw(augmentedSpaces,augmentedLaws),orientationLaws,
    coinAddress,coinDecoder] AS coinProjection,
    ppg_probability_infinite_product[[nat,AugVariable],AugValue,augmentedSlots.TableDomain,
      augmentedCoins.TableSpaces(augmentedSpaces),augmentedCoins.coinLaw(augmentedSpaces,augmentedLaws)] AS augmentationProduct,
    ppg_measurable_dependent_product,ppg_measurable_compose

  original_coordinate_preimage: LEMMA FORALL(p:[nat,V],A:set[(originalSlots.TableDomain(p))]):
    ppg_measurable_map[(augmentedSlots.TableDomain(originalAddress(p))),(originalSlots.TableDomain(p))].inverseImage(originalDecoder(p),A)=
    ppg_measurable_map[(dataDomain(p`2)),(domain(p`2))].inverseImage(
      ppg_probability_tagged_left[Value,bool,domain(p`2),spaces(p`2),laws(p`2)].decode,A)

  coin_coordinate_preimage: LEMMA FORALL(p:CoinIndex,A:set[(orientationDomain(p))]):
    ppg_measurable_map[(augmentedSlots.TableDomain(coinAddress(p))),(orientationDomain(p))].inverseImage(coinDecoder(p),A)=
    ppg_measurable_map[(coinDomain),(fullset[bool])].inverseImage(
      ppg_probability_tagged_right[Value,bool,fullset[bool],OrientationSigma,fairOrientation].decode,A)

  original_coordinate_laws: LEMMA originalProjection.coordinateLawsMatch

  coin_coordinate_laws: LEMMA coinProjection.coordinateLawsMatch

  original_table_decoder: LEMMA FORALL(eta:AugTable,p:[nat,V]):
    originalTable(eta)(p)=originalDecoder(p)(eta(originalAddress(p)))

  coin_table_decoder: LEMMA FORALL(eta:AugTable,p:CoinIndex):
    auxiliaryCoins(eta)(p)=coinDecoder(p)(eta(coinAddress(p)))

  original_coordinate_function: LEMMA FORALL(p:[nat,V]):
    (LAMBDA(eta:AugTable):originalDecoder(p)(eta(originalAddress(p))))=
    (LAMBDA(eta:AugTable):originalTable(eta)(p))

  coin_coordinate_function: LEMMA FORALL(p:CoinIndex):
    (LAMBDA(eta:AugTable):coinDecoder(p)(eta(coinAddress(p))))=
    (LAMBDA(eta:AugTable):auxiliaryCoins(eta)(p))

  original_projection_composes: LEMMA FORALL(x:augmentationTables.FullBlock):
    originalFullProjection(augmentedLaw.logMap(x))=originalProjection.project(x)

  coin_projection_composes: LEMMA FORALL(x:augmentationTables.FullBlock):
    auxiliaryCoins(augmentedLaw.logMap(x))=coinProjection.project(x)

  original_address_injective: LEMMA injective?(originalAddress)

  coin_address_injective: LEMMA injective?(coinAddress)

  IMPORTING ppg_measurable_dependent_product[AugTable,[nat,AugVariable],AugValue,augmentedSlots.TableDomain] AS augmentedCoordinates,
    ppg_measurable_block_map[AugTable,[nat,V],Value,originalSlots.TableDomain,originalCoins.TableSpaces(spaces)] AS originalBlockMaps,
    ppg_measurable_block_map[AugTable,CoinIndex,bool,orientationDomain,orientationSpaces] AS coinBlockMaps

  augmented_sigma_coordinates: LEMMA
    AugSigma=augmentedCoordinates.nativeProduct(augmentedCoins.TableSpaces(augmentedSpaces))

  original_table_coordinate_measurable: LEMMA FORALL(p:[nat,V]):
    ppg_measurable_map[AugTable,(originalSlots.TableDomain(p))].measurable(
      AugSigma,originalCoins.TableSpaces(spaces)(p),LAMBDA(eta:AugTable):originalTable(eta)(p))

  coin_table_coordinate_measurable: LEMMA FORALL(p:CoinIndex):
    ppg_measurable_map[AugTable,(orientationDomain(p))].measurable(
      AugSigma,orientationSpaces(p),LAMBDA(eta:AugTable):auxiliaryCoins(eta)(p))

  measurable_originalFullProjection: LEMMA
    ppg_measurable_map[AugTable,originalTables.FullBlock].measurable(
      AugSigma,originalTables.tableSigma,originalFullProjection)

  original_full_log_identity: LEMMA FORALL(eta:AugTable):
    originalLaw.logMap(originalFullProjection(eta))=originalTable(eta)

  original_full_log_function: LEMMA
    (LAMBDA(eta:AugTable):originalLaw.logMap(originalFullProjection(eta)))=originalTable

  measurable_originalTable: THEOREM ppg_measurable_map[AugTable,OriginalTable].measurable(
    AugSigma,OriginalSigma,originalTable)

  measurable_auxiliaryCoins: THEOREM ppg_measurable_map[AugTable,CoinTable].measurable(
    AugSigma,CoinSigma,auxiliaryCoins)

  augmentedMeasure: ppg_probability_measure[AugTable,AugSigma].Probability = augmentedLaw.logMeasure

  IMPORTING ppg_probability_map[AugTable,OriginalTable,AugSigma,OriginalSigma] AS originalTablePush,
    ppg_probability_map[AugTable,CoinTable,AugSigma,CoinSigma] AS auxiliaryCoinsPush

  IMPORTING ppg_probability_infinite_product[[nat,V],Value,originalSlots.TableDomain,
    originalCoins.TableSpaces(spaces),originalCoins.coinLaw(spaces,laws)] AS originalProduct,
    ppg_probability_map[AugTable,originalTables.FullBlock,AugSigma,originalTables.tableSigma] AS originalFullPush,
    ppg_probability_push_compose

  original_project_function: LEMMA
    (LAMBDA(x:augmentationTables.FullBlock):originalFullProjection(augmentedLaw.logMap(x)))=
    originalProjection.project

  coin_project_function: LEMMA
    (LAMBDA(x:augmentationTables.FullBlock):auxiliaryCoins(augmentedLaw.logMap(x)))=
    coinProjection.project

  original_full_projection_law: LEMMA
    originalFullPush.pushforward(augmentedLaw.logMeasure,originalFullProjection)=originalProduct.infiniteLaw

  map_originalTable: THEOREM originalTablePush.pushforward(augmentedLaw.logMeasure,originalTable)=originalLaw.logMeasure

  original_table_mass: LEMMA FORALL(B:(OriginalSigma)):
    augmentedMeasure(ppg_measurable_map[AugTable,OriginalTable].inverseImage(originalTable,B))=originalLaw.logMeasure(B)

  map_auxiliaryCoins: THEOREM auxiliaryCoinsPush.pushforward(augmentedLaw.logMeasure,auxiliaryCoins)=orientationProduct.infiniteLaw

END ppg_hls_augmented_space
