% Splitting a finite conditioning set into neighbors and non-neighbors
% separates the two uses of the LLL hypothesis. The products and set
% identities below require no probability law. Marginal weights may be
% any nonnegative real masses on arbitrary subsets of the outcome space.
%
% Noga Alon and Joel H. Spencer, The Probabilistic Method, fourth edition,
% Wiley, 2016, Lemma 5.1.1. Lean counterpart: PPGraphLLL.lean.
ppg_lll_event_splits[X,C,V:TYPE,
  (IMPORTING ppg_bdd[C,V]) vars:CertVars]: THEORY
BEGIN
  IMPORTING ppg_event_dependence[X,C,V,vars],ppg_real_product_order[C]
  A: VAR BadEvents
  B,T,U,W: VAR finite_set[C]
  i,j: VAR C
  x: VAR [C->real]
  m: VAR RawMass

  pass_event(A,i): set[X] = complement(A(i))

  good_event(A,B): set[X] = all_pass(A,B)

  event_prob(A,m)(i:C): real = m(A(i))

  factors(x)(i:C): real = 1-x(i)

  Bounds(x,B): bool = FORALL(j:C):B(j) IMPLIES 0<=x(j) AND x(j)<1

  S1_of(B,T,i): finite_set[C] = intersection(T,neighbors(vars,B,i))

  S2_of(B,T,i): finite_set[C] = difference(T,neighbors(vars,B,i))

  all_pass_empty_source: THEOREM all_pass(A,emptyset[C])=fullset[X]

  all_pass_subset_source: THEOREM subset?(T,U) IMPLIES subset?(all_pass(A,U),all_pass(A,T))

  all_pass_union_source: THEOREM all_pass(A,union(T,U))=intersection(all_pass(A,T),all_pass(A,U))

  all_pass_insert_source: THEOREM NOT T(i) IMPLIES
    all_pass(A,add(i,T))=intersection(pass_event(A,i),all_pass(A,T))

  neighbors_subset_B: LEMMA subset?(neighbors(vars,B,i),B)

  factors_positive: LEMMA Bounds(x,T) IMPLIES PositiveFactors(factors(x),T)

  factors_unit: LEMMA Bounds(x,T) IMPLIES UnitFactors(factors(x),T)

  bounds_subset: LEMMA subset?(T,U) AND Bounds(x,U) IMPLIES Bounds(x,T)

  prod_one_sub_pos: THEOREM Bounds(x,T) IMPLIES 0<product(T,factors(x))

  prod_one_sub_le_one: THEOREM Bounds(x,T) IMPLIES product(T,factors(x))<=1

  x_mul_prod_le: THEOREM 0<=x(i) AND Bounds(x,T) IMPLIES x(i)*product(T,factors(x))<=x(i)

  pi_bound: THEOREM lll_feasible(event_prob(A,m),x,vars,B) AND B(i) IMPLIES
    m(A(i))<=x(i)*product(neighbors(vars,B,i),factors(x))

  lll_base_case: THEOREM lll_feasible(event_prob(A,m),x,vars,B) AND B(i) IMPLIES m(A(i))<=x(i)

  S_split_S1_S2: THEOREM T=union(S1_of(B,T,i),S2_of(B,T,i))

  S1_S2_disjoint: THEOREM disjoint?(S1_of(B,T,i),S2_of(B,T,i))

  S1_of_subset: THEOREM subset?(S1_of(B,T,i),T)

  S2_of_subset: THEOREM subset?(S2_of(B,T,i),T)

  all_pass_S_split: THEOREM all_pass(A,T)=intersection(all_pass(A,S1_of(B,T,i)),all_pass(A,S2_of(B,T,i)))

  S1_subset_neighbors: THEOREM subset?(S1_of(B,T,i),neighbors(vars,B,i))

  S2_indep_side: THEOREM subset?(T,B) AND NOT T(i) IMPLIES independent_side(B,i,S2_of(B,T,i))

  prod_mono_S1: THEOREM Bounds(x,B) IMPLIES product(neighbors(vars,B,i),factors(x))<=product(S1_of(B,T,i),factors(x))

  S1_member_in_B: THEOREM S1_of(B,T,i)(j) IMPLIES B(j)

  telescope_union_subset: THEOREM subset?(T,B) AND subset?(U,S1_of(B,T,i)) IMPLIES
    subset?(union(U,S2_of(B,T,i)),B)

  telescope_union_excludes: THEOREM NOT U(j) AND subset?(add(j,U),S1_of(B,T,i)) IMPLIES
    NOT union(U,S2_of(B,T,i))(j)

  telescope_union_ssub: THEOREM NOT U(j) AND subset?(add(j,U),S1_of(B,T,i)) IMPLIES
    subset?(union(U,S2_of(B,T,i)),T) AND union(U,S2_of(B,T,i))/=T
END ppg_lll_event_splits
