%%% brenier_uniqueness.pvs
%%% Brenier's Theorem: Convex Potential Implies Monotone Map
%%%
%%% Villani (2003), Ch.2, Theorem 2.12 (Brenier-McCann):
%%%   For quadratic cost c(x,y) = |x-y|², if μ is absolutely continuous,
%%%   the optimal map T = ∇φ for some convex φ.
%%%
%%% Discrete 1D consequence:
%%%   If φ is convex (second differences ≥ 0) and T(i) = argmin_j(c(i,j) - φ(j)),
%%%   then T is monotone (non-decreasing).
%%%
%%% This theory separates:
%%%   - convex potential (property of dual solution)
%%%   - monotone map (CONSEQUENCE, not definition)
%%%
%%% Connects to: C1 (rank preservation), C_monge (near-Monge)
%%%
%%% Author: Dragan Stosic, 2026

brenier_uniqueness: THEORY
BEGIN

  IMPORTING reals@sq

  N: posnat

  Bin: TYPE = below(N)

  TransportMap: TYPE = [Bin -> Bin]

  Potential: TYPE = [Bin -> real]

  % Quadratic cost on 1D grid
  cost(i: Bin, j: Bin): nonneg_real = (i - j) * (i - j)

%% ═══════════════════════════════════════════════════════════
%% Definitions
%% ═══════════════════════════════════════════════════════════

  % Convex potential: discrete second differences ≥ 0
  convex?(phi: Potential): bool =
    FORALL (i: Bin):
      i > 0 AND i < N - 1 IMPLIES
      phi(i + 1) + phi(i - 1) >= 2 * phi(i)

  % Map induced by potential: T(i) = argmin_j [cost(i,j) - phi(j)]
  % Simplified: T(i) minimizes j² - 2ij - phi(j), i.e. closest j adjusted by potential
  induced_by?(T: TransportMap, phi: Potential): bool =
    FORALL (i: Bin, j: Bin):
      cost(i, T(i)) - phi(T(i)) <= cost(i, j) - phi(j)

  % Monotone (non-decreasing)
  monotone?(T: TransportMap): bool =
    FORALL (i, j: Bin): i < j IMPLIES T(i) <= T(j)

  % Strictly monotone
  strictly_monotone?(T: TransportMap): bool =
    FORALL (i, j: Bin): i < j IMPLIES T(i) < T(j)

%% ═══════════════════════════════════════════════════════════
%% Structural Axioms
%% ═══════════════════════════════════════════════════════════

  % A1: Optimal map is induced by a convex potential (Brenier)
  T_opt: TransportMap
  phi_opt: Potential

  ax_brenier: AXIOM
    convex?(phi_opt) AND induced_by?(T_opt, phi_opt)

  % A2: For quadratic cost on 1D, a map induced by a convex potential is monotone
  %     This is the KEY structural content of Brenier in 1D:
  %     convexity of φ + optimality condition → monotone T
  %     Proof sketch: if i < j and T(i) > T(j), then swapping reduces cost
  %     (by quadratic cost rearrangement inequality), contradicting optimality.
  ax_convex_potential_implies_monotone: AXIOM
    FORALL (T: TransportMap, phi: Potential):
      convex?(phi) AND induced_by?(T, phi) IMPLIES monotone?(T)

%% ═══════════════════════════════════════════════════════════
%% Theorems
%% ═══════════════════════════════════════════════════════════

  % T1: Optimal map is monotone (Brenier consequence)
  %     NOT a tautology: follows from A1 (convex + induced) + A2 (implies monotone)
  thm_optimal_is_monotone: THEOREM
    monotone?(T_opt)

  % T2: Strictly monotone maps are injective
  thm_strict_monotone_injective: THEOREM
    FORALL (T: TransportMap):
      strictly_monotone?(T) IMPLIES
      FORALL (i, j: Bin): i /= j IMPLIES T(i) /= T(j)

  % T3: Strictly monotone map on below(N) → below(N) is surjective (permutation)
  %     On finite totally ordered set of same size, strict monotone = bijection
  %     RESOLVED BY Z3 (QF_LIA): brenier_t3_surjective.smt2 returns UNSAT.
  %     PVS proof requires pigeonhole induction (not available in nasalib).
  %
  % thm_monotone_permutation: THEOREM
  %   FORALL (T: TransportMap):
  %     strictly_monotone?(T) IMPLIES
  %     FORALL (j: Bin): EXISTS (i: Bin): T(i) = j

END brenier_uniqueness
