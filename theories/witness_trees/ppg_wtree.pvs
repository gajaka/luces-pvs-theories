% An ordered witness-tree shape has an event label at each node and a
% finite child list. Well-formedness and properness are separate predicates
% in ppg_mt_witness; this datatype imposes neither condition itself.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", Section 2, Lemma 2.1.
% https://arxiv.org/abs/0903.0544v3
% Lean datatype: WTree in PPGraphMoserTardosWitness.lean.
% The file-level declaration generates the PVS datatype folds used by
% the structural definitions.
%
% Author: Dragan Stosic, 2026.

ppg_wtree[I: TYPE+]: DATATYPE
BEGIN
  node(lab: I, children: list[ppg_wtree]): node?
END ppg_wtree
