% An injective natural code for labels gives an injective natural code
% for finite ordered witness trees. Paired codes retain the root label
% and the entire child list, including order and repetitions. The induced
% countability justifies later countable sums over witness occurrences.
%
% Lean counterpart: PPGraphMoserTardosWTreeCountable.lean.

ppg_rose_countable[C: TYPE]: THEORY
BEGIN
  IMPORTING ppg_rose_size[C], foundations@ppg_nat_list_code
  labelCode: VAR [C -> nat]
  t, u: VAR WTree

  treeCode(labelCode): [WTree -> nat] =
    reduce_nat(LAMBDA (a: C, ns: list[nat]): pairCode(labelCode(a), listCode(ns)))

  tree_code_node: LEMMA FORALL (a: C, cs: list[WTree]):
    treeCode(labelCode)(roseNode(a, cs)) =
      pairCode(labelCode(a), listCode(map(treeCode(labelCode))(cs)))

  tree_code_formula: LEMMA treeCode(labelCode)(t) =
    pairCode(labelCode(roseLabel(t)), listCode(map(treeCode(labelCode))(roseChildren(t))))

  tree_code_parts: LEMMA treeCode(labelCode)(t) = treeCode(labelCode)(u) IMPLIES
    labelCode(roseLabel(t)) = labelCode(roseLabel(u)) AND
    map(treeCode(labelCode))(roseChildren(t)) = map(treeCode(labelCode))(roseChildren(u))

  tree_code_injective: THEOREM injective?(labelCode) IMPLIES injective?(treeCode(labelCode))

  countable_labels: bool = EXISTS (e: [C -> nat]): injective?(e)

  Bounded(n: nat): TYPE = {t: WTree | treeSize(t) <= n}

  bounded_countable: LEMMA FORALL (n: nat): countable_labels IMPLIES
    EXISTS (e: [Bounded(n) -> nat]): injective?(e)

  trees_countable: THEOREM countable_labels IMPLIES
    EXISTS (e: [WTree -> nat]): injective?(e)

END ppg_rose_countable
