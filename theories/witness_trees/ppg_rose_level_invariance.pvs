% On a proper tree, a depth-indexed commutative fold is unchanged by canonicalization
% when its node rule commutes with rebuilding. The depth parameter advances
% once along each child edge. Footprint counts and finite check conjunctions
% are instances of this statement.
%
% PVS support for PPGraphMoserTardosCheckInvariance.lean.

ppg_rose_level_invariance[C, V, R: TYPE, unit: R,
  op: {f: [R, R -> R] | identity?(f)(unit) AND associative?(f) AND commutative?(f)}]: THEORY
BEGIN
  IMPORTING moser_tardos@ppg_mt_reconstruction_fold[C, V, R, unit, op], ppg_rose_canonical_core[C, V],
    foundations@ppg_list_fold_map[WTree, WTree, R, unit, op] AS treeMap
  t: VAR WTree
  h: VAR [nat, WTree -> R]
  g: VAR [nat, C -> R]
  f: VAR [WTree -> WTree]
  d, n: VAR nat

  hom_unfold: LEMMA nodeHom(h, g) IMPLIES h(d, t) =
    op(g(d, roseLabel(t)), treeLists.fold(roseChildren(t), LAMBDA (c: WTree): h(d + 1, c)))

  rebuild_hom: LEMMA nodeHom(h, g) AND proper(t) AND
    (FORALL (c: WTree): member(c, roseChildren(t)) IMPLIES h(d + 1, f(c)) = h(d + 1, c))
    IMPLIES h(d, rebuild(t, f)) = h(d, t)

  canonicalFuel_hom: THEOREM nodeHom(h, g) AND proper(t) AND depth(t) <= n IMPLIES
    h(d, canonicalFuel(n, t)) = h(d, t)

  canonicalize_hom: THEOREM nodeHom(h, g) AND proper(t) IMPLIES
    h(d, canonicalize(t)) = h(d, t)

END ppg_rose_level_invariance
