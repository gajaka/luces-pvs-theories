% A well-formed tree uses inclusive parent-child dependency, allowing
% a child to repeat its parent's label. Properness requires distinct
% labels only among siblings. Equal-depth independence is stronger and
% is handled separately.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", Section 2, Lemma 2.1.
% https://arxiv.org/abs/0903.0544v3
% Lean counterpart: PPGraphMoserTardosWitness.lean.

ppg_rose_structure[C, V: TYPE]: THEORY
BEGIN
  IMPORTING ppg_rose_size[C], moser_tardos@ppg_mt_tree[C, V],
    foundations@ppg_list_sets[C], foundations@ppg_list_sets[WTree], foundations@ppg_list_maps[WTree, bool], ppg_mt_rose_adt_reduce[C, bool]
  vars: VAR CertVars
  t, c: VAR WTree
  cs: VAR list[WTree]
  a: VAR C

  wfNode(vars)(a: C, bs: list[bool], t: WTree): bool =
    every(LAMBDA (b: bool): b)(bs) AND
    every(LAMBDA (c: WTree): roseLabel(c) = a OR dependent?(vars)(a, roseLabel(c)))(roseChildren(t))

  wellFormed(vars): [WTree -> bool] = ppg_mt_rose_adt_reduce[C, bool].REDUCE(wfNode(vars))

  distinctLabels(cs): bool = ppg_list_sets[C].nodup(map(roseLabel)(cs))

  properNode(a: C, bs: list[bool], t: WTree): bool =
    every(LAMBDA (b: bool): b)(bs) AND distinctLabels(roseChildren(t))

  proper: [WTree -> bool] = ppg_mt_rose_adt_reduce[C, bool].REDUCE(properNode)

  wellFormed_node: LEMMA wellFormed(vars)(roseNode(a, cs)) =
    (every(wellFormed(vars))(cs) AND
      every(LAMBDA (c: WTree): roseLabel(c) = a OR dependent?(vars)(a, roseLabel(c)))(cs))

  proper_node: LEMMA proper(roseNode(a, cs)) = (every(proper)(cs) AND distinctLabels(cs))

  wellFormed_singleton: THEOREM wellFormed(vars)(roseNode(a, null))

  proper_singleton: THEOREM proper(roseNode(a, null))

  wellFormed_unfold: LEMMA wellFormed(vars)(t) =
    (every(wellFormed(vars))(roseChildren(t)) AND
      every(LAMBDA (c: WTree): roseLabel(c) = roseLabel(t) OR dependent?(vars)(roseLabel(t), roseLabel(c)))(roseChildren(t)))

  proper_unfold: LEMMA proper(t) = (every(proper)(roseChildren(t)) AND distinctLabels(roseChildren(t)))

  wellFormed_child: LEMMA wellFormed(vars)(t) AND member(c, roseChildren(t)) IMPLIES
    wellFormed(vars)(c) AND (roseLabel(c) = roseLabel(t) OR dependent?(vars)(roseLabel(t), roseLabel(c)))

  proper_child: LEMMA proper(t) AND member(c, roseChildren(t)) IMPLIES proper(c)

END ppg_rose_structure
