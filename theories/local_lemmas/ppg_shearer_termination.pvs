% The finite Shearer expected-work bound makes the event of infinite
% resampling null. The existing count/termination correspondence then
% gives a good state on almost every table and termination probability one.
%
% Kolipaka--Szegedy bound, presented by Jan Vondrak, MATH233A (2018),
% Lecture 8. https://theory.stanford.edu/~jvondrak/MATH233A-2018/Math233-lec08.pdf
% Lean counterpart: PPGraphShearerExpectation.lean.
ppg_shearer_termination[C,V,Value:TYPE,domain:[V->set[Value]],
  universe:{F:finite_set[V]|F=fullset[V]},
  (IMPORTING moser_tardos@ppg_mt_native_spaces[C,V,Value,domain]) spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING ppg_core@ppg_bdd[C,V]) vars:CertVars]: THEORY
BEGIN
  IMPORTING ppg_shearer_total_expectation[C,V,Value,domain,universe,spaces,laws,vars],
    moser_tardos@ppg_mt_termination[C,V,Value,domain,spaces,laws]
  bad: VAR NativeBad
  fallback: VAR C
  enumeration: VAR SeqProbabilityEnumeration
  B: VAR UniversalLabels
  p: VAR [C->real]

  ae_randomInit_exists_good_of_strictCriterion: THEOREM mt_wf(vars,bad) AND
    (FORALL(c:C):baseProbability(bad)(c)<=p(c)) AND StrictCriterion(p,B) IMPLIES
    ae?[LogSpace,asNasa(NativeTableSigma(spaces)),nasaLaw](terminationEvent(vars,bad,fallback,enumeration))

  logMeasure_randomInit_termination_eq_one_of_strictCriterion: THEOREM mt_wf(vars,bad) AND
    (FORALL(c:C):baseProbability(bad)(c)<=p(c)) AND StrictCriterion(p,B) IMPLIES
    logMeasure(terminationEvent(vars,bad,fallback,enumeration))=1

END ppg_shearer_termination
