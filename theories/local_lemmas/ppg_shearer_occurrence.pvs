% A sequence at time s records the actual witness rooted at s+1. It
% depends only on the finite selected-label history. Its occurrence event
% is the countable union over active times with the prescribed root label.
%
% Repeated active occurrences of one label have different label counts,
% hence different profiles. Reindexing this injection proves the count
% identity for each table, including tables with infinitely many steps.
%
% Noga Alon and Joel H. Spencer, The Probabilistic Method, fourth edition
% (2016), Section 5.7. The occurrence argument uses the actual MT witness.
% Lean counterpart: PPGraphShearerOccurrence.lean.
ppg_shearer_occurrence[C,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_core@ppg_bdd[C,V]) vars:CertVars]: THEORY
BEGIN
  IMPORTING ppg_shearer_witness[C,V,vars], ppg_shearer_profile_weights[C,V,vars],
    moser_tardos@ppg_mt_occurrence_counting[C,V,Value,domain],
    measure_probability@ppg_measurable_compose[LogSpace,list[C],LayerSeq], measure_probability@ppg_indicator_reindex[nat,LayerSeq]
  bad: VAR [C,MTState->bool]
  fallback,a: VAR C
  enumeration: VAR list[C]
  coordinates: VAR [V->ppg_measurable_space[Value].MeasurableSpace]
  omega: VAR LogSpace
  s,t: VAR nat
  Clog: VAR [nat->C]
  L: VAR LayerSeq
  B: VAR UniversalLabels

  randomInitSequence(bad,fallback,enumeration,omega,s): LayerSeq =
    treeLayers(tau_C(vars,shiftedC(vars,bad,fallback,enumeration,initialStateFromLog(omega),omega),s+1))

  decodeSequence(fallback,s)(w:list[C]): LayerSeq =
    treeLayers(tau_C(vars,LAMBDA(k:nat):readHistory(fallback,w,k),s+1))

  sequence_factors_through_history: LEMMA
    (LAMBDA(omega:LogSpace):randomInitSequence(bad,fallback,enumeration,omega,s))=
    (LAMBDA(omega:LogSpace):decodeSequence(fallback,s)(
      history(shiftedC(vars,bad,fallback,enumeration,initialStateFromLog(omega),omega),s+2)))

  decode_sequence_measurable: LEMMA measurable(fullset[set[list[C]]],fullset[set[LayerSeq]],decodeSequence(fallback,s))

  measurable_randomInitSequence: THEOREM completeEnumeration(enumeration) AND measurableBad(coordinates,bad) IMPLIES
    measurable(TableSigma(coordinates),fullset[set[LayerSeq]],
      LAMBDA(omega:LogSpace):randomInitSequence(bad,fallback,enumeration,omega,s))

  measurableSet_randomInitSequence_eq: THEOREM completeEnumeration(enumeration) AND measurableBad(coordinates,bad) IMPLIES
    TableSigma(coordinates)({omega:LogSpace|randomInitSequence(bad,fallback,enumeration,omega,s)=L})

  sequenceOccurrence(bad,fallback,enumeration,a,L): set[LogSpace] = {omega:LogSpace|
    EXISTS(s:nat):randomInitResamplingEvent(vars,bad,fallback,enumeration,a,s)(omega) AND
      randomInitSequence(bad,fallback,enumeration,omega,s)=L}

  sequenceOccurrence_eq_iUnion: THEOREM sequenceOccurrence(bad,fallback,enumeration,a,L)=
    countableUnion(LAMBDA(s:nat):intersection(randomInitResamplingEvent(vars,bad,fallback,enumeration,a,s),
      {omega:LogSpace|randomInitSequence(bad,fallback,enumeration,omega,s)=L}))

  measurable_sequence_component: LEMMA completeEnumeration(enumeration) AND measurableBad(coordinates,bad) IMPLIES
    TableSigma(coordinates)(intersection(randomInitResamplingEvent(vars,bad,fallback,enumeration,a,s),
      {omega:LogSpace|randomInitSequence(bad,fallback,enumeration,omega,s)=L}))

  measurableSet_sequenceOccurrence: THEOREM completeEnumeration(enumeration) AND measurableBad(coordinates,bad) IMPLIES
    TableSigma(coordinates)(sequenceOccurrence(bad,fallback,enumeration,a,L))

  sequenceOccurrence_nonempty_mem_properFamily: THEOREM nonempty?(sequenceOccurrence(bad,fallback,enumeration,a,L)) IMPLIES
    properFamily(B,sets[C].singleton(a))(L)

  sequenceOccurrence_eq_empty_of_not_mem_properFamily: THEOREM NOT properFamily(B,sets[C].singleton(a))(L) IMPLIES
    sequenceOccurrence(bad,fallback,enumeration,a,L)=emptyset[LogSpace]

  tauC_treeLayers_ne_of_lt: THEOREM 0<s AND 0<t AND s<t AND Clog(s)=Clog(t) IMPLIES
    treeLayers(tau_C(vars,Clog,s))/=treeLayers(tau_C(vars,Clog,t))

  randomInitSequence_ne_of_lt: THEOREM s<t AND
    realC(vars,bad,fallback,enumeration,initialStateFromLog(omega),omega,s)=
      realC(vars,bad,fallback,enumeration,initialStateFromLog(omega),omega,t) IMPLIES
    randomInitSequence(bad,fallback,enumeration,omega,s)/=randomInitSequence(bad,fallback,enumeration,omega,t)

  sequenceWeightsNN(bad,fallback,enumeration,omega,a)(L): nonneg_real =
    IF sequenceOccurrence(bad,fallback,enumeration,a,L)(omega) THEN 1 ELSE 0 ENDIF

  active_sequence_injective: LEMMA FORALL(s,t:nat):activeTimes(vars,bad,fallback,enumeration,omega,a)(s) AND
    activeTimes(vars,bad,fallback,enumeration,omega,a)(t) AND
    randomInitSequence(bad,fallback,enumeration,omega,s)=randomInitSequence(bad,fallback,enumeration,omega,t) IMPLIES s=t

  active_sequence_image: LEMMA
    supportImage(activeTimes(vars,bad,fallback,enumeration,omega,a),
      LAMBDA(s:nat):randomInitSequence(bad,fallback,enumeration,omega,s))=
      {L:LayerSeq|sequenceOccurrence(bad,fallback,enumeration,a,L)(omega)}

  sequence_indicator_function: LEMMA
    (LAMBDA(L:LayerSeq):IF supportImage(activeTimes(vars,bad,fallback,enumeration,omega,a),
      LAMBDA(s:nat):randomInitSequence(bad,fallback,enumeration,omega,s))(L) THEN 1 ELSE 0 ENDIF)=
      sequenceWeightsNN(bad,fallback,enumeration,omega,a)

  randomInitResamplingCount_eq_tsum_sequenceOccurrence: THEOREM
    randomInitResamplingCount(vars,bad,fallback,enumeration,omega,a)=
      ppg_nonneg_tsum[LayerSeq].tsum(sequenceWeightsNN(bad,fallback,enumeration,omega,a))

END ppg_shearer_occurrence
