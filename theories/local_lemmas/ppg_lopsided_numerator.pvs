% Dropping neighboring exclusions enlarges the numerator event.
% Lopsidependence then bounds its mass by the product of two marginals.
% The canonical outer mass permits arbitrary bad-event subsets here.
%
% David G. Harris, "Lopsidependency in the Moser-Tardos framework:
% Beyond the Lopsided Lovasz Local Lemma", Section 1.2.
% https://arxiv.org/abs/1610.02420
% Lean counterpart: PPGraphLopsidedLLL.lean, lopsided_numerator_bound.
ppg_lopsided_numerator[X,C,V:TYPE,
  (IMPORTING measure_probability@ppg_measurable_space[X]) S:MeasurableSpace,
  (IMPORTING measure_probability@ppg_probability_measure[X,S]) mu:Probability,
  (IMPORTING ppg_core@ppg_bdd[C,V]) vars:CertVars]: THEORY
BEGIN
  IMPORTING measure_probability@ppg_probability_outer[X,S,mu],measure_probability@ppg_event_dependence[X,C,V,vars]
  A: VAR BadEvents
  B,T: VAR finite_set[C]
  i: VAR C

  numeratorRemote(B,T,i): finite_set[C] = difference(T,neighbors(vars,B,i))

  numeratorRemote_subset: LEMMA subset?(numeratorRemote(B,T,i),T)

  numeratorRemote_side: LEMMA subset?(T,B) AND NOT T(i) IMPLIES
    independent_side(B,i,numeratorRemote(B,T,i))

  numerator_drop: LEMMA subset?(intersection(A(i),all_pass(A,T)),
    intersection(A(i),all_pass(A,numeratorRemote(B,T,i))))

  lopsided_numerator_bound: THEOREM lll_lopsidependence(mass,A,B) AND
    subset?(T,B) AND B(i) AND NOT T(i) IMPLIES
      mass(intersection(A(i),all_pass(A,T)))<=
        mass(A(i))*passProbability(mass,A,numeratorRemote(B,T,i))

END ppg_lopsided_numerator
