% Distinct labels within a depth slice preserve each vertex contribution.
% The product of layer products is the product over all tree vertices.
% Applying the additive version to a label indicator reads its occurrence
% count from the profile. Equal profiles therefore have equal counts.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", Section 2. https://arxiv.org/abs/0903.0544v3
% Lean counterpart: PPGraphShearerLayerProfile.lean.
ppg_shearer_profile_weights[C,V:TYPE,(IMPORTING ppg_core@ppg_bdd[C,V]) vars:CertVars]: THEORY
BEGIN
  IMPORTING ppg_shearer_profile_fold[C,V,real,vars,1,LAMBDA(a,b:real):a*b] AS weightProfile,
    ppg_shearer_profile_fold[C,V,nat,vars,0,LAMBDA(r,s:nat):r+s] AS countProfile,
    moser_tardos@ppg_mt_label_counts[C,V], foundations@ppg_nat_indicator[C], foundations@ppg_nat_indicator[Addr],
    foundations@ppg_real_product[Addr]
  T,U: VAR GTree
  a: VAR C
  p: VAR [C->real]
  J: VAR Layer

  layerCount(a): [Layer->nat] = LAMBDA(J:Layer):IF J(a) THEN 1 ELSE 0 ENDIF

  profileCount(T,a): nat =
    ppg_list_fold[Layer,nat,0,LAMBDA(r,s:nat):r+s].fold(treeLayers(T),layerCount(a))

  label_product_fold: LEMMA ppg_finite_product[C].product=
    ppg_monoid_sum[C,real,1,LAMBDA(a,b:real):a*b].sum

  address_product_fold: LEMMA ppg_finite_product[Addr].product=
    ppg_monoid_sum[Addr,real,1,LAMBDA(a,b:real):a*b].sum

  weight_eta: LEMMA (LAMBDA(a:C):p(a))=p

  singleton_filter: LEMMA intersection(J,LAMBDA(b:C):b=a)=
    IF J(a) THEN sets[C].singleton(a) ELSE emptyset[C] ENDIF

  layer_indicator_sum: LEMMA
    ppg_monoid_sum[C,nat,0,LAMBDA(r,s:nat):r+s].sum(J,LAMBDA(b:C):IF b=a THEN 1 ELSE 0 ENDIF)=layerCount(a)(J)

  indicator_layers: LEMMA
    (LAMBDA(d:nat):ppg_monoid_sum[C,nat,0,LAMBDA(r,s:nat):r+s].sum
      (treeLayer(T,d),LAMBDA(b:C):IF b=a THEN 1 ELSE 0 ENDIF))=
    (LAMBDA(d:nat):layerCount(a)(treeLayer(T,d)))

  label_filter: LEMMA labelled(T,a)=intersection(T`dom,LAMBDA(w:Addr):T`lab(w)=a)

  sequenceWeight_treeLayers: THEOREM SameDepthIndependent(vars,T) IMPLIES
    sequenceWeight(p)(treeLayers(T))=product(T`dom,LAMBDA(w:Addr):p(T`lab(w)))

  countLabel_eq_layers_sum: THEOREM SameDepthIndependent(vars,T) IMPLIES count_label(T,a)=profileCount(T,a)

  countLabel_eq_of_treeLayers_eq: THEOREM SameDepthIndependent(vars,T) AND SameDepthIndependent(vars,U) AND
    treeLayers(T)=treeLayers(U) IMPLIES count_label(T,a)=count_label(U,a)

END ppg_shearer_profile_weights
