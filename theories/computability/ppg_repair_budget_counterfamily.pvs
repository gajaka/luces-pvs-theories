% A state is a successful bounded-evaluation budget. Every state is reachable.
% The checker uses literal evaln: its budget bounds intermediate values and
% is not an exact step counter. Its primitive recursiveness is derived below.
% Mario Carneiro, Mathlib Computability.PartrecCode, primrec_evaln;
% Lean counterpart: PPGraphRepairUndecidability, bounded counter-family.
ppg_repair_budget_counterfamily: THEORY
BEGIN
  IMPORTING ppg_code_predicate_halting,ppg_primcodable_product[ppg_partrec_code,nat],
    ppg_primcodable_nat,ppg_typed_primrec_map[[ppg_partrec_code,nat],bool],
    decision@ppg_reachability_refutation[nat,bool]

  input,k,n,u,v,start: VAR nat

  c: VAR ppg_partrec_code

  p: VAR [ppg_partrec_code,nat]

  o: VAR lift[nat]

  boundedCheck(input)(p): bool = up?[nat](evaln(p`2,p`1,input))

  BoundedGood(input,c,k): bool = boundedCheck(input)((c,k))

  budgetGraph(input,c): RepairGraph = (# edges:=LAMBDA(u,v:nat):TRUE,
    reach_rel:=LAMBDA(u,v:nat):TRUE,invariant_holds:=LAMBDA(k:nat):BoundedGood(input,c,k) #)

  budgetArgT(input): TotalFunction = pairT(pairT(rightT,leftT),constT(input))

  budgetOptionalT(input): TotalFunction = compT(actualElementT,budgetArgT(input))

  budgetBoolT(input): TotalFunction = compT(compT(zeroTestT,zeroTestT),budgetOptionalT(input))

  budgetNormalizerT(input): TotalFunction = compT(succT,budgetBoolT(input))

  budgetInputCodec: ppg_primcodable_core[[ppg_partrec_code,nat]].Codec = productCodec(codeCodec,natCodec)

  pr_budgetArg: LEMMA NatPrimrec(budgetArgT(input))

  pr_budgetOptional: LEMMA NatPrimrec(budgetOptionalT(input))

  pr_budgetBool: LEMMA NatPrimrec(budgetBoolT(input))

  pr_budgetNormalizer: LEMMA NatPrimrec(budgetNormalizerT(input))

  budgetOptional_value: LEMMA budgetOptionalT(input)(n)=
    encodeLiftNat(evaln(rightT(n),ofNatCode(leftT(n)),input))

  double_zeroTest_option: LEMMA zeroTestT(zeroTestT(encodeLiftNat(o)))=
    IF up?[nat](o) THEN 1 ELSE 0 ENDIF

  budgetBool_value: LEMMA budgetBoolT(input)(n)=
    IF boundedCheck(input)((ofNatCode(leftT(n)),rightT(n))) THEN 1 ELSE 0 ENDIF

  budgetInput_decode: LEMMA budgetInputCodec`decode(n)=
    up[[ppg_partrec_code,nat]]((ofNatCode(leftT(n)),rightT(n)))

  budget_normalized: LEMMA ppg_typed_primrec_map[[ppg_partrec_code,nat],bool].normalizedMap
    (budgetInputCodec,boolCodec,boundedCheck(input))=budgetNormalizerT(input)

  boundedCheck_primrec: THEOREM ppg_typed_primrec_map[[ppg_partrec_code,nat],bool].TypedPrimrec
    (budgetInputCodec,boolCodec,boundedCheck(input))

  boundedGood_iff_evaln_mem: THEOREM BoundedGood(input,c,k) IFF EXISTS(v:nat):evaln(k,c,input)=up[nat](v)

  good_exists_iff_halting: THEOREM (EXISTS(k:nat):BoundedGood(input,c,k)) IFF evalDom(c,input)

  budgetGraph_reach_iff_path: THEOREM budgetGraph(input,c)`reach_rel(u,v)
    IFF Reach(budgetGraph(input,c)`edges)(u,v)

  reachable_good_iff_halting: THEOREM
    (EXISTS(k:nat):budgetGraph(input,c)`reach_rel(start,k) AND budgetGraph(input,c)`invariant_holds(k))
      IFF evalDom(c,input)

  noReachableGood_iff_nonhalting: THEOREM NoReachableGood(budgetGraph(input,c),start) IFF NOT evalDom(c,input)

END ppg_repair_budget_counterfamily
