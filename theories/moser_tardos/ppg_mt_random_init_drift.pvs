% Slot-zero initialization uses the original table and its original law.
% The initial potential mean is retained; it need not equal the potential
% at any fixed state. Finite expected count implies success almost surely.
%
% Robin A. Moser and Gabor Tardos, A constructive proof of the general
% Lovasz Local Lemma, Journal of the ACM 57(2), 2010, Section 2.
% Johannes Lengler, Drift Analysis, arXiv:1712.00964, Theorem 1.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_mt_random_init_drift[C,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_mt_coordinate_laws[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),fallback:C,
  eventOrder:{e:list[C]|FORALL(c:C):member(c,e)},
  (IMPORTING ppg_mt_observed_history[C,V,Value,domain,spaces,laws,fallback,eventOrder])
  vars:[C->finite_set[V]],
  B:ppg_mt_check_probability[C,V,Value,domain,spaces,laws].NativeBad,
  Phi:MeasurablePotential]: THEORY
BEGIN
  IMPORTING ppg_mt_observed_history[C,V,Value,domain,spaces,laws,fallback,eventOrder] AS randomObserved,
    ppg_mt_random_process[C,V,Value,domain] AS randomSlots,
    ppg_mt_drift_pointwise[C,V,Value,domain,fallback,eventOrder] AS randomPointwise,
    ppg_mt_native_spaces[C,V,Value,domain] AS randomSpaces,
    ppg_mt_raw_active_expectation[C,V,Value,domain,spaces,laws,fallback,eventOrder] AS randomRaw,
    ppg_mt_time_expectation[C,V,Value,domain,spaces,laws] AS randomLegacy,
    ppg_mt_termination[C,V,Value,domain,spaces,laws] AS randomTermination,
    measure_probability@ppg_enn_simple_sup

  ResamplingLog: TYPE = randomSlots.LogSpace

  randomInit: randomObserved.Initializer = randomSlots.initialStateFromLog

  IMPORTING ppg_mt_conditional_certificate[C,V,Value,domain,spaces,laws,fallback,eventOrder,vars,B,randomInit,Phi] AS randomCertificate

  MTCertificate(delta:nonneg_real): TYPE = randomCertificate.MTCertificate(delta)

  delta: VAR posreal

  initialPotential(F:[nat->randomCertificate.NativeFunction]): randomCertificate.NativeFunction = F(0)

  initial_potential_value: LEMMA FORALL(delta:posreal,T:MTCertificate(delta),omega:ResamplingLog):
    initialPotential(T)(omega)=Phi(randomSlots.initialStateFromLog(omega))

  random_count_identity: LEMMA randomRaw.expectedActiveCount(randomRaw.runningSchedule(vars,B,randomInit))=
    randomLegacy.randomInitETLog(vars,B,fallback,randomRaw.nativeEnumeration)

  randomInitETLog_le_of_drift: THEOREM FORALL(delta:posreal,T:MTCertificate(delta)):
    ele(randomLegacy.randomInitETLog(vars,B,fallback,randomRaw.nativeEnumeration),
      dividePositive(ofReal(randomCertificate.mean(initialPotential(T))),delta))

  randomInitETLog_lt_top_of_drift: THEOREM FORALL(delta:posreal,T:MTCertificate(delta)):
    ennFinite?(randomLegacy.randomInitETLog(vars,B,fallback,randomRaw.nativeEnumeration))

  ae_randomInit_exists_good_of_drift: THEOREM FORALL(delta:posreal,T:MTCertificate(delta)):
    ae?[ResamplingLog,asNasa(randomCertificate.tableSigma),randomCertificate.nativeLaw](
      randomTermination.terminationEvent(vars,B,fallback,randomRaw.nativeEnumeration))

END ppg_mt_random_init_drift
