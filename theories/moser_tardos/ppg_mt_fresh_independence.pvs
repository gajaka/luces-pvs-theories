% A fixed fresh row after time t is independent of the entire past block.
% The same holds for the whole future block, even with infinitely many
% variables. No independence claim is made for sample-dependent blocks.
%
% Lean counterpart: PPGraphMoserTardosPastIndependence.lean.

ppg_mt_fresh_independence[C, V, Value: TYPE, domain: [V -> set[Value]],
  (IMPORTING ppg_mt_native_spaces[C, V, Value, domain])
  spaces: VariableSpaces, laws: VariableLaws(spaces)]: THEORY
BEGIN
  IMPORTING ppg_mt_log_independence[C, V, Value, domain, spaces, laws],
            measure_probability@ppg_measurable_dependent_product

  row(n: nat): set[[nat, V]] = {p: [nat, V] | p`1 = n}

  past(t: nat): set[[nat, V]] = {p: [nat, V] | p`1 <= t}

  future(t: nat): set[[nat, V]] = {p: [nat, V] | p`1 > t}

  different_rows: LEMMA FORALL (n, m: nat): n /= m IMPLIES disjoint?(row(n), row(m))

  row_after_past: LEMMA FORALL (n, t: nat): n > t IMPLIES disjoint?(row(n), past(t))

  future_after_past: LEMMA FORALL (t: nat): disjoint?(future(t), past(t))

  rowState(n: nat)(x: Block(row(n))): MTState = LAMBDA (v: V): x(n, v)

  row_state_coordinate: LEMMA FORALL (n: nat, v: V):
    ppg_measurable_map[Block(row(n)), (domain(v))].measurable(
      blockSigma(row(n)), spaces(v), LAMBDA (x: Block(row(n))): rowState(n)(x)(v))

  row_state_sigma: LEMMA FORALL (n: nat):
    ppg_measurable_dependent_product[Block(row(n)), V, Value, domain].nativeProduct(spaces) =
      NativeStateSigma(spaces)

  row_state_measurable: LEMMA FORALL (n: nat):
    ppg_measurable_map[Block(row(n)), MTState].measurable(
      blockSigma(row(n)), NativeStateSigma(spaces), rowState(n))

  rowEvent(n: nat, B: (NativeStateSigma(spaces))): (blockSigma(row(n))) =
    ppg_measurable_map[Block(row(n)), MTState].inverseImage(rowState(n), B)

  freshEvent(n: nat, B: (NativeStateSigma(spaces))): (NativeTableSigma(spaces)) =
    logBlockEvent(row(n), rowEvent(n, B))

  fresh_event_eq: LEMMA FORALL (n: nat, B: (NativeStateSigma(spaces))):
    freshEvent(n, B) = {omega: LogSpace | B(freshState(omega, n))}

  fresh_states_independent: THEOREM FORALL (n, m: nat,
    B, D: (NativeStateSigma(spaces))): n /= m IMPLIES
      logMeasure(intersection(freshEvent(n, B), freshEvent(m, D))) =
        logMeasure(freshEvent(n, B)) * logMeasure(freshEvent(m, D))

  fresh_past_independent: THEOREM FORALL (n, t: nat,
    B: (NativeStateSigma(spaces)), D: (blockSigma(past(t)))): n > t IMPLIES
      logMeasure(intersection(freshEvent(n, B), logBlockEvent(past(t), D))) =
        logMeasure(freshEvent(n, B)) * logMeasure(logBlockEvent(past(t), D))

  future_past_independent: THEOREM FORALL (t: nat,
    B: (blockSigma(future(t))), D: (blockSigma(past(t)))):
      logMeasure(intersection(logBlockEvent(future(t), B), logBlockEvent(past(t), D))) =
        logMeasure(logBlockEvent(future(t), B)) * logMeasure(logBlockEvent(past(t), D))

END ppg_mt_fresh_independence
