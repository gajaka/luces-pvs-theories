% Both the fresh row and the past contain infinitely many coordinates in this example.
ppg_mt_independence_examples: THEORY
BEGIN
  IMPORTING measure_probability@ppg_measurable_space, measure_probability@ppg_probability_dirac

  domain(v: nat): set[nat] = fullset[nat]

  spaces(v: nat): ppg_measurable_space[(domain(v))].MeasurableSpace = fullset[set[(domain(v))]]

  laws(v: nat): ppg_probability_measure[(domain(v)), spaces(v)].Probability =
    ppg_probability_dirac[(domain(v)), spaces(v)].dirac(v + 2)

  IMPORTING ppg_mt_fresh_independence[bool, nat, nat, domain, spaces, laws]

  fresh_row_and_past: THEOREM FORALL (B: (NativeStateSigma(spaces)), D: (blockSigma(past(6)))):
    logMeasure(intersection(freshEvent(7, B), logBlockEvent(past(6), D))) =
      logMeasure(freshEvent(7, B)) * logMeasure(logBlockEvent(past(6), D))

  entire_future_and_past: THEOREM FORALL (B: (blockSigma(future(6))), D: (blockSigma(past(6)))):
    logMeasure(intersection(logBlockEvent(future(6), B), logBlockEvent(past(6), D))) =
      logMeasure(logBlockEvent(future(6), B)) * logMeasure(logBlockEvent(past(6), D))

END ppg_mt_independence_examples
