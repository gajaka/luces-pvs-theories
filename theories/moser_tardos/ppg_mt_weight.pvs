% The weight p[T] multiplies p over all nodes of a witness tree.
% Every repeated label contributes another factor. Nonnegative factors
% make this weight monotone in p.
%
% Noga Alon and Joel H. Spencer, The Probabilistic Method, 4th ed.,
% Wiley, 2016, Section 5.7, "Moser's Fix-It Algorithm".
% Theorems 5.7.1 and 5.7.3 use this node product. The book's weak Moser
% trees satisfy wf? and proper?: distinctness is required among siblings.
% Lean counterpart: PPGraphMoserTardosWeight.lean.
%
% This theory defines the weight, not its probabilistic interpretation.
% ppg_rose_weight_sum proves the finite-depth enumeration identity for
% the arbitrary-carrier construction used by the expectation theorems.
%
% Author: Dragan Stosic, 2026.

ppg_mt_weight[C: TYPE+, V: TYPE+]: THEORY
BEGIN

  IMPORTING ppg_mt_witness[C, V]
  IMPORTING witness_trees@ppg_wtree_adt_reduce[C, nonneg_real]

  t: VAR WTree
  cs: VAR list[WTree]
  i: VAR C
  p, q: VAR [C -> nonneg_real]

  %% Section 1: Weight

  prod_list(l: list[nonneg_real]): RECURSIVE nonneg_real =
    CASES l OF
      null: 1,
      cons(h, r): h * prod_list(r)
    ENDCASES
  MEASURE length(l)

  weight(p): [WTree -> nonneg_real] =
    reduce(LAMBDA (i: C, l: list[nonneg_real]): p(i) * prod_list(l))

  weight_children: LEMMA
    FORALL (p: [C -> nonneg_real], i: C, cs: list[WTree]):
      weight(p)(node(i, cs)) = p(i) * prod_list(map(weight(p))(cs))

  weight_singleton: LEMMA
    FORALL (p: [C -> nonneg_real], i: C):
      weight(p)(node(i, null)) = p(i)

  %% Section 2: Monotonicity in p
  %
  % The structural fact behind substituting a bound x >= p into the weight
  % and still getting an upper bound. That is the use Theorem 5.7.3 makes
  % of its hypothesis x[a] >= p[a].

  prod_list_map_mono: LEMMA
    FORALL (p, q: [C -> nonneg_real], cs: list[WTree]):
      every(LAMBDA (c: WTree): weight(p)(c) <= weight(q)(c))(cs)
        IMPLIES
          prod_list(map(weight(p))(cs)) <= prod_list(map(weight(q))(cs))

  weight_mono: LEMMA
    FORALL (p, q: [C -> nonneg_real]):
      (FORALL (i: C): p(i) <= q(i))
        IMPLIES FORALL (t: WTree): weight(p)(t) <= weight(q)(t)

END ppg_mt_weight
