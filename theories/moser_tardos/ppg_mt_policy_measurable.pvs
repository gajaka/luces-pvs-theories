% A finite scan of measurable bad-event tests selects a measurable label.
% Resampling the footprint of that label is then jointly measurable in
% the current state and the fresh state. This proves the property for
% pickFirstViolated; it is not an assumption on arbitrary selectors.
%
% Lean counterpart: PPGraphMoserTardosRandomTrajectory.lean.

ppg_mt_policy_measurable[C, V, Value: TYPE, domain: [V -> set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_mt_log_measurable[C, V, Value, domain]

  StatePair: TYPE = [MTState, MTState]

  IMPORTING ppg_mt_measurable_state[StatePair, C, V, Value, domain],
    measure_probability@ppg_measurable_pair[StatePair, MTState, MTState],
    measure_probability@ppg_measurable_compose[StatePair, MTState, C], measure_probability@ppg_measurable_map[MTState, C]
  coordinates: VAR [V -> ppg_measurable_space[Value].MeasurableSpace]
  bad: VAR [C, MTState -> bool]
  fallback, c: VAR C
  enumeration: VAR list[C]
  vars: VAR CertVars
  pick: VAR [MTState -> C]
  F: VAR finite_set[V]

  measurableBad(coordinates, bad): bool =
    FORALL (c: C): StateSigma(coordinates)({s: MTState | bad(c, s)})

  StatePairSigma(coordinates): ppg_measurable_space[StatePair].MeasurableSpace =
    pairSigma(StateSigma(coordinates), StateSigma(coordinates))

  measurable_pickFromList: THEOREM measurableBad(coordinates, bad) IMPLIES
    measurable(StateSigma(coordinates), fullset[set[C]],
      LAMBDA (s: MTState): pickFromList(bad, fallback, enumeration, s))

  measurable_pickFirstViolated: THEOREM measurableBad(coordinates, bad) IMPLIES
    measurable(StateSigma(coordinates), fullset[set[C]],
      LAMBDA (s: MTState): pickFirstViolated(bad, fallback, enumeration, s))

  measurable_resample_fixed: THEOREM
    measurable(StatePairSigma(coordinates), StateSigma(coordinates),
      LAMBDA (p: StatePair): resample(F, p`1, p`2))

  measurable_pick_equality: LEMMA
    measurable(StateSigma(coordinates), fullset[set[C]], pick) IMPLIES
      StatePairSigma(coordinates)({p: StatePair | pick(p`1) = c})

  measurable_resampleChain: THEOREM
    measurable(StateSigma(coordinates), fullset[set[C]], pick) IMPLIES
      measurable(StatePairSigma(coordinates), StateSigma(coordinates),
        LAMBDA (p: StatePair): resampleChain(vars, pick, enumeration, p`1, p`2))

END ppg_mt_policy_measurable
