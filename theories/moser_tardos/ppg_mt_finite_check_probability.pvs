% With a finite variable universe, each vertex check has exactly the
% product-state probability of its label's bad event. Substitution into
% the disjoint-block formula gives the node-product probability of tauCheck.
% The table reads are fixed by the tree before taking their probability.
%
% Noga Alon and Joel H. Spencer, The Probabilistic Method, 4th ed.,
% Wiley, 2016, Section 5.7, "Moser's Fix-It Algorithm".
% Theorem 5.7.2. See also Moser and Tardos, Lemma 2.1:
% https://arxiv.org/abs/0903.0544v3
% Lean counterpart: PPGraphMoserTardosProbability.lean.

ppg_mt_finite_check_probability[C, V, Value: TYPE, domain: [V -> set[Value]],
  universe: {F: finite_set[V] | F = fullset[V]},
  (IMPORTING ppg_mt_native_spaces[C, V, Value, domain])
  spaces: VariableSpaces, laws: VariableLaws(spaces)]: THEORY
BEGIN
  IMPORTING ppg_mt_state_probability[C, V, Value, domain, universe, spaces, laws],
            ppg_mt_check_probability[C, V, Value, domain, spaces, laws]
  vars: VAR CertVars
  bad: VAR NativeBad
  T: VAR GTree
  w: VAR Addr
  Clog: VAR [nat -> C]
  t: VAR nat

  baseEvent(bad: NativeBad, a: C): (NativeStateSigma(spaces)) = {s: MTState | bad(a, s)}

  labelFactors(bad, T): [Addr -> real] = LAMBDA (w: Addr): stateMeasure(baseEvent(bad, T`lab(w)))

  checkState_readAt: LEMMA (LAMBDA (omega: LogSpace): checkState(vars, T, omega, w)) =
    readAt(LAMBDA (v: V): localCount(vars, T, w, v))

  check_event_preimage: LEMMA checkEvents(vars, bad, T)(w) =
    ppg_measurable_map[LogSpace, MTState].inverseImage(
      readAt(LAMBDA (v: V): localCount(vars, T, w, v)), baseEvent(bad, T`lab(w)))

  logMeasure_checkState_eq_pi: THEOREM
    logMeasure(checkEvents(vars, bad, T)(w)) = stateMeasure(baseEvent(bad, T`lab(w)))

  check_event_factors_eq_labels: LEMMA
    ppg_probability_event_product[LogSpace, Addr, NativeTableSigma(spaces)].eventFactors(
      logMeasure, checkEvents(vars, bad, T)) = labelFactors(bad, T)

  finite_tree_check_product_p: THEOREM mt_wf(vars, bad) AND SameDepthIndependent(vars, T) IMPLIES
    logMeasure({omega: LogSpace | tauCheck(vars, bad, T, omega)}) = product(T`dom, labelFactors(bad, T))

  logMeasure_tauCheck_eq_prod_p: THEOREM mt_wf(vars, bad) IMPLIES
    logMeasure({omega: LogSpace | tauCheck(vars, bad, tau_C(vars, Clog, t), omega)}) =
      product(tau_C(vars, Clog, t)`dom, labelFactors(bad, tau_C(vars, Clog, t)))

END ppg_mt_finite_check_probability
