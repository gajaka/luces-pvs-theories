% Finite expected stopped length makes the infinite-count event null.
% The pointwise count/termination equivalence then gives probability one
% of reaching a good state, and hence the existence of a good state.
%
% Initialization uses slot zero of the same product table as resampling.
% These statements do not give almost-sure termination from an arbitrary
% fixed initial state. The variable type need not be finite.
% Lean counterpart: PPGraphMoserTardosTermination.lean.

ppg_mt_termination[C,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces)]: THEORY
BEGIN
  IMPORTING ppg_mt_time_expectation[C,V,Value,domain,spaces,laws],
    ppg_mt_count_termination[C,V,Value,domain],
    measure_probability@ppg_integral_finiteness[LogSpace,NativeTableSigma(spaces),logMeasure]
  vars: VAR CertVars
  bad: VAR NativeBad
  fallback: VAR C
  enumeration: VAR FullEnumeration

  randomCountFunction(vars,bad,fallback,enumeration)(omega:LogSpace): ENN =
    randomInitTLog(vars,bad,fallback,enumeration,omega)

  % Reaching one good state suffices; later unstopped states are irrelevant.
  terminationEvent(vars,bad,fallback,enumeration): set[LogSpace] =
    {omega:LogSpace|EXISTS(N:nat):MTGood(bad,
      randTraj(vars,bad,fallback,enumeration,initialStateFromLog(omega),omega,N))}

  native_random_count_measurable: LEMMA measurable(NativeTableSigma(spaces),ENNSigma,
    randomCountFunction(vars,bad,fallback,enumeration))

  finite_event_termination: LEMMA
    finiteEvent(randomCountFunction(vars,bad,fallback,enumeration))=
    terminationEvent(vars,bad,fallback,enumeration)

  termination_event_measurable: LEMMA
    NativeTableSigma(spaces)(terminationEvent(vars,bad,fallback,enumeration))

  ae_randomInitTLog_lt_top: THEOREM ennFinite?(randomInitETLog(vars,bad,fallback,enumeration)) IMPLIES
    ae?[LogSpace,asNasa(NativeTableSigma(spaces)),nasaLaw](
      {omega:LogSpace|ennFinite?(randomInitTLog(vars,bad,fallback,enumeration,omega))})

  ae_randomInit_exists_good: THEOREM ennFinite?(randomInitETLog(vars,bad,fallback,enumeration)) IMPLIES
    ae?[LogSpace,asNasa(NativeTableSigma(spaces)),nasaLaw](terminationEvent(vars,bad,fallback,enumeration))

  logMeasure_randomInit_termination_eq_one: THEOREM
    ennFinite?(randomInitETLog(vars,bad,fallback,enumeration)) IMPLIES
    logMeasure(terminationEvent(vars,bad,fallback,enumeration))=1

  exists_MTGood_of_randomInitETLog_lt_top: THEOREM
    ennFinite?(randomInitETLog(vars,bad,fallback,enumeration)) IMPLIES
    EXISTS(z:MTState):MTGood(bad,z)

END ppg_mt_termination
