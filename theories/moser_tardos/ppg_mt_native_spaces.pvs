% Each variable retains its own measurable value domain. The state space
% and the table over (local index, variable) carry the corresponding
% product sigma algebras. Their ambient-subtype descriptions are proved
% equal, so coordinate measurability transfers between representations.
%
% Lean counterpart: PPGraphMoserTardosLogSpace.lean.

ppg_mt_native_spaces[C, V, Value: TYPE, domain: [V -> set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_mt_coordinate_laws[C, V, Value, domain],
            ppg_mt_log_measurable[C, V, Value, domain],
            measure_probability@ppg_measurable_dependent_product[LogSpace, V, Value, domain],
            measure_probability@ppg_measurable_dependent_product[LogSpace, [nat, V], Value, TableDomain]
  spaces: VAR VariableSpaces
  n: VAR nat

  NativeStateSigma(spaces): ppg_measurable_space[MTState].MeasurableSpace =
    ppg_measurable_dependent_product[LogSpace, V, Value, domain].nativeProduct(spaces)

  NativeTableSigma(spaces): ppg_measurable_space[LogSpace].MeasurableSpace =
    ppg_measurable_dependent_product[LogSpace, [nat, V], Value, TableDomain].nativeProduct(TableSpaces(spaces))

  variableAmbient(spaces): [V -> ppg_measurable_space[Value].MeasurableSpace] =
    ppg_measurable_dependent_product[LogSpace, V, Value, domain].ambientCoordinates(spaces)

  table_ambient_eq: LEMMA TableCoordinates(variableAmbient(spaces)) =
    ppg_measurable_dependent_product[LogSpace, [nat, V], Value, TableDomain].ambientCoordinates(TableSpaces(spaces))

  state_sigma_native_eq: LEMMA StateSigma(variableAmbient(spaces)) = NativeStateSigma(spaces)

  table_sigma_native_eq: LEMMA TableSigma(variableAmbient(spaces)) = NativeTableSigma(spaces)

  native_freshState_measurable: LEMMA measurable(NativeTableSigma(spaces), NativeStateSigma(spaces),
    LAMBDA (omega: LogSpace): freshState(omega, n))

  native_initialState_measurable: LEMMA measurable(NativeTableSigma(spaces), NativeStateSigma(spaces),
    initialStateFromLog)

END ppg_mt_native_spaces
