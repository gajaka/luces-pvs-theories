% A full finite state carrier is in bijection with its initial index
% range. The inverse is chosen from a proved nonempty fiber for each
% index, so the empty carrier requires no distinguished state.
% Encoding and decoding preserve the original rational vectors and matrices.
%
% Sheldon Axler, Linear Algebra Done Right, fourth edition, Springer, 2024.
% https://linear.axler.net/
% Finite indexing for the rational system in PPGraphFinitePotential.lean.
ppg_finite_state_index[State: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)}]: THEORY
BEGIN
  IMPORTING finite_models@ppg_finite_potential_system[State,universe]

  dimension: nat = card(universe)

  Index: TYPE = below(dimension)

  IMPORTING ppg_sum_image[State,Index] AS reindexing,
    ppg_rational_sum[Index] AS indexed,
    ppg_monoid_sum[Index,rat,0,LAMBDA(a,b:rat):a+b] AS indexRational
  s,t: VAR State
  i,j: VAR Index
  f: VAR Vector
  v: VAR [Index->rat]
  matrix: VAR Matrix
  indexed: VAR [Index,Index->rat]

  index(s): Index = bij(universe)(s)

  index_injective: LEMMA injective?[State,Index](index)

  index_fiber_exists: LEMMA EXISTS(s:State):index(s)=i

  state(i): {s:State|index(s)=i} = choose({s:State|index(s)=i})

  index_state: LEMMA index(state(i))=i

  state_index: LEMMA state(index(s))=s

  indexUniverse: finite_set[Index] = image(index,universe)

  index_universe_full: LEMMA indexUniverse(i)

  encodeVector(f): [Index->rat] = LAMBDA(i:Index):f(state(i))

  decodeVector(v): Vector = LAMBDA(s:State):v(index(s))

  encodeMatrix(matrix): [Index,Index->rat] =
    LAMBDA(i,j:Index):matrix(state(i),state(j))

  decodeMatrix(indexed): Matrix = LAMBDA(s,t:State):indexed(index(s),index(t))

  vector_decode_encode: LEMMA decodeVector(encodeVector(f))=f

  vector_encode_decode: LEMMA encodeVector(decodeVector(v))=v

  matrix_decode_encode: LEMMA decodeMatrix(encodeMatrix(matrix))=matrix

  matrix_encode_decode: LEMMA encodeMatrix(decodeMatrix(indexed))=indexed

  real_sum_reindexed: LEMMA FORALL(h:[State->real]):
    ppg_finite_sum[Index].fsum(indexUniverse,LAMBDA(i:Index):h(state(i)))=fsum(universe,h)

  indexedSum(v): rat = indexRational.sum(indexUniverse,v)

  rational_sum_reindexed: LEMMA indexedSum(encodeVector(f))=rational.sum(universe,f)

  indexedMatVec(matrix,f): [Index->rat] = LAMBDA(i:Index):
    indexRational.sum(indexUniverse,LAMBDA(j:Index):encodeMatrix(matrix)(i,j)*encodeVector(f)(j))

  encode_matVec: LEMMA indexedMatVec(matrix,f)=encodeVector(matVec(matrix,f))

END ppg_finite_state_index
