% Pointwise agreement transports a universal predicate across a list map.
ppg_list_every_map[T, R: TYPE]: THEORY
BEGIN
  IMPORTING ppg_list_maps[T, R]
  xs: VAR list[T]
  f: VAR [T -> R]
  P: VAR pred[R]
  Q: VAR pred[T]

  list_forall_map_iff_pointwise: THEOREM
    (FORALL (x: T): member(x, xs) IMPLIES (P(f(x)) IFF Q(x))) IMPLIES
    ((FORALL (y: R): member(y, map(f)(xs)) IMPLIES P(y)) IFF
      (FORALL (x: T): member(x, xs) IMPLIES Q(x)))

END ppg_list_every_map
