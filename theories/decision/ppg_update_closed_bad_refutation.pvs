% A checked closed bad class of the finite reduced model refutes
% a good concrete reachable state. Only the reduced carrier is enumerated;
% the concrete state space is arbitrary.
%
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, Chapter 1, American Mathematical Society, 2017.
ppg_update_closed_bad_refutation[State,Abstract,Input: TYPE,
  abstractUniverse:{U:finite_set[Abstract]|FORALL(a:Abstract):U(a)},
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)}]: THEORY
BEGIN
  IMPORTING finite_models@ppg_finite_input_update[State,Input,inputs] AS badPathSource,
    finite_models@ppg_finite_input_update[Abstract,Input,inputs] AS badPathTarget,
    finite_models@ppg_finite_update[Abstract,Input,abstractUniverse,inputs] AS badPathFinite,
    finite_models@ppg_finite_update_projection[State,Abstract,Input,inputs] AS badPathCommutation,
    finite_models@ppg_update_projection_reach[State,Abstract,Input,inputs] AS badPathProjection,
    finite_models@ppg_update_reach[State,Input,inputs] AS badPathSourceReach,
    finite_models@ppg_update_reach[Abstract,Input,inputs] AS badPathTargetReach,
    finite_models@ppg_finite_update_view[Abstract,Input,abstractUniverse,inputs] AS badPathView,
    finite_models@ppg_finite_closed_bad[Abstract,abstractUniverse] AS badPathChecker

  R: VAR badPathSource.Rule
  Q: VAR badPathTarget.Rule
  p: VAR [State->Abstract]
  s0: VAR State
  U: VAR set[Abstract]

  checkedClosedBad_no_path: THEOREM badPathCommutation.Commutes(R,Q,p) AND
    badPathTarget.Valid(Q) AND badPathChecker.checkClosedBad(badPathFinite.model(Q),U) AND
    U(p(s0)) IMPLIES NOT badPathSourceReach.ReachesGood(R,s0)

END ppg_update_closed_bad_refutation
