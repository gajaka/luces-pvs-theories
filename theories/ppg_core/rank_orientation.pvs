%%% rank_orientation.pvs
%%% Order Reversal for Finite Assignments
%%%
%%% A strictly decreasing assignment becomes strictly increasing after
%%% composition with reversed identity. Reversal is an involution.
%%%
%%% Motivating observations:
%%%   Boot 293 (dawn): rho(T, identity) = +0.995
%%%   Boot 298 (dusk): rho(T, identity) = -0.995, rho(T, reversed) = +0.995
%%% The rank theorem takes strict anti-monotonicity as an explicit premise.
%%%
%%% Author: Dragan Stosic, 2026

rank_orientation: THEORY
BEGIN

  N: posnat = 20  % number of bins

  Bin: TYPE = below(N)

  Assignment: TYPE = [Bin -> Bin]

  % Identity map
  identity: Assignment = LAMBDA (b: Bin): b

  % Reversed identity
  reversed: Assignment = LAMBDA (b: Bin): N - 1 - b

  % Monotone (no crossings vs reference)
  monotone_wrt?(T: Assignment, ref: Assignment): bool =
    FORALL (i, j: Bin): i < j IMPLIES ref(T(i)) <= ref(T(j))

  % Anti-monotone (perfectly reversed)
  anti_monotone?(T: Assignment): bool =
    FORALL (i, j: Bin): i < j IMPLIES T(i) > T(j)

%% ═══════════════════════════════════════════════════════════
%% Theorem
%% ═══════════════════════════════════════════════════════════

  % T1: Anti-monotone assignment is monotone with respect to reversed identity
  thm_reversed_preserves_rank: THEOREM
    FORALL (T: Assignment):
      anti_monotone?(T) IMPLIES
        FORALL (i, j: Bin):
          i < j IMPLIES reversed(T(i)) < reversed(T(j))

  % T2: Reversed is its own inverse (involution)
  %     reversed(reversed(b)) = b for all bins
  thm_reversed_involution: THEOREM
    FORALL (b: Bin): reversed(reversed(b)) = b

END rank_orientation
