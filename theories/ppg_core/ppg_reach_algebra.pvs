% Structural laws of the inductively defined reflexive transitive closure.
ppg_reach_algebra[T: TYPE]: THEORY
BEGIN
  IMPORTING decision@ppg_reachability_refutation[T, bool]
  step, other: VAR [T, T -> bool]
  u, v, w: VAR T

  reach_single: LEMMA step(v, w) IMPLIES Reach(step)(v, w)

  reach_trans: LEMMA Reach(step)(v, u) AND Reach(step)(u, w) IMPLIES Reach(step)(v, w)

  reach_head: LEMMA step(v, u) AND Reach(step)(u, w) IMPLIES Reach(step)(v, w)

  reach_mono: LEMMA
    (FORALL (a, b: T): step(a, b) IMPLIES other(a, b)) AND Reach(step)(v, w) IMPLIES Reach(other)(v, w)

  reach_closed: LEMMA
    (FORALL (a, b: T): step(a, b) IMPLIES Reach(other)(a, b)) AND Reach(step)(v, w) IMPLIES Reach(other)(v, w)

  reach_symm: LEMMA symmetric?(step) AND Reach(step)(v, w) IMPLIES Reach(step)(w, v)

  reach_equivalence: LEMMA symmetric?(step) IMPLIES equivalence?(Reach(step))

END ppg_reach_algebra
