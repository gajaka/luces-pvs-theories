% Prefix counts increase for every event family, independently of a measure.
ppg_count_order[X: TYPE]: THEORY
BEGIN
  IMPORTING ppg_event_count[X]
  E,F: VAR [nat->set[X]]
  x: VAR X
  i,j: VAR nat

  prefix_ordered: LEMMA i<=j IMPLIES countPrefix(E,x,i)<=countPrefix(E,x,j)

  prefix_congr: LEMMA (FORALL(k:nat):E(k)(x)=F(k)(x)) IMPLIES
    countPrefix(E,x,i)=countPrefix(F,x,i)

END ppg_count_order
