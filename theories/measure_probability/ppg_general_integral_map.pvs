% Simple functions pull back term by term along the measurable
% map. Their integrals agree with the pushforward measure by definition.
% Increasing simple approximations extend this identity to every
% nonnegative measurable function, with no finiteness premise on the law.
%
% Paul R. Halmos, Measure Theory, Springer, 1974, induced measures.
% Mathlib, MeasureTheory/Integral/Lebesgue/Map.lean, lintegral_map.
ppg_general_integral_map[X,Y:TYPE,
  (IMPORTING measure_integration@subset_algebra_def)
    SX:sigma_algebra[X],SY:sigma_algebra[Y],
  (IMPORTING measure_integration@measure_def[X,SX]) mu:measure_type,
  (IMPORTING ppg_general_measure_map[X,Y,SX,SY]) h:MeasurableMap]: THEORY
BEGIN
  IMPORTING ppg_general_simple_approximation[X,SX,mu]

  mappedLaw: measure_type[Y,SY] = mapMeasure(mu,h)

  IMPORTING ppg_general_simple_approximation[Y,SY,mappedLaw]

  SourceSimple: TYPE = ppg_general_lintegral[X,SX,mu].Simple

  TargetSimple: TYPE = ppg_general_lintegral[Y,SY,mappedLaw].Simple

  TargetTerm: TYPE = ppg_general_lintegral[Y,SY,mappedLaw].SimpleTerm

  SourceMeasurable: TYPE = ppg_simple_comparison_regions[X,SX,mu].LowerMeasurable

  TargetMeasurable: TYPE = ppg_simple_comparison_regions[Y,SY,mappedLaw].LowerMeasurable

  L: VAR TargetSimple
  t: VAR TargetTerm
  f: VAR TargetMeasurable
  x: VAR X
  A: VAR (SY)
  a: VAR nonneg_real
  n: VAR nat

  pullSimple(L): RECURSIVE SourceSimple = IF null?(L) THEN null ELSE
    cons((car(L)`1,inverseEvent(h,car(L)`2)),pullSimple(cdr(L)))
    ENDIF MEASURE length(L)

  pull_simple_nil: LEMMA pullSimple(list_adt[TargetTerm].null)=
    list_adt[ppg_general_lintegral[X,SX,mu].SimpleTerm].null

  pull_simple_cons: LEMMA pullSimple(cons(t,L))=
    cons((t`1,inverseEvent(h,t`2)),pullSimple(L))

  pull_simple_value: THEOREM
    ppg_general_lintegral[X,SX,mu].simpleValue(pullSimple(L))(x)=
      ppg_general_lintegral[Y,SY,mappedLaw].simpleValue(L)(h(x))

  mapped_event_value: LEMMA
    ppg_general_measure_values[Y,SY,mappedLaw].nativeValue(mappedLaw(A))=
      ppg_general_measure_values[X,SX,mu].nativeValue(mu(inverseEvent(h,A)))

  pull_simple_integral: THEOREM
    ppg_general_lintegral[X,SX,mu].simpleIntegral(pullSimple(L))=
      ppg_general_lintegral[Y,SY,mappedLaw].simpleIntegral(L)

  pullFunction(f)(x:X): ENN = f(h(x))

  target_level_measurable: LEMMA SY({y:Y|ele(ennFinite(a),f(y))})

  pull_level_set: LEMMA {x:X|ele(ennFinite(a),pullFunction(f)(x))}=
    inverseEvent(h,{y:Y|ele(ennFinite(a),f(y))})

  pull_function_measurable: THEOREM
    ppg_simple_comparison_regions[X,SX,mu].lowerMeasurable(pullFunction(f))

  pullMeasurable(f): SourceMeasurable = pullFunction(f)

  pullPrefix(f)(n:nat): SourceMeasurable =
    ppg_simple_function_lattice[X,SX,mu].simpleAsMeasurable(pullSimple(
      ppg_general_simple_approximation[Y,SY,mappedLaw].simplePrefix(f,n)))

  pull_prefix_at: LEMMA pullPrefix(f)(n)(x)=
    ppg_general_simple_approximation[Y,SY,mappedLaw].prefixValues(f)(n)(h(x))

  pull_prefix_value_sequence: LEMMA
    (LAMBDA(n:nat):pullPrefix(f)(n)(x))=
      (LAMBDA(n:nat):ppg_general_simple_approximation[Y,SY,mappedLaw].prefixValues(f)(n)(h(x)))

  pull_prefix_increasing: LEMMA
    ppg_general_monotone_integral[X,SX,mu].increasingFunctions(pullPrefix(f))

  target_prefix_sup_at: LEMMA
    ppg_general_monotone_integral[Y,SY,mappedLaw].pointwiseSup(
      ppg_general_simple_approximation[Y,SY,mappedLaw].prefixValues(f))(h(x))=f(h(x))

  target_prefix_nat_sup_at: LEMMA
    natSup(LAMBDA(n:nat):ppg_general_simple_approximation[Y,SY,mappedLaw].prefixValues(f)(n)(h(x)))=f(h(x))

  pull_prefix_sup: THEOREM
    ppg_general_monotone_integral[X,SX,mu].pointwiseSup(pullPrefix(f))=pullMeasurable(f)

  pull_prefix_integrals: LEMMA
    (LAMBDA(n:nat):ppg_general_lintegral[X,SX,mu].lintegral(pullPrefix(f)(n)))=
      (LAMBDA(n:nat):ppg_general_lintegral[Y,SY,mappedLaw].simpleIntegral(
        ppg_general_simple_approximation[Y,SY,mappedLaw].simplePrefix(f,n)))

  general_integral_map: THEOREM
    ppg_general_lintegral[X,SX,mu].lintegral(pullMeasurable(f))=
      ppg_general_lintegral[Y,SY,mappedLaw].lintegral(f)

END ppg_general_integral_map
