    (|CoordinateLaw| TYPE-EQ-DECL NIL |ppg_probability_block_base| NIL)
    (|coins| FORMAL-CONST-DECL "[i: I -> CoordinateLaw(i)]"
     |ppg_probability_cylinder_bounded| NIL)
    (|is_finite| CONST-DECL "bool" |finite_sets| NIL)
    (|finite_set| TYPE-EQ-DECL NIL |finite_sets| NIL)
    (H FORMAL-CONST-DECL "finite_set[I]" |ppg_probability_cylinder_bounded|
     NIL))
   SHOSTAK)))

