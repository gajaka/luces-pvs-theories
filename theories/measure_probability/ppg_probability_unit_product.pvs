% Evaluating a one-coordinate product recovers its actual marginal law.
% The fixed coordinate type below[1] introduces no inhabitance assumption
% on any surrounding data or event carrier.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_probability_unit_product[Value:TYPE,D:set[Value],
  (IMPORTING ppg_measurable_space[(D)]) S:MeasurableSpace,
  (IMPORTING ppg_probability_measure[(D),S]) mu:Probability]: THEORY
BEGIN
  Unit: TYPE = below[1]

  unitUniverse:finite_set[Unit] = singleton[Unit](0)

  unit_universe_full: LEMMA unitUniverse=fullset[Unit]

  unitDomain(u:Unit):set[Value] = D

  IMPORTING ppg_probability_coordinates[Unit,Value,unitDomain] AS unitCoordinates,
    ppg_subtype_measure_congruence,ppg_subtype_probability_congruence,
    ppg_probability_space_congruence

  unitSpaces:unitCoordinates.CoordinateSpaces =
    LAMBDA(u:Unit):S

  unitLaws:unitCoordinates.ProbabilityFamily(unitSpaces) =
    LAMBDA(u:Unit):mu

  IMPORTING ppg_measurable_block[Unit,Value,unitDomain,unitSpaces] AS unitBlocks,
    ppg_measurable_block_box[Unit,Value,unitDomain,unitSpaces] AS unitBoxes,
    ppg_probability_finite_product[Unit,Value,unitDomain,unitSpaces,unitLaws] AS unitProduct,
    foundations@ppg_finite_product[Unit] AS unitFold,
    foundations@ppg_finite_product_factors[Unit] AS unitFactors

  unit_product_value: LEMMA FORALL(a:real):unitFold.product(unitUniverse,LAMBDA(u:Unit):a)=a

  UnitValue: TYPE = unitBlocks.Block(unitUniverse)

  UnitSigma: MACRO ppg_measurable_space[UnitValue].MeasurableSpace = unitBlocks.blockSigma(unitUniverse)

  unitEval(x:UnitValue):(D) = x(0)

  unitEvents(A:(S)):unitBoxes.CoordinateEvents = LAMBDA(u:Unit):A

  unit_box_preimage: LEMMA FORALL(A:(S)):
    ppg_measurable_map[UnitValue,(D)].inverseImage(unitEval,A)=unitBoxes.blockBox(unitUniverse,unitEvents(A))

  unit_eval_measurable: LEMMA ppg_measurable_map[UnitValue,(D)].measurable(UnitSigma,S,unitEval)

  IMPORTING ppg_probability_map[UnitValue,(D),UnitSigma,S] AS unitPush

  unit_eval_mass: LEMMA FORALL(A:(S)):
    unitPush.pushforward(unitProduct.finiteLaw(unitUniverse),unitEval)(A)=mu(A)

  unit_product_law: THEOREM
    unitPush.pushforward(unitProduct.finiteLaw(unitUniverse),unitEval)=mu

END ppg_probability_unit_product
