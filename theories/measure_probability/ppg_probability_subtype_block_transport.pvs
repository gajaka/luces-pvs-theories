% A finite full universe on a subtype identifies its coordinate law
% with the block law. Inclusion and restriction are measurable inverses.
% Patrick Billingsley, Probability and Measure, third edition.
ppg_probability_subtype_block_transport[V,Value:TYPE,domain:[V->set[Value]],F:finite_set[V],U:{E:finite_set[(F)]|E=fullset[(F)]},
  (IMPORTING moser_tardos@ppg_mt_native_spaces[bool,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces)]: THEORY
BEGIN

  IMPORTING ppg_measurable_block[V,Value,domain,spaces] AS originalBlocks,
    ppg_probability_finite_product[V,Value,domain,spaces,laws] AS originalFinite,
    moser_tardos@ppg_mt_random_process[bool,V,Value,domain] AS slots,
    moser_tardos@ppg_mt_read_probability[bool,V,Value,domain,spaces,laws] AS reads,
    moser_tardos@ppg_mt_log_probability[bool,V,Value,domain,spaces,laws] AS logLaw

  subDomain: MACRO [(F)->set[Value]] = LAMBDA(a:(F)):domain(a)

  subSpaces: MACRO [a:(F)->ppg_measurable_space[(subDomain(a))].MeasurableSpace] =
    LAMBDA(a:(F)):spaces(a)

  subLaws: MACRO [a:(F)->ppg_probability_measure[(subDomain(a)),subSpaces(a)].Probability] =
    LAMBDA(a:(F)):laws(a)

  IMPORTING ppg_measurable_block[(F),Value,subDomain,subSpaces] AS subtypeBlocks,
    ppg_probability_finite_product[(F),Value,subDomain,subSpaces,subLaws] AS subtypeFinite,
    hls@ppg_hls_table_query[V,Value,(F),domain,U,spaces,laws,LAMBDA(a:(F)):a] AS query

  SourceValue: TYPE = originalBlocks.Block(F)

  TargetValue: TYPE = subtypeBlocks.Block(U)

  SourceSigma: MACRO ppg_measurable_space[SourceValue].MeasurableSpace = originalBlocks.blockSigma(F)

  TargetSigma: MACRO ppg_measurable_space[TargetValue].MeasurableSpace = subtypeBlocks.blockSigma(U)

  IMPORTING ppg_measurable_block_map[SourceValue,(F),Value,subDomain,subSpaces] AS subtypeMaps,
    ppg_measurable_block_map[TargetValue,V,Value,domain,spaces] AS originalMaps,
    ppg_probability_map[SourceValue,TargetValue,SourceSigma,TargetSigma] AS blockPush,
    ppg_probability_push_compose[slots.LogSpace,SourceValue,TargetValue,
      NativeTableSigma(spaces),SourceSigma,TargetSigma] AS readCompose

  toFull(x:SourceValue):TargetValue = LAMBDA(a:(U)):x(a)

  fromFull(y:TargetValue):SourceValue = LAMBDA(a:(F)):y(a)

  coordinate_measurable: LEMMA FORALL(a:(U)):
    ppg_measurable_map[SourceValue,(domain(a))].measurable(SourceSigma,spaces(a),
      LAMBDA(x:SourceValue):toFull(x)(a))

  to_full_measurable: LEMMA ppg_measurable_map[SourceValue,TargetValue].measurable(
    SourceSigma,TargetSigma,toFull)

  from_coordinate_measurable: LEMMA FORALL(a:(F)):
    ppg_measurable_map[TargetValue,(domain(a))].measurable(TargetSigma,spaces(a),
      LAMBDA(y:TargetValue):fromFull(y)(a))

  from_full_measurable: LEMMA ppg_measurable_map[TargetValue,SourceValue].measurable(
    TargetSigma,SourceSigma,fromFull)

  original_inverse: LEMMA FORALL(x:SourceValue):fromFull(toFull(x))=x

  subtype_inverse: LEMMA FORALL(y:TargetValue):toFull(fromFull(y))=y

  zero: MACRO [V->nat] = LAMBDA(v:V):0

  subZero: MACRO [(F)->nat] = LAMBDA(a:(F)):0

  read_composite_eq: LEMMA (LAMBDA(omega:slots.LogSpace):toFull(reads.readBlock(F,zero)(omega)))=
    query.tableQuery(subZero)

  slot_zero_injective: LEMMA query.injectiveQuery(subZero)

  mapped_finite_law: THEOREM blockPush.pushforward(originalFinite.finiteLaw(F),toFull)=
    subtypeFinite.finiteLaw(U)

END ppg_probability_subtype_block_transport
