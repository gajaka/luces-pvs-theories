% Finite sums of nonnegative integrable functions are integrable, and
% their NASALib mean is the sum of their means. The empty sum is the zero
% function. This is the finite-sum step before taking increasing limits
% in the count decompositions.

ppg_finite_integral[X,T: TYPE,
  (IMPORTING ppg_measurable_space[X]) S: MeasurableSpace,
  (IMPORTING ppg_probability_measure[X,S]) probLaw: Probability]: THEORY
BEGIN
  IMPORTING ppg_extended_integral[X,S,probLaw], foundations@ppg_nonneg_folds[T], foundations@ppg_finite_induction[T]
  A: VAR finite_set[T]
  rows: VAR [T->NonnegativeFunction]
  g: VAR NonnegativeFunction
  x: VAR X

  rowValue(rows,x)(t:T): nonneg_real = rows(t)(x)

  nativeSum(A,rows): RECURSIVE NonnegativeFunction = IF empty?(A) THEN nnConstant(0)
    ELSE rows(choose(A))+nativeSum(rest(A),rows) ENDIF MEASURE card(A)

  native_sum_empty: LEMMA nativeSum(emptyset[T],rows)=nnConstant(0)

  native_sum_value: LEMMA nativeSum(A,rows)(x)=sums.sum(A,rowValue(rows,x))

  native_sum_mean: LEMMA mean(nativeSum(A,rows))=sums.sum(A,LAMBDA(t:T):mean(rows(t)))

  native_sum_function_eq: LEMMA (FORALL(x:X):g(x)=sums.sum(A,rowValue(rows,x))) IMPLIES
    g=nativeSum(A,rows)

  native_sum_mean_of_values: THEOREM (FORALL(x:X):g(x)=sums.sum(A,rowValue(rows,x))) IMPLIES
    mean(g)=sums.sum(A,LAMBDA(t:T):mean(rows(t)))

END ppg_finite_integral
