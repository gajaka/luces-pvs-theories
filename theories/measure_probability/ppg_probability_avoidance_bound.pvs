% Removing finitely many measurable events loses at most the sum of
% their masses. The estimate follows by splitting at one measurable
% event and inducting over the remaining finite family.
%
% Patrick Billingsley, Probability and Measure, 3rd ed., Wiley, 1995.
ppg_probability_avoidance_bound[X,K:TYPE,
  (IMPORTING ppg_measurable_space[X]) S:MeasurableSpace,
  (IMPORTING ppg_probability_measure[X,S]) mu:Probability]: THEORY
BEGIN
  IMPORTING ppg_probability_outer[X,S,mu],ppg_event_avoidance[X,K],
    foundations@ppg_finite_sum[K],ppg_finite_events[X,K,S]
  A: VAR BadEvents
  F: VAR finite_set[K]
  a: VAR K
  B: VAR set[X]
  E: VAR (S)

  allMeasurable(A): bool = FORALL(a:K):S(A(a))

  weights(A)(a:K): real = mass(A(a))

  cut_lower: LEMMA mass(B)-mass(E)<=mass(difference(B,E))

  avoidance_step_lower: LEMMA allMeasurable(A) IMPLIES
    mass(all_pass(A,F))-mass(A(a))<=mass(all_pass(A,add(a,F)))

  avoidance_sum_lower: THEOREM allMeasurable(A) IMPLIES
    1-fsum(F,weights(A))<=mass(all_pass(A,F))

  avoidance_meet_eq: LEMMA all_pass(A,F)=finiteMeet(F,LAMBDA(a:K):complement(A(a)))

  avoidance_measurable: LEMMA allMeasurable(A) IMPLIES S(all_pass(A,F))

END ppg_probability_avoidance_bound
