% Rational lower indicators are accumulated by finite maxima.
% Every measurable nonnegative extended function is the pointwise supremum
% of this increasing sequence, including infinite values and empty carriers.
%
% Paul R. Halmos, Measure Theory, Springer, 1974.
ppg_general_simple_approximation[X:TYPE,
  (IMPORTING measure_integration@subset_algebra_def[X]) S:sigma_algebra,
  (IMPORTING measure_integration@measure_def[X,S]) mu:measure_type]: THEORY
BEGIN
  IMPORTING ppg_simple_function_lattice[X,S,mu],foundations@ppg_nonnegative_rational_grid

  f: VAR LowerMeasurable
  n,N: VAR nat
  x: VAR X
  b: VAR nonneg_real

  rationalTerm(f,n): Simple = cons((gridCoeff(n),
    {x:X|ele(ennFinite(gridCoeff(n)),f(x))}),list_adt[SimpleTerm].null)

  simplePrefix(f,N): RECURSIVE Simple = IF N=0 THEN rationalTerm(f,0) ELSE
    maxSimple(simplePrefix(f,N-1),rationalTerm(f,N)) ENDIF MEASURE N

  rational_term_value: LEMMA simpleValue(rationalTerm(f,n))(x)=
    IF ele(ennFinite(gridCoeff(n)),f(x)) THEN gridCoeff(n) ELSE 0 ENDIF

  rational_term_minorant: LEMMA simpleMinorant(rationalTerm(f,n),f)

  prefix_zero: LEMMA simplePrefix(f,0)=rationalTerm(f,0)

  prefix_succ: LEMMA simplePrefix(f,N+1)=maxSimple(simplePrefix(f,N),rationalTerm(f,N+1))

  prefix_minorant: THEOREM simpleMinorant(simplePrefix(f,N),f)

  prefix_step_value_bound: LEMMA
    simpleValue(simplePrefix(f,N))(x)<=simpleValue(simplePrefix(f,N+1))(x)

  prefix_value_monotone: THEOREM FORALL(M,N:nat,f:LowerMeasurable,x:X):N<=M IMPLIES
    simpleValue(simplePrefix(f,N))(x)<=simpleValue(simplePrefix(f,M))(x)

  prefix_member_bound: THEOREM FORALL(N,n:nat,f:LowerMeasurable,x:X):n<=N IMPLIES
    simpleValue(rationalTerm(f,n))(x)<=simpleValue(simplePrefix(f,N))(x)

  prefixValues(f)(N:nat): LowerMeasurable = simpleAsMeasurable(simplePrefix(f,N))

  prefix_values_at: LEMMA prefixValues(f)(N)(x)=ennFinite(simpleValue(simplePrefix(f,N))(x))

  prefix_values_increasing: LEMMA increasingFunctions(prefixValues(f))

  prefix_value_below_function: LEMMA ele(prefixValues(f)(N)(x),f(x))

  prefix_sup_below_function: LEMMA ele(pointwiseSup(prefixValues(f))(x),f(x))

  prefix_captures_grid: LEMMA ele(ennFinite(gridCoeff(n)),f(x)) IMPLIES
    ele(ennFinite(gridCoeff(n)),pointwiseSup(prefixValues(f))(x))

  prefix_sup_finite_bound: LEMMA ele(pointwiseSup(prefixValues(f))(x),ennFinite(b)) IMPLIES
    ele(f(x),ennFinite(b))

  function_below_prefix_sup: LEMMA ele(f(x),pointwiseSup(prefixValues(f))(x))

  prefix_pointwise_sup: THEOREM pointwiseSup(prefixValues(f))=f

  prefix_integral_at: LEMMA lintegral(prefixValues(f)(N))=simpleIntegral(simplePrefix(f,N))

  prefix_integral_function: LEMMA
    (LAMBDA(n:nat):lintegral(prefixValues(f)(n)))=
      (LAMBDA(n:nat):simpleIntegral(simplePrefix(f,n)))

  lintegral_simple_approximation: THEOREM lintegral(f)=
    natSup(LAMBDA(n:nat):simpleIntegral(simplePrefix(f,n)))

END ppg_general_simple_approximation
