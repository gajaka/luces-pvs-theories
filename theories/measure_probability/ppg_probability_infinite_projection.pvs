% A coordinate injection and proved marginal transports determine the
% law of an entire product projection. Finite rectangles give every
% finite marginal; cylinder uniqueness then gives the full law.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% This naturality statement permits different source and target value
% carriers and retains arbitrary, possibly empty, coordinate types.
ppg_probability_infinite_projection[I,J,SourceValue,TargetValue:TYPE,
  sourceDomain:[I->set[SourceValue]],targetDomain:[J->set[TargetValue]],
  (IMPORTING ppg_probability_coordinates[I,SourceValue,sourceDomain],
    ppg_probability_coordinates[J,TargetValue,targetDomain],ppg_measurable_map)
  sourceSpaces:ppg_probability_coordinates[I,SourceValue,sourceDomain].CoordinateSpaces,
  targetSpaces:ppg_probability_coordinates[J,TargetValue,targetDomain].CoordinateSpaces,
  sourceLaws:ppg_probability_coordinates[I,SourceValue,sourceDomain].ProbabilityFamily(sourceSpaces),
  targetLaws:ppg_probability_coordinates[J,TargetValue,targetDomain].ProbabilityFamily(targetSpaces),
  address:[J->I],
  decoder:{f:[j:J->[(sourceDomain(address(j)))->(targetDomain(j))]]|
    FORALL(j:J):ppg_measurable_map[(sourceDomain(address(j))),(targetDomain(j))].measurable(
      sourceSpaces(address(j)),targetSpaces(j),f(j))}]: THEORY
BEGIN
  IMPORTING ppg_measurable_cylinder[I,SourceValue,sourceDomain,sourceSpaces] AS sourceCylinders,
    ppg_measurable_cylinder[J,TargetValue,targetDomain,targetSpaces] AS targetCylinders,
    ppg_measurable_block[I,SourceValue,sourceDomain,sourceSpaces] AS sourceBlocks,
    ppg_measurable_block[J,TargetValue,targetDomain,targetSpaces] AS targetBlocks,
    ppg_measurable_block_box[J,TargetValue,targetDomain,targetSpaces] AS targetBoxes,
    ppg_probability_infinite_marginals[I,SourceValue,sourceDomain,sourceSpaces,sourceLaws] AS sourceMarginals,
    ppg_probability_infinite_product[I,SourceValue,sourceDomain,sourceSpaces,sourceLaws] AS sourceProduct,
    ppg_probability_infinite_product[J,TargetValue,targetDomain,targetSpaces,targetLaws] AS targetProduct,
    ppg_probability_disjoint_family[I,SourceValue,J,sourceDomain,sourceSpaces,sourceLaws] AS sourceFamily,
    ppg_probability_finite_consistency[J,TargetValue,targetDomain,targetSpaces,targetLaws] AS targetUnique,
    ppg_probability_finite_product[J,TargetValue,targetDomain,targetSpaces,targetLaws] AS targetFinite,
    ppg_probability_cylinder_content[J,TargetValue,targetDomain,targetSpaces,targetLaws] AS targetContent,
    ppg_measurable_block_update[I,SourceValue,sourceDomain,sourceSpaces] AS sourceUpdates,
    ppg_cylinder_algebra[J,TargetValue,targetDomain,targetSpaces] AS targetAlgebra

  SourceTable: TYPE = sourceCylinders.FullBlock

  TargetTable: TYPE = targetCylinders.FullBlock

  SourceSigma: MACRO ppg_measurable_space[SourceTable].MeasurableSpace = sourceCylinders.tableSigma

  TargetSigma: MACRO ppg_measurable_space[TargetTable].MeasurableSpace = targetCylinders.tableSigma

  IMPORTING ppg_measurable_block_map[SourceTable,J,TargetValue,targetDomain,targetSpaces] AS projectionMaps,
    ppg_probability_map[SourceTable,TargetTable,SourceSigma,TargetSigma] AS projectionPush,
    ppg_finite_events[SourceTable,J,SourceSigma] AS projectionMeets,
    ppg_probability_event_product[SourceTable,J,SourceSigma] AS projectionFactors,
    foundations@ppg_finite_product[J] AS projectionFold,
    ppg_measurable_compose

  TargetEvents: TYPE = targetBoxes.CoordinateEvents

  E: VAR TargetEvents
  F: VAR finite_set[J]
  j: VAR J

  project(x:SourceTable): TargetTable = LAMBDA(j:J):decoder(j)(x(address(j)))

  projected_coordinate_measurable: LEMMA
    ppg_measurable_map[SourceTable,(targetDomain(j))].measurable(SourceSigma,targetSpaces(j),
      LAMBDA(x:SourceTable):project(x)(j))

  project_measurable: LEMMA ppg_measurable_map[SourceTable,TargetTable].measurable(SourceSigma,TargetSigma,project)

  coordinateLawsMatch: bool = FORALL(j:J):
    ppg_probability_map[(sourceDomain(address(j))),(targetDomain(j)),
      sourceSpaces(address(j)),targetSpaces(j)].pushforward(sourceLaws(address(j)),decoder(j))=targetLaws(j)

  coordinatePreimage(j:J,A:(targetSpaces(j))): (sourceSpaces(address(j))) =
    ppg_measurable_map[(sourceDomain(address(j))),(targetDomain(j))].inverseImage(decoder(j),A)

  projectedEvent(j:J,A:(targetSpaces(j))): (SourceSigma) = {x:SourceTable|A(project(x)(j))}

  projected_event_coordinate: LEMMA FORALL(j:J,A:(targetSpaces(j))):projectedEvent(j,A)=
    sourceBlocks.blockCylinder(fullset[I],address(j),coordinatePreimage(j,A))

  projected_event_mass: LEMMA FORALL(j:J,A:(targetSpaces(j))):coordinateLawsMatch IMPLIES
    sourceProduct.infiniteLaw(projectedEvent(j,A))=targetLaws(j)(A)

  projectedEvents(E): [J->(SourceSigma)] = LAMBDA(j:J):projectedEvent(j,E(j))

  projectedBlocks: [J->set[I]] = LAMBDA(j:J):singleton[I](address(j))

  projected_blocks_disjoint: LEMMA injective?(address) IMPLIES sourceFamily.pairwiseDisjoint(F,projectedBlocks)

  projected_event_depends: LEMMA FORALL(j:J,A:(targetSpaces(j))):sourceUpdates.dependsOn(projectedBlocks(j),projectedEvent(j,A))

  projected_event_factors: LEMMA coordinateLawsMatch IMPLIES
    projectionFactors.eventFactors(sourceProduct.infiniteLaw,projectedEvents(E))=
      (LAMBDA(j:J):targetLaws(j)(E(j)))

  projected_complete_family: LEMMA
    projectionMeets.completeFamily(projectedEvents(E))=projectedEvents(E)

  projected_meet_mass: LEMMA injective?(address) AND coordinateLawsMatch IMPLIES
    sourceProduct.infiniteLaw(projectionMeets.finiteMeet(F,projectedEvents(E)))=
      projectionFold.product(F,LAMBDA(j:J):targetLaws(j)(E(j)))

  query(F)(x:SourceTable): targetBlocks.Block(F) = LAMBDA(j:(F)):project(x)(j)

  query_restriction: LEMMA FORALL(x:SourceTable):
    ppg_measurable_block_restriction[J,TargetValue,targetDomain,targetSpaces].restrictBlock(fullset[J],F)(project(x))=query(F)(x)

  query_measurable: LEMMA ppg_measurable_map[SourceTable,targetBlocks.Block(F)].measurable(
    SourceSigma,targetBlocks.blockSigma(F),query(F))

  query_box_preimage: LEMMA
    ppg_measurable_map[SourceTable,targetBlocks.Block(F)].inverseImage(query(F),targetBoxes.blockBox(F,E))=
      projectionMeets.finiteMeet(F,projectedEvents(E))

  queryLaw(F): ppg_probability_measure[targetBlocks.Block(F),targetBlocks.blockSigma(F)].Probability =
    ppg_probability_map[SourceTable,targetBlocks.Block(F),SourceSigma,targetBlocks.blockSigma(F)].pushforward(
      sourceProduct.infiniteLaw,query(F))

  query_law_box: LEMMA injective?(address) AND coordinateLawsMatch IMPLIES
    queryLaw(F)(targetBoxes.blockBox(F,E))=projectionFold.product(F,LAMBDA(j:J):targetLaws(j)(E(j)))

  finite_projection_law: LEMMA injective?(address) AND coordinateLawsMatch IMPLIES
    queryLaw(F)=targetFinite.finiteLaw(F)

  projectionLaw: ppg_probability_measure[TargetTable,TargetSigma].Probability =
    projectionPush.pushforward(sourceProduct.infiniteLaw,project)

  cylinder_query_preimage: LEMMA FORALL(B:(targetBlocks.blockSigma(F))):
    ppg_measurable_map[SourceTable,TargetTable].inverseImage(project,targetCylinders.tableCylinder(F,B))=
      ppg_measurable_map[SourceTable,targetBlocks.Block(F)].inverseImage(query(F),B)

  projection_cylinder_mass: LEMMA injective?(address) AND coordinateLawsMatch IMPLIES
    FORALL(B:(targetBlocks.blockSigma(F))):
      projectionLaw(targetCylinders.tableCylinder(F,B))=targetFinite.finiteLaw(F)(B)

  projection_content: LEMMA injective?(address) AND coordinateLawsMatch IMPLIES
    FORALL(A:(targetAlgebra.Cylinders)):projectionLaw(A)=targetContent.content(A)

  infinite_product_projection: THEOREM injective?(address) AND coordinateLawsMatch IMPLIES
    projectionLaw=targetProduct.infiniteLaw

END ppg_probability_infinite_projection
