% The sigma algebra on a function space is generated by its coordinate
% evaluations. No restriction is placed on the index or value carrier.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley,
% 1995, the coordinate construction of product sigma algebras.

ppg_measurable_function[A, I, Y: TYPE]: THEORY
BEGIN
  Pi: TYPE = [I -> Y]

  IMPORTING ppg_measurable_map[A, Pi], ppg_measurable_map[A, Y],
    ppg_measurable_map[Pi, Y]

  SA: VAR ppg_measurable_space[A].MeasurableSpace
  coordinates: VAR [I -> ppg_measurable_space[Y].MeasurableSpace]
  i: VAR I
  B: VAR set[Y]
  f: VAR [A -> Pi]

  cylinder(i, B): set[Pi] = {p: Pi | B(p(i))}

  cylinders(coordinates): set[set[Pi]] = {E: set[Pi] |
    EXISTS (i: I, B: set[Y]): coordinates(i)(B) AND E = cylinder(i, B)}

  productSigma(coordinates): ppg_measurable_space[Pi].MeasurableSpace =
    generated(cylinders(coordinates))

  measurable_cylinder: LEMMA coordinates(i)(B) IMPLIES productSigma(coordinates)(cylinder(i, B))

  measurable_coordinate: LEMMA measurable(productSigma(coordinates), coordinates(i),
    LAMBDA (p: Pi): p(i))

  inverseImage_cylinder: LEMMA inverseImage(f, cylinder(i, B)) =
    inverseImage(LAMBDA (a: A): f(a)(i), B)

  measurable_product: LEMMA
    (FORALL (i: I): measurable(SA, coordinates(i), LAMBDA (a: A): f(a)(i))) IMPLIES
      measurable(SA, productSigma(coordinates), f)

END ppg_measurable_function
