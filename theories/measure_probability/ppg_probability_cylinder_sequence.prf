     (LEMMA "increasing_union_mass[Block(F), blockSigma(F)]"
      ("mu" "finiteLaw(F)" "E" "E!1"))
     (LEMMA "measurable_countable_union[Block(F)]"
      ("S" "blockSigma(F)" "E" "E!1"))
     (ASSERT) (REWRITE "cylinder_sequence_mass") (EXPAND "cylinderSequence")
     (LEMMA "cylinder_countable_union" ("F" "F" "E" "E!1"))
     (REPLACE -1 :DIR RL :ACTUALS? T)
     (LEMMA "content_cylinder" ("F" "F" "B" "countableUnion[Block(F)](E!1)"))
     (ASSERT))
    NIL)
   ((|Family| TYPE-EQ-DECL NIL |ppg_measurable_space| NIL)
    (|measurable_countable_union| FORMULA-DECL NIL |ppg_measurable_space| NIL)
    (|cylinder_sequence_mass| FORMULA-DECL NIL
     |ppg_probability_cylinder_sequence| NIL)
    (|cylinder_countable_union| FORMULA-DECL NIL
     |ppg_measurable_cylinder_sequence| NIL)
    (|countableUnion| CONST-DECL "Event" |ppg_measurable_space| NIL)
