% Joint and forward events are intersections of inverse images under
% the coordinate test maps. The excluded event is a measurable
% difference by its raw set identity; no measure assumption is used.
%
% Kun He, Qian Li and Xiaoming Sun, Moser-Tardos Algorithm: Beyond
% Shearer's Bound, arXiv:2111.06527, Proposition 3.3.
ppg_native_intersection_measurable[X,Y,Z:TYPE,
  (IMPORTING measure_integration@subset_algebra_def)
    SX:sigma_algebra[X],SY:sigma_algebra[Y],SZ:sigma_algebra[Z]]: THEORY
BEGIN
  IMPORTING ppg_intersection_events[X,Y,Z],
    ppg_native_intersection_coordinates[X,Y,Z,SX,SY,SZ],
    ppg_native_double_measurable[[X,Z],Y,sigma_times(SX,SZ),SY],
    measure_integration@sigma_algebra[[[X,Z],Y],sigma_times(sigma_times(SX,SZ),SY)],
    measure_integration@sigma_algebra[[[X,Z],[Y,Y]],sigma_times(sigma_times(SX,SZ),sigma_times(SY,SY))]

  A: VAR (sigma_times(SX,SY))
  B: VAR (sigma_times(SY,SZ))

  joint_event_preimages: LEMMA jointEvent(A,B)=
    intersection(ppg_general_measure_map[[[X,Z],Y],[X,Y],sigma_times(sigma_times(SX,SZ),SY),sigma_times(SX,SY)].inverseEvent(jointLeft,A),
      ppg_general_measure_map[[[X,Z],Y],[Y,Z],sigma_times(sigma_times(SX,SZ),SY),sigma_times(SY,SZ)].inverseEvent(jointRight,B))

  measurableSet_jointEvent: THEOREM sigma_times(sigma_times(SX,SZ),SY)(jointEvent(A,B))

  forward_event_preimages: LEMMA forwardEvent(A,B)=
    intersection(ppg_general_measure_map[[[X,Z],[Y,Y]],[X,Y],sigma_times(sigma_times(SX,SZ),sigma_times(SY,SY)),sigma_times(SX,SY)].inverseEvent(forwardLeft,A),
      ppg_general_measure_map[[[X,Z],[Y,Y]],[Y,Z],sigma_times(sigma_times(SX,SZ),sigma_times(SY,SY)),sigma_times(SY,SZ)].inverseEvent(forwardRight,B))

  measurableSet_forwardEvent: THEOREM sigma_times(sigma_times(SX,SZ),sigma_times(SY,SY))(forwardEvent(A,B))

  jointAsEvent(A,B): (sigma_times(sigma_times(SX,SZ),SY)) = jointEvent(A,B)

  forwardAsEvent(A,B): (sigma_times(sigma_times(SX,SZ),sigma_times(SY,SY))) = forwardEvent(A,B)

  double_joint_measurable: THEOREM sigma_times(sigma_times(SX,SZ),sigma_times(SY,SY))(doubleEvent(jointEvent(A,B)))

  measurableSet_oneOrderOnly: THEOREM sigma_times(sigma_times(SX,SZ),sigma_times(SY,SY))(oneOrderOnly(A,B))

END ppg_native_intersection_measurable
