% Finite indicator counts increase along every path. If those counts
% converge to a real value, their extended supremum is bounded by that
% value. This pointwise statement does not involve a measure.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_count_prefix_limit[Omega:TYPE]: THEORY
BEGIN
  IMPORTING ppg_event_count[Omega],ppg_sup_clip,foundations@ppg_nat_range,ppg_enn_add,
    metric_space@convergence_aux

  E: VAR [nat->set[Omega]]
  omega: VAR Omega
  i,j,n: VAR nat
  c,b: VAR real
  a: VAR nonneg_real
  u: VAR [nat->real]

  count_prefix_monotone: LEMMA i<=j IMPLIES countPrefix(E,omega,i)<=countPrefix(E,omega,j)

  count_prefix_increasing: LEMMA increasing?(LAMBDA(n:nat):countPrefix(E,omega,n))

  count_prefix_lower: LEMMA ele(ennFinite(countPrefix(E,omega,n)),eventCount(E,omega))

  count_prefix_le_limit: LEMMA convergence?(LAMBDA(k:nat):countPrefix(E,omega,k),c)
    IMPLIES countPrefix(E,omega,n)<=c

  count_limit_nonnegative: LEMMA convergence?(LAMBDA(n:nat):countPrefix(E,omega,n),c)
    IMPLIES 0<=c

  count_limit_upper: LEMMA convergence?(LAMBDA(n:nat):countPrefix(E,omega,n),c)
    IMPLIES ele(eventCount(E,omega),ennFinite(abs(c)))

  finite_below_count_limit: LEMMA convergence?(LAMBDA(n:nat):countPrefix(E,omega,n),c) AND
    ele(ennFinite(a),eventCount(E,omega)) IMPLIES a<=c

  real_image_nonempty: LEMMA nonempty?[real](image[nat,real](u,fullset[nat]))

  real_converging_bound: LEMMA converges_upto?(u,c) AND (FORALL(n:nat):u(n)<=b) IMPLIES c<=b

END ppg_count_prefix_limit
