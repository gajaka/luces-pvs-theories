% Every real function of a measurable finite-state map is the finite
% sum of its pulled-back singleton indicators. Native integral linearity
% therefore gives its mean from the masses of those state events.
% The coefficients may have either sign.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_finite_image_integral[State,Omega:TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  (IMPORTING ppg_nasa_sigma[Omega]) S:MeasurableSpace,
  (IMPORTING ppg_finite_law_view[Omega,S]) measureLaw:FiniteLaw]: THEORY
BEGIN
  IMPORTING finite_models@ppg_finite_process_integral[State,Omega,universe,S,measureLaw] AS imageValue,
    ppg_finite_measure_integral[Omega,S,measureLaw] AS functions,
    ppg_finite_expectation[Omega,S,measureLaw] AS eventMean,
    foundations@ppg_finite_sum[State] AS sums,
    measure_integration@integral[Omega,ppg_nasa_sigma[Omega].asNasa(S),measureLaw] AS native

  X: VAR imageValue.StateMap
  f: VAR [State->real]
  t: VAR State
  A: VAR finite_set[State]

  pointValue(t,f,X): functions.NativeFunction = f(t)*functions.indicator(imageValue.stateEvent(X,t))

  point_mean: LEMMA native.integral(pointValue(t,f,X))=f(t)*eventMean.mass(imageValue.stateEvent(X,t))

  finite_value_mean: LEMMA native.integral(imageValue.finiteValue(A,f,X))=
    sums.fsum(A,LAMBDA(t:State):f(t)*eventMean.mass(imageValue.stateEvent(X,t)))

  integrable_value_mean: THEOREM native.integral(imageValue.integrableValue(f,X))=
    sums.fsum(universe,LAMBDA(t:State):f(t)*eventMean.mass(imageValue.stateEvent(X,t)))

END ppg_finite_image_integral
