% While the process runs through N, its first-hit count is at least N+1.
% The corresponding simple minorant gives Markov's bound under the
% original measure, including infinite and nonsemifinite measures.
%
% Michael Mitzenmacher and Eli Upfal, Probability and Computing,
% second edition, Theorem 3.1, Cambridge University Press, 2017.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_general_hit_markov[State,Omega: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  (IMPORTING ppg_nasa_sigma[Omega]) S:MeasurableSpace,
  (IMPORTING measure_integration@measure_def[Omega,asNasa(S)])
  originalMeasure:measure_type]: THEORY
BEGIN
  IMPORTING ppg_general_simple_integral[Omega,S,originalMeasure],
    finite_models@ppg_finite_hit_tail[State,Omega,universe,S]

  SingletonStateSpace: TYPE = {SY:StateSpace|singletonMeasurable(SY)}

  MeasurableProcess(SY:StateSpace): TYPE = {X:Process|processMeasurable(SY,X)}

  runningMeasured(M:Model,SY:SingletonStateSpace,X:MeasurableProcess(SY),N:nat): (S) =
    runningEvent(M,X,N)

  generalExpectedHitCount(M:Model,X:Process): ENN =
    generalLintegral(LAMBDA(omega:Omega):hitCount(M,X,omega))

  running_measure_le_mean_div: THEOREM FORALL(M:Model,SY:SingletonStateSpace,
    X:MeasurableProcess(SY),N:nat):
    ele(originalMass(runningMeasured(M,SY,X,N)),
      dividePositive(generalExpectedHitCount(M,X),N+1))

END ppg_general_hit_markov
