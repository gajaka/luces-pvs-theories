% Two measurable maps with the same domain give a measurable
% pair map. Rectangle inverse images are intersections; the product
% sigma algebra is generated by those rectangles.
%
% Mathlib, MeasureTheory/MeasurableSpace/Constructions.lean, measurable_prod_mk.
ppg_native_pair_maps[T,U,V:TYPE,
  (IMPORTING measure_integration@subset_algebra_def)
    ST:sigma_algebra[T],SU:sigma_algebra[U],SV:sigma_algebra[V]]: THEORY
BEGIN
  IMPORTING measure_integration@product_sigma[U,V,SU,SV],
    ppg_general_measure_map[T,U,ST,SU],ppg_general_measure_map[T,V,ST,SV],
    ppg_general_measure_map[T,[U,V],ST,sigma_times(SU,SV)],
    ppg_native_measurable_generators[T,[U,V],ST],
    measure_integration@sigma_algebra[T,ST]

  f: VAR ppg_general_measure_map[T,U,ST,SU].MeasurableMap
  g: VAR ppg_general_measure_map[T,V,ST,SV].MeasurableMap
  A: VAR (SU)
  B: VAR (SV)
  D: VAR set[[U,V]]

  pairFunction(f,g)(t:T): [U,V] = (f(t),g(t))

  targetGenerators: set[set[[U,V]]] = fullset[measurable_rectangle(SU,SV)]

  target_generator_is_rectangle: LEMMA targetGenerators(D) IMPLIES
    measurable_rectangle?(SU,SV)(D)

  pair_rectangle_inverse: THEOREM
    ppg_measurable_map[T,[U,V]].inverseImage(pairFunction(f,g),cross_product(A,B))=
      intersection(ppg_general_measure_map[T,U,ST,SU].inverseEvent(f,A),
        ppg_general_measure_map[T,V,ST,SV].inverseEvent(g,B))

  pair_rectangle_measurable: THEOREM ST(
    ppg_measurable_map[T,[U,V]].inverseImage(pairFunction(f,g),cross_product(A,B)))

  pair_generators_measurable: THEOREM targetGenerators(D) IMPLIES ST(
    ppg_measurable_map[T,[U,V]].inverseImage(pairFunction(f,g),D))

  pair_generated_preimages: THEOREM
    subset?(measure_integration@subset_algebra_def[[U,V]].generated_sigma_algebra(targetGenerators),
      preimageSigma(pairFunction(f,g)))

  target_product_generated: LEMMA sigma_times(SU,SV)=
    measure_integration@subset_algebra_def[[U,V]].generated_sigma_algebra(targetGenerators)

  pair_measurable: THEOREM
    ppg_general_measure_map[T,[U,V],ST,sigma_times(SU,SV)].measurableMap?(pairFunction(f,g))

  pairMap(f,g): ppg_general_measure_map[T,[U,V],ST,sigma_times(SU,SV)].MeasurableMap = pairFunction(f,g)

END ppg_native_pair_maps
