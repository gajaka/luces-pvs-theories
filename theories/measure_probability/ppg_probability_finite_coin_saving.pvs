% The two coin laws give the same half-sum of the forward and one-order
% event masses. Product-measure identification transfers the intersection bound.
% Patrick Billingsley, Probability and Measure, third edition.
ppg_probability_finite_coin_saving[X,Y,Z:TYPE,
  (IMPORTING ppg_measurable_space[X],ppg_measurable_space[Y],
    ppg_measurable_space[Z])
  SX:ppg_measurable_space[X].MeasurableSpace,
  SY:ppg_measurable_space[Y].MeasurableSpace,
  SZ:ppg_measurable_space[Z].MeasurableSpace,
  (IMPORTING ppg_probability_measure[X,SX],
    ppg_probability_measure[Y,SY],ppg_probability_measure[Z,SZ])
  muX:ppg_probability_measure[X,SX].Probability,
  muY:ppg_probability_measure[Y,SY].Probability,
  muZ:ppg_probability_measure[Z,SZ].Probability]: THEORY
BEGIN

  IMPORTING ppg_probability_pair[X,Y,SX,SY] AS leftReal,
    ppg_probability_pair[Y,Z,SY,SZ] AS rightReal,
    ppg_probability_pair[X,Z,SX,SZ] AS privateReal,
    ppg_probability_pair[Y,Y,SY,SY] AS sharedReal,
    ppg_probability_pair[[X,Z],[Y,Y],privateReal.JointSpace,
      sharedReal.JointSpace] AS fourReal,
    ppg_probability_finite_native_product[X,Z,SX,SZ,muX,muZ] AS privateBridge,
    ppg_probability_finite_native_product[Y,Y,SY,SY,muY,muY] AS sharedBridge,
    ppg_probability_finite_native_four[X,Y,Z,SX,SY,SZ,muX,muY,muZ] AS fourBridge,
    ppg_probability_finite_native_triple[X,Y,Z,SX,SY,SZ,muX,muY,muZ] AS tripleBridge

  IMPORTING ppg_probability_intersection[X,Y,Z,
      ppg_nasa_sigma[X].asNasa(SX),ppg_nasa_sigma[Y].asNasa(SY),
      ppg_nasa_sigma[Z].asNasa(SZ),privateBridge.leftNative,
      sharedBridge.leftNative,privateBridge.rightNative] AS estimate,
    hls@ppg_hls_coin_saving[X,Y,Z,
      ppg_nasa_sigma[X].asNasa(SX),ppg_nasa_sigma[Y].asNasa(SY),
      ppg_nasa_sigma[Z].asNasa(SZ),privateBridge.leftNative,
      sharedBridge.leftNative,privateBridge.rightNative] AS nativeSaving,
    ppg_native_intersection_measurable[X,Y,Z,
      ppg_nasa_sigma[X].asNasa(SX),ppg_nasa_sigma[Y].asNasa(SY),
      ppg_nasa_sigma[Z].asNasa(SZ)] AS nativeEvents,
    ppg_probability_real_difference[[[X,Z],[Y,Y]],
      sigma_times(sigma_times(ppg_nasa_sigma[X].asNasa(SX),
        ppg_nasa_sigma[Z].asNasa(SZ)),
        sigma_times(ppg_nasa_sigma[Y].asNasa(SY),ppg_nasa_sigma[Y].asNasa(SY))),
      estimate.fourProb] AS nativeReal,
    hls@ppg_hls_coin_choice[[[X,Z],[Y,Y]],fourReal.JointSpace] AS finiteChoice,
    hls@ppg_hls_fair_orientation

  FourValue: TYPE = [[X,Z],[Y,Y]]

  IMPORTING ppg_probability_pair[OrientationCoin,FourValue,
    OrientationSigma,fourReal.JointSpace] AS coinReal

  A: VAR (leftReal.JointSpace)

  B: VAR (rightReal.JointSpace)

  E: VAR (fourReal.JointSpace)

  delta: VAR real

  four_sigma_eq: LEMMA fourReal.JointSpace=
    sigma_times(sigma_times(ppg_nasa_sigma[X].asNasa(SX),
      ppg_nasa_sigma[Z].asNasa(SZ)),
      sigma_times(ppg_nasa_sigma[Y].asNasa(SY),ppg_nasa_sigma[Y].asNasa(SY)))

  forwardBlock(A,B):(fourReal.JointSpace) = nativeEvents.forwardAsEvent(A,B)

  oneOrderBlock(A,B):(fourReal.JointSpace) = estimate.oneOrderAsEvent(A,B)

  coinSavingEvent(A,B):(coinReal.JointSpace) =
    finiteChoice.choiceEvent(forwardBlock(A,B),oneOrderBlock(A,B))

  finiteCoinMass(A,B): nonneg_real =
    coinReal.productLaw(fairOrientation,fourBridge.nestedLaw)(coinSavingEvent(A,B))

  native_event_real: LEMMA nativeReal.realMass(E)=fourBridge.nestedLaw(E)

  forward_mass: LEMMA fourBridge.nestedLaw(forwardBlock(A,B))=
    leftReal.productLaw(muX,muY)(A)*rightReal.productLaw(muY,muZ)(B)

  finite_average_formula: LEMMA finiteCoinMass(A,B)=
    fourBridge.nestedLaw(forwardBlock(A,B))/2+
      fourBridge.nestedLaw(oneOrderBlock(A,B))/2

  native_average_mass: LEMMA nativeSaving.averagedEventMass(A,B)=finiteCoinMass(A,B)

  finite_coin_intersection_saving: THEOREM
    delta>=0 AND delta<=tripleBridge.tripleLaw(nativeEvents.jointAsEvent(A,B)) IMPLIES
      finiteCoinMass(A,B)<=
        leftReal.productLaw(muX,muY)(A)*rightReal.productLaw(muY,muZ)(B)-delta*delta/2

END ppg_probability_finite_coin_saving
