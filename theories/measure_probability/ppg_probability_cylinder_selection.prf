    (|nonneg_real| NONEMPTY-TYPE-EQ-DECL NIL |real_types| NIL)
    (|CylinderSequence| TYPE-EQ-DECL NIL |ppg_probability_cylinder_selection|
     NIL)
    (|Cylinders| CONST-DECL "set[TableEvent[I, Value, domain, spaces]]"
     |ppg_cylinder_algebra| NIL)
    (|TableEvent| TYPE-EQ-DECL NIL |ppg_measurable_cylinder| NIL)
    (|nat| NONEMPTY-TYPE-EQ-DECL NIL |naturalnumbers| NIL)
    (>= CONST-DECL "bool" |reals| NIL)
    (|int| NONEMPTY-TYPE-EQ-DECL NIL |integers| NIL)
    (|integer_pred| CONST-DECL "[rational -> boolean]" |integers| NIL)
    (|rational| NONEMPTY-TYPE-FROM-DECL NIL |rationals| NIL)
    (|rational_pred| CONST-DECL "[real -> boolean]" |rationals| NIL)
    (|real| NONEMPTY-TYPE-FROM-DECL NIL |reals| NIL)
    (|real_pred| CONST-DECL "[number_field -> boolean]" |reals| NIL)
    (|number_field| NONEMPTY-TYPE-FROM-DECL NIL |number_fields| NIL)
    (|number_field_pred| CONST-DECL "[number -> boolean]" |number_fields| NIL)
    (|number| NONEMPTY-TYPE-DECL NIL |numbers| NIL)
    (|FullBlock| TYPE-EQ-DECL NIL |ppg_measurable_cylinder| NIL)
    (|spaces| FORMAL-CONST-DECL
     "[i: I -> ppg_measurable_space[(domain(i))].MeasurableSpace]"
     |ppg_probability_cylinder_selection| NIL)
    (|MeasurableSpace| NONEMPTY-TYPE-EQ-DECL NIL |ppg_measurable_space| NIL)
    (|sigma?| CONST-DECL "bool" |ppg_measurable_space| NIL)
    (|Event| TYPE-EQ-DECL NIL |ppg_measurable_space| NIL)
    (|domain| FORMAL-CONST-DECL "[I -> set[Value]]"
     |ppg_probability_cylinder_selection| NIL)
    (|Value| FORMAL-TYPE-DECL NIL |ppg_probability_cylinder_selection| NIL)
    (|fullset| CONST-DECL "set" |sets| NIL) (|set| TYPE-EQ-DECL NIL |sets| NIL)
    (|bool| NONEMPTY-TYPE-EQ-DECL NIL |booleans| NIL)
    (|boolean| NONEMPTY-TYPE-DECL NIL |booleans| NIL)
    (I FORMAL-TYPE-DECL NIL |ppg_probability_cylinder_selection| NIL))
   SHOSTAK)))

