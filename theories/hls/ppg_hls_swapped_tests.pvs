% At a reversible arc, each endpoint reads the other endpoint's table
% entry precisely on their shared variables. Locality of the bad event
% turns agreement on its own footprint into equality of endpoint tests.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", proof of Lemma 3.4. https://arxiv.org/abs/2111.06527
% Lean counterpart: PPGraphHLSSwappedTests.lean.
ppg_hls_swapped_tests[C,V,Value:TYPE,domain:[V->set[Value]],
  footprint:[C->finite_set[V]],
  (IMPORTING moser_tardos@ppg_mt_semantics[C,V,Value,domain])bad:[C,MTState->bool]]: THEORY
BEGIN
  IMPORTING ppg_hls_prefix_check[C,V,Value,domain,footprint,bad]
  Q: VAR (Valid)
  u,v,r: VAR WNode
  omega: VAR rawSlots.LogSpace
  sigma,tau: VAR MTState
  a: VAR V

  swapShared(u,v)(sigma,tau): MTState = LAMBDA(a:V):
    IF footprint(u`1)(a) AND footprint(v`1)(a) THEN tau(a) ELSE sigma(a) ENDIF

  reverse_source_agrees_on_footprint: LEMMA Edge(Q)(u,v) AND
    dagPaths.Acyclic(dagPaths.reverseArc(Edge(Q),u,v)) AND footprint(u`1)(a) IMPLIES
      tableState(reverse(Q,u,v),u)(omega)(a)=
        swapShared(u,v)(tableState(Q,u)(omega),tableState(Q,v)(omega))(a)

  reverse_target_agrees_on_footprint: LEMMA Edge(Q)(u,v) AND
    dagPaths.Acyclic(dagPaths.reverseArc(Edge(Q),u,v)) AND footprint(v`1)(a) IMPLIES
      tableState(reverse(Q,u,v),v)(omega)(a)=
        swapShared(u,v)(tableState(Q,v)(omega),tableState(Q,u)(omega))(a)

  reverse_source_test_eq_swap: THEOREM mt_wf(footprint,bad) AND Edge(Q)(u,v) AND
    dagPaths.Acyclic(dagPaths.reverseArc(Edge(Q),u,v)) IMPLIES
      (tableEvent(reverse(Q,u,v),u)(omega) IFF
        bad(u`1,swapShared(u,v)(tableState(Q,u)(omega),tableState(Q,v)(omega))))

  reverse_target_test_eq_swap: THEOREM mt_wf(footprint,bad) AND Edge(Q)(u,v) AND
    dagPaths.Acyclic(dagPaths.reverseArc(Edge(Q),u,v)) IMPLIES
      (tableEvent(reverse(Q,u,v),v)(omega) IFF
        bad(v`1,swapShared(u,v)(tableState(Q,v)(omega),tableState(Q,u)(omega))))

  flipped_prefix_failure_forces_swapped_failure: THEOREM mt_wf(footprint,bad) AND
    Edge(Q)(u,v) AND dagPaths.Acyclic(dagPaths.reverseArc(Edge(Q),u,v)) AND
    tableCheck(Q)(omega) AND NOT tableCheck(ancestorPrefix(reverse(Q,u,v),r))(omega) IMPLIES
      NOT bad(u`1,swapShared(u,v)(tableState(Q,u)(omega),tableState(Q,v)(omega))) OR
      NOT bad(v`1,swapShared(u,v)(tableState(Q,v)(omega),tableState(Q,u)(omega)))

END ppg_hls_swapped_tests
