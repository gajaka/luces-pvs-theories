% Before time t, a variable has been read once for each earlier log
% occurrence whose footprint contains it. The second coordinate makes
% the occurrence map injective, so its image has the same cardinality.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Section 2.1. https://arxiv.org/abs/2111.06527
% Lean counterpart: PPGraphHLSTimeDAG.lean.
ppg_hls_time_coordinates[C,V:TYPE,footprint:[C->finite_set[V]]]: THEORY
BEGIN
  IMPORTING ppg_hls_table_coordinates[C,V,footprint],
    ppg_hls_time_dag[C,coordinateGraph.dependencyGraph],
    foundations@ppg_finite_bijection[nat,WNode] AS timeImages
  labels: VAR [nat->C]
  n,t,s: VAR nat
  a: VAR V
  u: VAR WNode

  timeNode_injective: LEMMA timeNode(labels)(s)=timeNode(labels)(t) IMPLIES s=t

  readerTimes(labels,t,a): finite_set[nat] = filteredRange(
    LAMBDA(s:nat):footprint(labels(s))(a),t)

  readerTimes_member: LEMMA readerTimes(labels,t,a)(s) IFF s<t AND footprint(labels(s))(a)

  reader_image_iff: LEMMA image[nat,WNode](timeNode(labels),readerTimes(labels,t,a))(u) IFF
    u`2<t AND u`1=labels(u`2) AND footprint(labels(u`2))(a)

  priorReaders_time_member: LEMMA t<n AND footprint(labels(t))(a) IMPLIES
    (priorReaders(timeDAG(labels,n),timeNode(labels)(t),a)(u) IFF
      u`2<t AND u`1=labels(u`2) AND footprint(labels(u`2))(a))

  priorReaders_timeDAG: THEOREM t<n AND footprint(labels(t))(a) IMPLIES
    priorReaders(timeDAG(labels,n),timeNode(labels)(t),a)=
      image[nat,WNode](timeNode(labels),readerTimes(labels,t,a))

  timeNode_injOn: LEMMA timeImages.injOn(timeNode(labels),readerTimes(labels,t,a))

  localIndex_timeDAG: THEOREM t<n AND footprint(labels(t))(a) IMPLIES
    localIndex(timeDAG(labels,n),timeNode(labels)(t))(a)=card(readerTimes(labels,t,a))

END ppg_hls_time_coordinates
