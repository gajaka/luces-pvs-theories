% Each supported node has four local choices, except that matching-arc
% endpoints and fixed mates must stay up. The dependent function type
% keeps exactly those local restrictions and no coordinates elsewhere.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Appendix C. https://arxiv.org/abs/2111.06527
% Lean counterpart: LocalChoice and IndependentChoices in PPGraphHLSChoiceSum.lean.
ppg_hls_independent_choices[C:TYPE,G:{A:[C,C->bool]|(FORALL(i:C):NOT A(i,i)) AND
  (FORALL(i,j:C):A(i,j)=A(j,i))},
  (IMPORTING ppg_hls_choice_weights[C,G]) M:DependencyMatching,D:WitnessDAG]: THEORY
BEGIN
  Choice: TYPE = ppg_hls_expansion_vertices[C,G].ExpansionChoice

  IMPORTING measure_probability@ppg_nonneg_tsum[Choice] AS choiceSums,measure_probability@ppg_enn_finite[Choice] AS finiteChoices

  u: VAR WNode
  ch: VAR Choice
  f: VAR [Choice->ENN]
  up,down: VAR [C->ENN]

  forcedUp(u): bool = arcNodes(matchingArcs(M,D))(u) OR M(u`1)=u`1

  choices: finite_set[Choice] = add[Choice](3,add[Choice](2,add[Choice](1,singleton[Choice](0))))

  choices_full: LEMMA choices(ch)

  localDomain(u): finite_set[Choice] = IF forcedUp(u) THEN singleton[Choice](0) ELSE choices ENDIF

  localDomain_member: LEMMA localDomain(u)(ch) IFF (forcedUp(u) IMPLIES ch=0)

  localDomain_up: LEMMA localDomain(u)(0)

  LocalChoice(u): TYPE = (localDomain(u))

  IndependentChoices: TYPE = [u:(D`nodes)->LocalChoice(u)]

  upChoices: IndependentChoices = LAMBDA(u:(D`nodes)):0

  singleton_choice_sum: LEMMA choiceSums.esum(singleton(ch),f)=f(ch)

  four_choice_sum: LEMMA choiceSums.esum(choices,f)=eadd(eadd(eadd(f(0),f(1)),f(2)),f(3))

  local_esum: LEMMA choiceSums.esum(localDomain(u),LAMBDA(ch:Choice):
    choiceWeight(M,up,down,u`1,ch))=
      IF forcedUp(u) THEN up(u`1) ELSE
        eadd(eadd(eadd(up(u`1),down(u`1)),emul(down(u`1),up(M(u`1)))),
          emul(down(u`1),down(M(u`1)))) ENDIF

  legalToIndependent(c:LegalChoices(M,D)): IndependentChoices = LAMBDA(u:(D`nodes)):c(u)

  legalToIndependent_at: LEMMA FORALL(c:LegalChoices(M,D),u:(D`nodes)):
    legalToIndependent(c)(u)=c(u)

  legalToIndependent_injective: LEMMA injective?(legalToIndependent)

END ppg_hls_independent_choices
