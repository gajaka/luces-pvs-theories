% The first-violated schedule draws its initial state from table slot
% zero and follows the random-initialized MT execution. Pointwise equality
% of its label events and stopped work transfers the policy bounds to
% the native expectations.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Theorem 1.6, Algorithm 1 and Sections 3.1--3.3,
% arXiv:2111.06527. Robin A. Moser and Gabor Tardos, "A constructive
% proof of the general Lovasz Local Lemma", Section 2, arXiv:0903.0544.
% Lean counterpart: PPGraphHLSExpectation.lean, results 2--8.
ppg_hls_expectation[C,V,Value:TYPE,domain:[V->set[Value]],
  variableUniverse:{U:finite_set[V]|U=fullset[V]},
  default:C,universe:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING moser_tardos@ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:{q:MTProcess|FORALL(i:C):NativeStateSigma(spaces)(q`bad(i))},
  (IMPORTING local_lemmas@ppg_shearer_bdd[C,V,process`footprint])
  p:[C->real],
  (IMPORTING ppg_hls_matching[C,dependencyGraph,p])
  O:OverlapBounds,a:C]: THEORY
BEGIN
  IMPORTING ppg_hls_policy_expectation[C,V,Value,domain,variableUniverse,
      default,universe,spaces,laws,process,p,O] AS hlsExpectationPolicyBounds,
    moser_tardos@ppg_mt_policy_first[C,V,Value,domain,universe,
      ppg_mt_native_spaces[C,V,Value,domain].variableAmbient(spaces)] AS hlsExpectationFirstPolicy,
    moser_tardos@ppg_mt_policy_schedule[C,V,Value,domain,universe,
      ppg_mt_native_spaces[C,V,Value,domain].variableAmbient(spaces)] AS hlsExpectationSchedules,
    moser_tardos@ppg_mt_policy_expectation[C,V,Value,domain,universe,spaces,laws] AS hlsExpectationPolicyLaw,
    ppg_hls_policy_count_integral[C,V,Value,domain,process`footprint,
      universe,spaces,laws,badTest(process)] AS hlsExpectationCounts,
    moser_tardos@ppg_mt_time_expectation[C,V,Value,domain,spaces,laws] AS hlsExpectationNativeTime,
    moser_tardos@ppg_mt_termination[C,V,Value,domain,spaces,laws] AS hlsExpectationNativeTermination,
    moser_tardos@ppg_mt_log_probability[C,V,Value,domain,spaces,laws] AS hlsExpectationTableLaw,
    local_lemmas@ppg_shearer_bdd[C,V,process`footprint] AS hlsExpectationGraph,
    ppg_hls_matching[C,hlsExpectationGraph.dependencyGraph,p] AS hlsExpectationOverlap,
    local_lemmas@ppg_shearer_budget[C,hlsExpectationGraph.dependencyGraph] AS hlsExpectationStable,
    local_lemmas@ppg_shearer_slack[C,hlsExpectationGraph.dependencyGraph] AS hlsExpectationSlack,
    ppg_hls_policy_count_bound[C,V,Value,domain,variableUniverse,
      default,universe,spaces,laws,process,p,O,a] AS hlsExpectationLabelBound

  hprob: bool = hlsExpectationPolicyBounds.hprob

  hp: bool = hlsExpectationPolicyBounds.hp

  hInt: bool = hlsExpectationPolicyBounds.hInt

  assumptions: bool = hprob AND hp AND hInt

  criterion: bool = hlsExpectationPolicyBounds.criterion

  eventOrder: VAR hlsExpectationNativeTime.FullEnumeration

  t: VAR nat

  epsilon: VAR posreal

  firstSchedule(eventOrder): hlsExpectationSchedules.Schedule(process`footprint,badTest(process)) =
    hlsExpectationFirstPolicy.first(process`footprint,badTest(process),default,eventOrder)

  first_selected_events: LEMMA
    hlsExpectationCounts.nativeSelectedEvents(firstSchedule(eventOrder),a)(t)=
      hlsExpectationNativeTime.randomSelected(process`footprint,badTest(process),default,eventOrder,a)(t)

  first_expected_count: LEMMA
    hlsExpectationCounts.expectedCount(firstSchedule(eventOrder),a)=
      hlsExpectationNativeTime.randomInitExpectedResamplingCount(process`footprint,
        badTest(process),default,eventOrder,a)

  first_expected_work: LEMMA hlsExpectationPolicyBounds.expectedWork(firstSchedule(eventOrder))=
    hlsExpectationNativeTime.randomInitETLog(process`footprint,badTest(process),default,eventOrder)

  randomInitExpectedResamplingCount_le_tsum_refinedWeight: THEOREM
    assumptions IMPLIES ele(hlsExpectationNativeTime.randomInitExpectedResamplingCount(
      process`footprint,badTest(process),default,eventOrder,a),
      hlsExpectationLabelBound.properTotal)

  randomInitExpectedResamplingCount_le_stableBudget: THEOREM
    assumptions AND criterion IMPLIES
    ele(hlsExpectationNativeTime.randomInitExpectedResamplingCount(process`footprint,
      badTest(process),default,eventOrder,a),ofReal(hlsExpectationPolicyBounds.singletonBudget(a)))

  randomInitETLog_le_sum_stableBudget: THEOREM assumptions AND criterion IMPLIES
    ele(hlsExpectationNativeTime.randomInitETLog(process`footprint,badTest(process),default,eventOrder),
      ofReal(hlsExpectationPolicyBounds.totalBudget))

  randomInitETLog_lt_top: THEOREM assumptions AND criterion IMPLIES
    ennFinite?(hlsExpectationNativeTime.randomInitETLog(process`footprint,
      badTest(process),default,eventOrder))

  randomInitETLog_le_card_div_slack: THEOREM assumptions AND
    StrictCriterion(hlsExpectationSlack.dilated(epsilon,hlsExpectationOverlap.reduced(O)),universe) IMPLIES
    ele(hlsExpectationNativeTime.randomInitETLog(process`footprint,badTest(process),default,eventOrder),
      ofReal(finite_sets[C].card(universe)/epsilon))

  ae_randomInit_exists_good: THEOREM assumptions AND criterion IMPLIES
    ae?[ppg_mt_random_process[C,V,Value,domain].LogSpace,asNasa(NativeTableSigma(spaces)),nasaLaw](
      hlsExpectationNativeTermination.terminationEvent(process`footprint,badTest(process),
        default,eventOrder))

  logMeasure_randomInit_termination_eq_one: THEOREM assumptions AND criterion IMPLIES
    hlsExpectationTableLaw.logMeasure(hlsExpectationNativeTermination.terminationEvent(process`footprint,
      badTest(process),default,eventOrder))=1

END ppg_hls_expectation
