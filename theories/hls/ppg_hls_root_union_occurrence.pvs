% An active ordinal occurrence supplies its canonical execution DAG.
% The raw policy check and the measurable table check read the same
% coordinates. Process locality transfers the violated-event tests.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", Section 2, https://arxiv.org/abs/0903.0544v3
% Lean counterpart: PPGraphHLSRootUnion.lean,
% ordinalOccurrence_subset_rootUnion.
ppg_hls_root_union_occurrence[C,V,Value:TYPE,domain:[V->set[Value]],
  universe:{B:finite_set[C]|FORALL(a:C):B(a)},
  (IMPORTING moser_tardos@ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:MTProcess]: THEORY
BEGIN
  IMPORTING moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws] AS native,
    moser_tardos@ppg_mt_native_spaces[C,V,Value,domain] AS nativeSpaces,
    moser_tardos@ppg_mt_random_process[C,V,Value,domain] AS slots,
    local_lemmas@ppg_shearer_bdd[C,V,process`footprint] AS graph,
    ppg_hls_witness_dag[C,graph.dependencyGraph] AS dags,
    ppg_hls_table_events[C,V,Value,domain,spaces,laws,process] AS tables,
    moser_tardos@ppg_mt_check_measurable[C,V,Value,domain] AS reads,
    ppg_hls_table_check_core[C,V,Value,domain,process`footprint,
      native.badTest(process)] AS rawTables,
    ppg_hls_root_union_events[C,V,Value,domain,process`footprint,
      native.badTest(process)] AS rawUnion,
    ppg_hls_ordinal_occurrence[C,V,Value,domain,process`footprint,
      native.badTest(process)] AS ordinals,
    ppg_hls_real_dag[C,V,Value,domain,process`footprint,
      native.badTest(process)] AS execution,
    ppg_hls_policy_dag[C,V,Value,domain,process`footprint,
      native.badTest(process)] AS policyDags,
    moser_tardos@ppg_mt_policy_state[C,V,Value,domain] AS policy,
    moser_tardos@ppg_mt_correspondence[C,V,Value,domain] AS trajectory,
    moser_tardos@ppg_mt_stopped_events[C,V,Value,domain] AS stopped,
    measure_probability@ppg_finite_events[slots.LogSpace,[C,nat],nativeSpaces.NativeTableSigma(spaces)] AS meets,
    ppg_hls_root_union_measurable[C,V,Value,domain,universe,spaces,laws,process] AS unions

  fallback,a: VAR C

  enumeration: VAR list[C]

  r,t: VAR nat

  D: VAR dags.WitnessDAG

  u: VAR dags.WNode

  omega: VAR slots.LogSpace

  process_local_bad: LEMMA policyDags.localBad

  table_state_raw_equal: LEMMA tables.tableState(D,u)=rawTables.tableState(D,u)

  table_event_raw_equal: LEMMA tables.tableEvent(D,u)=rawTables.tableEvent(D,u)

  table_check_raw_equal: LEMMA tables.tableCheck(D)=rawTables.tableCheck(D)

  root_union_raw_equal: LEMMA unions.rootUnion(a,r)=rawUnion.rootUnion(a,r)

  occurrence_running: LEMMA stopped.randomInitResamplingEvent(process`footprint,
    native.badTest(process),fallback,enumeration,a,t)(omega) IMPLIES
    policy.Running(process`footprint,native.badTest(process),
      execution.realSchedule(fallback,enumeration,omega),omega,t+1)

  occurrence_label: LEMMA stopped.randomInitResamplingEvent(process`footprint,
    native.badTest(process),fallback,enumeration,a,t)(omega) IMPLIES
    execution.realSchedule(fallback,enumeration,omega)(t)=a

  occurrence_root: LEMMA stopped.randomInitResamplingEvent(process`footprint,
    native.badTest(process),fallback,enumeration,a,t)(omega) AND
    policyDags.earlierLabelCount(execution.realSchedule(fallback,enumeration,omega),t)=r
    IMPLIES policyDags.realRoot(execution.realSchedule(fallback,enumeration,omega),t)=(a,r)

  ordinalOccurrence_subset_rootUnion: THEOREM
    subset?(ordinals.ordinalOccurrence(fallback,enumeration,a,r),unions.rootUnion(a,r))

END ppg_hls_root_union_occurrence
