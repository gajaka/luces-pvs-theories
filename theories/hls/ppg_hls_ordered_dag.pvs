% A finite source set is embedded as labeled occurrence nodes. Filtering
% its ordered pairs and taking their image records exactly the chosen
% directions between dependent labels. Only the validity theorem needs
% a strict total order, and only on the source set used in the build.
%
% The witness representation follows Kun He, Qian Li and Xiaoming Sun,
% "Moser-Tardos Algorithm: Beyond Shearer's Bound", Definitions 2.1--2.4.
% https://arxiv.org/abs/2111.06527
% Lean counterpart: PPGraphHLSOrderedDAG.lean.
ppg_hls_ordered_dag[C,A:TYPE,G:{H:[C,C->bool]|(FORALL(i:C):NOT H(i,i)) AND
  (FORALL(i,j:C):H(i,j)=H(j,i))}]: THEORY
BEGIN
  IMPORTING ppg_hls_witness_dag[C,G], ppg_hls_reversal[[C,nat]] AS orderedPaths,
    foundations@ppg_finite_bind[A,[A,A]] AS orderedPairs
  S: VAR finite_set[A]
  labels: VAR [A->C]
  tags: VAR [A->nat]
  before: VAR [A,A->bool]
  a,b,c,d: VAR A
  e: VAR [A,A]
  u,v,w: VAR WNode

  embed(labels,tags)(a): WNode = (labels(a),tags(a))

  source_pair_eta: LEMMA (e`1,e`2)=e

  sourcePairs(S): finite_set[[A,A]] = orderedPairs.biUnion(S,
    LAMBDA(a:A):image[A,[A,A]](LAMBDA(b:A):(a,b),S))

  sourcePairs_member: LEMMA sourcePairs(S)(e) IFF S(e`1) AND S(e`2)

  allowedPair(labels,before)(e): bool =
    before(e`1,e`2) AND (labels(e`1)=labels(e`2) OR G(labels(e`1),labels(e`2)))

  build(S,labels,tags,before): WitnessDAG =
    (#nodes:=image[A,WNode](embed(labels,tags),S),
      arcs:=image[[A,A],[WNode,WNode]](
        LAMBDA(e:[A,A]):(embed(labels,tags)(e`1),embed(labels,tags)(e`2)),
        intersection(sourcePairs(S),allowedPair(labels,before)))#)

  localInjective(S,labels,tags): bool = FORALL(a,b:A):
    S(a) AND S(b) AND embed(labels,tags)(a)=embed(labels,tags)(b) IMPLIES a=b

  orderTransitive(S,before): bool = FORALL(a,b,c:A):
    S(a) AND S(b) AND S(c) AND before(a,b) AND before(b,c) IMPLIES before(a,c)

  orderIrreflexive(S,before): bool = FORALL(a:A):S(a) IMPLIES NOT before(a,a)

  orderTotal(S,before): bool = FORALL(a,b:A):
    S(a) AND S(b) AND a/=b IMPLIES before(a,b) OR before(b,a)

  local_injective_elim: LEMMA localInjective(S,labels,tags) AND S(a) AND S(b) AND
    embed(labels,tags)(a)=embed(labels,tags)(b) IMPLIES a=b

  order_transitive_elim: LEMMA orderTransitive(S,before) AND S(a) AND S(b) AND S(c) AND
    before(a,b) AND before(b,c) IMPLIES before(a,c)

  order_total_elim: LEMMA orderTotal(S,before) AND S(a) AND S(b) AND a/=b IMPLIES
    before(a,b) OR before(b,a)

  dependence_symmetric: LEMMA (labels(a)=labels(b) OR G(labels(a),labels(b))) IFF
    (labels(b)=labels(a) OR G(labels(b),labels(a)))

  node_iff: THEOREM build(S,labels,tags,before)`nodes(u) IFF
    EXISTS(a:A):S(a) AND embed(labels,tags)(a)=u

  node_intro: LEMMA S(a) IMPLIES build(S,labels,tags,before)`nodes(embed(labels,tags)(a))

  edge_witness: THEOREM Edge(build(S,labels,tags,before))(u,v) IFF
    EXISTS(a,b:A):S(a) AND S(b) AND embed(labels,tags)(a)=u AND
      embed(labels,tags)(b)=v AND before(a,b) AND (labels(a)=labels(b) OR G(labels(a),labels(b)))

  edge_embed: THEOREM localInjective(S,labels,tags) AND S(a) AND S(b) IMPLIES
    (Edge(build(S,labels,tags,before))(embed(labels,tags)(a),embed(labels,tags)(b)) IFF
      before(a,b) AND (labels(a)=labels(b) OR G(labels(a),labels(b))))

  edge_to_node: LEMMA localInjective(S,labels,tags) AND S(b) AND
    Edge(build(S,labels,tags,before))(u,embed(labels,tags)(b)) IMPLIES
    EXISTS(d:A):S(d) AND embed(labels,tags)(d)=u AND before(d,b)

  orderPathCase(S,labels,tags,before)(u,v): bool =
    EXISTS(a,b:A):S(a) AND S(b) AND embed(labels,tags)(a)=u AND
      embed(labels,tags)(b)=v AND before(a,b)

  order_case_single: LEMMA Edge(build(S,labels,tags,before))(u,v) IMPLIES
    orderPathCase(S,labels,tags,before)(u,v)

  order_case_trans: LEMMA localInjective(S,labels,tags) AND orderTransitive(S,before) AND
    orderPathCase(S,labels,tags,before)(u,v) AND orderPathCase(S,labels,tags,before)(v,w) IMPLIES
    orderPathCase(S,labels,tags,before)(u,w)

  transGen_order: THEOREM localInjective(S,labels,tags) AND orderTransitive(S,before) AND
    positivePath(build(S,labels,tags,before))(u,v) IMPLIES
    EXISTS(a,b:A):S(a) AND S(b) AND embed(labels,tags)(a)=u AND
      embed(labels,tags)(b)=v AND before(a,b)

  positive_path_bridge: LEMMA positivePath(build(S,labels,tags,before))(u,v) IFF
    orderedPaths.positivePath(Edge(build(S,labels,tags,before)))(u,v)

  ordered_path_from_node: LEMMA localInjective(S,labels,tags) AND orderTransitive(S,before) AND
    S(a) AND positivePath(build(S,labels,tags,before))(embed(labels,tags)(a),u) IMPLIES
    EXISTS(c:A):S(c) AND embed(labels,tags)(c)=u AND before(a,c)

  build_supported: LEMMA Edge(build(S,labels,tags,before))(u,v) IMPLIES
    build(S,labels,tags,before)`nodes(u) AND build(S,labels,tags,before)`nodes(v)

  build_acyclic: LEMMA localInjective(S,labels,tags) AND orderTransitive(S,before) AND
    orderIrreflexive(S,before) IMPLIES orderedPaths.Acyclic(Edge(build(S,labels,tags,before)))

  build_oriented: LEMMA localInjective(S,labels,tags) AND orderTotal(S,before) AND
    build(S,labels,tags,before)`nodes(u) AND build(S,labels,tags,before)`nodes(v) AND u/=v IMPLIES
    ((Edge(build(S,labels,tags,before))(u,v) OR Edge(build(S,labels,tags,before))(v,u)) IFF
      (u`1=v`1 OR G(u`1,v`1)))

  valid: THEOREM localInjective(S,labels,tags) AND orderIrreflexive(S,before) AND
    orderTransitive(S,before) AND orderTotal(S,before) IMPLIES Valid(build(S,labels,tags,before))
END ppg_hls_ordered_dag
