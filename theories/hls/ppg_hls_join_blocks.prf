    (|union| CONST-DECL "set" |sets| NIL)
    (|finite_intersection1| APPLICATION-JUDGEMENT "finite_set"
     |ppg_hls_join_blocks| NIL)
    (|finite_union| APPLICATION-JUDGEMENT "finite_set" |ppg_hls_join_blocks|
     NIL)
    (|join| CONST-DECL "UnionBlock" |ppg_measurable_block_union| NIL)
    (|decodeFull| CONST-DECL "AssemblyState" |ppg_hls_join_blocks| NIL)
    (|boolean| NONEMPTY-TYPE-DECL NIL |booleans| NIL)
    (|bool| NONEMPTY-TYPE-EQ-DECL NIL |booleans| NIL)
    (NOT CONST-DECL "[bool -> bool]" |booleans| NIL)
    (V FORMAL-TYPE-DECL NIL |ppg_hls_join_blocks| NIL)
    (|set| TYPE-EQ-DECL NIL |sets| NIL)
    (|is_finite| CONST-DECL "bool" |finite_sets| NIL)
    (|finite_set| TYPE-EQ-DECL NIL |finite_sets| NIL)
    (H FORMAL-CONST-DECL "finite_set[V]" |ppg_hls_join_blocks| NIL))
   SHOSTAK)))

