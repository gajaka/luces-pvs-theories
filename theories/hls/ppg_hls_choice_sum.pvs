% Validity supports the matching-arc endpoints, so the local up
% restrictions and LegalChoices are equivalent. The two maps below
% prove that equivalence before the finite product-of-sums is applied.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Appendix C. https://arxiv.org/abs/2111.06527
% Lean counterpart: tsum_legalChoiceWeight_eq in PPGraphHLSChoiceSum.lean.
ppg_hls_choice_sum[C:TYPE,G:{A:[C,C->bool]|(FORALL(i:C):NOT A(i,i)) AND
  (FORALL(i,j:C):A(i,j)=A(j,i))},
  (IMPORTING ppg_hls_choice_weights[C,G]) M:DependencyMatching,D:(Valid)]: THEORY
BEGIN
  IMPORTING ppg_hls_independent_choices[C,G,M,D],
    measure_probability@ppg_enn_product_domain[WNode,D`nodes] AS nodeDomain,
    measure_probability@ppg_enn_products[(D`nodes)] AS nodeProducts

  domainFamily: MACRO [(D`nodes)->finite_set[Choice]] = LAMBDA(u:(D`nodes)):localDomain(u)

  IMPORTING measure_probability@ppg_enn_dependent_product_sum[(D`nodes),Choice,nodeDomain.indexFull,domainFamily] AS assignments,
    finite_models@ppg_resampling_state_finite[(D`nodes),Choice,nodeDomain.indexFull,domainFamily] AS finiteAssignments

  up,down: VAR [C->ENN]
  c,d: VAR IndependentChoices
  u: VAR WNode

  matching_arc_supported: LEMMA FORALL(e:Arc):matchingArcs(M,D)(e) IMPLIES
    D`nodes(e`1) AND D`nodes(e`2)

  matching_nodes_supported: LEMMA arcNodes(matchingArcs(M,D))(u) IMPLIES D`nodes(u)

  independent_forced_up: LEMMA FORALL(c:IndependentChoices,u:(D`nodes)):
    forcedUp(u) IMPLIES c(u)=0

  independent_legal: LEMMA LegalExpansion(M,D,extendChoice(D)(c))

  independentToLegal(c): LegalChoices(M,D) = c

  independentToLegal_at: LEMMA FORALL(c:IndependentChoices,u:(D`nodes)):
    independentToLegal(c)(u)=c(u)

  independent_left_inverse: LEMMA legalToIndependent(independentToLegal(c))=c

  independent_right_inverse: LEMMA FORALL(k:LegalChoices(M,D)):
    independentToLegal(legalToIndependent(k))=k

  independentToLegal_injective: LEMMA injective?(independentToLegal)

  independentUniverse: finite_set[IndependentChoices] = finiteAssignments.allStates

  independentUniverse_full: LEMMA independentUniverse(c)

  legalUniverse: finite_set[LegalChoices(M,D)] =
    image[IndependentChoices,LegalChoices(M,D)](independentToLegal,independentUniverse)

  legalUniverse_full: LEMMA FORALL(k:LegalChoices(M,D)):legalUniverse(k)

  IMPORTING measure_probability@ppg_enn_finite_total[LegalChoices(M,D),legalUniverse] AS finiteLegal,
    measure_probability@ppg_enn_unrestricted_sum[LegalChoices(M,D)] AS legalWeights,
    measure_probability@ppg_nonneg_tsum[LegalChoices(M,D)] AS legalSums,
    measure_probability@ppg_nonneg_tsum[IndependentChoices] AS independentSums,
    measure_probability@ppg_enn_finite[LegalChoices(M,D)] AS legalFinite,
    measure_probability@ppg_enn_finite[IndependentChoices] AS independentFinite,
    foundations@ppg_monoid_image[IndependentChoices,LegalChoices(M,D),ENN,ennFinite(0),eadd] AS legalReindex

  familyFactor(up,down)(k:LegalChoices(M,D)): ENN = nodeProducts.eprod(nodeDomain.indexFull,
    LAMBDA(u:(D`nodes)):choiceWeight(M,up,down,u`1,k(u)))

  localTotal(up,down)(u:(D`nodes)): ENN = IF forcedUp(u) THEN up(u`1) ELSE
    eadd(eadd(eadd(up(u`1),down(u`1)),emul(down(u`1),up(M(u`1)))),
      emul(down(u`1),down(M(u`1)))) ENDIF

  legal_sum_reindex: LEMMA legalSums.esum(legalUniverse,familyFactor(up,down))=
    independentSums.esum(independentUniverse,LAMBDA(c:IndependentChoices):
      familyFactor(up,down)(independentToLegal(c)))

  local_sums_at: LEMMA FORALL(u:(D`nodes)):
    assignments.domainSums(LAMBDA(v:(D`nodes)):LAMBDA(ch:Choice):
      choiceWeight(M,up,down,v`1,ch))(u)=localTotal(up,down)(u)

  local_sums_function: LEMMA
    assignments.domainSums(LAMBDA(v:(D`nodes)):LAMBDA(ch:Choice):
      choiceWeight(M,up,down,v`1,ch))=localTotal(up,down)

  independent_product_of_sums: LEMMA
    independentSums.esum(independentUniverse,LAMBDA(c:IndependentChoices):
      familyFactor(up,down)(independentToLegal(c)))=
        nodeProducts.eprod(nodeDomain.indexFull,localTotal(up,down))

  tsum_legalChoiceWeight_eq: THEOREM legalWeights.eTsum(familyFactor(up,down))=
    nodeProducts.eprod(nodeDomain.indexFull,localTotal(up,down))

END ppg_hls_choice_sum
