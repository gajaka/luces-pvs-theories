% A pair event retains both original tests and excludes the swapped order
% when its relative coin is flip. The separate block bridge will identify
% these tests with the literal four-block coinChoice event.
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Lemma 3.4. Lean: PPGraphHLSAugmentedPair.lean.
ppg_hls_augmented_pair_events[C,V,Value:TYPE,domain:[V->set[Value]],
  default:C,universe:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING moser_tardos@ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:MTProcess]: THEORY
BEGIN
  IMPORTING moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws] AS native,
    ppg_hls_augmented_space[C,V,Value,domain,spaces,laws] AS aug,
    local_lemmas@ppg_shearer_bdd[C,V,process`footprint] AS graph,
    ppg_hls_witness_dag[C,graph.dependencyGraph] AS dags,
    ppg_hls_pair_keys[C,graph.dependencyGraph] AS keys,
    ppg_hls_reversal[[C,nat]] AS paths,
    ppg_hls_relative_coins[C,default,graph.dependencyGraph] AS coins,
    ppg_hls_fair_orientation AS fair,
    ppg_hls_clique_ranks[C,graph.dependencyGraph] AS ranks,
    ppg_hls_table_check_core[C,V,Value,domain,process`footprint,native.badTest(process)] AS raw,
    ppg_hls_swapped_tests[C,V,Value,domain,process`footprint,native.badTest(process)] AS swaps,
    ppg_hls_augmented_existence[C,V,Value,domain,process`footprint,
      native.badTest(process),universe] AS choices

  Arc: TYPE = [dags.WNode,dags.WNode]

  M: VAR keys.DependencyMatching

  D: VAR dags.WitnessDAG

  Q: VAR (dags.Valid)

  e: VAR Arc

  r: VAR dags.WNode

  omega: VAR aug.OriginalTable

  eta: VAR aug.AugTable

  pairCoin(M,D,e,eta): fair.OrientationCoin = coins.relativeCoin(M,e`1`1,
    aug.auxiliaryCoins(eta)((keys.matchPair(M,e`1`1),
      ranks.cliqueRank(D,keys.matchPair(M,e`1`1),e`1))))

  pairForward(D,e)(omega): bool = raw.tableEvent(D,e`1)(omega) AND
    raw.tableEvent(D,e`2)(omega)

  % The shared-footprint intersection is symmetric in the two endpoints.
  pairOpposite(D,e)(omega): bool =
    native.badTest(process)(e`1`1,swaps.swapShared(e`1,e`2)(
      raw.tableState(D,e`1)(omega),raw.tableState(D,e`2)(omega))) AND
    native.badTest(process)(e`2`1,swaps.swapShared(e`1,e`2)(
      raw.tableState(D,e`2)(omega),raw.tableState(D,e`1)(omega)))

  augmentedPairCheck(M,D,e): set[aug.AugTable] = {eta:aug.AugTable|
    pairForward(D,e)(aug.originalTable(eta)) AND
      (pairCoin(M,D,e,eta)=fair.orientationKeep OR
        NOT pairOpposite(D,e)(aug.originalTable(eta)))}

  coinLabels(M,eta)(K:finite_set[C],n:nat): C =
    coins.coinLabel(M,K,aug.auxiliaryCoins(eta)((K,n)))

  actualAugmentedCheck(M,r,D,eta): bool = choices.AugmentedCheck(
    M,coinLabels(M,eta),r,D,aug.originalTable(eta))

  augmented_table_check: LEMMA actualAugmentedCheck(M,r,D,eta) IMPLIES
    raw.tableCheck(D)(aug.originalTable(eta))

  matching_source_not_fixed: LEMMA M(e`1`1)=e`2`1 AND e`1`1/=e`2`1 IMPLIES
    M(e`1`1)/=e`1`1

  augmented_pair_flip_failure: LEMMA actualAugmentedCheck(M,r,Q,eta) AND
    dags.Edge(Q)(e`1,e`2) AND
    paths.Acyclic(paths.reverseArc(dags.Edge(Q),e`1,e`2)) AND
    M(e`1`1)=e`2`1 AND e`1`1/=e`2`1 AND pairCoin(M,Q,e,eta)=fair.orientationFlip
    IMPLIES NOT pairOpposite(Q,e)(aug.originalTable(eta))

  augmentedCheck_implies_pairCheck: LEMMA actualAugmentedCheck(M,r,Q,eta) AND
    dags.Edge(Q)(e`1,e`2) AND
    paths.Acyclic(paths.reverseArc(dags.Edge(Q),e`1,e`2)) AND
    M(e`1`1)=e`2`1 AND e`1`1/=e`2`1 IMPLIES augmentedPairCheck(M,Q,e)(eta)

END ppg_hls_augmented_pair_events
