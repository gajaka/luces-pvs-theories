% Each pair check reads two finite data blocks and one auxiliary coin.
% Equality on those actual coordinates determines the complete four-block
% value, and therefore the literal coin-choice event. No validity or
% measurability hypothesis is needed for these pointwise identities.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", proof of Lemma 3.4. Patrick Billingsley, Probability
% and Measure, third edition, Wiley, 1995: inverse images of events.
% Lean counterparts: PPGraphHLSAugmentedDependence.lean and
% PPGraphHLSAugmentedPair.lean.
ppg_hls_augmented_dependence[C,V,Value:TYPE,domain:[V->set[Value]],
  default:C,universe:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING moser_tardos@ppg_mt_native_spaces[C,V,Value,domain])
  spaces:ppg_mt_coordinate_laws[C,V,Value,domain].VariableSpaces,
  laws:ppg_mt_coordinate_laws[C,V,Value,domain].VariableLaws(spaces),
  (IMPORTING moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:ppg_mt_native_process[C,V,Value,domain,spaces,laws].MTProcess,
  (IMPORTING ppg_hls_table_coordinates[C,V,process`footprint])
  u,v:ppg_hls_witness_dag[C,
    ppg_shearer_bdd[C,V,process`footprint].dependencyGraph].WNode]: THEORY
  EXPORTING ALL WITH CLOSURE

BEGIN
  IMPORTING ppg_hls_pair_probability[C,V,Value,domain,spaces,laws,process,u,v] AS blocks,
    ppg_hls_augmented_pair_events[C,V,Value,domain,default,universe,
      spaces,laws,process] AS pairs,
    ppg_hls_unit_pair_block_equivalence[C,V,Value,domain,default,universe,
      spaces,laws,process,u,v] AS literal,
    ppg_hls_unit_event_dependence[C,V,Value,domain,default,universe,
      spaces,laws,process] AS depends,
    ppg_hls_augmented_space[C,V,Value,domain,spaces,laws] AS aug,
    ppg_hls_augmented_coordinates[C,V,process`footprint] AS coords,
    ppg_hls_table_coordinates[C,V,process`footprint] AS originalCoords,
    ppg_hls_table_events[C,V,Value,domain,spaces,laws,process] AS tables,
    local_lemmas@ppg_shearer_bdd[C,V,process`footprint] AS graph,
    ppg_hls_pair_keys[C,graph.dependencyGraph] AS keys,
    ppg_hls_reversal[[C,nat]] AS paths,
    ppg_hls_fair_orientation AS fair

  CoinFourValue: TYPE = [fair.OrientationCoin,blocks.FourValue]

  M: VAR keys.DependencyMatching

  D: VAR WitnessDAG

  Q: VAR (Valid)

  w,r: VAR WNode

  omega,tau: VAR aug.OriginalTable

  eta,theta: VAR aug.AugTable

  a: VAR V

  tableAgreement(D,w,omega,tau): bool = FORALL(p:[nat,V]):
    originalCoords.tableCoordinates(D,w)(p) IMPLIES omega(p)=tau(p)

  augmentedPairRead(M,D)(eta): CoinFourValue =
    (pairs.pairCoin(M,D,(u,v),eta),blocks.pairBlockRead(D)(aug.originalTable(eta)))

  coinChoice(x:CoinFourValue): bool =
    (x`1=fair.orientationKeep AND blocks.forwardEvent(x`2)) OR
    (x`1=fair.orientationFlip AND blocks.oneOrderOnly(x`2))

  augmentedPairCheck(M,D): set[aug.AugTable] =
    {eta:aug.AugTable|coinChoice(augmentedPairRead(M,D)(eta))}

  table_agreement_sample: LEMMA tableAgreement(D,w,omega,tau) AND
    process`footprint(w`1)(a) IMPLIES
      omega((originalCoords.localIndex(D,w)(a),a))=
        tau((originalCoords.localIndex(D,w)(a),a))

  source_private_read_eq: LEMMA tableAgreement(D,u,omega,tau) IMPLIES
    blocks.pairBlockRead(D)(omega)`1`1=blocks.pairBlockRead(D)(tau)`1`1

  target_private_read_eq: LEMMA tableAgreement(D,v,omega,tau) IMPLIES
    blocks.pairBlockRead(D)(omega)`1`2=blocks.pairBlockRead(D)(tau)`1`2

  source_shared_read_eq: LEMMA tableAgreement(D,u,omega,tau) IMPLIES
    blocks.pairBlockRead(D)(omega)`2`1=blocks.pairBlockRead(D)(tau)`2`1

  target_shared_read_eq: LEMMA tableAgreement(D,v,omega,tau) IMPLIES
    blocks.pairBlockRead(D)(omega)`2`2=blocks.pairBlockRead(D)(tau)`2`2

  pairBlockRead_eq_of_coordinates: THEOREM tableAgreement(D,u,omega,tau) AND
    tableAgreement(D,v,omega,tau) IMPLIES
      blocks.pairBlockRead(D)(omega)=blocks.pairBlockRead(D)(tau)

  originalTable_event_depends_on_dataCoordinates: THEOREM
    depends.agrees(coords.dataCoordinates(D,u),eta,theta) IMPLIES
      (tables.tableEvent(D,u)(aug.originalTable(eta)) IFF
        tables.tableEvent(D,u)(aug.originalTable(theta)))

  source_original_agreement: LEMMA
    depends.agrees(coords.pairCoordinates(M,D,(u,v)),eta,theta) IMPLIES
      tableAgreement(D,u,aug.originalTable(eta),aug.originalTable(theta))

  target_original_agreement: LEMMA
    depends.agrees(coords.pairCoordinates(M,D,(u,v)),eta,theta) IMPLIES
      tableAgreement(D,v,aug.originalTable(eta),aug.originalTable(theta))

  augmentedPairRead_eq_of_coordinates: THEOREM
    depends.agrees(coords.pairCoordinates(M,D,(u,v)),eta,theta) IMPLIES
      augmentedPairRead(M,D)(eta)=augmentedPairRead(M,D)(theta)

  augmentedPairCheck_depends_on_pairCoordinates: THEOREM
    depends.agrees(coords.pairCoordinates(M,D,(u,v)),eta,theta) IMPLIES
      (augmentedPairCheck(M,D)(eta) IFF augmentedPairCheck(M,D)(theta))

  augmentedPairCheck_eq_pointwise: LEMMA
    augmentedPairCheck(M,D)=pairs.augmentedPairCheck(M,D,(u,v))

  augmentedCheck_implies_pairCheck: THEOREM
    pairs.actualAugmentedCheck(M,r,Q,eta) AND Edge(Q)(u,v) AND
    paths.Acyclic(paths.reverseArc(Edge(Q),u,v)) AND
    M(u`1)=v`1 AND u`1/=v`1 IMPLIES augmentedPairCheck(M,Q)(eta)

END ppg_hls_augmented_dependence
