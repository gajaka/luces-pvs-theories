% Partitioning a finite node set by label turns each constant fiber
% product into a power. The actual finite label cover represents Fintype.
% No validity or matching premise is involved.
% Nicolas Bourbaki, Algebra I, Chapters 1--3, Springer, 1989.
% Lean counterpart: PPGraphHLSProductDiscount.prod_nodes_by_label.
ppg_hls_label_products[C,R:TYPE,unit:R,
  op:{f:[R,R->R]|identity?(f)(unit) AND associative?(f) AND commutative?(f)},
  universe:{U:finite_set[C]|FORALL(i:C):U(i)}]: THEORY
BEGIN
  IMPORTING foundations@ppg_finite_fiber_fold[[C,nat],C,R,unit,op] AS fibers,
    foundations@ppg_monoid_finite_power[[C,nat],R,unit,op] AS powers,
    foundations@ppg_monoid_sum[[C,nat],R,unit,op] AS nodes,
    foundations@ppg_monoid_sum[C,R,unit,op] AS labels

  N: VAR finite_set[[C,nat]]
  f: VAR [C->R]
  i: VAR C

  label_product: LEMMA
    nodes.sum(fibers.fiber(N,LAMBDA(u:[C,nat]):u`1,i),LAMBDA(u:[C,nat]):f(u`1))=
      powers.power(f(i),card(intersection(N,LAMBDA(u:[C,nat]):u`1=i)))

  prod_nodes_by_label: THEOREM nodes.sum(N,LAMBDA(u:[C,nat]):f(u`1))=
    labels.sum(universe,LAMBDA(i:C):powers.power(f(i),card(intersection(N,LAMBDA(u:[C,nat]):u`1=i))))

END ppg_hls_label_products
