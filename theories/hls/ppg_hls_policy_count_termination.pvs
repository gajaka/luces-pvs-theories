% A good state ends the active prefix, although the unstopped trajectory
% can change afterwards. Admissibility gives the converse: if no state is
% good, every time is active. Finite expected work therefore gives a good
% state almost surely under the original product-table law.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", Section 2; Patrick Billingsley, Probability and
% Measure, third edition, Wiley, 1995, almost-everywhere finiteness.
% Lean counterpart: PPGraphHLSPolicyCounting.lean, MTPolicy.
ppg_hls_policy_count_termination[C,V,Value:TYPE,domain:[V->set[Value]],
  footprint:[C->finite_set[V]],universe:{S:finite_set[C]|FORALL(a:C):S(a)},
  (IMPORTING moser_tardos@ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING moser_tardos@ppg_mt_check_probability[C,V,Value,domain,spaces,laws])bad:NativeBad]: THEORY
BEGIN
  IMPORTING ppg_hls_policy_count_integral[C,V,Value,domain,footprint,universe,spaces,laws,bad],
    moser_tardos@ppg_mt_policy_schedule[C,V,Value,domain,universe,variableAmbient(spaces)] AS terminationSchedule,
    moser_tardos@ppg_mt_policy_state[C,V,Value,domain] AS terminationPolicy,
    moser_tardos@ppg_mt_policy_expectation[C,V,Value,domain,universe,spaces,laws] AS terminationExpectation,
    measure_probability@ppg_integral_finiteness[LogSpace,NativeTableSigma(spaces),logMeasure] AS policyFiniteness,
    measure_probability@ppg_extended_integral[LogSpace,NativeTableSigma(spaces),logMeasure] AS terminationIntegral

  sig: VAR PolicySchedule
  omega: VAR LogSpace

  policyCountFunction(sig)(omega): ENN =
    terminationSchedule.tLog(footprint,bad,sig`select(omega),omega)

  terminationEvent(sig): set[LogSpace] = {omega:LogSpace|
    EXISTS(N:nat):goodAt(sig`select(omega),omega,N)}

  policy_schedule_admissible: LEMMA terminationPolicy.Admissible(footprint,bad,sig`select(omega),omega)

  native_policy_count_measurable: LEMMA measurable(NativeTableSigma(spaces),ENNSigma,policyCountFunction(sig))

  expected_work_count_integral: LEMMA terminationExpectation.expectedWork(footprint,bad,sig)=
    terminationIntegral.lintegral(policyCountFunction(sig))

  finite_event_termination: LEMMA ppg_enn_finiteness[LogSpace].finiteEvent(policyCountFunction(sig))=terminationEvent(sig)

  termination_event_measurable: LEMMA NativeTableSigma(spaces)(terminationEvent(sig))

  ae_exists_good_of_expectedWork_lt_top: THEOREM
    ennFinite?(terminationExpectation.expectedWork(footprint,bad,sig)) IMPLIES
    ae?[LogSpace,asNasa(NativeTableSigma(spaces)),nasaLaw](terminationEvent(sig))

  measure_termination_eq_one_of_expectedWork_lt_top: THEOREM
    ennFinite?(terminationExpectation.expectedWork(footprint,bad,sig)) IMPLIES
    logMeasure(terminationEvent(sig))=1

END ppg_hls_policy_count_termination
