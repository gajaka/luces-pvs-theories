    (|real| NONEMPTY-TYPE-FROM-DECL NIL |reals| NIL)
    (>= CONST-DECL "bool" |reals| NIL)
    (|nnreal| TYPE-EQ-DECL NIL |real_types| NIL)
    (|Mass| TYPE-EQ-DECL NIL |ppg_probability_measure| NIL)
    (|probability?| CONST-DECL "bool" |ppg_probability_measure| NIL)
    (|Probability| TYPE-EQ-DECL NIL |ppg_probability_measure| NIL)
    (|VariableLaws| TYPE-EQ-DECL NIL |ppg_mt_coordinate_laws| NIL)
    (|laws| FORMAL-CONST-DECL "VariableLaws(spaces)"
     |ppg_hls_join_three_probability| NIL)
    (|AssemblyState| TYPE-EQ-DECL NIL |ppg_hls_join_blocks| NIL)
    (|MTState| TYPE-EQ-DECL NIL |ppg_mt_semantics| NIL)
    (|NativeStateSigma| CONST-DECL
     "ppg_measurable_space[MTState[C, V, Value, domain]].MeasurableSpace"
     |ppg_mt_native_spaces| NIL)
    (= CONST-DECL "[T, T -> boolean]" |equalities| NIL)
    (|fullset| CONST-DECL "set" |sets| NIL)
    (|universe| FORMAL-CONST-DECL "{U: finite_set[V] | U = fullset[V]}"
     |ppg_hls_join_three_probability| NIL)
    (|StateEvent| TYPE-EQ-DECL NIL |ppg_hls_join_blocks_probability| NIL))
   SHOSTAK)))

