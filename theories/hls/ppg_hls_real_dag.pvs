% The counter-driven process starts from the table's slot-zero state.
% Its actual selection sequence specializes the policy witness DAG.
% Counter/cardinality and table-index identities identify the states;
% locality then transfers each violated-event test on an active prefix.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", Section 2; Kun He, Qian Li and Xiaoming Sun,
% "Moser-Tardos Algorithm: Beyond Shearer's Bound", Section 2.1.
% Lean counterpart: PPGraphHLSRealDAG.lean.
ppg_hls_real_dag[C,V,Value:TYPE,domain:[V->set[Value]],
  footprint:[C->finite_set[V]],
  (IMPORTING moser_tardos@ppg_mt_semantics[C,V,Value,domain])bad:[C,MTState->bool]]: THEORY
BEGIN
  IMPORTING ppg_hls_policy_dag[C,V,Value,domain,footprint,bad],
    moser_tardos@ppg_mt_correspondence[C,V,Value,domain] AS trajectory
  fallback: VAR C
  enumeration: VAR list[C]
  omega: VAR rawSlots.LogSpace
  t,n: VAR nat
  a: VAR V

  realSchedule(fallback,enumeration,omega): [nat->C] = LAMBDA(s:nat):
    realC(footprint,bad,fallback,enumeration,
      initialStateFromLog(omega),omega,s)

  realExecutionDAG(fallback,enumeration,omega,t): WitnessDAG =
    executionDAG(realSchedule(fallback,enumeration,omega),t)

  realWitnessDAG(fallback,enumeration,omega,t): WitnessDAG =
    realDAG(realSchedule(fallback,enumeration,omega),t)

  policy_state_is_real: LEMMA
    policy.policyState(footprint,realSchedule(fallback,enumeration,omega),omega,t)=
      randStep(footprint,bad,fallback,enumeration,
        initialStateFromLog(omega),omega,t)`1

  running_is_real: LEMMA
    policy.Running(footprint,bad,realSchedule(fallback,enumeration,omega),omega,n) IFF
      trajectory.RunningUntil(footprint,bad,fallback,enumeration,
        initialStateFromLog(omega),omega,n)

  execution_valid: THEOREM Valid(realExecutionDAG(fallback,enumeration,omega,t))

  execution_proper: THEOREM Proper(realExecutionDAG(fallback,enumeration,omega,t))

  real_valid: THEOREM Valid(realWitnessDAG(fallback,enumeration,omega,t))

  real_canonical: THEOREM Canonical(realWitnessDAG(fallback,enumeration,omega,t))

  real_proper: THEOREM Proper(realWitnessDAG(fallback,enumeration,omega,t))

  time_state_agrees: THEOREM t<n AND
    footprint(realSchedule(fallback,enumeration,omega)(t))(a) IMPLIES
      tableState(timeDAG(realSchedule(fallback,enumeration,omega),n),
        timeNode(realSchedule(fallback,enumeration,omega))(t))(omega)(a)=
          randStep(footprint,bad,fallback,enumeration,
            initialStateFromLog(omega),omega,t)`1(a)

  time_check_of_running: THEOREM localBad AND
    trajectory.RunningUntil(footprint,bad,fallback,enumeration,
      initialStateFromLog(omega),omega,n) IMPLIES
        tableCheck(timeDAG(realSchedule(fallback,enumeration,omega),n))(omega)

  execution_check_of_running: THEOREM localBad AND
    trajectory.RunningUntil(footprint,bad,fallback,enumeration,
      initialStateFromLog(omega),omega,t+1) IMPLIES
        tableCheck(realExecutionDAG(fallback,enumeration,omega,t))(omega)

  real_check_of_running: THEOREM localBad AND
    trajectory.RunningUntil(footprint,bad,fallback,enumeration,
      initialStateFromLog(omega),omega,t+1) IMPLIES
        tableCheck(realWitnessDAG(fallback,enumeration,omega,t))(omega)

  real_isProperCanonical: THEOREM
    properCanonicalFor(realWitnessDAG(fallback,enumeration,omega,t),
      realSchedule(fallback,enumeration,omega)(t))

END ppg_hls_real_dag
