% The HLS probability and intersection bounds give finite expected time
% for slot-zero initialization. A good state follows, and the constant-log
% descent then supplies an existential repair path from every initial state.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Theorem 1.6, arXiv:2111.06527.
% Lean counterpart: PPGraphHLSRepairBridge.lean.
ppg_hls_repair_bridge[C,V,Value:TYPE,domain:[V->set[Value]],
  variableUniverse:{U:finite_set[V]|U=fullset[V]},
  default:C,universe:{U:finite_set[C]|FORALL(i:C):U(i)},
  eventOrder:{e:list[C]|FORALL(i:C):member(i,e)},
  (IMPORTING moser_tardos@ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:{q:MTProcess|FORALL(i:C):NativeStateSigma(spaces)(q`bad(i))},
  (IMPORTING local_lemmas@ppg_shearer_bdd[C,V,process`footprint])
  p:[C->real],
  (IMPORTING ppg_hls_matching[C,dependencyGraph,p])
  O:OverlapBounds]: THEORY
BEGIN
  IMPORTING ppg_hls_expectation[C,V,Value,domain,variableUniverse,
      default,universe,spaces,laws,process,p,O,default] AS hlsRepairExpectation,
    moser_tardos@ppg_mt_termination[C,V,Value,domain,spaces,laws] AS hlsRepairTermination,
    moser_tardos@ppg_mt_time_expectation[C,V,Value,domain,spaces,laws] AS hlsRepairNativeTime,
    moser_tardos@ppg_mt_check_probability[C,V,Value,domain,spaces,laws] AS hlsRepairChecks,
    moser_tardos@ppg_mt_selection[C,V,Value,domain] AS hlsRepairSelection,
    moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws] AS hlsRepairNativeProcess,
    moser_tardos@ppg_mt_semantics[C,V,Value,domain] AS hlsRepairModel,
    moser_tardos@ppg_mt_repair_target[C,V,Value,domain,variableUniverse] AS hlsRepairTarget,
    moser_tardos@ppg_mt_reach[C,V,Value,domain] AS hlsRepairReach,
    ppg_core@ppg_repair_semantics[hlsRepairModel.MTState] AS hlsRepairSemantics,
    moser_tardos@ppg_mt_state_probability[C,V,Value,domain,variableUniverse,
      spaces,laws] AS hlsRepairStateLaw,
    local_lemmas@ppg_shearer_bdd[C,V,process`footprint] AS hlsRepairGraph,
    ppg_hls_matching[C,hlsRepairGraph.dependencyGraph,p] AS hlsRepairOverlap,
    local_lemmas@ppg_shearer_polynomial[C,hlsRepairGraph.dependencyGraph] AS hlsRepairPolynomial

  nativeBad: hlsRepairChecks.NativeBad = hlsRepairNativeProcess.badTest(process)

  hprob: bool = FORALL(i:C):hlsRepairStateLaw.stateMeasure(process`bad(i))=p(i)

  hp: bool = FORALL(i:C):0<p(i)

  hInt: bool = FORALL(i:C):O`delta(i)<=hlsRepairStateLaw.stateMeasure(
    intersection(process`bad(i),process`bad(O`mate(i))))

  criterion: bool = hlsRepairPolynomial.StrictCriterion(hlsRepairOverlap.reduced(O),universe)

  s: VAR hlsRepairModel.MTState

  edges: VAR [hlsRepairModel.MTState,hlsRepairModel.MTState->bool]

  process_well_formed: LEMMA
    hlsRepairModel.mt_wf(process`footprint,hlsRepairNativeProcess.badTest(process))

  enumeration_complete: LEMMA hlsRepairSelection.completeEnumeration(eventOrder)

  hls_finite_expectation: LEMMA hprob AND hp AND hInt AND criterion IMPLIES
    ennFinite?(hlsRepairNativeTime.randomInitETLog(process`footprint,nativeBad,
      default,eventOrder))

  good_state_exists: THEOREM hprob AND hp AND hInt AND criterion IMPLIES
    EXISTS(z:hlsRepairModel.MTState):
      hlsRepairSelection.MTGood(hlsRepairNativeProcess.badTest(process),z)

  good_repair_reachable: THEOREM hprob AND hp AND hInt AND criterion IMPLIES
    EXISTS(w:hlsRepairModel.MTState):
      hlsRepairReach.mtReach(process`footprint,hlsRepairNativeProcess.badTest(process),
        default,eventOrder)(s,w) AND
      hlsRepairSelection.MTGood(hlsRepairNativeProcess.badTest(process),w)

  mtRepairGraph_globally_repairable: THEOREM
    hprob AND hp AND hInt AND criterion IMPLIES
      hlsRepairSemantics.globally_repairable(hlsRepairReach.mtRepairGraph(process`footprint,
        hlsRepairNativeProcess.badTest(process),default,eventOrder,edges))

END ppg_hls_repair_bridge
