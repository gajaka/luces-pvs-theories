% For each matching pair, select the larger rank-parity class of its
% reversible arcs. Distinct selected arcs have disjoint endpoints, and
% every label retains at least half its participating nodes.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Proposition 3.2. https://arxiv.org/abs/2111.06527
% Lean counterpart: PPGraphHLSMatchingSelection.lean.
ppg_hls_matching_selection[C:TYPE,G:{A:[C,C->bool]|(FORALL(i:C):NOT A(i,i)) AND
  (FORALL(i,j:C):A(i,j)=A(j,i))}]: THEORY
BEGIN
  IMPORTING ppg_hls_pair_keys[C,G], ppg_hls_parity_selection[[C,nat]] AS parity,
    foundations@ppg_finite_bijection[[[C,nat],[C,nat]],[C,nat]] AS endpointImages,
    foundations@ppg_finite_bind[[[C,nat],[C,nat]],[C,nat]] AS arcEndpoints

  Arc: TYPE = [WNode,WNode]

  M: VAR DependencyMatching
  D: VAR WitnessDAG
  Q: VAR (Valid)
  i,j: VAR C
  e,f: VAR Arc
  E: VAR finite_set[Arc]
  u,v: VAR WNode

  matchingArcs(M,D): finite_set[Arc] = intersection(D`arcs,
    LAMBDA(e:Arc):M(e`1`1)=e`2`1 AND e`1`1/=e`2`1 AND
      dagPaths.Acyclic(dagPaths.reverseArc(Edge(D),e`1,e`2)))

  pairArcs(M,D,i): finite_set[Arc] = intersection(matchingArcs(M,D),
    LAMBDA(e:Arc):matchPair(M,e`1`1)=matchPair(M,i))

  selectedPairArcs(M,D,i): finite_set[Arc] = parity.largerParity(pairArcs(M,D,i),
    LAMBDA(u:WNode):cliqueRank(D,matchPair(M,i),u))

  % This is the existential membership of univ.biUnion, bounded by the
  % original finite arcs. The same definition works for an infinite C.
  selectedArcs(M,D): finite_set[Arc] = intersection(matchingArcs(M,D),
    LAMBDA(e:Arc):EXISTS(i:C):selectedPairArcs(M,D,i)(e))

  arcNodes(E): finite_set[WNode] = parity.endpoints(E)

  labelEndpoint(i)(e): WNode = IF e`1`1=i THEN e`1 ELSE e`2 ENDIF

  mem_pairArcs_data: THEOREM pairArcs(M,D,i)(e) IMPLIES
    Edge(D)(e`1,e`2) AND M(e`1`1)=e`2`1 AND e`1`1/=e`2`1 AND
    dagPaths.Acyclic(dagPaths.reverseArc(Edge(D),e`1,e`2)) AND
    matchPair(M,e`1`1)=matchPair(M,i)

  pairArc_labels_mem: THEOREM pairArcs(M,D,i)(e) IMPLIES
    matchPair(M,i)(e`1`1) AND matchPair(M,i)(e`2`1)

  pairArcs_eq_of_pair_eq: THEOREM matchPair(M,i)=matchPair(M,j) IMPLIES
    pairArcs(M,D,i)=pairArcs(M,D,j)

  selectedPairArcs_eq_of_pair_eq: THEOREM matchPair(M,i)=matchPair(M,j) IMPLIES
    selectedPairArcs(M,D,i)=selectedPairArcs(M,D,j)

  selectedPairArcs_subset: THEOREM subset?(selectedPairArcs(M,D,i),pairArcs(M,D,i))

  selectedPairArcs_half: THEOREM card(pairArcs(M,D,i))<=2*card(selectedPairArcs(M,D,i))

  selectedPairArcs_matching: LEMMA selectedPairArcs(M,D,i)(e) IMPLIES matchingArcs(M,D)(e)

  arcNodes_member: LEMMA arcNodes(E)(u) IFF
    EXISTS(e:Arc):E(e) AND (u=e`1 OR u=e`2)

  pairArcs_endpoint_data: LEMMA pairArcs(M,Q,i)(e) AND
    (u=e`1 OR u=e`2) IMPLIES Q`nodes(u) AND matchPair(M,i)(u`1)

  pairArcs_node_data: LEMMA parity.endpoints(pairArcs(M,Q,i))(u) IMPLIES
    Q`nodes(u) AND matchPair(M,i)(u`1)

  pairArcs_rank_injective: LEMMA parity.rankInjective(pairArcs(M,Q,i),
    LAMBDA(u:WNode):cliqueRank(Q,matchPair(M,i),u))

  pairArcs_consecutive: LEMMA parity.consecutive(pairArcs(M,Q,i),
    LAMBDA(u:WNode):cliqueRank(Q,matchPair(M,i),u))

  selectedPairArcs_endpoints_disjoint: THEOREM selectedPairArcs(M,Q,i)(e) AND
    selectedPairArcs(M,Q,i)(f) AND e/=f IMPLIES
      disjoint?(parity.edgeVertices(e),parity.edgeVertices(f))

  selectedArcs_subset: THEOREM subset?(selectedArcs(M,D),matchingArcs(M,D))

  selectedArcs_member: LEMMA selectedArcs(M,D)(e) IFF
    EXISTS(i:C):selectedPairArcs(M,D,i)(e)

  selectedArcs_intro: LEMMA selectedPairArcs(M,D,i)(e) IMPLIES selectedArcs(M,D)(e)

  pairArc_endpoint_keys: LEMMA pairArcs(M,D,i)(e) IMPLIES
    matchPair(M,e`1`1)=matchPair(M,i) AND matchPair(M,e`2`1)=matchPair(M,i)

  selectedArcs_endpoints_disjoint: THEOREM selectedArcs(M,Q)(e) AND
    selectedArcs(M,Q)(f) AND e/=f IMPLIES
      disjoint?(parity.edgeVertices(e),parity.edgeVertices(f))

  labelEndpoint_mem: THEOREM parity.edgeVertices(e)(labelEndpoint(i)(e))

  labelEndpoint_label: THEOREM pairArcs(M,D,i)(e) IMPLIES labelEndpoint(i)(e)`1=i

  selected_labelEndpoint_injective: THEOREM
    endpointImages.injOn(labelEndpoint(i),selectedPairArcs(M,Q,i))

  matchingArc_at_label: LEMMA matchingArcs(M,D)(e) AND (u=e`1 OR u=e`2) AND
    u`1=i IMPLIES pairArcs(M,D,i)(e) AND labelEndpoint(i)(e)=u

  incident_labelNodes_subset_image: THEOREM
    subset?(intersection(arcNodes(matchingArcs(M,D)),LAMBDA(u:WNode):u`1=i),
      image(labelEndpoint(i),pairArcs(M,D,i)))

  selected_endpoint_image_subset: THEOREM
    subset?(image(labelEndpoint(i),selectedPairArcs(M,D,i)),
      intersection(arcNodes(selectedArcs(M,D)),LAMBDA(u:WNode):u`1=i))

  selectedArcs_half_incident_nodes: THEOREM
    card(intersection(arcNodes(matchingArcs(M,Q)),LAMBDA(u:WNode):u`1=i))<=
      2*card(intersection(arcNodes(selectedArcs(M,Q)),LAMBDA(u:WNode):u`1=i))

END ppg_hls_matching_selection
