% An HLS certificate records measurable bad events, their probabilities,
% positive marginal weights, matching overlap bounds and the strict reduced
% Shearer criterion. Its consequences are incompatible with infeasibility
% certificates and minimal conflict cores for the same MT process.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Theorem 1.6, arXiv:2111.06527.
% Lean counterpart: PPGraphHLSDecisionBridge.lean, first seven results.
ppg_hls_decision_bridge[C,V,Value:TYPE,domain:[V->set[Value]],
  variableUniverse:{U:finite_set[V]|U=fullset[V]},
  default:C,universe:{U:finite_set[C]|FORALL(i:C):U(i)},
  eventOrder:{e:list[C]|FORALL(i:C):member(i,e)},
  (IMPORTING moser_tardos@ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:MTProcess]: THEORY
BEGIN
  IMPORTING moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws] AS hlsDecisionNativeProcess,
    moser_tardos@ppg_mt_semantics[C,V,Value,domain] AS hlsDecisionModel,
    moser_tardos@ppg_mt_selection[C,V,Value,domain] AS hlsDecisionSelection,
    decision@ppg_infeasibility[hlsDecisionModel.MTState,C] AS hlsDecisionInfeasibility,
    moser_tardos@ppg_mt_infeasibility[C,V,Value,domain,variableUniverse,universe] AS hlsDecisionFeasibility,
    moser_tardos@ppg_mt_state_probability[C,V,Value,domain,variableUniverse,
      spaces,laws] AS hlsDecisionStateLaw,
    moser_tardos@ppg_mt_reach[C,V,Value,domain] AS hlsDecisionReach,
    decision@ppg_repair_regions[hlsDecisionModel.MTState,C] AS hlsDecisionRegions,
    decision@ppg_unsatisfiable_core[hlsDecisionModel.MTState,C] AS hlsDecisionCores,
    local_lemmas@ppg_shearer_bdd[C,V,process`footprint] AS hlsDecisionGraph,
    local_lemmas@ppg_shearer_polynomial[C,hlsDecisionGraph.dependencyGraph] AS hlsDecisionPolynomial,
    ppg_hls_repair_bridge

  badMeasurable: bool = FORALL(i:C):NativeStateSigma(spaces)(process`bad(i))

  HLSCertified: bool = IF badMeasurable THEN
    EXISTS(p:[C->real]):
      (FORALL(i:C):hlsDecisionStateLaw.stateMeasure(process`bad(i))=p(i)) AND
      (FORALL(i:C):0<p(i)) AND
      (EXISTS(O:ppg_hls_matching[C,hlsDecisionGraph.dependencyGraph,p].OverlapBounds):
        (FORALL(i:C):O`delta(i)<=hlsDecisionStateLaw.stateMeasure(
          intersection(process`bad(i),process`bad(O`mate(i))))) AND
        hlsDecisionPolynomial.StrictCriterion(
          ppg_hls_matching[C,hlsDecisionGraph.dependencyGraph,p].reduced(O),universe))
    ELSE FALSE ENDIF

  s: VAR hlsDecisionModel.MTState

  K: VAR finite_set[C]

  edges: VAR [hlsDecisionModel.MTState,hlsDecisionModel.MTState->bool]

  earlier: VAR bool

  hlsCertified_good_exists: THEOREM HLSCertified IMPLIES
    EXISTS(z:hlsDecisionModel.MTState):hlsDecisionSelection.MTGood(hlsDecisionNativeProcess.badTest(process),z)

  hlsCertified_satisfiable: THEOREM HLSCertified IMPLIES
    hlsDecisionInfeasibility.Satisfiable(fullset[hlsDecisionModel.MTState],
      hlsDecisionFeasibility.mtSat(hlsDecisionNativeProcess.badTest(process)),universe)

  hlsCertified_repair_reachable: THEOREM HLSCertified IMPLIES
    EXISTS(w:hlsDecisionModel.MTState):hlsDecisionReach.mtReach(process`footprint,
      hlsDecisionNativeProcess.badTest(process),default,eventOrder)(s,w) AND
      hlsDecisionSelection.MTGood(hlsDecisionNativeProcess.badTest(process),w)

  infeasible_excludes_hlsCertified: THEOREM
    hlsDecisionInfeasibility.Infeasible(fullset[hlsDecisionModel.MTState],
      hlsDecisionFeasibility.mtSat(hlsDecisionNativeProcess.badTest(process)),universe) IMPLIES
      NOT HLSCertified

  hlsCertified_excludes_all_cores: THEOREM HLSCertified IMPLIES
    NOT hlsDecisionCores.MinimalCore(fullset[hlsDecisionModel.MTState],
      hlsDecisionFeasibility.mtSat(hlsDecisionNativeProcess.badTest(process)),K)

  hlsCertified_excludes_noReachableGood: THEOREM HLSCertified IMPLIES
    NOT hlsDecisionInfeasibility.NoReachableGood(hlsDecisionReach.mtRepairGraph(process`footprint,
      hlsDecisionNativeProcess.badTest(process),default,eventOrder,edges),s)

  hls_extension_gap_iff: THEOREM
    hlsDecisionRegions.Gap(fullset[hlsDecisionModel.MTState],hlsDecisionFeasibility.mtSat(hlsDecisionNativeProcess.badTest(process)),
      universe,earlier OR HLSCertified) IFF
    (hlsDecisionRegions.Gap(fullset[hlsDecisionModel.MTState],hlsDecisionFeasibility.mtSat(hlsDecisionNativeProcess.badTest(process)),
      universe,earlier) AND NOT HLSCertified)

END ppg_hls_decision_bridge
