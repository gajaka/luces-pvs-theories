% Renaming a finite set of occurrences preserves its label product in
% every commutative monoid. Validity supplies injectivity of the names;
% the operation itself has no numerical or positivity restriction.
%
% Lean counterpart: PPGraphHLSNormalization.prod_normalize_nodes.
% Finite products are the finite fold of the supplied monoid operation.
ppg_hls_normalization_product[C,R:TYPE,
  G:{A:[C,C->bool]|(FORALL(i:C):NOT A(i,i)) AND
    (FORALL(i,j:C):A(i,j)=A(j,i))},unit:R,
  op:{f:[R,R->R]|identity?(f)(unit) AND associative?(f) AND commutative?(f)}]: THEORY
BEGIN
  IMPORTING ppg_hls_normalization[C,G],
    foundations@ppg_monoid_image[[C,nat],[C,nat],R,unit,op] AS renameProduct,
    foundations@ppg_monoid_sum[[C,nat],R,unit,op] AS labelProduct
  Q: VAR (Valid)
  p: VAR [C->R]

  prod_normalize_nodes: THEOREM
    labelProduct.sum(normalize(Q)`nodes,LAMBDA(u:WNode):p(u`1))=
      labelProduct.sum(Q`nodes,LAMBDA(u:WNode):p(u`1))
END ppg_hls_normalization_product
