% Each rooted unit event has its coordinate-product probability. The
% refined bound compares these probabilities pointwise. Unrestricted
% nonnegative sums preserve the bound, including infinity and an empty
% rooted family.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Lemma 3.4 and Theorem 3.13, arXiv:2111.06527.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_hls_root_refined_probability[C,V,Value:TYPE,domain:[V->set[Value]],
  variableUniverse:{U:finite_set[V]|U=fullset[V]},
  default:C,universe:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING moser_tardos@ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:{q:MTProcess|FORALL(i:C):
    ppg_mt_native_spaces[C,V,Value,domain].NativeStateSigma(spaces)(q`bad(i))},
  (IMPORTING local_lemmas@ppg_shearer_bdd[C,V,process`footprint])
  p:[C->real],
  (IMPORTING ppg_hls_matching[C,
    ppg_shearer_bdd[C,V,process`footprint].dependencyGraph,p])
  O:OverlapBounds,alpha:C,r:nat]: THEORY
BEGIN
  IMPORTING ppg_hls_root_union_measure[C,V,Value,domain,default,universe,
      spaces,laws,process,alpha,r] AS rootMass,
    ppg_hls_root_family_weight[C,
      ppg_shearer_bdd[C,V,process`footprint].dependencyGraph,universe,alpha] AS weights,
    ppg_hls_root_family_weight_at[C,
      ppg_shearer_bdd[C,V,process`footprint].dependencyGraph,universe,alpha,r] AS atRoot,
    ppg_hls_product_discount[C,
      ppg_shearer_bdd[C,V,process`footprint].dependencyGraph,p,universe] AS rootDiscount,
    ppg_hls_refined_weight[C,
      ppg_shearer_bdd[C,V,process`footprint].dependencyGraph,p] AS rootRefined,
    ppg_hls_unit_checks[C,V,Value,domain,default,universe,
      spaces,laws,process] AS rootUnits,
    ppg_hls_root_union_measurable[C,V,Value,domain,universe,
      spaces,laws,process] AS unions,
    ppg_hls_augmented_space[C,V,Value,domain,spaces,laws] AS rootAug,
    moser_tardos@ppg_mt_log_probability[C,V,Value,domain,spaces,laws] AS rootOriginalLaw,
    moser_tardos@ppg_mt_state_probability[C,V,Value,domain,variableUniverse,
      spaces,laws] AS rootStateLaw,
    ppg_hls_table_events[C,V,Value,domain,spaces,laws,process] AS rootTables,
    measure_probability@ppg_enn_unrestricted_sum[rootMass.Family] AS rootedSum,
    measure_probability@ppg_enn_finite_order[rootMass.Family] AS rootedOrder,
    ppg_hls_refined_probability

  hprob: bool = FORALL(i:C):rootStateLaw.stateMeasure(process`bad(i))=p(i)

  hp: bool = FORALL(i:C):0<p(i)

  hInt: bool = FORALL(i:C):O`delta(i)<=rootStateLaw.stateMeasure(
    intersection(process`bad(i),process`bad(O`mate(i))))

  D: VAR rootMass.Family

  unitWeight(D): ENN = ennFinite(rootAug.augmentedMeasure(rootUnits.unitCheck(O`mate,D)))

  refinedWeightAt(D): ENN = rootRefined.refinedWeight(O)(D)

  process_bad_measurable: LEMMA rootTables.badMeasurable

  rooted_unit_refined: LEMMA hprob AND hp AND hInt IMPLIES
    ele(unitWeight(D),refinedWeightAt(D))

  rooted_sum_refined: LEMMA hprob AND hp AND hInt IMPLIES
    ele(rootedSum.eTsum(unitWeight),rootedSum.eTsum(refinedWeightAt))

  exact_rooted_weight_sum: LEMMA
    rootedSum.eTsum(refinedWeightAt)=weights.rootFamilyWeight(rootRefined.refinedWeight(O))(r)

  root_union_le_refined: THEOREM hprob AND hp AND hInt IMPLIES
    ele(ennFinite(rootOriginalLaw.logMeasure(unions.rootUnion(alpha,r))),
      weights.rootFamilyWeight(rootRefined.refinedWeight(O))(r))

END ppg_hls_root_refined_probability
