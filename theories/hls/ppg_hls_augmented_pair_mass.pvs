% A measurable target event is evaluated by its actual read preimage.
% The established image law therefore identifies the augmented event mass
% with the fair-coin and four-block product mass, without any saving bound.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995:
% image measures. Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm:
% Beyond Shearer's Bound", proof of Lemma 3.4.
ppg_hls_augmented_pair_mass[C,V,Value:TYPE,domain:[V->set[Value]],
  default:C,universe:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING moser_tardos@ppg_mt_native_spaces[C,V,Value,domain])
  spaces:ppg_mt_coordinate_laws[C,V,Value,domain].VariableSpaces,
  laws:ppg_mt_coordinate_laws[C,V,Value,domain].VariableLaws(spaces),
  (IMPORTING moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:ppg_mt_native_process[C,V,Value,domain,spaces,laws].MTProcess,
  (IMPORTING ppg_hls_table_coordinates[C,V,process`footprint])
  u,v:ppg_hls_witness_dag[C,
    ppg_shearer_bdd[C,V,process`footprint].dependencyGraph].WNode,
  (IMPORTING ppg_hls_pair_keys[C,
    ppg_shearer_bdd[C,V,process`footprint].dependencyGraph])
  matching:ppg_hls_pair_keys[C,
    ppg_shearer_bdd[C,V,process`footprint].dependencyGraph].DependencyMatching,
  dag:ppg_hls_witness_dag[C,
    ppg_shearer_bdd[C,V,process`footprint].dependencyGraph].WitnessDAG]: THEORY
BEGIN
  IMPORTING ppg_hls_augmented_pair_law[C,V,Value,domain,default,universe,
      spaces,laws,process,u,v,matching,dag] AS massLaw,
    ppg_hls_augmented_dependence[C,V,Value,domain,default,universe,
      spaces,laws,process,u,v] AS reads,
    ppg_hls_pair_probability[C,V,Value,domain,spaces,laws,process,u,v] AS blocks,
    ppg_hls_augmented_space[C,V,Value,domain,spaces,laws] AS aug,
    ppg_hls_fair_orientation AS fair

  F: MACRO finite_set[V] = blocks.F

  H: MACRO finite_set[V] = blocks.H

  Z: MACRO finite_set[V] = blocks.Z

  IMPORTING measure_probability@ppg_probability_four_product[(F),(H),(Z),Value,
      LAMBDA(a:(F)):domain(a),LAMBDA(a:(H)):domain(a),LAMBDA(a:(Z)):domain(a),
      blocks.universeF,blocks.universeH,blocks.universeZ,
      LAMBDA(a:(F)):spaces(a),LAMBDA(a:(H)):spaces(a),LAMBDA(a:(Z)):spaces(a),
      LAMBDA(a:(F)):laws(a),LAMBDA(a:(H)):laws(a),LAMBDA(a:(Z)):laws(a)] AS four,
    measure_probability@ppg_probability_pair[fair.OrientationCoin,blocks.FourValue,
      fair.OrientationSigma,four.ResultSigma] AS resultLaw

  CoinFourSigma: MACRO ppg_measurable_space[reads.CoinFourValue].MeasurableSpace =
    resultLaw.JointSpace

  IMPORTING measure_probability@ppg_measurable_map[aug.AugTable,reads.CoinFourValue] AS readMaps,
    measure_probability@ppg_probability_map[aug.AugTable,reads.CoinFourValue,
      aug.AugSigma,CoinFourSigma] AS readPush

  E: VAR (CoinFourSigma)

  law_sigma_eq: LEMMA massLaw.CoinFourSigma=CoinFourSigma

  actual_read_measurable: LEMMA readMaps.measurable(
    aug.AugSigma,CoinFourSigma,reads.augmentedPairRead(matching,dag))

  pair_check_preimage: LEMMA reads.augmentedPairCheck(matching,dag)=
    readMaps.inverseImage(reads.augmentedPairRead(matching,dag),reads.coinChoice)

  typed_event_mass: THEOREM Valid(dag) AND Edge(dag)(u,v) IMPLIES
    aug.augmentedMeasure(readMaps.inverseImage(
      reads.augmentedPairRead(matching,dag),E))=
        resultLaw.productLaw(fair.fairOrientation,four.nestedLaw)(E)

END ppg_hls_augmented_pair_mass
