% On a finite variable universe, each fixed read has the product state
% law. Disjoint node-coordinate blocks then make the DAG-check probability
% exactly the product of the individual bad-event probabilities.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Section 3.1.
% https://arxiv.org/abs/2111.06527
% Lean counterpart: the two probability theorems of PPGraphHLSTableCheck.lean.
% The measurable-process and finite-variable conditions occur here only;
% neither is a premise of the preceding combinatorial statements.
ppg_hls_table_probability[C,V,Value:TYPE,domain:[V->set[Value]],
  universe:{F:finite_set[V]|F=fullset[V]},
  (IMPORTING moser_tardos@ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING moser_tardos@ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:{P:MTProcess|FORALL(i:C):NativeStateSigma(spaces)(P`bad(i))}]: THEORY
BEGIN
  IMPORTING moser_tardos@ppg_mt_random_process[C,V,Value,domain] AS probabilitySlots,
    moser_tardos@ppg_mt_semantics[C,V,Value,domain] AS probabilityStates,
    moser_tardos@ppg_mt_check_measurable[C,V,Value,domain] AS probabilityReads,
    moser_tardos@ppg_mt_native_spaces[C,V,Value,domain] AS probabilitySpaces,
    moser_tardos@ppg_mt_state_probability[C,V,Value,domain,universe,spaces,laws] AS stateLaw,
    moser_tardos@ppg_mt_log_probability[C,V,Value,domain,spaces,laws] AS tableLaw,
    moser_tardos@ppg_mt_log_family[C,V,Value,[C,nat],domain,spaces,laws] AS nodeLaw,
    local_lemmas@ppg_shearer_bdd[C,V,process`footprint] AS probabilityGraph,
    ppg_hls_witness_dag[C,probabilityGraph.dependencyGraph],
    ppg_hls_table_coordinates[C,V,process`footprint] AS probabilityCoordinates,
    ppg_hls_table_events[C,V,Value,domain,spaces,laws,process] AS probabilityEvents,
    measure_probability@ppg_probability_map[probabilitySlots.LogSpace,probabilityStates.MTState,
      probabilitySpaces.NativeTableSigma(spaces),probabilitySpaces.NativeStateSigma(spaces)] AS readPush,
    measure_probability@ppg_measurable_map[probabilitySlots.LogSpace,probabilityStates.MTState] AS probabilityMaps,
    measure_probability@ppg_probability_event_product[probabilitySlots.LogSpace,[C,nat],
      probabilitySpaces.NativeTableSigma(spaces)] AS nodeFactors,
    foundations@ppg_finite_product[[C,nat]] AS nodeProduct
  D: VAR WitnessDAG
  Q: VAR (Valid)
  u,v: VAR WNode

  process_bad_measurable: LEMMA probabilityEvents.badMeasurable

  nodeEvents(D): nodeLaw.LogEvents = LAMBDA(u:WNode):probabilityEvents.tableEvent(D,u)

  nodeBlocks(D)(u): set[[nat,V]] = probabilityCoordinates.tableCoordinates(D,u)

  nodeWeights(D)(u): real = stateLaw.stateMeasure(process`bad(u`1))

  table_event_preimage: LEMMA probabilityEvents.tableEvent(D,u)=
    probabilityMaps.inverseImage(probabilityReads.readAt(probabilityCoordinates.localIndex(D,u)),process`bad(u`1))

  logMeasure_tableEvent_eq_pi: THEOREM
    tableLaw.logMeasure(probabilityEvents.tableEvent(D,u))=stateLaw.stateMeasure(process`bad(u`1))

  node_event_factors: LEMMA nodeFactors.eventFactors(tableLaw.logMeasure,nodeEvents(D))=nodeWeights(D)

  node_blocks_disjoint: LEMMA FORALL(u,v:WNode):Q`nodes(u) AND Q`nodes(v) AND u/=v
    IMPLIES disjoint?(nodeBlocks(Q)(u),nodeBlocks(Q)(v))

  node_event_depends: LEMMA nodeLaw.logDepends(nodeBlocks(D)(u),nodeEvents(D)(u))

  table_check_meet: LEMMA probabilityEvents.tableCheck(D)=
    ppg_finite_events[probabilitySlots.LogSpace,[C,nat],probabilitySpaces.NativeTableSigma(spaces)].finiteMeet(
      D`nodes,nodeEvents(D))

  logMeasure_tableCheck_eq_prod: THEOREM
    tableLaw.logMeasure(probabilityEvents.tableCheck(Q))=nodeProduct.product(Q`nodes,nodeWeights(Q))
END ppg_hls_table_probability
