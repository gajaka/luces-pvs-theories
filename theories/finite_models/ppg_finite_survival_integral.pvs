% Moving one unit of the killed horizon through the conditional law
% preserves the stopped integral. Iterating reaches the indicator of the
% running event. This identifies its original finite measure exactly;
% normalization is used only in the fixed-initial-state corollary.
%
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, Lemma 1.13, American Mathematical Society, 2017.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_finite_survival_integral[State,Omega: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  (IMPORTING measure_probability@ppg_nasa_sigma[Omega]) S:MeasurableSpace,
  (IMPORTING measure_probability@ppg_finite_law_view[Omega,S]) measureLaw:FiniteLaw,
  (IMPORTING measure_probability@ppg_filtration[Omega,State,S]) history:Filtration]: THEORY
BEGIN
  IMPORTING ppg_finite_survival_conditional[State,Omega,universe,S,measureLaw,history]
  M: VAR Model
  X: VAR AdaptedProcess
  f: VAR Vector
  n,N: VAR nat
  s0: VAR State

  stopped_survival_indicator: LEMMA stoppedNativeValue(M,survivalVector(M,0),X,n)=
    indicator(runningAmbient(M,X,n))

  stopped_survival_native_initial: LEMMA stoppedNativeValue(M,survivalVector(M,N),X,0)=
    integrableValue(survivalVector(M,N),ambientState(X,0))

  stopped_survival_integral_horizon: THEOREM FORALL(M:Model,X:Realization(M),n,N:nat):
    stoppedMean(M,survivalVector(M,N),X,n)=mass(runningAmbient(M,X,n+N))

  running_measure_eq_survival: THEOREM FORALL(M:Model,X:Realization(M),N:nat):
    ennFinite(mass(runningAmbient(M,X,N)))=
      ofReal(integral(integrableValue(survivalVector(M,N),ambientState(X,0))))

  fixed_value_function: LEMMA (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES
    integrableValue(f,ambientState(X,0))=constant(f(s0))

  fixed_state_integral: LEMMA mass(fullset[Omega])=1 AND
    (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES
      integral(integrableValue(f,ambientState(X,0)))=f(s0)

  running_measure_fixed_eq_survival: THEOREM FORALL(M:Model,X:Realization(M),s0:State,N:nat):
    mass(fullset[Omega])=1 AND (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES
      ennFinite(mass(runningAmbient(M,X,N)))=ofReal(survival(M,N,s0))

END ppg_finite_survival_integral
