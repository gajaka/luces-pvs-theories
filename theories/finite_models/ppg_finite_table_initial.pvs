% The initializer that reads slot zero depends only on those entries.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Section 2.
ppg_finite_table_initial[V,Value:TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]]]: THEORY
BEGIN
  plainDomain: MACRO [V->set[Value]] = LAMBDA(v:V):domains(v)

  IMPORTING ppg_finite_table_core[V,Value,variables,domains] AS initialTable,
    moser_tardos@ppg_mt_random_process[bool,V,Value,plainDomain] AS initialSlots

  initialStateFromLog_local: THEOREM initialTable.InitialLocal(initialSlots.initialStateFromLog)

END ppg_finite_table_initial
