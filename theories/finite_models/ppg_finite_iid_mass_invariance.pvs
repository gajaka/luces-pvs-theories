% The finite-state auxiliary data do not enter the input law. Equal
% input mass functions give equal coordinate laws and equal full IID
% measures on the original sequence space.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_finite_iid_mass_invariance[Left,Right,Input: TYPE,
  leftUniverse:{U:finite_set[Left]|FORALL(s:Left):U(s)},
  rightUniverse:{U:finite_set[Right]|FORALL(s:Right):U(s)},
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)},
  (IMPORTING ppg_finite_update[Left,Input,leftUniverse,inputs])
  R:{R:Rule|Valid(R)},
  (IMPORTING ppg_finite_update[Right,Input,rightUniverse,inputs])
  Q:{Q:ppg_finite_update[Right,Input,rightUniverse,inputs].Rule|
    ppg_finite_update[Right,Input,rightUniverse,inputs].Valid(Q)}]: THEORY
BEGIN
  IMPORTING ppg_finite_iid_law[Left,Input,leftUniverse,inputs,R] AS massLeftLaw,
    ppg_finite_iid_law[Right,Input,rightUniverse,inputs,Q] AS massRightLaw,
    ppg_finite_update_law[Left,Input,leftUniverse,inputs] AS massLeftPMF,
    ppg_finite_update_law[Right,Input,rightUniverse,inputs] AS massRightPMF

  sameMass: bool = R`mass=Q`mass

  coordinate_space_equal: LEMMA massLeftLaw.coordinateSigma=massRightLaw.coordinateSigma

  spaces_equal: LEMMA massLeftLaw.iidSpaces=massRightLaw.iidSpaces

  input_pmf_equal: LEMMA sameMass IMPLIES massLeftPMF.inputPMF(R)=massRightPMF.inputPMF(Q)

  coordinate_law_equal: LEMMA sameMass IMPLIES massLeftLaw.coordinateLaw=massRightLaw.coordinateLaw

  coins_equal: LEMMA sameMass IMPLIES massLeftLaw.iidCoins=massRightLaw.iidCoins

  native_space_equal: LEMMA massLeftLaw.nativeSigma=massRightLaw.nativeSigma

  forget_equal: LEMMA massLeftLaw.forget=massRightLaw.forget

  iid_probability_equal: LEMMA sameMass IMPLIES massLeftLaw.iidProbability=massRightLaw.iidProbability

  iid_measure_equal: LEMMA sameMass IMPLIES massLeftLaw.iidMeasure=massRightLaw.iidMeasure

END ppg_finite_iid_mass_invariance
