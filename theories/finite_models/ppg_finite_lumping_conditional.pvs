% Finite conditional linearity gives the law of each projected state
% indicator under the original measure and history sigma-algebra.
% The history space is an explicit argument, so the same construction
% applies at every time of a filtration.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, Section 2.3.1, American Mathematical Society, 2017.
ppg_finite_lumping_conditional[State,Abstract,Omega: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  abstractUniverse:{U:finite_set[Abstract]|FORALL(a:Abstract):U(a)},
  (IMPORTING measure_probability@ppg_nasa_sigma[Omega]) S:MeasurableSpace,
  (IMPORTING measure_probability@ppg_finite_law_view[Omega,S]) measureLaw:FiniteLaw]: THEORY
BEGIN
  IMPORTING ppg_finite_lumping[State,Abstract,universe,abstractUniverse],
    ppg_finite_process_integral[State,Omega,universe,S,measureLaw] AS concreteIntegral,
    ppg_finite_process_integral[Abstract,Omega,abstractUniverse,S,measureLaw] AS reducedIntegral,
    measure_probability@ppg_finite_history_value,ppg_finite_conditional_value,
    measure_probability@ppg_measurable_map[Omega,State] AS concreteMap,
    measure_probability@ppg_measurable_map[Omega,Abstract] AS reducedMap

  HistorySigma: TYPE = {K:ppg_measurable_space[Omega].MeasurableSpace|subset?(K,S)}

  CurrentMap(H:HistorySigma): TYPE = ppg_finite_history_value[State,Omega,universe,S,measureLaw,H].HistoryStateMap

  ReducedCurrentMap(H:HistorySigma): TYPE = ppg_finite_history_value[Abstract,Omega,abstractUniverse,S,measureLaw,H].HistoryStateMap

  SourcePair(H:HistorySigma): TYPE = ppg_finite_conditional_value[State,Omega,universe,S,measureLaw,H].Pair

  ReducedPair(H:HistorySigma): TYPE = ppg_finite_conditional_value[Abstract,Omega,abstractUniverse,S,measureLaw,H].Pair

  M: VAR ppg_finite_drift[State,universe].Model
  N: VAR ppg_finite_drift[Abstract,abstractUniverse].Model
  p: VAR [State->Abstract]
  Y: VAR concreteIntegral.StateMap
  rawY: VAR [Omega->State]
  K: VAR ppg_measurable_space[Omega].MeasurableSpace
  omega: VAR Omega
  s: VAR State
  a: VAR Abstract

  real_function_eq: LEMMA FORALL(f,g:[Omega->real]):
    f=g IFF (FORALL(omega:Omega):f(omega)=g(omega))

  composition_measurable: LEMMA
    concreteMap.measurable(K,concreteIntegral.fullStateSigma,rawY) IMPLIES
    reducedMap.measurable(K,reducedIntegral.fullStateSigma,LAMBDA(omega:Omega):p(rawY(omega)))

  projectAmbient(p,Y): reducedIntegral.StateMap = LAMBDA(omega:Omega):p(Y(omega))

  projectCurrent(H:HistorySigma,p:[State->Abstract],X:CurrentMap(H)): ReducedCurrentMap(H) =
    LAMBDA(omega:Omega):p(X(omega))

  projected_ambient_at: LEMMA projectAmbient(p,Y)(omega)=p(Y(omega))

  projected_current_at: LEMMA FORALL(H:HistorySigma,p:[State->Abstract],
    X:CurrentMap(H),omega:Omega):projectCurrent(H,p,X)(omega)=p(X(omega))

  indicator_product_function: LEMMA
    (LAMBDA(t:State):M`transition(s,t)*(IF p(t)=a THEN 1 ELSE 0 ENDIF))=
    (LAMBDA(t:State):IF a=p(t) THEN M`transition(s,t) ELSE 0 ENDIF)

  projected_indicator_row: LEMMA FORALL(H:HistorySigma,
    M:ppg_finite_drift[State,universe].Model,N:ppg_finite_drift[Abstract,abstractUniverse].Model,
    p:[State->Abstract],s:State,a:Abstract):Compatible(M,N,p) IMPLIES
    ppg_finite_conditional_value[State,Omega,universe,S,measureLaw,H].localValue(M,LAMBDA(t:State):IF p(t)=a THEN 1 ELSE 0 ENDIF)(s)=
      N`transition(p(s),a)

  next_indicator_function: LEMMA
    ppg_finite_measure_integral[Omega,S,measureLaw].indicator(
      reducedIntegral.stateEvent(projectAmbient(p,Y),a))=
    concreteIntegral.integrableValue(LAMBDA(t:State):IF p(t)=a THEN 1 ELSE 0 ENDIF,Y)

  projected_history_row: LEMMA FORALL(H:HistorySigma,
    M:ppg_finite_drift[State,universe].Model,N:ppg_finite_drift[Abstract,abstractUniverse].Model,
    p:[State->Abstract],X:CurrentMap(H),a:Abstract):Compatible(M,N,p) IMPLIES
    ppg_finite_history_value[State,Omega,universe,S,measureLaw,H].historyValue(
      ppg_finite_conditional_value[State,Omega,universe,S,measureLaw,H].localValue(M,LAMBDA(t:State):IF p(t)=a THEN 1 ELSE 0 ENDIF),X)=
      ppg_finite_conditional_value[Abstract,Omega,abstractUniverse,S,measureLaw,H].rowCoordinate(N,projectCurrent(H,p,X),a)

  transition_versions_projected: LEMMA FORALL(H:HistorySigma,
    M:ppg_finite_drift[State,universe].Model,N:ppg_finite_drift[Abstract,abstractUniverse].Model,
    p:[State->Abstract],X:CurrentMap(H),Y:concreteIntegral.StateMap):
    Compatible(M,N,p) AND ppg_finite_conditional_value[State,Omega,universe,S,measureLaw,H].TransitionVersions(M,X,Y) IMPLIES
      ppg_finite_conditional_value[Abstract,Omega,abstractUniverse,S,measureLaw,H].TransitionVersions(N,projectCurrent(H,p,X),projectAmbient(p,Y))

  projectPair(H:HistorySigma,p:[State->Abstract],q:SourcePair(H)): ReducedPair(H) =
    (# current:=projectCurrent(H,p,q`current),next:=projectAmbient(p,q`next) #)

  pair_realized_projection: LEMMA FORALL(H:HistorySigma,
    M:ppg_finite_drift[State,universe].Model,N:ppg_finite_drift[Abstract,abstractUniverse].Model,
    p:[State->Abstract],q:SourcePair(H)):
    Compatible(M,N,p) AND ppg_finite_conditional_value[State,Omega,universe,S,measureLaw,H].realized(M,q) IMPLIES
      ppg_finite_conditional_value[Abstract,Omega,abstractUniverse,S,measureLaw,H].realized(N,projectPair(H,p,q))

END ppg_finite_lumping_conditional
