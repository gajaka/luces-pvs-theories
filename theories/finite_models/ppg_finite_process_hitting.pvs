% The stopped count is bounded by the active count. Its finite expected
% value therefore makes the first good state occur almost everywhere.
% For probability measures, a fixed initial state removes the initial
% integral and the success event has mass one.
%
% Johannes Lengler, "Drift Analysis", arXiv:1712.00964, additive drift.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% Lean counterpart: the expectedHitCount and success results in
% PPGraphFiniteDriftProcess.lean.
ppg_finite_process_hitting[State,Omega: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  (IMPORTING measure_probability@ppg_nasa_sigma[Omega]) S:MeasurableSpace,
  (IMPORTING measure_probability@ppg_finite_law_view[Omega,S]) measureLaw:FiniteLaw,
  (IMPORTING measure_probability@ppg_filtration[Omega,State,S]) history:Filtration]: THEORY
BEGIN
  IMPORTING ppg_finite_process_expectation[State,Omega,universe,S,measureLaw,history],
    ppg_finite_process_count_measurable[State,Omega,universe,S],
    measure_probability@ppg_finite_integral_finiteness[Omega,S,measureLaw],measure_probability@ppg_enn_add
  M: VAR Model
  X: VAR AdaptedProcess
  W: VAR Witness
  E: VAR [nat->set[Omega]]
  omega: VAR Omega
  n: VAR nat
  s0: VAR State

  active_schedule_events: LEMMA activeSchedule(M,X)=activeEvents(M,X)

  active_count_event_count: LEMMA activeCount(E,omega)=eventCount(E,omega)

  hit_count_below_active: LEMMA
    ele(hitCount(M,X,omega),eventCount(activeSchedule(M,X),omega))

  expectedHitCount(M,X): ENN = lintegral(LAMBDA(omega:Omega):hitCount(M,X,omega))

  hit_integral_below_active: LEMMA
    ele(expectedHitCount(M,X),expectedCount(activeSchedule(M,X)))

  expectedHitCount_le: THEOREM FORALL(M:Model,W:AcceptedWitness(M),X:Realization(M)):
    ele(expectedHitCount(M,X),ennFinite(potentialMean(M,W,X,0)/positiveRate(M,W)))

  expectedHitCount_lt_top: THEOREM FORALL(M:Model,W:AcceptedWitness(M),X:Realization(M)):
    ennFinite?(expectedHitCount(M,X))

  potentialAt(M:Model,W:AcceptedWitness(M),s0:State): nonneg_real = W`potential(s0)

  fixed_potential_function: LEMMA (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES
    potentialValue(W,X,0)=constant(W`potential(s0))

  fixed_initial_mean: LEMMA FORALL(M:Model,W:AcceptedWitness(M),X:AdaptedProcess,s0:State):
    mass(fullset[Omega])=1 AND (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES
    potentialMean(M,W,X,0)=potentialAt(M,W,s0)

  expectedHitCount_fixed_le: THEOREM FORALL(M:Model,W:AcceptedWitness(M),X:Realization(M),s0:State):
    mass(fullset[Omega])=1 AND (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES
    ele(expectedHitCount(M,X),ennFinite(potentialAt(M,W,s0)/positiveRate(M,W)))

  process_measurable: LEMMA processMeasurable(fullStateSigma,X)

  hit_measurable: LEMMA measurable(S,ENNSigma,LAMBDA(omega:Omega):hitCount(M,X,omega))

  successEvent(M,X): set[Omega] = {omega:Omega|EXISTS(T:nat):M`good(X(T)(omega))}

  success_event_finite: LEMMA successEvent(M,X)=finiteEvent(LAMBDA(omega:Omega):hitCount(M,X,omega))

  success_measurable: LEMMA S(successEvent(M,X))

  measurableSuccess(M,X): (S) = successEvent(M,X)

  success_complement_infinite: LEMMA complement(measurableSuccess(M,X))=
    infiniteEvent(LAMBDA(omega:Omega):hitCount(M,X,omega))

  ae_exists_good: THEOREM FORALL(M:Model,W:AcceptedWitness(M),X:Realization(M)):
    ae?(successEvent(M,X))

  success_mass_full: LEMMA FORALL(M:Model,W:AcceptedWitness(M),X:Realization(M)):
    mass(measurableSuccess(M,X))=mass(fullset[Omega])

  measure_success_eq_one: THEOREM FORALL(M:Model,W:AcceptedWitness(M),X:Realization(M)):
    mass(fullset[Omega])=1 IMPLIES mass(measurableSuccess(M,X))=1

END ppg_finite_process_hitting
