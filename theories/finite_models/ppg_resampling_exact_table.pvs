% The actual table realization satisfies the first-step equations.
% The generic exact-hitting theorem therefore identifies its expected
% resampling count with the native integral of the initial solution value.
%
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, Exercise 10.22(a), American Mathematical Society, 2017.
% Michael Mitzenmacher and Eli Upfal, Probability and Computing,
% second edition, Section 7.1.1, Cambridge University Press, 2017.
ppg_resampling_exact_table[V,Value:TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]],
  (IMPORTING ppg_finite_resampling_core[V,Value,variables,domains])
  Q:{Q:Marginals|Valid(Q)},P:Policy,
  (IMPORTING ppg_resampling_table_product[V,Value,variables,domains,Q])
  init:ppg_resampling_table_product[V,Value,variables,domains,Q].TableInitializer]: THEORY
BEGIN
  IMPORTING ppg_finite_table_core[V,Value,variables,domains] AS exactTableCore,
    ppg_finite_resampling_core[V,Value,variables,domains] AS core,
    ppg_resampling_table_product[V,Value,variables,domains,Q] AS laws,
    ppg_resampling_state_finite[V,Value,variables,domains] AS states,
    ppg_resampling_potential[V,Value,variables,domains] AS kernelProof

  State: TYPE = exactTableCore.State

  ResamplingLog: TYPE = exactTableCore.ResamplingLog

  ambient: MACRO ppg_measurable_space[ResamplingLog].MeasurableSpace = laws.tableAmbient

  IMPORTING ppg_resampling_table_execution[V,Value,variables,domains,Q,P,init] AS execution,
    ppg_finite_update[State,State,states.allStates,states.allStates] AS update,
    ppg_finite_potential_system[State,states.allStates] AS equations

  tableMeasure: MACRO ppg_finite_law_view[ResamplingLog,ambient].FiniteLaw = execution.tableMeasure

  history: MACRO ppg_filtration[ResamplingLog,State,ambient].Filtration = execution.tableH

  IMPORTING ppg_finite_potential_expectation[State,ResamplingLog,states.allStates,
      ambient,execution.tableMeasure,history] AS exact,
    ppg_finite_process_realization[State,ResamplingLog,states.allStates,
      ambient,execution.tableMeasure,history] AS process,
    ppg_finite_process_integral[State,ResamplingLog,states.allStates,
      ambient,execution.tableMeasure] AS values,
    ppg_finite_process_hitting[State,ResamplingLog,states.allStates,
      ambient,execution.tableMeasure,history] AS hitting,
    measure_probability@ppg_finite_measure_integral[ResamplingLog,ambient,execution.tableMeasure] AS functions,
    measure_integration@integral[ResamplingLog,ppg_nasa_sigma[ResamplingLog].asNasa(ambient),
      execution.tableMeasure] AS native

  tableModel: exact.StochasticAbsorbingModel = update.model(core.rule(Q,P))

  Solution: TYPE = {f:[State->rat]|equations.Equations(tableModel,f)}

  f: VAR Solution

  tableProcess: process.Realization(tableModel) = execution.tableRealized

  initialMap: values.StateMap = init

  initialValue(f): functions.NativeFunction = values.integrableValue(f,initialMap)

  initial_process: LEMMA process.ambientState(tableProcess,0)=initialMap

  initial_function: LEMMA values.integrableValue(f,process.ambientState(tableProcess,0))=initialValue(f)

  table_expectedHitCount_eq_of_equations: THEOREM
    hitting.expectedHitCount(tableModel,tableProcess)=ofReal(native.integral(initialValue(f)))

END ppg_resampling_exact_table
