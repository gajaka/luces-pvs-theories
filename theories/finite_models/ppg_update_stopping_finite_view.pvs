% On a finite state carrier, the general running events and first-hit
% counts coincide with the earlier stopping construction on the IID
% trajectory. This identifies the objects used by the integral bounds.
%
% Johannes Lengler, "Drift Analysis", arXiv:1712.00964.
ppg_update_stopping_finite_view[State,Input: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)}]: THEORY
BEGIN
  IMPORTING ppg_finite_input_update[State,Input,inputs] AS stopViewRaw,
    ppg_input_update_stopping[State,Input,inputs] AS stopViewRawEvents,
    ppg_finite_input_history[Input] AS stopViewHistory,
    ppg_finite_update[State,Input,universe,inputs] AS stopViewFinite,
    ppg_finite_update_view[State,Input,universe,inputs] AS stopViewBridge,
    ppg_finite_iid_trajectory[State,Input,universe,inputs] AS stopViewTrajectory,
    ppg_finite_process_stopping[State,stopViewHistory.Sample,universe,
      stopViewHistory.ambientSigma] AS stopViewStopping,
    ppg_finite_process_history[State,stopViewHistory.Sample,universe,
      stopViewHistory.ambientSigma] AS stopViewEvents

  R: VAR stopViewRaw.Rule
  s0: VAR State
  omega: VAR stopViewHistory.Sample

  trajectory_family: LEMMA (LAMBDA(n:nat):stopViewRaw.iidTrajectory(R,s0,n))=
    (LAMBDA(n:nat):stopViewTrajectory.iidTrajectory(R,s0,n))

  active_family: LEMMA stopViewRawEvents.activeEvents(R,s0)=
    stopViewStopping.activeEvents(stopViewFinite.model(R),
      LAMBDA(n:nat):stopViewTrajectory.iidTrajectory(R,s0,n))

  running_family: LEMMA stopViewRawEvents.runningEvents(R,s0)=
    stopViewStopping.runningEvents(stopViewFinite.model(R),
      LAMBDA(n:nat):stopViewTrajectory.iidTrajectory(R,s0,n))

  hit_count: LEMMA stopViewRawEvents.hitCount(R,s0,omega)=
    stopViewStopping.hitCount(stopViewFinite.model(R),
      LAMBDA(n:nat):stopViewTrajectory.iidTrajectory(R,s0,n),omega)

END ppg_update_stopping_finite_view
