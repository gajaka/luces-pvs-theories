% The conditional indicator law determines every finite state value.
% Restricting by the running event gives a conditional version for any
% value that vanishes at good states. Applying this to the killed
% recursion preserves its stopped integral after shifting the horizon.
%
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, Lemma 1.13, American Mathematical Society, 2017.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_finite_survival_conditional[State,Omega: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  (IMPORTING measure_probability@ppg_nasa_sigma[Omega]) S:MeasurableSpace,
  (IMPORTING measure_probability@ppg_finite_law_view[Omega,S]) measureLaw:FiniteLaw,
  (IMPORTING measure_probability@ppg_filtration[Omega,State,S]) history:Filtration]: THEORY
BEGIN
  IMPORTING ppg_finite_stopped_telescope[State,Omega,universe,S,measureLaw,history],
    ppg_finite_stopped_survival[State,Omega,universe,S]
  M: VAR Model
  f: VAR Vector
  X: VAR AdaptedProcess
  n,k: VAR nat

  ZeroVector(M:Model): TYPE = {f:Vector|GoodZero(M,f)}

  survivalVector(M,k): ZeroVector(M) = LAMBDA(s:State):survival(M,k,s)

  stopped_native_shift_good_zero: LEMMA GoodZero(M,f) IMPLIES
    stoppedNativeValue(M,f,X,n+1)=
      restricted(runningAmbient(M,X,n),integrableValue(f,ambientState(X,n+1)))

  stopped_zero_next_version: LEMMA FORALL(M:Model,f:ZeroVector(M),X:Realization(M),n:nat):
    ppg_conditional_versions[Omega,S,measureLaw,history(n)].conditionalVersion(
      stoppedNativeValue(M,f,X,n+1),stoppedRow(M,f,X,n))

  survival_row_next: LEMMA stoppedRow(M,survivalVector(M,k),X,n)=
    stoppedNativeValue(M,survivalVector(M,k+1),X,n)

  stopped_survival_integral_step: THEOREM FORALL(M:Model,X:Realization(M),n,k:nat):
    stoppedMean(M,survivalVector(M,k),X,n+1)=
      stoppedMean(M,survivalVector(M,k+1),X,n)

END ppg_finite_survival_conditional
