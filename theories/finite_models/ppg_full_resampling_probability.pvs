% The native finite product is the state law of a complete table row.
% Good-state probabilities use its outer measure on arbitrary sets. A
% measurable safe box therefore gives a lower bound even when the bad
% tests themselves are not assumed measurable.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Section 2.
% Michael Mitzenmacher and Eli Upfal, Probability and Computing,
% second edition, Cambridge University Press, 2017.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_full_resampling_probability[C,V,Value:TYPE,domain:[V->set[Value]],
  universe:{U:finite_set[V]|FORALL(v:V):U(v)},
  events:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING moser_tardos@ppg_mt_coordinate_laws[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces)]: THEORY
BEGIN
  IMPORTING moser_tardos@ppg_mt_semantics[C,V,Value,domain] AS semantics,
    moser_tardos@ppg_mt_random_process[C,V,Value,domain] AS slots,
    moser_tardos@ppg_mt_selection[C,V,Value,domain] AS selection,
    moser_tardos@ppg_mt_native_spaces[C,V,Value,domain] AS nativeSpaces,
    moser_tardos@ppg_mt_check_measurable[C,V,Value,domain] AS reads

  State: TYPE = semantics.MTState

  ResamplingLog: TYPE = slots.LogSpace

  BadTest: TYPE = [C,State->bool]

  stateSigma: MACRO ppg_measurable_space[State].MeasurableSpace = nativeSpaces.NativeStateSigma(spaces)

  logSigma: MACRO ppg_measurable_space[ResamplingLog].MeasurableSpace = nativeSpaces.NativeTableSigma(spaces)

  universe_full: LEMMA universe=fullset[V]

  events_full: LEMMA events=fullset[C]

  IMPORTING moser_tardos@ppg_mt_state_probability[C,V,Value,domain,universe,spaces,laws] AS stateLaw,
    moser_tardos@ppg_mt_log_probability[C,V,Value,domain,spaces,laws] AS tableLaw,
    moser_tardos@ppg_mt_outer_probability[State,stateSigma,stateLaw.stateMeasure] AS stateOuter,
    ppg_full_resampling_paths[C,V,Value,domain,universe] AS paths,
    measure_probability@ppg_finite_events[State,C,stateSigma] AS goodEvents,
    measure_probability@ppg_finite_events[State,V,stateSigma] AS coordinateEvents,
    measure_probability@ppg_measurable_dependent_product[ResamplingLog,V,Value,domain] AS stateGeometry,
    measure_probability@ppg_measurable_block[V,Value,domain,spaces] AS blocks,
    measure_probability@ppg_measurable_block_box[V,Value,domain,spaces] AS boxes,
    measure_probability@ppg_probability_finite_product[V,Value,domain,spaces,laws] AS productDistribution,
    foundations@ppg_finite_product[V] AS scalarProduct,
    foundations@ppg_real_product_order[V] AS productOrder,
    measure_probability@ppg_measurable_map[ResamplingLog,State] AS logMap,
    measure_probability@ppg_probability_map[ResamplingLog,State,logSigma,stateSigma] AS logPush,
    measure_probability@ppg_measurable_map[blocks.Block(universe),State] AS blockMap,
    measure_probability@ppg_probability_map[blocks.Block(universe),State,blocks.blockSigma(universe),stateSigma] AS blockPush

  bad: VAR BadTest
  E: VAR boxes.CoordinateEvents
  n: VAR nat
  c: VAR C
  v: VAR V

  goodSet(bad): set[State] = {s:State|selection.MTGood(bad,s)}

  badSet(bad): set[State] = complement(goodSet(bad))

  badMeasurable(bad): bool = FORALL(c:C):stateSigma({s:State|bad(c,s)})

  goodLabels(bad)(c): set[State] = {s:State|NOT bad(c,s)}

  good_set_finite: LEMMA goodSet(bad)=goodEvents.finiteMeet(events,goodLabels(bad))

  good_label_measurable: LEMMA badMeasurable(bad) IMPLIES stateSigma(goodLabels(bad)(c))

  good_measurable: LEMMA badMeasurable(bad) IMPLIES stateSigma(goodSet(bad))

  bad_measurable: LEMMA badMeasurable(bad) IMPLIES stateSigma(badSet(bad))

  mtGoodProbability(bad): {r:nnreal|r<=1} = stateOuter.outerProbability(goodSet(bad))

  mtBadProbability(bad): {r:nnreal|r<=1} = stateOuter.outerProbability(badSet(bad))

  mtGoodProbability_add_bad: THEOREM badMeasurable(bad) IMPLIES mtGoodProbability(bad)+mtBadProbability(bad)=1

  one_sub_mtBadProbability: THEOREM badMeasurable(bad) IMPLIES 1-mtBadProbability(bad)=mtGoodProbability(bad)

  bad_slot_preimage: LEMMA paths.mtBadSlotEvent(bad,n)=logMap.inverseImage(
    LAMBDA(omega:ResamplingLog):slots.freshState(omega,n),badSet(bad))

  measurableSet_mtBadSlotEvent: THEOREM badMeasurable(bad) IMPLIES logSigma(paths.mtBadSlotEvent(bad,n))

  MeasurableBad: TYPE = {bad:BadTest|badMeasurable(bad)}

  B: VAR MeasurableBad

  badSlotValue(B,n): (logSigma) = paths.mtBadSlotEvent(B,n)

  fresh_read_eq: LEMMA (LAMBDA(omega:ResamplingLog):slots.freshState(omega,n))=reads.readAt(LAMBDA(v:V):n)

  logMeasure_mtBadSlotEvent: THEOREM tableLaw.logMeasure(badSlotValue(B,n))=mtBadProbability(B)

  stateBox(E): set[State] = {s:State|FORALL(v:V):E(v)(s(v))}

  boxCoordinates(E)(v): set[State] = stateGeometry.nativeCylinder(v,E(v))

  box_set_finite: LEMMA stateBox(E)=coordinateEvents.finiteMeet(universe,boxCoordinates(E))

  box_coordinate_measurable: LEMMA stateSigma(boxCoordinates(E)(v))

  box_measurable: LEMMA stateSigma(stateBox(E))

  box_preimage: LEMMA blockMap.inverseImage(stateLaw.stateDecode,stateBox(E))=boxes.blockBox(universe,E)

  boxMass(E): nnreal = scalarProduct.product(universe,LAMBDA(v:V):laws(v)(E(v)))

  box_mass: LEMMA stateLaw.stateMeasure(stateBox(E))=boxMass(E)

  SafeBox(bad,E): bool = FORALL(s:State):(FORALL(v:V):E(v)(s(v))) IMPLIES selection.MTGood(bad,s)

  box_subset_good: LEMMA SafeBox(bad,E) IMPLIES subset?(stateBox(E),goodSet(bad))

  mtGoodProbability_ge_box: THEOREM SafeBox(bad,E) IMPLIES boxMass(E)<=mtGoodProbability(bad)

  box_mass_positive: LEMMA (FORALL(v:V):0<laws(v)(E(v))) IMPLIES 0<boxMass(E)

  mtGoodProbability_pos_of_box: THEOREM SafeBox(bad,E) AND (FORALL(v:V):0<laws(v)(E(v))) IMPLIES
    0<mtGoodProbability(bad)

END ppg_full_resampling_probability
