    (|finite_set| TYPE-EQ-DECL NIL |finite_sets| NIL)
    (|universe| FORMAL-CONST-DECL
     "{U: finite_set[State] | FORALL (s: State): U(s)}" |ppg_finite_update_law|
     NIL)
    (|inputs| FORMAL-CONST-DECL
     "{U: finite_set[Input] | FORALL (a: Input): U(a)}" |ppg_finite_update_law|
     NIL)
    (|Rule| TYPE-EQ-DECL NIL |ppg_finite_update| NIL)
    (|Valid| CONST-DECL "bool" |ppg_finite_update| NIL)
    (|ValidRule| TYPE-EQ-DECL NIL |ppg_finite_update_law| NIL))
   SHOSTAK)))

