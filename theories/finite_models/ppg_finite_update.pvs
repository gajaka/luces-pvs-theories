% A finite randomized update determines its transition matrix by summing
% fresh-input masses over the fibers of the actual update. Weighted rows
% then agree with the expectation computed directly from the update.
%
% Michael Mitzenmacher and Eli Upfal, Probability and Computing,
% second edition, Chapters 2 and 7, Cambridge University Press, 2017.
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, Chapter 1, American Mathematical Society, 2017.
ppg_finite_update[State,Input: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)}]: THEORY
BEGIN
  IMPORTING ppg_finite_drift[State,universe] AS drift,
    ppg_finite_potential_system[State,universe] AS system,
    ppg_finite_potential_order[State,universe] AS order,
    foundations@ppg_rational_sum[Input],
    foundations@ppg_monoid_sum[Input,rat,0,LAMBDA(x,y:rat):x+y] AS inputSum,
    foundations@ppg_finite_weighted_projection[Input,State]

  Rule: TYPE = [# mass:[Input->rat],update:[State,Input->State],good:pred[State] #]

  R: VAR Rule
  W: VAR drift.Witness
  s,t: VAR State
  a: VAR Input
  f: VAR system.Vector

  Valid(R): bool = (FORALL(a:Input):0<=R`mass(a)) AND inputSum.sum(inputs,R`mass)=1

  kernel(R,s,t): rat = inputSum.sum(inputs,
    LAMBDA(a:Input):IF t=R`update(s,a) THEN R`mass(a) ELSE 0 ENDIF)

  model(R): drift.Model = (# transition:=LAMBDA(s,t:State):kernel(R,s,t),good:=R`good #)

  kernel_term_nonnegative: LEMMA Valid(R) IMPLIES
    0<=(IF t=R`update(s,a) THEN R`mass(a) ELSE 0 ENDIF)

  kernel_nonnegative: THEOREM Valid(R) IMPLIES 0<=kernel(R,s,t)

  kernel_fiber_real: LEMMA
    fiberWeight(inputs,LAMBDA(a:Input):R`update(s,a),R`mass,t)=kernel(R,s,t)

  kernel_weighted_function: LEMMA
    (LAMBDA(t:State):fiberWeight(inputs,LAMBDA(a:Input):R`update(s,a),R`mass,t)*f(t))=
    (LAMBDA(t:State):kernel(R,s,t)*f(t))

  weighted_next_value: THEOREM system.successorValue(model(R),f,s)=
    inputSum.sum(inputs,LAMBDA(a:Input):R`mass(a)*f(R`update(s,a)))

  kernel_normalized: THEOREM Valid(R) IMPLIES
    ppg_monoid_sum[State,rat,0,LAMBDA(x,y:rat):x+y].sum(
      universe,LAMBDA(t:State):kernel(R,s,t))=1

  kernel_zero_of_unreachable: THEOREM
    (FORALL(a:Input):R`update(s,a)/=t) IMPLIES kernel(R,s,t)=0

  kernel_fixed_function: LEMMA (FORALL(a:Input):R`update(s,a)=s) IMPLIES
    (LAMBDA(a:Input):IF t=R`update(s,a) THEN R`mass(a) ELSE 0 ENDIF)=
    (LAMBDA(a:Input):IF t=s THEN R`mass(a) ELSE 0 ENDIF)

  kernel_eq_pure_of_fixed: THEOREM Valid(R) AND
    (FORALL(a:Input):R`update(s,a)=s) IMPLIES
    kernel(R,s,t)=IF s=t THEN 1 ELSE 0 ENDIF

  localExpectation_eq_update: THEOREM drift.localExpectation(model(R),W,s)=
    inputSum.sum(inputs,LAMBDA(a:Input):R`mass(a)*W`potential(R`update(s,a)))

  check(R,W): bool = drift.check(model(R),W)

  updateConditions(R,W): bool =
    (FORALL(s:State):0<=W`potential(s)) AND
    (FORALL(s:State):R`good(s) IMPLIES W`potential(s)=0) AND 0<W`delta AND
    (FORALL(s:State):inputSum.sum(inputs,
      LAMBDA(a:Input):R`mass(a)*W`potential(R`update(s,a)))+
      (IF R`good(s) THEN 0 ELSE W`delta ENDIF)<=W`potential(s))

  check_eq_true_iff: THEOREM Valid(R) IMPLIES (check(R,W) IFF updateConditions(R,W))

END ppg_finite_update
