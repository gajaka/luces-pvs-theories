    (|numfield| NONEMPTY-TYPE-EQ-DECL NIL |number_fields| NIL)
    (+ CONST-DECL "[numfield, numfield -> numfield]" |number_fields| NIL)
    (|n| FORMAL-CONST-DECL "nat" |ppg_finite_path_space| NIL)
    (|below| TYPE-EQ-DECL NIL |naturalnumbers| NIL)
    (V FORMAL-TYPE-DECL NIL |ppg_finite_path_space| NIL)
    (|Value| FORMAL-TYPE-DECL NIL |ppg_finite_path_space| NIL)
    (|set| TYPE-EQ-DECL NIL |sets| NIL)
    (|is_finite| CONST-DECL "bool" |finite_sets| NIL)
    (|finite_set| TYPE-EQ-DECL NIL |finite_sets| NIL)
    (|domains| FORMAL-CONST-DECL "[V -> finite_set[Value]]"
     |ppg_finite_path_space| NIL)
    (|variables| FORMAL-CONST-DECL "{U: finite_set[V] | FORALL (v: V): U(v)}"
     |ppg_finite_path_space| NIL)
    (|State| TYPE-EQ-DECL NIL |ppg_finite_table_paths| NIL)
    (|Path| TYPE-EQ-DECL NIL |ppg_finite_path_space| NIL)
    (|pathUniverse| CONST-DECL "{U: finite_set[Path] | FORALL (p: Path): U(p)}"
     |ppg_finite_path_space| NIL)
    (|path_singleton_measurable| FORMULA-DECL NIL |ppg_finite_path_space| NIL))
   SHOSTAK)))

