% The finite path space carries the product sigma algebra generated
% by its state coordinates. A prefix map is measurable because each
% coordinate is a measurable trajectory map.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_finite_table_measurable_prefix[V,Value: TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]],
  (IMPORTING moser_tardos@ppg_mt_coordinate_laws[bool,V,Value,LAMBDA(v:V):domains(v)])
  spaces:{S:VariableSpaces|FORALL(v:V,x:(domains(v))):S(v)(singleton[(domains(v))](x))}]: THEORY
BEGIN
  IMPORTING ppg_finite_table_core[V,Value,variables,domains] AS prefixTable,
    ppg_finite_table_paths[V,Value,variables,domains] AS prefixPaths,
    ppg_finite_table_spaces[V,Value,variables,domains,spaces] AS prefixSpaces,
    ppg_finite_table_measurable[V,Value,variables,domains,spaces] AS prefixMeasurable

  State: TYPE = prefixTable.State

  ResamplingLog: TYPE = prefixTable.ResamplingLog

  Footprint: TYPE = prefixTable.Footprint

  Initializer: TYPE = prefixTable.Initializer

  IMPORTING measure_probability@ppg_measurable_map[ResamplingLog,State] AS prefixStateMap,
    measure_probability@ppg_measurable_map,
    measure_probability@ppg_measurable_space

  pathCylinder(n:nat,k:below(n+1),B:set[State]): set[prefixPaths.Path(n)] =
    {p:prefixPaths.Path(n)|B(p(k))}

  pathGenerators(n:nat): set[set[prefixPaths.Path(n)]] =
    {A:set[prefixPaths.Path(n)]|EXISTS(k:below(n+1),B:set[State]):
      prefixSpaces.stateSigma(B) AND A=pathCylinder(n,k,B)}

  pathSigma(n:nat): ppg_measurable_space[prefixPaths.Path(n)].MeasurableSpace =
    ppg_measurable_space[prefixPaths.Path(n)].generated(pathGenerators(n))

  prefixMap(F:Footprint,init:Initializer,n:nat): [ResamplingLog->prefixPaths.Path(n)] =
    LAMBDA(omega:ResamplingLog):prefixPaths.statePrefix(F,init,n,omega)

  prefix_cylinder_preimage: LEMMA FORALL(F:Footprint,init:Initializer,n:nat,k:below(n+1),B:set[State]):
    ppg_measurable_map[ResamplingLog,prefixPaths.Path(n)].inverseImage(prefixMap(F,init,n),pathCylinder(n,k,B))=
      prefixStateMap.inverseImage(prefixMeasurable.trajectoryMap(F,init,k),B)

  generator_preimage_measurable: LEMMA FORALL(F:Footprint,init:Initializer,n:nat,A:set[prefixPaths.Path(n)]):
    prefixStateMap.measurable(prefixSpaces.tableSigma,prefixSpaces.stateSigma,init) AND
      pathGenerators(n)(A) IMPLIES
        prefixSpaces.tableSigma(
          ppg_measurable_map[ResamplingLog,prefixPaths.Path(n)].inverseImage(prefixMap(F,init,n),A))

  measurable_prefix: THEOREM FORALL(F:Footprint,init:Initializer,n:nat):
    prefixStateMap.measurable(prefixSpaces.tableSigma,prefixSpaces.stateSigma,init) IMPLIES
      ppg_measurable_map[ResamplingLog,prefixPaths.Path(n)].measurable(
        prefixSpaces.tableSigma,pathSigma(n),prefixMap(F,init,n))

END ppg_finite_table_measurable_prefix
