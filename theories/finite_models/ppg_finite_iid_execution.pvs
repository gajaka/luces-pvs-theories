% Iterating the update on IID coordinates gives an adapted execution.
% The independent-coordinate conditional version supplies freshness;
% the execution theorem then constructs the kernel realization.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% Johannes Lengler, "Drift Analysis", arXiv:1712.00964.
ppg_finite_iid_execution[State,Input: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)},
  (IMPORTING ppg_finite_update[State,Input,universe,inputs])
  R:{R:Rule|Valid(R)},s0:State]: THEORY
BEGIN
  IMPORTING ppg_finite_input_history[Input] AS iidRunHistory,
    ppg_finite_iid_law[State,Input,universe,inputs,R] AS iidRunLaw,
    ppg_finite_iid_trajectory[State,Input,universe,inputs] AS iidRunTrajectory,
    measure_probability@ppg_filtration[iidRunHistory.Sample,State,iidRunHistory.ambientSigma] AS iidRunFiltration,
    ppg_finite_process_realization[State,iidRunHistory.Sample,universe,
      iidRunHistory.ambientSigma,iidRunLaw.iidMeasure,iidRunTrajectory.inputFiltration] AS iidRunProcess,
    ppg_finite_update_execution[State,Input,iidRunHistory.Sample,universe,inputs,
      iidRunHistory.ambientSigma,iidRunLaw.iidMeasure,iidRunTrajectory.inputFiltration] AS iidRunUpdate,
    ppg_finite_update[State,Input,universe,inputs] AS iidRunRule,
    ppg_finite_iid_fresh AS iidRunFresh,
    measure_probability@ppg_finite_measure_integral[iidRunHistory.Sample,iidRunHistory.ambientSigma,
      iidRunLaw.iidMeasure] AS iidRunFunctions

  n: VAR nat
  a: VAR Input
  omega: VAR iidRunHistory.Sample

  filtration_value: LEMMA iidRunTrajectory.inputFiltration=iidRunHistory.inputHistory

  iidProcess: iidRunProcess.AdaptedProcess =
    LAMBDA(n:nat):iidRunTrajectory.iidTrajectory(R,s0,n)

  iidDraws: iidRunUpdate.DrawProcess =
    LAMBDA(n:nat):(LAMBDA(omega:iidRunHistory.Sample):omega(n))

  draw_event_value: LEMMA iidRunUpdate.drawEvent(iidRunUpdate.drawState(iidDraws,n),a)=
    iidRunLaw.sequenceCoordinate(n,singleton[Input](a))

  history_mass_function: LEMMA
    ppg_finite_history_value[State,iidRunHistory.Sample,universe,
      iidRunHistory.ambientSigma,iidRunLaw.iidMeasure,iidRunTrajectory.inputFiltration(n)].historyValue(
        LAMBDA(s:State):R`mass(a),iidRunProcess.historyCurrent(iidProcess,n))=
      iidRunFunctions.constant(R`mass(a))

  iid_fresh_version: LEMMA iidRunUpdate.freshVersion(R,iidProcess,iidDraws,n)

  iidExecution: THEOREM iidRunUpdate.Execution(R,iidProcess,iidDraws)

  executionProcess: iidRunUpdate.ExecutionProcess(R,iidDraws) = iidProcess

  iidRealized: iidRunProcess.Realization(iidRunRule.model(R)) =
    iidRunUpdate.executionRealization(R,iidDraws,executionProcess)

  iidRealization: THEOREM iidRunProcess.TransitionProcess(iidRunRule.model(R),iidRealized)

  realization_at: LEMMA iidRealized(n)(omega)=iidRunTrajectory.iidTrajectory(R,s0,n)(omega)

END ppg_finite_iid_execution
