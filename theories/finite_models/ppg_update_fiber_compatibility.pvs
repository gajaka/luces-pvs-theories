% Commuting updates with the same input masses give the fiber-mass
% identity of strong lumpability. The concrete sum is used only here,
% where both state carriers are finite.
%
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, Section 2.3.1, Lemma 2.5, American Mathematical
% Society, 2017.
ppg_update_fiber_compatibility[State,Abstract,Input: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  abstractUniverse:{U:finite_set[Abstract]|FORALL(a:Abstract):U(a)},
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)}]: THEORY
BEGIN
  IMPORTING ppg_finite_update[State,Input,universe,inputs] AS fiberSource,
    ppg_finite_update[Abstract,Input,abstractUniverse,inputs] AS fiberTarget,
    ppg_finite_update_projection[State,Abstract,Input,inputs] AS fiberCommutation,
    ppg_finite_lumping[State,Abstract,universe,abstractUniverse] AS fiberLumping,
    ppg_finite_potential_system[State,universe] AS fiberSourceSystem

  R: VAR fiberSource.Rule
  Q: VAR fiberTarget.Rule
  p: VAR [State->Abstract]
  s: VAR State
  a: VAR Abstract

  good_function: LEMMA fiberCommutation.Commutes(R,Q,p) IMPLIES
    R`good=(LAMBDA(s:State):Q`good(p(s)))

  fiber_indicator_function: LEMMA
    (LAMBDA(t:State):fiberSource.kernel(R,s,t)*(IF a=p(t) THEN 1 ELSE 0 ENDIF))=
    (LAMBDA(t:State):IF a=p(t) THEN fiberSource.kernel(R,s,t) ELSE 0 ENDIF)

  input_projected_function: LEMMA fiberCommutation.Commutes(R,Q,p) IMPLIES
    (LAMBDA(i:Input):R`mass(i)*(IF a=p(R`update(s,i)) THEN 1 ELSE 0 ENDIF))=
    (LAMBDA(i:Input):IF a=Q`update(p(s),i) THEN Q`mass(i) ELSE 0 ENDIF)

  fiber_identity: LEMMA fiberCommutation.Commutes(R,Q,p) IMPLIES
    fiberLumping.fiberMass(fiberSource.model(R),p,s,a)=fiberTarget.kernel(Q,p(s),a)

  compatible_of_commutes: THEOREM fiberCommutation.Commutes(R,Q,p) IMPLIES
    fiberLumping.Compatible(fiberSource.model(R),fiberTarget.model(Q),p)

END ppg_update_fiber_compatibility
