% The update fiber factors by coordinates. Summing each selected
% coordinate leaves its target marginal; an unselected coordinate must
% retain its old value. The resulting formula uses the actual update
% kernel and the original rational product mass.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Algorithm 1.1.
ppg_resampling_kernel[V,Value: TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_finite_resampling_core[V,Value,variables,domains] AS kernelCore,
    ppg_resampling_state_finite[V,Value,variables,domains] AS kernelFinite,
    ppg_resampling_normalization[V,Value,variables,domains] AS kernelNormalization,
    foundations@ppg_dependent_product_sum[V,Value,variables,domains] AS kernelProductSum

  State: TYPE = kernelCore.State

  IMPORTING ppg_finite_update[State,State,kernelFinite.allStates,kernelFinite.allStates] AS kernelUpdate,
    foundations@ppg_finite_sum[State] AS kernelStateSum,
    foundations@ppg_finite_sum[Value] AS kernelValueSum,
    foundations@ppg_finite_point_sum[Value] AS kernelValuePoint,
    foundations@ppg_rational_sum[State] AS kernelRationalSum,
    foundations@ppg_rational_product[V] AS kernelRationalProduct,
    foundations@ppg_finite_product[V] AS kernelRealProduct

  Q: VAR kernelCore.Marginals
  P: VAR kernelCore.Policy
  F: VAR finite_set[V]
  s,t,fresh: VAR State
  v: VAR V
  x: VAR Value

  factors(Q,F,s,t)(v)(x): real =
    IF (IF F(v) THEN x ELSE s(v) ENDIF)=t(v) THEN kernelCore.extendMass(Q,v)(x) ELSE 0 ENDIF

  rawFiber(Q,F,s,t)(fresh): real =
    IF kernelCore.coordinateUpdate(F,s,fresh)=t THEN kernelCore.productMass(Q,fresh) ELSE 0 ENDIF

  fiber_function: LEMMA rawFiber(Q,F,s,t)=
    (LAMBDA(fresh:State):kernelRealProduct.product(variables,
      LAMBDA(v:V):factors(Q,F,s,t)(v)(fresh(v))))

  kernel_fiber_function: LEMMA
    (LAMBDA(fresh:State):
      IF t=kernelCore.coordinateUpdate(kernelCore.activeFootprint(P,s),s,fresh)
        THEN kernelCore.productMass(Q,fresh) ELSE 0 ENDIF)=
      rawFiber(Q,kernelCore.activeFootprint(P,s),s,t)

  kernel_fiber_sum: LEMMA kernelUpdate.kernel(kernelCore.rule(Q,P),s,t)=
    kernelStateSum.fsum(kernelFinite.allStates,rawFiber(Q,kernelCore.activeFootprint(P,s),s,t))

  kernel_product_sum: LEMMA kernelUpdate.kernel(kernelCore.rule(Q,P),s,t)=
    kernelRealProduct.product(variables,
      kernelProductSum.domainSums(factors(Q,kernelCore.activeFootprint(P,s),s,t)))

  selected_factor_sum: LEMMA F(v) IMPLIES
    kernelValueSum.fsum(domains(v),factors(Q,F,s,t)(v))=Q`mass(v)(t(v))

  unselected_factor_function: LEMMA NOT F(v) IMPLIES
    factors(Q,F,s,t)(v)=
      (IF s(v)=t(v) THEN kernelCore.extendMass(Q,v) ELSE (LAMBDA(x:Value):0) ENDIF)

  unselected_factor_sum: LEMMA kernelCore.Valid(Q) AND NOT F(v) IMPLIES
    kernelValueSum.fsum(domains(v),factors(Q,F,s,t)(v))=(IF s(v)=t(v) THEN 1 ELSE 0 ENDIF)

  coordinate_factor_sum: LEMMA kernelCore.Valid(Q) IMPLIES
    kernelValueSum.fsum(domains(v),factors(Q,F,s,t)(v))=
      (IF F(v) THEN Q`mass(v)(t(v)) ELSE IF s(v)=t(v) THEN 1 ELSE 0 ENDIF ENDIF)

  coordinate_sum_function: LEMMA kernelCore.Valid(Q) IMPLIES
    kernelProductSum.domainSums(factors(Q,F,s,t))=
      (LAMBDA(v:V):IF F(v) THEN Q`mass(v)(t(v)) ELSE IF s(v)=t(v) THEN 1 ELSE 0 ENDIF ENDIF)

  kernel_eq_coordinate_product: THEOREM kernelCore.Valid(Q) IMPLIES
    kernelUpdate.kernel(kernelCore.rule(Q,P),s,t)=
      kernelRationalProduct.ratProduct(variables,LAMBDA(v:V):
        IF kernelCore.activeFootprint(P,s)(v) THEN Q`mass(v)(t(v))
        ELSE IF s(v)=t(v) THEN 1 ELSE 0 ENDIF ENDIF)

END ppg_resampling_kernel
