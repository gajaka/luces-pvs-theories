% The native independent product lives on a dependent table whose
% coordinate domains are the full input carrier. Forgetting these
% vacuous subtype predicates gives the original space of input sequences.
% The IID probability law is the pushforward of that constructed product.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_finite_iid_law[State,Input: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)},
  (IMPORTING ppg_finite_update[State,Input,universe,inputs])
  R:{R:Rule|Valid(R)}]: THEORY
BEGIN
  IMPORTING ppg_finite_input_history[Input] AS iidSampleHistory,
    ppg_finite_update_law[State,Input,universe,inputs] AS iidUpdateProbability,
    measure_probability@ppg_finite_atomic_probability[Input,inputs] AS iidInputAtoms

  Coordinate: TYPE = (fullset[Input])

  IMPORTING measure_probability@ppg_measurable_space[Coordinate] AS iidCoordinateSpace

  coordinateSigma: ppg_measurable_space[Coordinate].MeasurableSpace =
    fullset[set[Coordinate]]

  iidDomain: MACRO [nat->set[Input]] = LAMBDA(n:nat):fullset[Input]

  iidSpaces: [n:nat->ppg_measurable_space[(iidDomain(n))].MeasurableSpace] =
    LAMBDA(n:nat):coordinateSigma

  IMPORTING measure_probability@ppg_probability_measure[Coordinate,coordinateSigma] AS iidCoordinateProbability,
    measure_probability@ppg_probability_map[Input,Coordinate,iidInputAtoms.fullSigma,coordinateSigma] AS iidCoordinatePush,
    measure_probability@ppg_probability_block_base[nat,Input,iidDomain,iidSpaces] AS iidBlockBase,
    measure_probability@ppg_measurable_map[Input,Coordinate] AS iidInputCoordinateMap

  includeInput(a:Input): Coordinate = a

  coordinateLaw: iidCoordinateProbability.Probability =
    iidCoordinatePush.pushforward(iidUpdateProbability.inputPMF(R),includeInput)

  spaces_at: LEMMA FORALL(n:nat):iidSpaces(n)=coordinateSigma

  coordinateTrace(B:set[Input]): (coordinateSigma) = {a:Coordinate|B(a)}

  coordinate_native_event(n:nat,B:set[Input]): (iidSpaces(n)) = coordinateTrace(B)

  include_trace_preimage: LEMMA FORALL(B:set[Input]):
    iidInputCoordinateMap.inverseImage(includeInput,coordinateTrace(B))=B

  coordinate_law_event: LEMMA FORALL(B:set[Input]):
    coordinateLaw(coordinateTrace(B))=iidUpdateProbability.inputPMF(R)(B)

  iidCoins: [n:nat->iidBlockBase.CoordinateLaw(n)] = LAMBDA(n:nat):coordinateLaw

  IMPORTING measure_probability@ppg_probability_infinite_product[nat,Input,iidDomain,iidSpaces,iidCoins] AS iidNativeProduct,
    measure_probability@ppg_probability_infinite_marginals[nat,Input,iidDomain,iidSpaces,iidCoins] AS iidNativeMarginals,
    measure_probability@ppg_measurable_cylinder[nat,Input,iidDomain,iidSpaces] AS iidNativeCylinders,
    measure_probability@ppg_measurable_block[nat,Input,iidDomain,iidSpaces] AS iidNativeBlocks

  NativeTable: TYPE = iidNativeCylinders.FullBlock

  nativeSigma: ppg_measurable_space[NativeTable].MeasurableSpace = iidNativeCylinders.tableSigma

  native_sigma_eq: LEMMA nativeSigma=iidNativeCylinders.tableSigma

  IMPORTING measure_probability@ppg_measurable_map[NativeTable,iidSampleHistory.Sample] AS iidForgetMap,
    measure_probability@ppg_probability_map[NativeTable,iidSampleHistory.Sample,nativeSigma,
      iidSampleHistory.ambientSigma] AS iidForgetPush,
    measure_probability@ppg_probability_measure[iidSampleHistory.Sample,iidSampleHistory.ambientSigma] AS iidSequenceProbability,
    measure_probability@ppg_probability_finite_view[iidSampleHistory.Sample,iidSampleHistory.ambientSigma] AS iidFiniteView

  forget(x:NativeTable): iidSampleHistory.Sample = LAMBDA(n:nat):x(n)

  embed(omega:iidSampleHistory.Sample): NativeTable =
    LAMBDA(n:(fullset[nat])):omega(n)

  forget_embed: LEMMA FORALL(omega:iidSampleHistory.Sample):forget(embed(omega))=omega

  embed_forget: LEMMA FORALL(x:NativeTable):embed(forget(x))=x

  coordinate_preimage: LEMMA FORALL(n:nat,B:set[Input]):
    iidForgetMap.inverseImage(forget,iidSampleHistory.coordinateEvent(n,B))=
      iidNativeBlocks.blockCylinder(fullset[nat],n,{a:(iidDomain(n))|B(a)})

  generator_preimage_measurable: LEMMA FORALL(E:set[iidSampleHistory.Sample]):
    iidSampleHistory.allGenerators(E) IMPLIES nativeSigma(iidForgetMap.inverseImage(forget,E))

  forget_measurable: LEMMA iidForgetMap.measurable(
    nativeSigma,iidSampleHistory.ambientSigma,forget)

  iidProbability: iidSequenceProbability.Probability =
    iidForgetPush.pushforward(iidNativeProduct.infiniteLaw,forget)

  iid_probability_apply: LEMMA FORALL(A:(iidSampleHistory.ambientSigma)):
    iidProbability(A)=iidNativeProduct.infiniteLaw(iidForgetMap.inverseImage(forget,A))

  sequenceCoordinate(n:nat,B:set[Input]): (iidSampleHistory.ambientSigma) =
    iidSampleHistory.coordinateEvent(n,B)

  sequence_coordinate_preimage: LEMMA FORALL(n:nat,B:set[Input]):
    iidForgetMap.inverseImage(forget,sequenceCoordinate(n,B))=
      iidNativeBlocks.blockCylinder(fullset[nat],n,coordinate_native_event(n,B))

  iid_coordinate_mass: LEMMA FORALL(n:nat,B:set[Input]):
    iidProbability(sequenceCoordinate(n,B))=iidUpdateProbability.inputPMF(R)(B)

  iid_probability_full: LEMMA iidProbability(fullset[iidSampleHistory.Sample])=1

  IMPORTING measure_probability@ppg_measurable_map[iidSampleHistory.Sample,Input] AS iidSequenceInputMap,
    measure_probability@ppg_probability_map[iidSampleHistory.Sample,Input,iidSampleHistory.ambientSigma,
      iidInputAtoms.fullSigma] AS iidInputMarginal,
    measure_probability@ppg_probability_measure[Input,iidInputAtoms.fullSigma] AS iidInputProbability,
    measure_probability@ppg_probability_finite_view[Input,iidInputAtoms.fullSigma] AS iidInputFiniteView

  coordinateEvaluation(n:nat): iidInputMarginal.MeasurableMap =
    LAMBDA(omega:iidSampleHistory.Sample):omega(n)

  evaluation_preimage: LEMMA FORALL(n:nat,B:set[Input]):
    iidSequenceInputMap.inverseImage(coordinateEvaluation(n),B)=sequenceCoordinate(n,B)

  evaluation_preimage_measurable: LEMMA FORALL(n:nat,B:set[Input]):
    iidSampleHistory.ambientSigma(iidSequenceInputMap.inverseImage(coordinateEvaluation(n),B))

  inputMarginal(n:nat): iidInputProbability.Probability =
    iidInputMarginal.pushforward(iidProbability,coordinateEvaluation(n))

  input_marginal_law: LEMMA FORALL(n:nat):inputMarginal(n)=iidUpdateProbability.inputPMF(R)

  nativeInputMarginal(n:nat): ppg_finite_law_view[Input,iidInputAtoms.fullSigma].FiniteLaw =
    iidInputFiniteView.nativeLaw(inputMarginal(n))

  iid_input_map: THEOREM FORALL(n:nat):
    nativeInputMarginal(n)=iidInputFiniteView.nativeLaw(iidUpdateProbability.inputPMF(R))

  iidMeasure: ppg_finite_law_view[iidSampleHistory.Sample,iidSampleHistory.ambientSigma].FiniteLaw =
    iidFiniteView.nativeLaw(iidProbability)

  iid_measure_full: LEMMA iidMeasure(fullset[iidSampleHistory.Sample])=(TRUE,1)

  native_marginal_apply: LEMMA FORALL(n:nat,B:(iidInputAtoms.fullSigma)):
    nativeInputMarginal(n)(B)=
      iidMeasure(iidSequenceInputMap.inverseImage(coordinateEvaluation(n),B))

  IMPORTING measure_probability@ppg_finite_measure_integral[iidSampleHistory.Sample,iidSampleHistory.ambientSigma,
      iidMeasure] AS iidSampleIntegral,
    measure_integration@integral[iidSampleHistory.Sample,asNasa(iidSampleHistory.ambientSigma),
      iidMeasure] AS iidNativeIntegral,
    measure_integration@measure_props[iidSampleHistory.Sample,asNasa(iidSampleHistory.ambientSigma),
      iidMeasure] AS iidNativeMass

  iid_native_mass: LEMMA FORALL(A:(iidSampleHistory.ambientSigma)):
    iidNativeMass.mu(A)=iidProbability(A)

  inputIndicator(n:nat,a:Input): iidSampleIntegral.NativeFunction =
    iidSampleIntegral.indicator(sequenceCoordinate(n,singleton[Input](a)))

  input_indicator_at: LEMMA FORALL(n:nat,a:Input,omega:iidSampleHistory.Sample):
    inputIndicator(n,a)(omega)=IF omega(n)=a THEN 1 ELSE 0 ENDIF

  iid_input_indicator_integral: THEOREM FORALL(n:nat,a:Input):
    iidNativeIntegral.integral(inputIndicator(n,a))=R`mass(a)

END ppg_finite_iid_law
