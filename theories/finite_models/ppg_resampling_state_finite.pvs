% A dependent state is identified with its graph. Every graph lies
% in the finite powerset of the union of the finite coordinate domains.
% This construction also covers empty domains and an empty index type.
%
% Paul R. Halmos, Naive Set Theory, Van Nostrand, 1960.
ppg_resampling_state_finite[V,Value: TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_finite_resampling_core[V,Value,variables,domains] AS graphCore

  State: TYPE = graphCore.State

  Pair: TYPE = [V,Value]

  IMPORTING foundations@ppg_finite_injection[State,set[Pair]] AS graphFiniteInjection

  row(v:V): finite_set[Pair] =
    image[Value,Pair](LAMBDA(x:Value):(v,x),domains(v))

  support: set[Pair] = Union[Pair](
    image[V,set[Pair]](LAMBDA(v:V):row(v),variables))

  row_finite: LEMMA FORALL(v:V):is_finite(row(v))

  support_finite: LEMMA is_finite(support)

  finiteSupport: finite_set[Pair] = support

  graphs: finite_set[set[Pair]] = powerset[Pair](finiteSupport)

  stateGraph(s:State): (graphs) = {p:Pair|s(p`1)=p`2}

  state_graph_at: LEMMA FORALL(s:State,v:V):stateGraph(s)((v,s(v)))

  state_graph_injective: LEMMA injective?(stateGraph)

  full_state_finite: THEOREM is_finite(fullset[State])

  allStates: {U:finite_set[State]|FORALL(s:State):U(s)} = fullset[State]

END ppg_resampling_state_finite
