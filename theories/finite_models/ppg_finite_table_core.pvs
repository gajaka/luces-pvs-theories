% A selected coordinate consumes its next unused table entry. The
% initializer and the state-dependent footprint are deterministic maps;
% no sampling law or convergence assertion is part of this recursion.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Section 2.
ppg_finite_table_core[V,Value: TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]]]: THEORY
BEGIN
  plainDomain: MACRO [V->set[Value]] = LAMBDA(v:V):domains(v)

  IMPORTING ppg_finite_resampling_core[V,Value,variables,domains] AS tableCoordinates,
    moser_tardos@ppg_mt_random_process[bool,V,Value,plainDomain] AS tableSlots

  State: TYPE = tableCoordinates.State

  ResamplingLog: TYPE = tableSlots.LogSpace

  Counter: TYPE = [V->nat]

  RunState: TYPE = [State,Counter]

  Footprint: TYPE = [State->finite_set[V]]

  Initializer: TYPE = [ResamplingLog->State]

  F: VAR Footprint
  init: VAR Initializer
  omega,omega1,omega2: VAR ResamplingLog
  s0: VAR State
  n: VAR nat
  v: VAR V

  InitialLocal(init): bool = FORALL(omega1,omega2:ResamplingLog):
    (FORALL(v:V):omega1(0,v)=omega2(0,v)) IMPLIES init(omega1)=init(omega2)

  run(F,init,omega,n): RECURSIVE RunState =
    IF n=0 THEN (init(omega),LAMBDA(v:V):0)
    ELSE LET prev=run(F,init,omega,n-1),
      selected=F(prev`1),
      fresh=tableSlots.drawFrom(omega,LAMBDA(v:V):prev`2(v)+1)
    IN (tableCoordinates.coordinateUpdate(selected,prev`1,fresh),
      LAMBDA(v:V):IF selected(v) THEN prev`2(v)+1 ELSE prev`2(v) ENDIF)
    ENDIF MEASURE n

  trajectory(F,init,n,omega): State = run(F,init,omega,n)`1

  count(F,init,n,omega)(v): nat = run(F,init,omega,n)`2(v)

  nextDraw(F,init,n,omega): State =
    tableSlots.drawFrom(omega,LAMBDA(v:V):count(F,init,n,omega)(v)+1)

  initialLocal_const: THEOREM InitialLocal(LAMBDA(omega:ResamplingLog):s0)

  run_zero: LEMMA run(F,init,omega,0)=(init(omega),LAMBDA(v:V):0)

  run_step: LEMMA run(F,init,omega,n+1)=
    (tableCoordinates.coordinateUpdate(F(trajectory(F,init,n,omega)),
      trajectory(F,init,n,omega),nextDraw(F,init,n,omega)),
      LAMBDA(v:V):IF F(trajectory(F,init,n,omega))(v)
        THEN count(F,init,n,omega)(v)+1 ELSE count(F,init,n,omega)(v) ENDIF)

  trajectory_zero: THEOREM trajectory(F,init,0,omega)=init(omega)

  trajectory_step: THEOREM trajectory(F,init,n+1,omega)=
    tableCoordinates.coordinateUpdate(F(trajectory(F,init,n,omega)),
      trajectory(F,init,n,omega),nextDraw(F,init,n,omega))

  count_zero: THEOREM count(F,init,0,omega)(v)=0

  count_step: THEOREM count(F,init,n+1,omega)(v)=count(F,init,n,omega)(v)+
    (IF F(trajectory(F,init,n,omega))(v) THEN 1 ELSE 0 ENDIF)

  count_mono_step: THEOREM count(F,init,n,omega)(v)<=count(F,init,n+1,omega)(v)

  count_le_time: THEOREM count(F,init,n,omega)(v)<=n

END ppg_finite_table_core
