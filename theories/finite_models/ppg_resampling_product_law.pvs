% The finite independent product retains each coordinate's native
% atomic probability law. The full variable block is identified with
% the original dependent state by forgetting its vacuous index subtype.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_resampling_product_law[V,Value: TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]],
  (IMPORTING ppg_finite_resampling_core[V,Value,variables,domains])
  Q:{Q:Marginals|Valid(Q)}]: THEORY
BEGIN
  State: TYPE = ppg_finite_resampling_core[V,Value,variables,domains].State

  plainDomain: MACRO [V->set[Value]] = LAMBDA(v:V):domains(v)

  IMPORTING ppg_resampling_marginal,
    measure_probability@ppg_measurable_space

  spaces: [v:V->ppg_measurable_space[(plainDomain(v))].MeasurableSpace] =
    LAMBDA(v:V):fullset[set[(plainDomain(v))]]

  IMPORTING measure_probability@ppg_probability_block_base[V,Value,plainDomain,spaces] AS resamplingBlockBase,
    measure_probability@ppg_measurable_block[V,Value,plainDomain,spaces] AS resamplingBlocks,
    measure_probability@ppg_measurable_block_box[V,Value,plainDomain,spaces] AS resamplingBoxes

  spaces_at: LEMMA FORALL(v:V):spaces(v)=fullset[set[(plainDomain(v))]]

  coins: [v:V->resamplingBlockBase.CoordinateLaw(v)] =
    LAMBDA(v:V):ppg_resampling_marginal[V,Value,variables,domains,Q,v].marginalPMF

  IMPORTING measure_probability@ppg_probability_finite_product[V,Value,plainDomain,spaces,coins] AS resamplingProduct,
    ppg_resampling_state_finite[V,Value,variables,domains] AS productFinite

  NativeBlock: TYPE = resamplingBlocks.Block(variables)

  nativeSigma: ppg_measurable_space[NativeBlock].MeasurableSpace =
    resamplingBlocks.blockSigma(variables)

  native_sigma_eq: LEMMA nativeSigma=resamplingBlocks.blockSigma(variables)

  stateSigma: MACRO ppg_measurable_space[State].MeasurableSpace = fullset[set[State]]

  IMPORTING measure_probability@ppg_measurable_map[NativeBlock,State] AS productForgetMap,
    measure_probability@ppg_probability_map[NativeBlock,State,nativeSigma,stateSigma] AS productPush,
    measure_probability@ppg_probability_measure[State,stateSigma] AS productStateProbability,
    measure_probability@ppg_finite_sigma[State,productFinite.allStates] AS productFiniteSigma,
    ppg_finite_resampling_core[V,Value,variables,domains] AS productCore,
    foundations@ppg_rational_product[V] AS productRational

  forget(x:NativeBlock): State = LAMBDA(v:V):x(v)

  embed(s:State): NativeBlock = LAMBDA(v:(variables)):s(v)

  forget_embed: LEMMA FORALL(s:State):forget(embed(s))=s

  embed_forget: LEMMA FORALL(x:NativeBlock):embed(forget(x))=x

  pointEvents(s:State): resamplingBoxes.CoordinateEvents =
    LAMBDA(v:V):singleton[(plainDomain(v))](s(v))

  forget_point: LEMMA FORALL(s:State):
    productForgetMap.inverseImage(forget,singleton[State](s))=
      resamplingBoxes.blockBox(variables,pointEvents(s))

  point_preimage_measurable: LEMMA FORALL(s:State):
    nativeSigma(productForgetMap.inverseImage(forget,singleton[State](s)))

  image_sigma_full: LEMMA productForgetMap.imageSigma(nativeSigma,forget)=stateSigma

  forget_measurable: LEMMA productForgetMap.measurable(nativeSigma,stateSigma,forget)

  productLaw: productStateProbability.Probability =
    productPush.pushforward(resamplingProduct.finiteLaw(variables),forget)

  coin_point_mass: LEMMA FORALL(s:State,v:V):
    coins(v)(pointEvents(s)(v))=Q`mass(v)(s(v))

  coin_mass_function: LEMMA FORALL(s:State):
    (LAMBDA(v:V):coins(v)(pointEvents(s)(v)))=(LAMBDA(v:V):Q`mass(v)(s(v)))

  product_law_point_mass: LEMMA FORALL(s:State):
    productLaw(singleton[State](s))=productCore.productMass(Q,s)

END ppg_resampling_product_law
