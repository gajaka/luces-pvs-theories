% A checked closed bad class keeps every running-event mass equal to
% one. Finite count charges therefore rule out every finite expectation.
% Continuity from above gives full mass to paths that never reach good.
%
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, American Mathematical Society, 2017.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_finite_closed_bad_tail[State,Omega: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  (IMPORTING measure_probability@ppg_nasa_sigma[Omega]) S:MeasurableSpace,
  (IMPORTING measure_probability@ppg_finite_law_view[Omega,S]) measureLaw:FiniteLaw,
  (IMPORTING measure_probability@ppg_filtration[Omega,State,S]) history:Filtration]: THEORY
BEGIN
  IMPORTING ppg_finite_survival_probability[State,Omega,universe,S,measureLaw,history],
    ppg_finite_potential_tail_bound[State,Omega,universe,S,measureLaw,history]
  M: VAR Model
  X: VAR AdaptedProcess
  z: VAR ENN

  nat_lower_unbounded: LEMMA (FORALL(N:nat):ele(ennFinite(N+1),z)) IMPLIES z=ennInfinity

  closed_running_mass_one: LEMMA FORALL(M:StochasticModel,U:CheckedClass(M),
    X:Realization(M),s0:State):U(s0) AND mass(fullset[Omega])=1 AND
    (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES
      (FORALL(N:nat):mass(runningAmbient(M,X,N))=1)

  closed_running_lower: LEMMA FORALL(M:StochasticModel,U:CheckedClass(M),
    X:Realization(M),s0:State):U(s0) AND mass(fullset[Omega])=1 AND
    (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES
      (FORALL(N:nat):ele(ennFinite(N+1),expectedHitCount(M,X)))

  expectedHitCount_closedBad_eq_top: THEOREM FORALL(M:StochasticModel,U:CheckedClass(M),
    X:Realization(M),s0:State):U(s0) AND mass(fullset[Omega])=1 AND
    (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES expectedHitCount(M,X)=ennInfinity

  constant_running_limit: LEMMA (FORALL(N:nat):mass(runningAmbient(M,X,N))=1) IMPLIES
    convergence_sequences.convergence((LAMBDA(n:nat):mass(runningAmbient(M,X,n))),1)

  closed_running_intersection_one: LEMMA FORALL(M:StochasticModel,U:CheckedClass(M),
    X:Realization(M),s0:State):U(s0) AND mass(fullset[Omega])=1 AND
    (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES
      mass(finiteIntersection(runningSchedule(M,X)))=1

  closed_success_mass_zero: LEMMA FORALL(M:StochasticModel,U:CheckedClass(M),
    X:Realization(M),s0:State):U(s0) AND mass(fullset[Omega])=1 AND
    (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES mass(measurableSuccess(M,X))=0

  neverGood(M,X): set[Omega] = {omega:Omega|FORALL(n:nat):NOT M`good(X(n)(omega))}

  never_good_complement_success: LEMMA neverGood(M,X)=complement(measurableSuccess(M,X))

  ae_never_good_closedBad: THEOREM FORALL(M:StochasticModel,U:CheckedClass(M),
    X:Realization(M),s0:State):U(s0) AND mass(fullset[Omega])=1 AND
    (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES ae?(neverGood(M,X))

END ppg_finite_closed_bad_tail
