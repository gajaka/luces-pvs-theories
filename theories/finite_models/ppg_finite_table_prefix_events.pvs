% A state prefix fixes its counter vector. Agreement on the associated
% consumed table block therefore preserves the prefix event in both
% directions, even when the footprint is chosen adaptively.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Section 2.
ppg_finite_table_prefix_events[V,Value: TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_finite_table_core[V,Value,variables,domains] AS eventTable,
    ppg_finite_table_paths[V,Value,variables,domains] AS eventPaths,
    ppg_finite_table_consumed[V,variables] AS eventConsumed,
    ppg_finite_table_stability[V,Value,variables,domains] AS eventStability

  ResamplingLog: TYPE = eventTable.ResamplingLog

  Footprint: TYPE = eventTable.Footprint

  Initializer: TYPE = eventTable.Initializer

  F: VAR Footprint
  init: VAR Initializer
  n: VAR nat
  omega1,omega2: VAR ResamplingLog

  PrefixAgreement(F:Footprint,n:nat,p:eventPaths.Path(n),omega1,omega2:ResamplingLog): bool =
    FORALL(slot:[nat,V]):eventConsumed.consumedBlock(eventPaths.pathCount(F,n,p))(slot) IMPLIES
      omega1(slot)=omega2(slot)

  prefix_agreement_symm: LEMMA FORALL(F:Footprint,n:nat,p:eventPaths.Path(n),
    omega1,omega2:ResamplingLog):
      PrefixAgreement(F,n,p,omega1,omega2) IMPLIES PrefixAgreement(F,n,p,omega2,omega1)

  prefix_read_agreement: LEMMA FORALL(F:Footprint,init:Initializer,n:nat,p:eventPaths.Path(n),
    omega1,omega2:ResamplingLog):
      PrefixAgreement(F,n,p,omega1,omega2) AND eventPaths.statePrefix(F,init,n,omega1)=p IMPLIES
        eventStability.Agreement(F,init,n,omega1,omega2)

  prefix_same_from_runs: LEMMA
    (FORALL(k:nat):k<=n IMPLIES eventTable.run(F,init,omega1,k)=eventTable.run(F,init,omega2,k)) IMPLIES
      eventPaths.statePrefix(F,init,n,omega1)=eventPaths.statePrefix(F,init,n,omega2)

  prefix_transfer: LEMMA FORALL(F:Footprint,init:Initializer,n:nat,p:eventPaths.Path(n),
    omega1,omega2:ResamplingLog):
      eventTable.InitialLocal(init) AND PrefixAgreement(F,n,p,omega1,omega2) AND
      eventPaths.statePrefix(F,init,n,omega1)=p IMPLIES eventPaths.statePrefix(F,init,n,omega2)=p

  prefix_event_depends_consumed: THEOREM FORALL(F:Footprint,init:Initializer,n:nat,p:eventPaths.Path(n),
    omega1,omega2:ResamplingLog):
      eventTable.InitialLocal(init) AND PrefixAgreement(F,n,p,omega1,omega2) IMPLIES
      (eventPaths.statePrefix(F,init,n,omega1)=p IFF eventPaths.statePrefix(F,init,n,omega2)=p)

END ppg_finite_table_prefix_events
