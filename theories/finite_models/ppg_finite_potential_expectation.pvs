% The expected first-hit count is the supremum of its finite running
% counts. The exact horizon identity and vanishing stopped potential
% identify this expectation with the initial state potential integral.
% Probability normalization is used only for a fixed initial state.
%
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, Exercise 10.22(a), American Mathematical Society, 2017.
% Michael Mitzenmacher and Eli Upfal, Probability and Computing,
% second edition, Section 7.1.1, Cambridge University Press, 2017.
ppg_finite_potential_expectation[State,Omega: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  (IMPORTING measure_probability@ppg_nasa_sigma[Omega]) S:MeasurableSpace,
  (IMPORTING measure_probability@ppg_finite_law_view[Omega,S]) measureLaw:FiniteLaw,
  (IMPORTING measure_probability@ppg_filtration[Omega,State,S]) history:Filtration]: THEORY
BEGIN
  IMPORTING ppg_finite_stopped_limit[State,Omega,universe,S,measureLaw,history],
    measure_probability@ppg_exact_count_limit
  M: VAR Model
  X: VAR AdaptedProcess
  s0: VAR State

  StochasticAbsorbingModel: TYPE = {M:Model|Stochastic(M) AND Absorbing(M)}

  checkedSolution(M:StochasticAbsorbingModel,f:SolvingVector(M)): CheckedVector(M) = f

  initialMean(M:StochasticAbsorbingModel,f:SolvingVector(M),X:AdaptedProcess): nonneg_real =
    stoppedMean(M,f,X,0)

  expected_hit_running: LEMMA expectedHitCount(M,X)=expectedCount(runningSchedule(M,X))

  expected_running_sup: LEMMA expectedCount(runningSchedule(M,X))=
    iSupNN(LAMBDA(N:nat):massPrefix(runningSchedule(M,X),N))

  expectedHitCount_eq_of_equations: THEOREM FORALL(M:StochasticAbsorbingModel,
    f:SolvingVector(M),X:Realization(M)):
    expectedHitCount(M,X)=ofReal(integral(integrableValue(f,ambientState(X,0))))

  fixed_initial_integral: LEMMA FORALL(M:StochasticAbsorbingModel,f:SolvingVector(M),
    X:AdaptedProcess,s0:State):
    mass(fullset[Omega])=1 AND (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES
      integral(integrableValue(f,ambientState(X,0)))=f(s0)

  expectedHitCount_fixed_eq_of_equations: THEOREM FORALL(M:StochasticAbsorbingModel,
    f:SolvingVector(M),X:Realization(M),s0:State):
    mass(fullset[Omega])=1 AND (FORALL(omega:Omega):X(0)(omega)=s0) IMPLIES
      expectedHitCount(M,X)=ofReal(f(s0))

END ppg_finite_potential_expectation
