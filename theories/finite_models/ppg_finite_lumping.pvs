% A compatible projection preserves good states and sums each concrete
% transition row over the fibers of the projection. These exact local
% identities preserve weighted rows, first-step equations and survival.
% Surjectivity is used to infer every abstract stochastic row.
% Accepted witnesses and closed bad classes pull back along the map.
%
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, Section 2.3.1, Lemma 2.5 and equation (2.10),
% American Mathematical Society, 2017.
ppg_finite_lumping[State,Abstract: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  abstractUniverse:{U:finite_set[Abstract]|FORALL(a:Abstract):U(a)}]: THEORY
BEGIN
  IMPORTING ppg_finite_drift[State,universe] AS concrete,
    ppg_finite_drift[Abstract,abstractUniverse] AS reduced,
    ppg_finite_potential_system[State,universe] AS concreteSystem,
    ppg_finite_potential_system[Abstract,abstractUniverse] AS reducedSystem,
    ppg_finite_potential_order[State,universe] AS concreteOrder,
    ppg_finite_potential_order[Abstract,abstractUniverse] AS reducedOrder,
    ppg_finite_survival[State,universe] AS concreteSurvival,
    ppg_finite_survival[Abstract,abstractUniverse] AS reducedSurvival,
    ppg_finite_closed_bad[State,universe] AS concreteClosed,
    ppg_finite_closed_bad[Abstract,abstractUniverse] AS reducedClosed,
    foundations@ppg_monoid_sum[State,rat,0,LAMBDA(x,y:rat):x+y] AS sourceSum,
    foundations@ppg_finite_weighted_projection[State,Abstract]
  M: VAR concrete.Model
  N: VAR reduced.Model
  p: VAR [State->Abstract]
  f: VAR reducedSystem.Vector
  s,t: VAR State
  a: VAR Abstract
  n: VAR nat
  W: VAR reduced.Witness
  U: VAR set[Abstract]
  s0: VAR State

  fiberMass(M,p,s,a): rat = sourceSum.sum(universe,
    LAMBDA(t:State):IF a=p(t) THEN M`transition(s,t) ELSE 0 ENDIF)

  Compatible(M,N,p): bool =
    (FORALL(s:State):M`good(s)=N`good(p(s))) AND
    (FORALL(s:State,a:Abstract):fiberMass(M,p,s,a)=N`transition(p(s),a))

  check(M,N,p): bool =
    ppg_finite_all[State].finiteAll(universe,LAMBDA(s:State):M`good(s)=N`good(p(s))) AND
    ppg_finite_all[State].finiteAll(universe,LAMBDA(s:State):
      ppg_finite_all[Abstract].finiteAll(abstractUniverse,
        LAMBDA(a:Abstract):fiberMass(M,p,s,a)=N`transition(p(s),a)))

  check_iff: THEOREM check(M,N,p) IFF Compatible(M,N,p)

  compatible_good: LEMMA Compatible(M,N,p) IMPLIES M`good(s)=N`good(p(s))

  good_function_projection: LEMMA Compatible(M,N,p) IMPLIES
    M`good=(LAMBDA(s:State):N`good(p(s)))

  compatible_fiber: LEMMA Compatible(M,N,p) IMPLIES
    fiberMass(M,p,s,a)=N`transition(p(s),a)

  fiber_mass_real: LEMMA
    fiberWeight(universe,p,LAMBDA(t:State):M`transition(s,t),a)=fiberMass(M,p,s,a)

  fiber_weighted_function: LEMMA Compatible(M,N,p) IMPLIES
    (LAMBDA(a:Abstract):fiberMass(M,p,s,a)*f(a))=
    (LAMBDA(a:Abstract):N`transition(p(s),a)*f(a))

  weighted_projection: THEOREM Compatible(M,N,p) IMPLIES
    concreteSystem.successorValue(M,LAMBDA(t:State):f(p(t)),s)=
    reducedSystem.successorValue(N,f,p(s))

  equations_pullback: THEOREM Compatible(M,N,p) AND reducedSystem.Equations(N,f)
    IMPLIES concreteSystem.Equations(M,LAMBDA(s:State):f(p(s)))

  survival_projection: THEOREM Compatible(M,N,p) IMPLIES
    concreteSurvival.survival(M,n,s)=reducedSurvival.survival(N,n,p(s))

  weighted_term_nonnegative: LEMMA concreteOrder.Stochastic(M) IMPLIES
    0<=(IF a=p(t) THEN M`transition(s,t) ELSE 0 ENDIF)

  fiber_nonnegative: LEMMA concreteOrder.Stochastic(M) IMPLIES 0<=fiberMass(M,p,s,a)

  projected_transition_nonnegative: LEMMA Compatible(M,N,p) AND concreteOrder.Stochastic(M)
    IMPLIES 0<=N`transition(p(s),a)

  projected_row_normalized: LEMMA Compatible(M,N,p) AND concreteOrder.Stochastic(M)
    IMPLIES reducedSystem.successorValue(N,LAMBDA(a:Abstract):1,p(s))=1

  stochastic_projected: THEOREM Compatible(M,N,p) AND surjective?[State,Abstract](p)
    AND concreteOrder.Stochastic(M) IMPLIES reducedOrder.Stochastic(N)

  pullWitness(p,W): concrete.Witness =
    (# potential:=LAMBDA(s:State):W`potential(p(s)),delta:=W`delta #)

  pull_local_expectation: LEMMA Compatible(M,N,p) IMPLIES
    concrete.localExpectation(M,pullWitness(p,W),s)=reduced.localExpectation(N,W,p(s))

  witness_checked: THEOREM Compatible(M,N,p) AND concreteOrder.Stochastic(M)
    AND reduced.check(N,W) IMPLIES concrete.check(M,pullWitness(p,W))

  fiber_member_bound: LEMMA concreteOrder.Stochastic(M) IMPLIES
    M`transition(s,t)<=fiberMass(M,p,s,p(t))

  pull_closed_bad_state: LEMMA Compatible(M,N,p) AND reducedClosed.ClosedBad(N,U)
    AND U(p(s)) IMPLIES NOT M`good(s)

  pull_closed_transition_zero: LEMMA Compatible(M,N,p) AND concreteOrder.Stochastic(M)
    AND reducedClosed.ClosedBad(N,U) AND U(p(s)) AND NOT U(p(t))
    IMPLIES M`transition(s,t)=0

  closedBad_pullback: THEOREM Compatible(M,N,p) AND concreteOrder.Stochastic(M)
    AND reducedClosed.ClosedBad(N,U) AND U(p(s0)) IMPLIES
    concreteClosed.ClosedBad(M,LAMBDA(s:State):U(p(s)))

  checkedClosedBad_refutes: THEOREM Compatible(M,N,p) AND concreteOrder.Stochastic(M)
    AND reducedClosed.checkClosedBad(N,U) AND U(p(s0)) IMPLIES
      NOT ppg_finite_potential_reach[State,universe].ReachesGood(M,s0)

END ppg_finite_lumping
