% Running indicators of the stopped table execution and the original
% counter-driven trajectory agree at every time on the same table.
% Their nonnegative sums therefore agree, including the infinite case.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Section 2.
ppg_finite_mt_count[I,V,Value:TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]],
  events:{U:finite_set[I]|FORALL(i:I):U(i)},
  fallback:I,eventOrder:{e:list[I]|FORALL(i:I):member(i,e)},
  (IMPORTING ppg_finite_table_core[V,Value,variables,domains],
    measure_probability@ppg_measurable_space[ppg_finite_table_core[V,Value,variables,domains].ResamplingLog])
  ambient:ppg_measurable_space[ppg_finite_table_core[V,Value,variables,domains].ResamplingLog].MeasurableSpace]: THEORY
BEGIN
  State: TYPE = ppg_finite_table_core[V,Value,variables,domains].State

  ResamplingLog: TYPE = ppg_finite_table_core[V,Value,variables,domains].ResamplingLog

  plainDomain: MACRO [V->set[Value]] = LAMBDA(v:V):domains(v)

  IMPORTING ppg_finite_mt_legacy[I,V,Value,variables,domains,events,fallback,eventOrder] AS countBridge,
    ppg_finite_table_core[V,Value,variables,domains] AS countTable,
    ppg_finite_resampling_core[V,Value,variables,domains] AS countCore,
    ppg_resampling_selection[I,V,Value,variables,domains,events] AS countSelection,
    ppg_resampling_state_finite[V,Value,variables,domains] AS countStates,
    moser_tardos@ppg_mt_random_process[I,V,Value,plainDomain] AS countSlots,
    moser_tardos@ppg_mt_correspondence[I,V,Value,plainDomain] AS countRunning,
    moser_tardos@ppg_mt_extended_count[I,V,Value,plainDomain] AS oldCount,
    measure_probability@ppg_nonneg_tsum[nat],
    ppg_finite_update[State,State,countStates.allStates,countStates.allStates] AS countUpdate,
    ppg_finite_drift[State,countStates.allStates] AS countDrift,
    ppg_finite_process_stopping[State,ResamplingLog,countStates.allStates,ambient] AS modernCount

  Q: VAR countCore.Marginals
  B: VAR countSelection.Problem
  init: VAR countTable.Initializer
  omega: VAR ResamplingLog
  n: VAR nat

  tableModel(Q,B): countDrift.Model = countUpdate.model(countCore.rule(Q,countBridge.firstPolicy(B)))

  tableProcess(B,init): [nat->[ResamplingLog->State]] =
    LAMBDA(n:nat):LAMBDA(omega:ResamplingLog):
      countTable.trajectory(countBridge.stoppedFootprint(B),init,n,omega)

  running_event: LEMMA modernCount.runningEvent(tableModel(Q,B),tableProcess(B,init),n)(omega) IFF
    countRunning.RunningUntil(B`footprint,B`bad,fallback,eventOrder,init(omega),omega,n+1)

  modernTerms(Q,B,init,omega): [nat->nonneg_real] = LAMBDA(n:nat):
    IF modernCount.runningEvent(tableModel(Q,B),tableProcess(B,init),n)(omega) THEN 1 ELSE 0 ENDIF

  legacyTerms(B,init,omega): [nat->nonneg_real] = LAMBDA(n:nat):
    IF countRunning.RunningUntil(B`footprint,B`bad,fallback,eventOrder,init(omega),omega,n+1)
      THEN 1 ELSE 0 ENDIF

  indicator_function: LEMMA modernTerms(Q,B,init,omega)=legacyTerms(B,init,omega)

  table_hitCount_eq_TLog: THEOREM modernCount.hitCount(tableModel(Q,B),tableProcess(B,init),omega)=
    oldCount.TLog(B`footprint,B`bad,fallback,eventOrder,init(omega),omega)

END ppg_finite_mt_count
