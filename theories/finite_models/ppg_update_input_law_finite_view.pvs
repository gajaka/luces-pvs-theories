% For a finite state carrier, the general input-law construction agrees
% with the earlier IID construction on the original rule. Equality is of
% the full laws, not merely of coordinate marginal values.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_update_input_law_finite_view[State,Input: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)},
  (IMPORTING ppg_finite_update[State,Input,universe,inputs])
  R:{R:Rule|Valid(R)}]: THEORY
BEGIN
  IMPORTING ppg_finite_input_update[State,Input,inputs] AS inputViewRaw,
    ppg_finite_update_view[State,Input,universe,inputs] AS inputViewFinite,
    ppg_finite_update_law[State,Input,universe,inputs] AS inputViewPMF,
    ppg_finite_iid_law[State,Input,universe,inputs,R] AS inputViewIID

  raw_valid: LEMMA inputViewRaw.Valid(R)

  IMPORTING ppg_update_input_law[State,Input,inputs,R] AS inputViewGeneral,
    ppg_finite_iid_mass_invariance[Input,State,Input,inputs,universe,inputs,
      inputViewGeneral.shadowRule,R] AS inputViewInvariance

  shadow_mass_function: LEMMA inputViewGeneral.shadowRule`mass=R`mass

  native_input_view: LEMMA inputViewGeneral.inputPMF=inputViewPMF.inputPMF(R)

  native_iid_view: LEMMA inputViewGeneral.iidMeasure=inputViewIID.iidMeasure

END ppg_update_input_law_finite_view
