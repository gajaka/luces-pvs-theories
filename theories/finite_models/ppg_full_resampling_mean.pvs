% The stopped work is the sum of the geometric running probabilities.
% Positive good-state mass makes this expectation finite. A measurable
% safe box gives the reciprocal bound; a zero-mass box keeps the bound
% infinite, as required by the extended nonnegative arithmetic.
%
% Michael Mitzenmacher and Eli Upfal, Probability and Computing,
% second edition, Cambridge University Press, 2017, geometric distribution.
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Section 2.
ppg_full_resampling_mean[C,V,Value:TYPE,domain:[V->set[Value]],
  universe:{U:finite_set[V]|FORALL(v:V):U(v)},
  events:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING moser_tardos@ppg_mt_coordinate_laws[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),fallback:C]: THEORY
BEGIN
  IMPORTING ppg_full_resampling_probability[C,V,Value,domain,universe,events,spaces,laws] AS probability,
    ppg_full_resampling_running[C,V,Value,domain,universe,events,spaces,laws] AS running,
    ppg_full_resampling_paths[C,V,Value,domain,universe] AS paths,
    moser_tardos@ppg_mt_semantics[C,V,Value,domain] AS semantics,
    moser_tardos@ppg_mt_random_process[C,V,Value,domain] AS slots,
    moser_tardos@ppg_mt_selection[C,V,Value,domain] AS selection,
    moser_tardos@ppg_mt_reach[C,V,Value,domain] AS reach,
    ppg_core@ppg_repair_semantics[semantics.MTState] AS repairPred,
    moser_tardos@ppg_mt_check_probability[C,V,Value,domain,spaces,laws] AS checks,
    moser_tardos@ppg_mt_time_expectation[C,V,Value,domain,spaces,laws] AS legacy,
    moser_tardos@ppg_mt_termination[C,V,Value,domain,spaces,laws] AS termination,
    moser_tardos@ppg_mt_native_spaces[C,V,Value,domain] AS nativeSpaces,
    moser_tardos@ppg_mt_log_probability[C,V,Value,domain,spaces,laws] AS originalLaw,
    measure_probability@ppg_measurable_block_box[V,Value,domain,spaces] AS boxes,
    measure_probability@ppg_nonneg_tsum[nat] AS total,
    measure_probability@ppg_enn_sup AS enn,
    measure_probability@ppg_probability_integral[slots.LogSpace,nativeSpaces.NativeTableSigma(spaces),originalLaw.logMeasure] AS logIntegral,
    measure_probability@ppg_nasa_sigma[slots.LogSpace] AS logSigmaBridge,
    measure_probability@ppg_enn_geometric AS geometric,
    measure_probability@ppg_enn_add AS order

  universe_full: LEMMA universe=fullset[V]

  IMPORTING moser_tardos@ppg_mt_budget_repair[C,V,Value,domain,universe,spaces,laws,fallback] AS repair

  B: VAR probability.MeasurableBad
  vars: VAR [C->finite_set[V]]
  enumeration: VAR legacy.FullEnumeration
  E: VAR boxes.CoordinateEvents
  edges: VAR [semantics.MTState,semantics.MTState->bool]

  nativeBad(B): checks.NativeBad = B

  expectedWork(vars,B,enumeration): enn.ENN = legacy.randomInitETLog(vars,nativeBad(B),fallback,enumeration)

  running_masses: LEMMA paths.Full(vars) IMPLIES
    (LAMBDA(n:nat):originalLaw.logMeasure(legacy.randomRun(vars,nativeBad(B),fallback,enumeration)(n)))=
      geometric.terms(probability.mtBadProbability(B))

  fullResampling_expected_work_eq: THEOREM paths.Full(vars) IMPLIES
    expectedWork(vars,B,enumeration)=geometric.geometricMean(probability.mtBadProbability(B))

  good_bad_complement: LEMMA 1-probability.mtBadProbability(B)=probability.mtGoodProbability(B)

  fullResampling_expected_work_lt_top: THEOREM paths.Full(vars) AND 0<probability.mtGoodProbability(B) IMPLIES
    ennFinite?(expectedWork(vars,B,enumeration))

  fullResampling_ae_exists_good: THEOREM paths.Full(vars) AND 0<probability.mtGoodProbability(B) IMPLIES
    ae?[slots.LogSpace,logSigmaBridge.asNasa(nativeSpaces.NativeTableSigma(spaces)),logIntegral.nasaLaw](
      termination.terminationEvent(vars,nativeBad(B),fallback,enumeration))

  fullResampling_expected_work_le_of_box: THEOREM paths.Full(vars) AND probability.SafeBox(B,E) IMPLIES
    ele(expectedWork(vars,B,enumeration),geometric.inverseFinite(probability.boxMass(E)))

  fullResampling_box_expected_work_lt_top: THEOREM paths.Full(vars) AND probability.SafeBox(B,E) AND
    (FORALL(v:V):0<laws(v)(E(v))) IMPLIES ennFinite?(expectedWork(vars,B,enumeration))

  full_footprint_well_formed: LEMMA paths.Full(vars) IMPLIES semantics.mt_wf(vars,B)

  fullResampling_globally_repairable: THEOREM paths.Full(vars) AND 0<probability.mtGoodProbability(B) IMPLIES
    repairPred.globally_repairable(reach.mtRepairGraph(vars,nativeBad(B),fallback,enumeration,edges))

END ppg_full_resampling_mean
