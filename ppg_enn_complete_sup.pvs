% Finite lower approximations determine an extended nonnegative supremum.
% A set containing infinity has every finite approximation; its supremum
% is infinity. The empty set has supremum zero.
%
% Sterling K. Berberian, Fundamentals of Real Analysis, Springer, 1999.
% The real completeness used here is the project's existing sSup.
ppg_enn_complete_sup: THEORY
BEGIN
  IMPORTING ppg_enn_add
  A: VAR set[ENN]
  x,y: VAR ENN
  a,b: VAR nonneg_real
  lowerFinite(A): set[nonneg_real] = {a:nonneg_real|
    EXISTS(x:ENN):A(x) AND ele(ennFinite(a),x)}
  extendedSup(A): ENN = sSup(lowerFinite(A))
  lower_finite_member: LEMMA A(x) AND ele(ennFinite(a),x) IMPLIES lowerFinite(A)(a)
  finite_tests: LEMMA
    (FORALL(a:nonneg_real):ele(ennFinite(a),x) IMPLIES a<=b) IFF ele(x,ennFinite(b))
  lower_finite_bound: LEMMA
    (FORALL(a:nonneg_real):lowerFinite(A)(a) IMPLIES a<=b) IFF
    (FORALL(x:ENN):A(x) IMPLIES ele(x,ennFinite(b)))
  extended_sup_finite_bound: LEMMA ele(extendedSup(A),ennFinite(b)) IFF
    (FORALL(x:ENN):A(x) IMPLIES ele(x,ennFinite(b)))
  extended_sup_upper: THEOREM A(x) IMPLIES ele(x,extendedSup(A))
  extended_sup_least: THEOREM
    (FORALL(x:ENN):A(x) IMPLIES ele(x,y)) IMPLIES ele(extendedSup(A),y)
END ppg_enn_complete_sup
