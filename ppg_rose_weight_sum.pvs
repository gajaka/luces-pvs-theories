% The sum of node-product weights over the canonical depth-D family
% equals mtWeight(D,a). Splitting by the chosen child-label subset gives
% the product of 1 + mtWeight(D,b), including the option of no child.
%
% Noga Alon and Joel H. Spencer, The Probabilistic Method, 4th ed.,
% Wiley, 2016, Section 5.7, "Moser's Fix-It Algorithm".
% Equation (5.9) and Theorem 5.7.3.
% Lean counterpart: PPGraphMoserTardosWeightSum.lean.
% The identity counts canonical representatives, not all sibling orders.

ppg_rose_weight_sum[C,V: TYPE]: THEORY
BEGIN
  IMPORTING ppg_rose_enumeration[C,V],
    ppg_bind_sum[finite_set[C],WTree,nonneg_real,0,LAMBDA(x,y:nonneg_real):x+y] AS enumSum,
    ppg_nonneg_folds[C] AS labelAlgebra
  vars: VAR CertVars
  U,S: VAR finite_set[C]
  D: VAR nat
  a: VAR C
  p: VAR [C -> nonneg_real]

  enum_mass(vars,U,p,D,a): nonneg_real = treeSums.sum(wtreesUpTo(vars,U,D,a),weight(p))

  mtWeight(vars,U,p,D,a): RECURSIVE nonneg_real = IF D=0 THEN p(a)
    ELSE p(a)*indices.sum(plusNeighbors(vars,U,a),LAMBDA(b:C):1+mtWeight(vars,U,p,D-1,b))
    ENDIF MEASURE D

  mtWeight_zero: LEMMA mtWeight(vars,U,p,0,a)=p(a)

  mtWeight_succ: LEMMA mtWeight(vars,U,p,D+1,a)=p(a)*indices.sum(plusNeighbors(vars,U,a),
    LAMBDA(b:C):1+mtWeight(vars,U,p,D,b))

  enum_mass_zero: LEMMA enum_mass(vars,U,p,0,a)=p(a)

  root_mass_function: LEMMA
    (LAMBDA(S:finite_set[C]):treeSums.sum(rootFamily(a,S,LAMBDA(b:C):wtreesUpTo(vars,U,D,b)),weight(p))) =
    (LAMBDA(S:finite_set[C]):p(a)*indices.sum(S,LAMBDA(b:C):enum_mass(vars,U,p,D,b)))

  enum_mass_succ: LEMMA enum_mass(vars,U,p,D+1,a)=p(a)*indices.sum(plusNeighbors(vars,U,a),
    LAMBDA(b:C):1+enum_mass(vars,U,p,D,b))

  sum_wtreesUpTo_weight: THEOREM enum_mass(vars,U,p,D,a)=mtWeight(vars,U,p,D,a)

END ppg_rose_weight_sum
