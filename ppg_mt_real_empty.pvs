% Empty label carriers admit neither an execution log nor a rooted address tree.
ppg_mt_real_empty: THEORY
BEGIN
  Empty: TYPE = {b: bool | FALSE}
  IMPORTING ppg_mt_real_witness[Empty, Empty]
  no_log: THEOREM NOT EXISTS (Clog: [nat -> Empty]): TRUE
  no_growing_tree: THEOREM NOT EXISTS (T: GTree): TRUE
  no_witness_tree: THEOREM NOT EXISTS (t: WTree): TRUE
END ppg_mt_real_empty
