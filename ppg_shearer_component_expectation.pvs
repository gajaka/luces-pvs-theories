% The global run's sequence count is bounded by the proper-family sum.
% Confinement identifies that sum with the one in the root's full BDD
% component. Strict positivity is needed only on this component.
% The bound concerns resampling work; it makes no scheduling claim.
%
% Kolipaka--Szegedy expected-work bound, localized by Dragan Stosic's BDD
% decomposition. Jan Vondrak, MATH233A (2018), Lecture 8, Lemma 8.1.
% https://theory.stanford.edu/~jvondrak/MATH233A-2018/Math233-lec08.pdf
% Lean counterpart: PPGraphShearerComponentOccurrence.lean.
ppg_shearer_component_expectation[C,V,Value:TYPE,domain:[V->set[Value]],
  universe:{F:finite_set[V]|F=fullset[V]},
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain]) spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING ppg_bdd[C,V]) vars:CertVars]: THEORY
BEGIN
  IMPORTING ppg_shearer_event_expectation[C,V,Value,domain,universe,spaces,laws,vars],
    ppg_shearer_component_sequences[C,V,vars]
  bad: VAR NativeBad
  fallback,a,c: VAR C
  enumeration: VAR SeqProbabilityEnumeration
  B: VAR UniversalLabels
  p: VAR [C->real]
  component_singleton_subset: LEMMA compOf(vars,B,c)(a) IMPLIES
    subset?(sets[C].singleton(a),compOf(vars,B,c))
  component_nonnegative: LEMMA (FORALL(i:C):baseProbability(bad)(i)<=p(i)) IMPLIES
    nonnegativeOn(p,compOf(vars,B,c))
  global_count_le_total: LEMMA mt_wf(vars,bad) AND
    (FORALL(i:C):baseProbability(bad)(i)<=p(i)) IMPLIES
    ele(randomInitExpectedResamplingCount(vars,bad,fallback,enumeration,a),
      properFamilyTotal(p,B,sets[C].singleton(a)))
  randomInitExpectedResamplingCount_le_componentBudget: THEOREM mt_wf(vars,bad) AND
    (FORALL(i:C):baseProbability(bad)(i)<=p(i)) AND compOf(vars,B,c)(a) AND
    StrictCriterion(p,compOf(vars,B,c)) IMPLIES
    ele(randomInitExpectedResamplingCount(vars,bad,fallback,enumeration,a),
      ennFinite(max(0,stableBudget(p,compOf(vars,B,c),sets[C].singleton(a)))))
END ppg_shearer_component_expectation
