% A measurable policy may inspect the entire table. Finite label fibers
% suffice to measure equality of two selections and hence every earlier
% occurrence rank. No stopping or independence condition enters this step.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley,
% 1995, measurable functions and countable unions of events.
% Lean counterpart: PPGraphHLSPolicyCounting.lean, MTPolicy.
ppg_hls_policy_count_measurable[C,V,Value:TYPE,domain:[V->set[Value]],
  footprint:[C->finite_set[V]],
  (IMPORTING ppg_mt_semantics[C,V,Value,domain])bad:[C,MTState->bool],
  universe:{S:finite_set[C]|FORALL(a:C):S(a)},
  (IMPORTING ppg_mt_log_measurable[C,V,Value,domain])
  coordinates:[V->ppg_measurable_space[Value].MeasurableSpace]]: THEORY
BEGIN
  IMPORTING ppg_hls_policy_count_core[C,V,Value,domain,footprint,bad,universe,coordinates],
    ppg_mt_policy_schedule[C,V,Value,domain,universe,coordinates] AS measSchedule,
    ppg_event_count[LogSpace] AS measCounts,
    ppg_measurable_map[LogSpace,nat] AS policyNatMaps,
    ppg_measurable_map[LogSpace,ENN] AS policyCountMaps,
    ppg_finite_events[LogSpace,C,TableSigma(coordinates)] AS policyLabelEvents

  d: VAR PolicyData
  sig: VAR PolicySchedule
  a: VAR C
  omega: VAR LogSpace
  s,t,r: VAR nat

  labelFiber(d,a,t): set[LogSpace] = {omega:LogSpace|d`select(omega)(t)=a}

  resampling_event_intersection: LEMMA resamplingEvent(d,a,t)=
    intersection(measSchedule.runningEvent(footprint,bad,d,t+1),labelFiber(d,a,t))

  measurable_label_fiber: LEMMA TableSigma(coordinates)(labelFiber(sig,a,t))

  measurableSet_resamplingEvent: THEOREM measSchedule.BadMeasurable(bad) IMPLIES
    TableSigma(coordinates)(resamplingEvent(sig,a,t))

  measurable_resampling_family: LEMMA measSchedule.BadMeasurable(bad) IMPLIES
    FORALL(t:nat):TableSigma(coordinates)(selectedEvents(sig,a)(t))

  measurable_count: THEOREM measSchedule.BadMeasurable(bad) IMPLIES
    policyCountMaps.measurable(TableSigma(coordinates),ENNSigma,
      LAMBDA(omega:LogSpace):count(sig,omega,a))

  sameLabelTime(d,t)(s): set[LogSpace] = {omega:LogSpace|
    d`select(omega)(s)=d`select(omega)(t)}

  sameLabelComplement(d,s,t)(a): set[LogSpace] = complement(intersection(
    labelFiber(d,a,s),labelFiber(d,a,t)))

  same_label_complement_meet: LEMMA sameLabelTime(d,t)(s)=
    complement(policyLabelEvents.finiteMeet(universe,sameLabelComplement(d,s,t)))

  measurable_same_label_complement: LEMMA
    TableSigma(coordinates)(sameLabelComplement(sig,s,t)(a))

  measurable_same_label_family: LEMMA
    FORALL(a:C):TableSigma(coordinates)(sameLabelComplement(sig,s,t)(a))

  measurable_same_label_time: LEMMA TableSigma(coordinates)(sameLabelTime(sig,t)(s))

  earlier_count_prefix: LEMMA earlierLabelCount(d`select(omega),t)=
    measCounts.countPrefix(sameLabelTime(d,t),omega,t)

  earlier_count_prefix_function: LEMMA
    (LAMBDA(omega:LogSpace):earlierLabelCount(d`select(omega),t))=
    (LAMBDA(omega:LogSpace):measCounts.countPrefix(sameLabelTime(d,t),omega,t))

  measurable_rank_prefix: LEMMA
    policyNatMaps.measurable(TableSigma(coordinates),fullset[set[nat]],
      LAMBDA(omega:LogSpace):earlierLabelCount(sig`select(omega),t))

  measurable_earlierLabelCount: THEOREM measSchedule.BadMeasurable(bad) IMPLIES
    policyNatMaps.measurable(TableSigma(coordinates),fullset[set[nat]],
      LAMBDA(omega:LogSpace):earlierLabelCount(sig`select(omega),t))

  ordinal_rank_preimage: LEMMA ordinalRankFiber(d,t,r)=
    policyNatMaps.inverseImage(
      LAMBDA(omega:LogSpace):earlierLabelCount(d`select(omega),t),singleton[nat](r))

  measurable_ordinal_rank_fiber: LEMMA TableSigma(coordinates)(ordinalRankFiber(sig,t,r))

  measurable_ordinal_component: LEMMA measSchedule.BadMeasurable(bad) IMPLIES
    TableSigma(coordinates)(intersection(resamplingEvent(sig,a,t),ordinalRankFiber(sig,t,r)))

  measurable_ordinal_family: LEMMA measSchedule.BadMeasurable(bad) IMPLIES
    FORALL(t:nat):TableSigma(coordinates)(intersection(resamplingEvent(sig,a,t),ordinalRankFiber(sig,t,r)))

  measurableSet_ordinalOccurrence: THEOREM measSchedule.BadMeasurable(bad) IMPLIES
    TableSigma(coordinates)(ordinalOccurrence(sig,a,r))

END ppg_hls_policy_count_measurable
