% Agreement is on actual augmented table cells, including both sum tags.
% Process locality uses only the finite footprint at each endpoint; no
% measurability or probability premise enters this dependence statement.
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Lemma 3.4. Lean: PPGraphHLSUnitChecks.lean.
ppg_hls_unit_event_dependence[C,V,Value:TYPE,domain:[V->set[Value]],
  default:C,universe:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:MTProcess]: THEORY
BEGIN
  IMPORTING ppg_hls_unit_checks[C,V,Value,domain,default,universe,
      spaces,laws,process] AS units,
    ppg_hls_augmented_pair_events[C,V,Value,domain,default,universe,
      spaces,laws,process] AS pairs,
    ppg_hls_augmented_space[C,V,Value,domain,spaces,laws] AS aug,
    ppg_mt_native_process[C,V,Value,domain,spaces,laws] AS native,
    ppg_shearer_bdd[C,V,process`footprint] AS graph,
    ppg_hls_witness_dag[C,graph.dependencyGraph] AS dags,
    ppg_hls_table_coordinates[C,V,process`footprint] AS originalCoordinates,
    ppg_hls_augmented_coordinates[C,V,process`footprint] AS coords,
    ppg_hls_pair_keys[C,graph.dependencyGraph] AS keys,
    ppg_hls_table_events[C,V,Value,domain,spaces,laws,process] AS tables,
    ppg_hls_process_table_bridge[C,V,Value,domain,spaces,laws,process] AS bridge,
    ppg_hls_table_check_core[C,V,Value,domain,process`footprint,native.badTest(process)] AS raw,
    ppg_hls_swapped_tests[C,V,Value,domain,process`footprint,native.badTest(process)] AS swaps

  M: VAR keys.DependencyMatching

  D: VAR dags.WitnessDAG

  u,v: VAR dags.WNode

  a: VAR V

  e: VAR pairs.Arc

  U: VAR units.CheckUnit

  eta,theta: VAR aug.AugTable

  A,B: VAR set[coords.AugmentedCoordinate]

  sigma,tau: VAR native.State

  agrees(B,eta,theta): bool = FORALL(q:coords.AugmentedCoordinate):
    B(q) IMPLIES eta(q)=theta(q)

  agrees_union_left: LEMMA agrees(union(A,B),eta,theta) IMPLIES agrees(A,eta,theta)

  agrees_union_right: LEMMA agrees(union(A,B),eta,theta) IMPLIES agrees(B,eta,theta)

  agrees_union_intro: LEMMA agrees(A,eta,theta) AND agrees(B,eta,theta)
    IMPLIES agrees(union(A,B),eta,theta)

  swapped_orientation_symmetry: LEMMA
    swaps.swapShared(u,v)(sigma,tau)=swaps.swapShared(v,u)(sigma,tau)

  original_data_agreement: LEMMA agrees(coords.dataCoordinates(D,u),eta,theta) IMPLIES
    (FORALL(p:[nat,V]):originalCoordinates.tableCoordinates(D,u)(p) IMPLIES
      aug.originalTable(eta)(p)=aug.originalTable(theta)(p))

  data_sample_agreement: LEMMA agrees(coords.dataCoordinates(D,u),eta,theta) AND
    process`footprint(u`1)(a) IMPLIES
      aug.originalTable(eta)((originalCoordinates.localIndex(D,u)(a),a))=
      aug.originalTable(theta)((originalCoordinates.localIndex(D,u)(a),a))

  original_single_depends: LEMMA agrees(coords.dataCoordinates(D,u),eta,theta) IMPLIES
    (tables.tableEvent(D,u)(aug.originalTable(eta)) IFF
      tables.tableEvent(D,u)(aug.originalTable(theta)))

  raw_single_depends: LEMMA agrees(coords.dataCoordinates(D,u),eta,theta) IMPLIES
    (raw.tableEvent(D,u)(aug.originalTable(eta)) IFF
      raw.tableEvent(D,u)(aug.originalTable(theta)))

  pair_agreement_data_source: LEMMA agrees(coords.pairCoordinates(M,D,e),eta,theta) IMPLIES
    agrees(coords.dataCoordinates(D,e`1),eta,theta)

  pair_agreement_data_target: LEMMA agrees(coords.pairCoordinates(M,D,e),eta,theta) IMPLIES
    agrees(coords.dataCoordinates(D,e`2),eta,theta)

  pair_agreement_coin: LEMMA agrees(coords.pairCoordinates(M,D,e),eta,theta) IMPLIES
    pairs.pairCoin(M,D,e,eta)=pairs.pairCoin(M,D,e,theta)

  swapped_cell_agreement: LEMMA
    agrees(union(coords.dataCoordinates(D,u),coords.dataCoordinates(D,v)),eta,theta) AND
    process`footprint(u`1)(a) IMPLIES
      swaps.swapShared(u,v)(raw.tableState(D,u)(aug.originalTable(eta)),
        raw.tableState(D,v)(aug.originalTable(eta)))(a)=
      swaps.swapShared(u,v)(raw.tableState(D,u)(aug.originalTable(theta)),
        raw.tableState(D,v)(aug.originalTable(theta)))(a)

  swapped_bad_depends: LEMMA
    agrees(union(coords.dataCoordinates(D,u),coords.dataCoordinates(D,v)),eta,theta) IMPLIES
    (native.badTest(process)(u`1,swaps.swapShared(u,v)(
      raw.tableState(D,u)(aug.originalTable(eta)),raw.tableState(D,v)(aug.originalTable(eta)))) IFF
     native.badTest(process)(u`1,swaps.swapShared(u,v)(
      raw.tableState(D,u)(aug.originalTable(theta)),raw.tableState(D,v)(aug.originalTable(theta)))))

  augmented_pair_depends: LEMMA agrees(coords.pairCoordinates(M,D,e),eta,theta) IMPLIES
    (pairs.augmentedPairCheck(M,D,e)(eta) IFF pairs.augmentedPairCheck(M,D,e)(theta))

  unitEvent_depends_on_unitCoordinates: THEOREM
    agrees(units.unitCoordinates(M,D)(U),eta,theta) IMPLIES
    (units.unitEvent(M,D)(U)(eta) IFF units.unitEvent(M,D)(U)(theta))

END ppg_hls_unit_event_dependence
