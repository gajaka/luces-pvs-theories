% The pointwise resampling-table check uses only the table, footprints
% and bad-event predicates. These are the literal definitions of
% ppg_hls_table_events after projecting its unused sigma and law fields;
% finiteMeet unfolds to the bounded universal quantifier below.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", Section 2. https://arxiv.org/abs/0903.0544v3
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Section 3.1. https://arxiv.org/abs/2111.06527
ppg_hls_table_check_core[C,V,Value:TYPE,domain:[V->set[Value]],
  footprint:[C->finite_set[V]],
  (IMPORTING ppg_mt_semantics[C,V,Value,domain])bad:[C,MTState->bool]]: THEORY
BEGIN
  IMPORTING ppg_mt_random_process[C,V,Value,domain] AS rawSlots,
    ppg_hls_table_coordinates[C,V,footprint]
  D: VAR WitnessDAG
  u: VAR WNode
  omega: VAR rawSlots.LogSpace
  a: VAR V

  tableState(D,u)(omega): MTState =
    LAMBDA(a:V):rawSlots.atIdx(omega,a,localIndex(D,u)(a))

  tableEvent(D,u): set[rawSlots.LogSpace] =
    {omega:rawSlots.LogSpace|bad(u`1,tableState(D,u)(omega))}

  tableCheck(D): set[rawSlots.LogSpace] =
    {omega:rawSlots.LogSpace|FORALL(u:WNode):D`nodes(u) IMPLIES tableEvent(D,u)(omega)}

  tableState_coordinate: LEMMA tableState(D,u)(omega)(a)=
    rawSlots.atIdx(omega,a,localIndex(D,u)(a))

  tableEvent_membership: LEMMA tableEvent(D,u)(omega) IFF bad(u`1,tableState(D,u)(omega))

  tableCheck_membership: LEMMA tableCheck(D)(omega) IFF
    (FORALL(u:WNode):D`nodes(u) IMPLIES tableEvent(D,u)(omega))

END ppg_hls_table_check_core
