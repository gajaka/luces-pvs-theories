% The total expectation sums occurrence probabilities first by label, then by tree.
ppg_mt_total_witness_expectation[C,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces)]: THEORY
BEGIN
  IMPORTING ppg_mt_expected_decomposition[C,V,Value,domain,spaces,laws],
    ppg_mt_witness_expectation[C,V,Value,domain,spaces,laws], ppg_enn_finite[C]
  vars: VAR CertVars
  bad: VAR NativeBad
  fallback: VAR C
  enumeration: VAR FullEnumeration
  randomInitETLog_eq_sum_tsum_witnessOccurrence: THEOREM
    randomInitETLog(vars,bad,fallback,enumeration)=
    ppg_nonneg_tsum[C].esum(labelUniverse(enumeration),LAMBDA(a:C):
      ppg_nonneg_tsum[WTree].tsum(LAMBDA(W:WTree):
        logMeasure(occurrenceEvents(vars,bad,fallback,enumeration,a)(W))))
END ppg_mt_total_witness_expectation
