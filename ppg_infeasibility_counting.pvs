% Exact inclusion-exclusion counts detect whether an admissible state
% exists. Weighted counts give the same test only when every atom has
% strictly positive weight; a zero-weight satisfying state is otherwise
% invisible to the mass.
%
% Lean counterpart: PPGraphInfeasibilityCounting.lean.
% For inclusion-exclusion, see Mitzenmacher and Upfal, Probability and
% Computing, Lemma 1.3.

ppg_infeasibility_counting[State, C: TYPE,
  universe: {U: finite_set[State] | FORALL (z: State): U(z)}]: THEORY
BEGIN
  IMPORTING ppg_finite_count[State, C, universe], ppg_inclusion_exclusion[State, C],
    ppg_finite_union[State], ppg_sum_order[State]
  allowed: VAR set[State]
  sat: VAR [C, State -> bool]
  B, K: VAR finite_set[C]
  c: VAR C
  z: VAR State
  weight: VAR [State -> real]

  admissibleStates(allowed): finite_set[State] = intersection(universe, allowed)

  rejectedStates(allowed, sat, c): finite_set[State] =
    intersection(universe, {z: State | allowed(z) AND NOT sat(c, z)})

  rejectedEvents(allowed, sat)(c, z): bool = rejectedStates(allowed, sat, c)(z)

  rejectedUnion(allowed, sat, B): finite_set[State] =
    familyUnion(image[C, finite_set[State]](LAMBDA (c: C): rejectedStates(allowed, sat, c), B))

  rejectedUnion_member: LEMMA rejectedUnion(allowed, sat, B)(z) IFF
    EXISTS c: B(c) AND rejectedStates(allowed, sat, c)(z)

  rejected_union_subset_admissible: THEOREM subset?(rejectedUnion(allowed, sat, B), admissibleStates(allowed))

  goodStates_eq_admissible_sdiff_rejected: THEOREM
    goodStates(allowed, sat, B) = difference(admissibleStates(allowed), rejectedUnion(allowed, sat, B))

  survivors_eq_goodStates: LEMMA survivors(admissibleStates(allowed), rejectedEvents(allowed, sat), B) = goodStates(allowed, sat, B)

  common_rejected_member: LEMMA nonempty?(K) IMPLIES
    (common(admissibleStates(allowed), rejectedEvents(allowed, sat), K)(z) IFF
      FORALL c: K(c) IMPLIES rejectedStates(allowed, sat, c)(z))

  exactGoodCount(allowed, sat, B): int = card(admissibleStates(allowed)) -
    unionCorrection(admissibleStates(allowed), rejectedEvents(allowed, sat), B)

  exactGoodCount_eq_goodCount: THEOREM exactGoodCount(allowed, sat, B) = goodCount(allowed, sat, B)

  exactGoodCount_nonneg: THEOREM exactGoodCount(allowed, sat, B) >= 0

  exactGoodCount_zero_iff: THEOREM exactGoodCount(allowed, sat, B) = 0 IFF Infeasible(allowed, sat, B)

  exactGoodCount_pos_iff: THEOREM exactGoodCount(allowed, sat, B) > 0 IFF Satisfiable(allowed, sat, B)

  goodMass(allowed, sat, B, weight): real = states.fsum(goodStates(allowed, sat, B), weight)

  goodStates_empty_of_infeasible: LEMMA Infeasible(allowed, sat, B) IMPLIES goodStates(allowed, sat, B) = emptyset[State]

  goodMass_zero_of_infeasible: THEOREM Infeasible(allowed, sat, B) IMPLIES goodMass(allowed, sat, B, weight) = 0

  goodMass_pos_of_satisfiable: THEOREM
    (FORALL z: allowed(z) IMPLIES weight(z) > 0) AND Satisfiable(allowed, sat, B) IMPLIES goodMass(allowed, sat, B, weight) > 0

  goodMass_zero_iff_infeasible: THEOREM (FORALL z: allowed(z) IMPLIES weight(z) > 0) IMPLIES
    (goodMass(allowed, sat, B, weight) = 0 IFF Infeasible(allowed, sat, B))

  goodMass_pos_iff_satisfiable: THEOREM (FORALL z: allowed(z) IMPLIES weight(z) > 0) IMPLIES
    (goodMass(allowed, sat, B, weight) > 0 IFF Satisfiable(allowed, sat, B))

END ppg_infeasibility_counting
