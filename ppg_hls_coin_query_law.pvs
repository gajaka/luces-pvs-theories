% A queried auxiliary coin is independent of the four queried data blocks.
% The coin and data addresses have different tags, so their row numbers
% need not differ. Only the complete data addresses must be injective.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Section 3.1. https://arxiv.org/abs/2111.06527
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_hls_coin_query_law[C,V,Value,X,Y,Z:TYPE,domain:[V->set[Value]],
  universeX:{F:finite_set[X]|F=fullset[X]},
  universeY:{F:finite_set[Y]|F=fullset[Y]},
  universeZ:{F:finite_set[Z]|F=fullset[Z]},
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  variableX:[X->V],variableY:[Y->V],variableZ:[Z->V],K:finite_set[C],r:nat,
  nX:[X->nat],nY1,nY2:[Y->nat],nZ:[Z->nat]]: THEORY
BEGIN
  IMPORTING ppg_hls_augmented_space[C,V,Value,domain,spaces,laws] AS coinAug,
    ppg_hls_query_four[V,Value,X,Y,Z,domain,universeX,universeY,universeZ,
      spaces,laws,variableX,variableY,variableZ] AS coinFourRead,
    ppg_hls_fair_orientation,
    ppg_probability_pair_map,ppg_probability_push_compose

  coinDataDomainX: MACRO [X->set[Value]] = LAMBDA(x:X):domain(variableX(x))

  coinDataDomainY: MACRO [Y->set[Value]] = LAMBDA(y:Y):domain(variableY(y))

  coinDataDomainZ: MACRO [Z->set[Value]] = LAMBDA(z:Z):domain(variableZ(z))

  coinDataSpacesX: MACRO [x:X->ppg_measurable_space[(coinDataDomainX(x))].MeasurableSpace] =
    LAMBDA(x:X):spaces(variableX(x))

  coinDataSpacesY: MACRO [y:Y->ppg_measurable_space[(coinDataDomainY(y))].MeasurableSpace] =
    LAMBDA(y:Y):spaces(variableY(y))

  coinDataSpacesZ: MACRO [z:Z->ppg_measurable_space[(coinDataDomainZ(z))].MeasurableSpace] =
    LAMBDA(z:Z):spaces(variableZ(z))

  coinDataLawsX: MACRO [x:X->ppg_probability_measure[(coinDataDomainX(x)),coinDataSpacesX(x)].Probability] =
    LAMBDA(x:X):laws(variableX(x))

  coinDataLawsY: MACRO [y:Y->ppg_probability_measure[(coinDataDomainY(y)),coinDataSpacesY(y)].Probability] =
    LAMBDA(y:Y):laws(variableY(y))

  coinDataLawsZ: MACRO [z:Z->ppg_probability_measure[(coinDataDomainZ(z)),coinDataSpacesZ(z)].Probability] =
    LAMBDA(z:Z):laws(variableZ(z))

  IMPORTING ppg_probability_four_product[X,Y,Z,Value,coinDataDomainX,coinDataDomainY,coinDataDomainZ,
    universeX,universeY,universeZ,coinDataSpacesX,coinDataSpacesY,coinDataSpacesZ,
    coinDataLawsX,coinDataLawsY,coinDataLawsZ] AS coinFourLaw,
    ppg_probability_unit_product[coinAug.AugValue,coinAug.coinDomain,
      coinAug.orientationSpace,coinAug.orientationLaw] AS coinUnit

  FourIndex: TYPE = union[union[X,Z],union[Y,Y]]

  actualDataDomain(k:FourIndex): MACRO set[Value] = domain(coinFourRead.fourVariable(k))

  actualDataSpaces(k:FourIndex): MACRO ppg_measurable_space[(actualDataDomain(k))].MeasurableSpace =
    spaces(coinFourRead.fourVariable(k))

  actualDataLaws(k:FourIndex): MACRO ppg_probability_measure[(actualDataDomain(k)),actualDataSpaces(k)].Probability =
    laws(coinFourRead.fourVariable(k))

  taggedDataDomain(k:FourIndex): MACRO set[coinAug.AugValue] = coinAug.dataDomain(coinFourRead.fourVariable(k))

  taggedDataSpaces(k:FourIndex): MACRO ppg_measurable_space[(taggedDataDomain(k))].MeasurableSpace =
    coinAug.dataSpace(coinFourRead.fourVariable(k))

  taggedDataLaws(k:FourIndex): MACRO ppg_probability_measure[(taggedDataDomain(k)),taggedDataSpaces(k)].Probability =
    coinAug.dataLaw(coinFourRead.fourVariable(k))

  dataDecoder: [k:FourIndex->[(taggedDataDomain(k))->(actualDataDomain(k))]] =
    LAMBDA(k:FourIndex):ppg_probability_tagged_left[Value,bool,
      domain(coinFourRead.fourVariable(k)),spaces(coinFourRead.fourVariable(k)),
      laws(coinFourRead.fourVariable(k))].decode

  data_decoder_measurable: LEMMA FORALL(k:FourIndex):
    ppg_measurable_map[(taggedDataDomain(k)),(actualDataDomain(k))].measurable(
      taggedDataSpaces(k),actualDataSpaces(k),dataDecoder(k))

  IMPORTING ppg_probability_finite_transport[FourIndex,coinAug.AugValue,Value,
    coinFourLaw.fourUniverse,taggedDataDomain,actualDataDomain,
    taggedDataSpaces,actualDataSpaces,taggedDataLaws,actualDataLaws,dataDecoder] AS coinDataTransport,
    ppg_probability_sum_product[coinUnit.Unit,FourIndex,coinAug.AugValue,
      coinUnit.unitDomain,taggedDataDomain,coinUnit.unitUniverse,coinFourLaw.fourUniverse,
      coinUnit.unitSpaces,taggedDataSpaces,coinUnit.unitLaws,taggedDataLaws] AS coinJointSplit

  data_coordinate_laws: LEMMA coinDataTransport.coordinateLawsMatch

  JointIndex: TYPE = union[coinUnit.Unit,FourIndex]

  jointVariable(k:JointIndex):coinAug.AugVariable =
    IF inl?(k) THEN inr(K) ELSE inl(coinFourRead.fourVariable(right(k))) ENDIF

  jointSlot(k:JointIndex):nat =
    IF inl?(k) THEN r ELSE coinFourRead.fourSlot(nX,nY1,nY2,nZ)(right(k)) ENDIF

  IMPORTING ppg_hls_table_query[coinAug.AugVariable,coinAug.AugValue,JointIndex,
    coinAug.augmentedDomain,coinJointSplit.sumUniverse,
    coinAug.augmentedSpaces,coinAug.augmentedLaws,jointVariable] AS coinJointQuery,
    ppg_mt_log_probability[bool,coinAug.AugVariable,coinAug.AugValue,
      coinAug.augmentedDomain,coinAug.augmentedSpaces,coinAug.augmentedLaws] AS coinQueryTableLaw,
    ppg_mt_native_spaces[bool,coinAug.AugVariable,coinAug.AugValue,coinAug.augmentedDomain] AS coinQueryTableSpaces,
    ppg_mt_carrier_congruence[C,bool,coinAug.AugVariable,coinAug.AugValue,coinAug.augmentedDomain,
      coinAug.augmentedSpaces,coinAug.augmentedLaws] AS coinTableCarrier

  dataAddressesInjective:bool = FORALL(a,b:FourIndex):
    (coinFourRead.fourSlot(nX,nY1,nY2,nZ)(a),coinFourRead.fourVariable(a))=
    (coinFourRead.fourSlot(nX,nY1,nY2,nZ)(b),coinFourRead.fourVariable(b)) IMPLIES a=b

  joint_query_injective: LEMMA dataAddressesInjective IMPLIES coinJointQuery.injectiveQuery(jointSlot)

  joint_domains_eq: LEMMA coinJointQuery.queryDomain=coinJointSplit.sumDomain

  joint_spaces_eq: LEMMA coinJointQuery.queryCoordinates=coinJointSplit.sumSpaces

  joint_laws_eq: LEMMA coinJointQuery.queryLaws=coinJointSplit.sumLaws

  joint_sigma_eq: LEMMA coinJointQuery.QuerySigma=coinJointSplit.SumSigma

  query_table_domains_eq: LEMMA
    ppg_mt_random_process[C,coinAug.AugVariable,coinAug.AugValue,coinAug.augmentedDomain].TableDomain=
      ppg_mt_random_process[bool,coinAug.AugVariable,coinAug.AugValue,coinAug.augmentedDomain].TableDomain

  augmented_sigma_query_eq: LEMMA coinAug.AugSigma=coinQueryTableSpaces.NativeTableSigma(coinAug.augmentedSpaces)

  augmented_query_law_eq: LEMMA coinAug.augmentedMeasure=coinQueryTableLaw.logMeasure

  jointQuery(eta:coinAug.AugTable):coinJointSplit.SumValue = coinJointQuery.tableQuery(jointSlot)(eta)

  joint_query_map_eq: LEMMA jointQuery=
    (coinJointQuery.tableQuery(jointSlot)::[coinAug.AugTable->coinJointSplit.SumValue])

  joint_query_measurable: LEMMA ppg_measurable_map[coinAug.AugTable,coinJointSplit.SumValue].measurable(
    coinAug.AugSigma,coinJointSplit.SumSigma,jointQuery)

  coinDecode(x:coinUnit.UnitValue):OrientationCoin =
    ppg_probability_tagged_right[Value,bool,fullset[bool],OrientationSigma,fairOrientation].decode(coinUnit.unitEval(x))

  dataDecode(x:coinDataTransport.SourceBlock):coinFourLaw.ResultValue =
    coinFourRead.splitFour(coinDataTransport.decodeBlock(x))

  coin_decode_measurable: LEMMA ppg_measurable_map[coinUnit.UnitValue,OrientationCoin].measurable(
    coinUnit.UnitSigma,OrientationSigma,coinDecode)

  data_decode_measurable: LEMMA ppg_measurable_map[coinDataTransport.SourceBlock,coinFourLaw.ResultValue].measurable(
    coinDataTransport.SourceSigma,coinFourLaw.ResultSigma,dataDecode)

  IMPORTING ppg_probability_map[coinUnit.UnitValue,OrientationCoin,coinUnit.UnitSigma,OrientationSigma] AS coinDecodePush,
    ppg_probability_finite_product[coinUnit.Unit,coinAug.AugValue,coinUnit.unitDomain,
      coinUnit.unitSpaces,coinUnit.unitLaws] AS coinUnitLaw,
    ppg_probability_map[coinDataTransport.SourceBlock,coinFourLaw.ResultValue,
      coinDataTransport.SourceSigma,coinFourLaw.ResultSigma] AS dataDecodePush,
    ppg_probability_finite_product[FourIndex,coinAug.AugValue,taggedDataDomain,taggedDataSpaces,taggedDataLaws] AS taggedFourLaw,
    ppg_probability_pair[OrientationCoin,coinFourLaw.ResultValue,OrientationSigma,coinFourLaw.ResultSigma] AS coinResultLaw

  coin_decode_law: LEMMA
    coinDecodePush.pushforward(coinUnitLaw.finiteLaw(coinUnit.unitUniverse),coinDecode)=fairOrientation

  data_decode_law: LEMMA
    dataDecodePush.pushforward(taggedFourLaw.finiteLaw(coinFourLaw.fourUniverse),dataDecode)=coinFourLaw.nestedLaw

  CoinAndFourValue: TYPE = [OrientationCoin,coinFourLaw.ResultValue]

  CoinAndFourSigma: MACRO ppg_measurable_space[CoinAndFourValue].MeasurableSpace = coinResultLaw.JointSpace

  coinAndFourRead(eta:coinAug.AugTable):CoinAndFourValue =
    (coinAug.auxiliaryCoins(eta)((K,r)),
      coinFourRead.readFour(nX,nY1,nY2,nZ)(coinAug.originalTable(eta)))

  decodedJoint(p:coinJointSplit.PairValue):CoinAndFourValue = (coinDecode(p`1),dataDecode(p`2))

  decode_joint_measurable: LEMMA ppg_measurable_map[coinJointSplit.PairValue,CoinAndFourValue].measurable(
    coinJointSplit.PairSigma,CoinAndFourSigma,decodedJoint)

  coin_and_four_function_eq: LEMMA
    coinAndFourRead=(LAMBDA(eta:coinAug.AugTable):decodedJoint(coinJointSplit.splitSum(jointQuery(eta))))

  measurable_coinAndFourRead: LEMMA ppg_measurable_map[coinAug.AugTable,CoinAndFourValue].measurable(
    coinAug.AugSigma,CoinAndFourSigma,coinAndFourRead)

  IMPORTING ppg_probability_map[coinAug.AugTable,coinJointSplit.SumValue,
      coinAug.AugSigma,coinJointSplit.SumSigma] AS jointQueryPush,
    ppg_probability_finite_product[JointIndex,coinAug.AugValue,coinJointSplit.sumDomain,
      coinJointSplit.sumSpaces,coinJointSplit.sumLaws] AS jointProductLaw,
    ppg_probability_finite_product[JointIndex,coinAug.AugValue,coinJointQuery.queryDomain,
      coinJointQuery.queryCoordinates,coinJointQuery.queryLaws] AS directJointProductLaw,
    ppg_probability_map[coinJointSplit.PairValue,CoinAndFourValue,
      coinJointSplit.PairSigma,CoinAndFourSigma] AS decodedJointPush,
    ppg_probability_map[coinAug.AugTable,CoinAndFourValue,
      coinAug.AugSigma,CoinAndFourSigma] AS coinAndFourPush

  joint_query_product_eq: LEMMA directJointProductLaw.finiteLaw(coinJointSplit.sumUniverse)=
    jointProductLaw.finiteLaw(coinJointSplit.sumUniverse)

  joint_query_law: LEMMA dataAddressesInjective IMPLIES
    jointQueryPush.pushforward(coinAug.augmentedMeasure,jointQuery)=jointProductLaw.finiteLaw(coinJointSplit.sumUniverse)

  decoded_joint_law: LEMMA decodedJointPush.pushforward(coinJointSplit.pairLaw,decodedJoint)=
    coinResultLaw.productLaw(fairOrientation,coinFourLaw.nestedLaw)

  map_coinAndFourRead: THEOREM dataAddressesInjective IMPLIES
    coinAndFourPush.pushforward(coinAug.augmentedMeasure,coinAndFourRead)=
      coinResultLaw.productLaw(fairOrientation,coinFourLaw.nestedLaw)

END ppg_hls_coin_query_law
