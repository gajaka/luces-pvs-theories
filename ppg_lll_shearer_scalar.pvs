% Scalar comparisons in the numerical Lovasz Local Lemma criterion.
% The signed event weight alpha is multiplied only by a positive q-value.
ppg_lll_shearer_scalar: THEORY
BEGIN
  numerical_step: LEMMA FORALL(alpha,x,g,h,qe,qr,qs:real):
    0<=x AND x<1 AND 0<qe AND 0<qr AND alpha<=x*g AND g<=h AND h*qr<=qe AND
    qs=qe-alpha*qr IMPLIES (1-x)*qe<=qs AND 0<qs
  conditional_step: LEMMA FORALL(qs,qt,ps,pt,f:real):
    0<qs AND 0<=ps AND f*qs<=qt AND qt*ps<=pt*qs IMPLIES f*ps<=pt
END ppg_lll_shearer_scalar
