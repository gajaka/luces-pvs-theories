% Auxiliary randomness selects an admissible schedule. The joint work
% function is its stopped count as a function of the auxiliary value and
% the table. Tonelli integrates the uniform conditional HLS bound under
% their product law. The auxiliary carrier is arbitrary and the joint
% work function is measurable.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Theorem 1.6, arXiv:2111.06527.
% Paul R. Halmos, Measure Theory, Springer, 1974, Tonelli's theorem.
% Lean: the last three results of PPGraphHLSPolicyExpectation.lean.
ppg_hls_randomized_expectation[C,V,Value:TYPE,domain:[V->set[Value]],
  variableUniverse:{U:finite_set[V]|U=fullset[V]},
  default:C,universe:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:{q:MTProcess|FORALL(i:C):NativeStateSigma(spaces)(q`bad(i))},
  (IMPORTING ppg_shearer_bdd[C,V,process`footprint])
  p:[C->real],
  (IMPORTING ppg_hls_matching[C,dependencyGraph,p])
  O:OverlapBounds,A:TYPE,
  (IMPORTING ppg_measurable_space[A]) SA:ppg_measurable_space[A].MeasurableSpace,
  (IMPORTING ppg_probability_measure[A,SA]) nu:ppg_probability_measure[A,SA].Probability]: THEORY
BEGIN
  IMPORTING ppg_hls_policy_expectation[C,V,Value,domain,variableUniverse,
      default,universe,spaces,laws,process,p,O] AS hlsRandomizedBounds,
    ppg_mt_policy_schedule[C,V,Value,domain,universe,
      ppg_mt_native_spaces[C,V,Value,domain].variableAmbient(spaces)] AS hlsRandomizedSchedules,
    ppg_hls_policy_count_integral[C,V,Value,domain,process`footprint,
      universe,spaces,laws,badTest(process)] AS hlsRandomizedCounts,
    ppg_hls_policy_count_core[C,V,Value,domain,process`footprint,
      badTest(process),universe,ppg_mt_native_spaces[C,V,Value,domain].variableAmbient(spaces)] AS hlsRandomizedCountCore,
    ppg_mt_policy_state[C,V,Value,domain] AS hlsRandomizedStates,
    ppg_mt_log_probability[C,V,Value,domain,spaces,laws] AS hlsRandomizedTableLaw,
    ppg_mt_random_process[C,V,Value,domain] AS hlsRandomizedSlots,
    ppg_probability_general_count[ppg_mt_random_process[C,V,Value,domain].LogSpace,ppg_mt_native_spaces[C,V,Value,domain].NativeTableSigma(spaces),
      hlsRandomizedTableLaw.logMeasure] AS hlsRandomizedLogBridge,
    ppg_probability_general_count[A,SA,nu] AS hlsRandomizedAuxBridge,
    ppg_general_probability_measure[A,asNasa(SA),hlsRandomizedAuxBridge.nativeProbability] AS hlsRandomizedAuxGeneral,
    ppg_general_probability_measure[ppg_mt_random_process[C,V,Value,domain].LogSpace,asNasa(ppg_mt_native_spaces[C,V,Value,domain].NativeTableSigma(spaces)),
      hlsRandomizedLogBridge.nativeProbability] AS hlsRandomizedLogGeneral,
    ppg_probability_product[A,ppg_mt_random_process[C,V,Value,domain].LogSpace,asNasa(SA),
      asNasa(ppg_mt_native_spaces[C,V,Value,domain].NativeTableSigma(spaces)),hlsRandomizedAuxBridge.nativeProbability,
      hlsRandomizedLogBridge.nativeProbability] AS hlsRandomizedProduct,
    ppg_general_sfinite_tonelli[A,ppg_mt_random_process[C,V,Value,domain].LogSpace,asNasa(SA),
      asNasa(ppg_mt_native_spaces[C,V,Value,domain].NativeTableSigma(spaces)),hlsRandomizedAuxBridge.nativeProbability,
      hlsRandomizedLogGeneral.sfiniteLaw] AS hlsRandomizedTonelli,
    ppg_general_lintegral[A,asNasa(SA),hlsRandomizedAuxBridge.nativeProbability] AS hlsRandomizedAuxIntegral,
    ppg_general_lintegral[ppg_mt_random_process[C,V,Value,domain].LogSpace,asNasa(ppg_mt_native_spaces[C,V,Value,domain].NativeTableSigma(spaces)),
      hlsRandomizedLogBridge.nativeProbability] AS hlsRandomizedLogIntegral,
    ppg_simple_comparison_regions[A,asNasa(SA),hlsRandomizedAuxBridge.nativeProbability] AS hlsRandomizedAuxRegions,
    ppg_general_indicator_integral[A,asNasa(SA),hlsRandomizedAuxBridge.nativeProbability] AS hlsRandomizedAuxIndicators,
    ppg_enn_borel_cuts[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace]] AS hlsRandomizedJointCuts,
    ppg_enn_measurable[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace]] AS hlsRandomizedJointENN,
    ppg_measurable_map[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace],ENN] AS hlsRandomizedJointMaps,
    ppg_enn_finiteness[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace]] AS hlsRandomizedJointFinite,
    ppg_nasa_sigma[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace]] AS hlsRandomizedJointSigma,
    ppg_shearer_bdd[C,V,process`footprint] AS hlsRandomizedGraph,
    ppg_hls_matching[C,hlsRandomizedGraph.dependencyGraph,p] AS hlsRandomizedOverlap,
    ppg_shearer_slack[C,hlsRandomizedGraph.dependencyGraph] AS hlsRandomizedSlack

  ProductSigma: sigma_algebra[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace]] =
    sigma_times(asNasa(SA),asNasa(ppg_mt_native_spaces[C,V,Value,domain].NativeTableSigma(spaces)))

  IMPORTING ppg_probability_law[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace],ProductSigma]

  actualProduct: ppg_probability_law[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace],ProductSigma].ProbabilityLaw =
    hlsRandomizedProduct.probabilityProduct

  IMPORTING ppg_general_lintegral[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace],ProductSigma,
      actualProduct] AS hlsRandomizedJointIntegral,
    ppg_simple_comparison_regions[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace],ProductSigma,
      actualProduct] AS hlsRandomizedJointRegions,
    ppg_general_probability_finiteness[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace],ProductSigma,
      actualProduct] AS hlsRandomizedJointFiniteness

  ScheduleFamily: TYPE =
    [A->hlsRandomizedSchedules.Schedule(process`footprint,badTest(process))]

  work(family:ScheduleFamily)(z:[A,ppg_mt_random_process[C,V,Value,domain].LogSpace]): ENN =
    hlsRandomizedSchedules.tLog(process`footprint,badTest(process),
      family(z`1)`select(z`2),z`2)

  jointlyMeasurable(family:ScheduleFamily): bool =
    hlsRandomizedJointMaps.measurable(hlsRandomizedJointSigma.asProject(ProductSigma),hlsRandomizedJointENN.ENNSigma,
      work(family))

  JointFamily: TYPE = (jointlyMeasurable)

  family: VAR JointFamily

  a: VAR A

  epsilon: VAR posreal

  measurableWork(family): hlsRandomizedTonelli.JointMeasurable = work(family)

  expectedRandomizedWork(family): ENN = hlsRandomizedJointIntegral.lintegral(work(family))

  randomizedTermination(family): set[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace]] =
    {z:[A,ppg_mt_random_process[C,V,Value,domain].LogSpace]|EXISTS(N:nat):FORALL(i:C):NOT process`bad(i)(
      hlsRandomizedStates.policyState(process`footprint,family(z`1)`select(z`2),z`2,N))}

  joint_work_lower_measurable: LEMMA hlsRandomizedJointRegions.lowerMeasurable(work(family))

  section_is_actual_count: LEMMA hlsRandomizedTonelli.sectionFunction(measurableWork(family),a)=
    LAMBDA(omega:ppg_mt_random_process[C,V,Value,domain].LogSpace):
      ppg_event_count[ppg_mt_random_process[C,V,Value,domain].LogSpace].eventCount(hlsRandomizedCounts.nativeActiveEvents(family(a)),omega)

  actual_section_integral: LEMMA
    hlsRandomizedTonelli.sectionIntegral(measurableWork(family))(a)=hlsRandomizedBounds.expectedWork(family(a))

  actual_tonelli_identity: LEMMA expectedRandomizedWork(family)=
    hlsRandomizedAuxIntegral.lintegral(hlsRandomizedTonelli.measurableSectionIntegral(measurableWork(family)))

  actual_constant_integral: LEMMA FORALL(c:nonneg_real):
    hlsRandomizedAuxIntegral.lintegral(LAMBDA(a:A):ennFinite(c))=ennFinite(c)

  randomized_expectedWork_le_sum_stableBudget: THEOREM
    hlsRandomizedBounds.assumptions AND hlsRandomizedBounds.criterion IMPLIES
      ele(expectedRandomizedWork(family),ofReal(hlsRandomizedBounds.totalBudget))

  randomized_expectedWork_le_card_div_slack: THEOREM hlsRandomizedBounds.assumptions AND
    StrictCriterion(hlsRandomizedSlack.dilated(epsilon,hlsRandomizedOverlap.reduced(O)),universe) IMPLIES
      ele(expectedRandomizedWork(family),ofReal(finite_sets[C].card(universe)/epsilon))

  finite_work_implies_good: LEMMA subset?(hlsRandomizedJointFinite.finiteEvent(work(family)),
    randomizedTermination(family))

  randomized_ae_exists_good: THEOREM hlsRandomizedBounds.assumptions AND hlsRandomizedBounds.criterion IMPLIES
    ae?[[A,ppg_mt_random_process[C,V,Value,domain].LogSpace],ProductSigma,actualProduct](randomizedTermination(family))

END ppg_hls_randomized_expectation
