% The original-table marginal carries the rooted union to augmented tables.
% A same-root augmented witness gives the inclusion in the unit-check union;
% the coded countable-union bound then sums the actual unit-check masses.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995:
% image measures, monotonicity and countable subadditivity. Kun He, Qian Li
% and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond Shearer's Bound",
% Section 2.1: the rooted witness families. The general ENN bound is the
% formal counting extension in PPGraphHLSRootUnion.lean.
%
% All bad events are measurable. Alpha and rootRank are theory formals, so
% the countable sum uses the literal rooted-canonical subtype as its index.
% Neither that family nor the variable type V is required to be inhabited.
ppg_hls_root_union_measure[C,V,Value:TYPE,domain:[V->set[Value]],
  default:C,universe:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:{p:MTProcess|FORALL(i:C):NativeStateSigma(spaces)(p`bad(i))},
  alpha:C,rootRank:nat]: THEORY
BEGIN
  IMPORTING ppg_hls_root_union_measurable[C,V,Value,domain,universe,
      spaces,laws,process] AS unions,
    ppg_hls_unit_checks[C,V,Value,domain,default,universe,
      spaces,laws,process] AS units,
    ppg_hls_unit_event_measurable[C,V,Value,domain,default,universe,
      spaces,laws,process] AS unitMeas,
    ppg_hls_root_union_unit_bridge[C,V,Value,domain,default,universe,
      spaces,laws,process] AS inclusion,
    ppg_hls_augmented_space[C,V,Value,domain,spaces,laws] AS aug,
    ppg_hls_table_events[C,V,Value,domain,spaces,laws,process] AS tables,
    ppg_mt_log_probability[C,V,Value,domain,spaces,laws] AS originalLaw,
    ppg_shearer_bdd[C,V,process`footprint] AS graph,
    ppg_hls_witness_dag[C,graph.dependencyGraph] AS dags,
    ppg_hls_pair_keys[C,graph.dependencyGraph] AS keys,
    ppg_hls_dag_countable[C,graph.dependencyGraph] AS dagCodes,
    ppg_measurable_map[aug.AugTable,aug.OriginalTable] AS maps,
    ppg_nasa_sigma[aug.AugTable] AS nasa

  Family: TYPE = unions.RootFamily(alpha,rootRank)

  M: VAR keys.DependencyMatching

  D: VAR Family

  eta: VAR aug.AugTable

  familyCode(D): nat = dagCodes.dagCode(unions.labelCode)(D)

  process_bad_measurable: LEMMA tables.badMeasurable

  family_code_injective: LEMMA injective?(familyCode)

  unit_event_measurable: LEMMA aug.AugSigma(units.unitCheck(M,D))

  unitEvents(M)(D): (aug.AugSigma) = units.unitCheck(M,D)

  IMPORTING ppg_countable_index_measure[aug.AugTable,Family,familyCode,
      aug.AugSigma,aug.augmentedMeasure] AS countableBound,
    ppg_countable_indexed_union[aug.AugTable,Family] AS indexed,
    ppg_enn_unrestricted_sum[Family] AS familySum,
    measure_integration@finite_measure[aug.AugTable,aug.AugSigma,
      aug.augmentedMeasure] AS augmentedMeasure

  unitUnion(M): set[aug.AugTable] = inclusion.unitCheckUnion(M,alpha,rootRank)

  unit_union_indexed: LEMMA unitUnion(M)=indexed.indexedUnion(unitEvents(M))

  unit_union_measurable: LEMMA aug.AugSigma(unitUnion(M))

  original_root_measurable: LEMMA aug.OriginalSigma(unions.rootUnion(alpha,rootRank))

  preimage_root_measurable: LEMMA aug.AugSigma(maps.inverseImage(
    aug.originalTable,unions.rootUnion(alpha,rootRank)))

  preimage_root_inclusion: LEMMA subset?(maps.inverseImage(
    aug.originalTable,unions.rootUnion(alpha,rootRank)),unitUnion(M))

  original_root_mass: LEMMA aug.augmentedMeasure(maps.inverseImage(
    aug.originalTable,unions.rootUnion(alpha,rootRank)))=
    originalLaw.logMeasure(unions.rootUnion(alpha,rootRank))

  original_root_mass_le_unit_union: LEMMA
    originalLaw.logMeasure(unions.rootUnion(alpha,rootRank))<=
      aug.augmentedMeasure(unitUnion(M))

  countable_unit_union_bound: LEMMA ele(ennFinite(aug.augmentedMeasure(unitUnion(M))),
    familySum.eTsum(LAMBDA(D:Family):ennFinite(aug.augmentedMeasure(units.unitCheck(M,D)))))

  measure_rootUnion_le_tsum_unitCheck: THEOREM ele(
    ennFinite(originalLaw.logMeasure(unions.rootUnion(alpha,rootRank))),
    familySum.eTsum(LAMBDA(D:Family):ennFinite(aug.augmentedMeasure(units.unitCheck(M,D)))))

END ppg_hls_root_union_measure
