% Finite prefix counts are integrable sums of event indicators.
% They increase to the unrestricted count; monotone convergence gives
% its extended integral as the sum of event probabilities. Neither
% termination nor a finite total expectation is required.

ppg_count_integral[X: TYPE,
  (IMPORTING ppg_measurable_space[X]) S: MeasurableSpace,
  (IMPORTING ppg_probability_measure[X, S]) probLaw: Probability]: THEORY
BEGIN
  IMPORTING ppg_monotone_integral[X,S,probLaw], ppg_event_count[X]
  E: VAR [nat -> (S)]
  n,i,j: VAR nat
  x: VAR X
  countApprox(E,n): RECURSIVE NonnegativeFunction =
    IF n=0 THEN nnConstant(0)
    ELSE countApprox(E,n-1)+nnIndicator(E(n-1)) ENDIF MEASURE n
  prefix_zero: LEMMA countApprox(E,0)=nnConstant(0)
  prefix_succ: LEMMA countApprox(E,n+1)=countApprox(E,n)+nnIndicator(E(n))
  prefix_value: LEMMA countApprox(E,n)(x)=countPrefix(E,x,n)
  prefix_mean: LEMMA mean(countApprox(E,n))=
    sums.sum(natRange(n),LAMBDA(k:nat):probLaw(E(k)))
  count_prefix_monotone: LEMMA i<=j IMPLIES countPrefix(E,x,i)<=countPrefix(E,x,j)
  prefix_monotone: LEMMA monotoneFamily(LAMBDA(n:nat):countApprox(E,n))
  prefix_sup: LEMMA supFunction(LAMBDA(n:nat):countApprox(E,n))=(LAMBDA(x:X):eventCount(E,x))
  prefix_mean_function: LEMMA (LAMBDA(n:nat):mean(countApprox(E,n)))=
    (LAMBDA(n:nat):sums.sum(natRange(n),LAMBDA(k:nat):probLaw(E(k))))
  lintegral_eventCount: THEOREM lintegral(LAMBDA(x:X):eventCount(E,x))=
    tsum(LAMBDA(k:nat):probLaw(E(k)))
END ppg_count_integral
