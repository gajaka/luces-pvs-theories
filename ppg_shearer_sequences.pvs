% Stable sequences are enumerated by a finite union over successor layers.
% Prepending the fixed root preserves distinct tails; different next layers
% have disjoint images because their tails have different first layers.
% The sequence weight is the product of all layer products, with repetition.
%
% Nicholas J. A. Harvey and Jan Vondrak, "An Algorithmic Proof of the
% Lovasz Local Lemma via Resampling Oracles", equation (11), Lemma 5.26.
% https://arxiv.org/abs/1504.02044
% Lean counterpart: PPGraphShearerStable.lean.
ppg_shearer_sequences[C:TYPE,G:{H:[C,C->bool]|(FORALL(a:C):NOT H(a,a)) AND
  (FORALL(a,b:C):H(a,b)=H(b,a))}]: THEORY
BEGIN

  Layer: TYPE = finite_set[C]

  LayerSeq: TYPE = list[Layer]

  IMPORTING ppg_shearer_budget[C,G],
    ppg_bind_sum[Layer,LayerSeq,real,0,LAMBDA(a,b:real):a+b] AS layerSums,
    ppg_sum_image[LayerSeq,LayerSeq], ppg_real_division_sum[LayerSeq],
    ppg_list_fold[Layer,real,1,LAMBDA(a,b:real):a*b] AS layerWeights
  B,J,K,H: VAR Layer
  L,M: VAR LayerSeq
  F: VAR finite_set[LayerSeq]
  d: VAR nat
  p: VAR [C->real]

  consFamily(J,F): finite_set[LayerSeq] =
    image[LayerSeq,LayerSeq](LAMBDA(L:LayerSeq):cons[Layer](J,L),F)

  stableSequences(B,d,J): RECURSIVE finite_set[LayerSeq] =
    IF d=0 THEN singleton(cons[Layer](J,null[Layer])) ELSE
      biUnion(successors(B,J),LAMBDA(K:Layer):consFamily(J,stableSequences(B,d-1,K))) ENDIF
    MEASURE d

  rooted(J,L): bool = IF cons?[Layer](L) THEN car[Layer](L)=J ELSE FALSE ENDIF

  sequenceWeight(p)(L): real = layerWeights.fold(L,LAMBDA(J:Layer):product(J,p))

  depthWeights(p,B,d): [Layer->real] = LAMBDA(K:Layer):
    ppg_finite_sum[LayerSeq].fsum(stableSequences(B,d,K),sequenceWeight(p))

  nonnegativeLayers(p,L): bool = FORALL(J:Layer):list_props[Layer].member(J,L) IMPLIES nonnegativeOn(p,J)

  stableSequences_zero: LEMMA stableSequences(B,0,J)=singleton(cons[Layer](J,null[Layer]))

  stableSequences_succ: LEMMA stableSequences(B,d+1,J)=
    biUnion(successors(B,J),LAMBDA(K:Layer):consFamily(J,stableSequences(B,d,K)))

  cons_family_member: LEMMA consFamily(J,F)(L) IFF
    EXISTS(M:LayerSeq):F(M) AND L=cons[Layer](J,M)

  stableSequences_member_succ: LEMMA stableSequences(B,d+1,J)(L) IFF
    EXISTS(K:Layer,M:LayerSeq):successors(B,J)(K) AND stableSequences(B,d,K)(M) AND L=cons[Layer](J,M)

  cons_tail_injective: LEMMA cons[Layer](J,L)=cons[Layer](J,M) IMPLIES L=M

  rooted_unique: LEMMA rooted(J,L) AND rooted(K,L) IMPLIES J=K

  sequenceWeight_null: LEMMA sequenceWeight(p)(null[Layer])=1

  sequenceWeight_cons: THEOREM sequenceWeight(p)(cons[Layer](J,L))=product(J,p)*sequenceWeight(p)(L)

  stableSequences_head_length: THEOREM stableSequences(B,d,J)(L) IMPLIES
    rooted(J,L) AND length[Layer](L)=d+1

  stableSequences_next_disjoint: THEOREM K/=H IMPLIES
    disjoint?(consFamily(J,stableSequences(B,d,K)),consFamily(J,stableSequences(B,d,H)))

  successor_layer: LEMMA successors(B,J)(K) IMPLIES subset?(K,B) AND Independent(K)

  sum_consFamily: LEMMA ppg_finite_sum[LayerSeq].fsum(consFamily(J,F),sequenceWeight(p))=
    product(J,p)*ppg_finite_sum[LayerSeq].fsum(F,sequenceWeight(p))

  layer_fsum_as_fold: LEMMA ppg_finite_sum[Layer].fsum=ppg_monoid_sum[Layer,real,0,LAMBDA(a,b:real):a+b].sum

  sequence_fsum_as_fold: LEMMA ppg_finite_sum[LayerSeq].fsum=ppg_monoid_sum[LayerSeq,real,0,LAMBDA(a,b:real):a+b].sum

  sum_stableSequences_succ: THEOREM
    ppg_finite_sum[LayerSeq].fsum(stableSequences(B,d+1,J),sequenceWeight(p))=
      product(J,p)*ppg_finite_sum[Layer].fsum(successors(B,J),LAMBDA(K:Layer):
        ppg_finite_sum[LayerSeq].fsum(stableSequences(B,d,K),sequenceWeight(p)))

  stableSequences_layers: THEOREM subset?(J,B) AND Independent(J) AND
    stableSequences(B,d,J)(L) IMPLIES
      FORALL(K:Layer):list_props[Layer].member(K,L) IMPLIES subset?(K,B) AND Independent(K)

  sequenceWeight_nonneg: THEOREM nonnegativeLayers(p,L) IMPLIES 0<=sequenceWeight(p)(L)

  sum_stableSequences_le: THEOREM subset?(J,B) AND Independent(J) AND
    nonnegativeOn(p,B) AND StrictCriterion(p,B) IMPLIES
      ppg_finite_sum[LayerSeq].fsum(stableSequences(B,d,J),sequenceWeight(p))<=stableBudget(p,B,J)

END ppg_shearer_sequences
