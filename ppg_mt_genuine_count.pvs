% Genuine times and their actual address trees have the same finite cardinality.
ppg_mt_genuine_count[C, V, Value: TYPE, domain: [V -> set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_mt_selection[C, V, Value, domain], ppg_mt_label_counts[C, V],
    ppg_nat_range, ppg_finite_bijection[nat, GTree] AS treeImage
  vars: VAR CertVars
  bad: VAR [C, MTState -> bool]
  fallback, a: VAR C
  enumeration: VAR list[C]
  initial: VAR MTState
  omega: VAR LogSpace
  n, t, s: VAR nat
  randC(vars, bad, fallback, enumeration, initial, omega)(t): C =
    pickFirstViolated(bad, fallback, enumeration,
      randTraj(vars, bad, fallback, enumeration, initial, omega, t))
  TLOG(vars, bad, fallback, enumeration, initial, omega, n): nat =
    card(filteredRange(LAMBDA (t: nat):
      NOT MTGood(bad, randTraj(vars, bad, fallback, enumeration, initial, omega, t)), n))
  genuineAt(vars, bad, fallback, enumeration, initial, omega, a, n): finite_set[nat] =
    filteredRange(LAMBDA (t: nat): 0 < t AND
      NOT MTGood(bad, randTraj(vars, bad, fallback, enumeration, initial, omega, t)) AND
      randC(vars, bad, fallback, enumeration, initial, omega)(t) = a, n)
  genuineAt_member: LEMMA genuineAt(vars, bad, fallback, enumeration, initial, omega, a, n)(t) IFF
    t < n AND 0 < t AND
    NOT MTGood(bad, randTraj(vars, bad, fallback, enumeration, initial, omega, t)) AND
    randC(vars, bad, fallback, enumeration, initial, omega)(t) = a
  genuineAt_trees_injective: LEMMA
    treeImage.injOn(LAMBDA (t: nat): tau_C(vars, randC(vars, bad, fallback, enumeration, initial, omega), t),
      genuineAt(vars, bad, fallback, enumeration, initial, omega, a, n))
  card_genuineAt_eq_card_trees: THEOREM
    card(genuineAt(vars, bad, fallback, enumeration, initial, omega, a, n)) =
    card(image(LAMBDA (t: nat): tau_C(vars, randC(vars, bad, fallback, enumeration, initial, omega), t),
      genuineAt(vars, bad, fallback, enumeration, initial, omega, a, n)))
END ppg_mt_genuine_count
