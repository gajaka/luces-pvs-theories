% Powers of two record preference along each matching-pair chain.
% Reversing an inconsistent arc gains at the earlier index, and any
% lost preference is at the later, smaller power. This is a finite
% natural-number score; no probability bound is involved.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", proof of Lemma 3.1. https://arxiv.org/abs/2111.06527
% Lean counterpart: PPGraphHLSOrientationScore.lean.
ppg_hls_orientation_score[C:TYPE,G:{A:[C,C->bool]|(FORALL(i:C):NOT A(i,i)) AND
  (FORALL(i,j:C):A(i,j)=A(j,i))}]: THEORY
BEGIN
  IMPORTING ppg_hls_pair_keys[C,G],
    ppg_monoid_sum[WNode,nat,0,LAMBDA(a,b:nat):a+b] AS nodeSum
  D: VAR WitnessDAG
  Q: VAR (Valid)
  M: VAR DependencyMatching
  Y: VAR [finite_set[C],nat->C]
  N,k: VAR nat
  u,v,w: VAR WNode
  S: VAR finite_set[WNode]
  f: VAR [WNode->nat]

  natDrop(N,k): nat = IF k<=N THEN N-k ELSE 0 ENDIF

  preferenceTerm(M,Y,N,D,u): nat =
    IF Y(matchPair(M,u`1),cliqueRank(D,matchPair(M,u`1),u))=u`1 THEN
      exp2(natDrop(N,cliqueRank(D,matchPair(M,u`1),u))) ELSE 0 ENDIF

  orientationScore(M,Y,N,D): nat =
    nodeSum.sum(D`nodes,LAMBDA(u:WNode):preferenceTerm(M,Y,N,D,u))

  preferenceTerm_reverse_other: THEOREM w/=u AND w/=v IMPLIES
    preferenceTerm(M,Y,N,reverse(D,u,v),w)=preferenceTerm(M,Y,N,D,w)

  sum_erase_two: THEOREM S(u) AND S(v) AND u/=v IMPLIES
    nodeSum.sum(S,f)=nodeSum.sum(remove(v,remove(u,S)),f)+f(u)+f(v)

  rank_power_strict: THEOREM k+1<=N IMPLIES
    exp2(natDrop(N,k+1))<exp2(natDrop(N,k))

  preferenceTerm_bound: LEMMA preferenceTerm(M,Y,N,D,u)<=
    exp2(natDrop(N,cliqueRank(D,matchPair(M,u`1),u)))

  score_remainder_eq: LEMMA
    nodeSum.sum(remove(v,remove(u,D`nodes)),
      LAMBDA(w:WNode):preferenceTerm(M,Y,N,reverse(D,u,v),w))=
    nodeSum.sum(remove(v,remove(u,D`nodes)),
      LAMBDA(w:WNode):preferenceTerm(M,Y,N,D,w))

  orientationScore_reverse_strict: THEOREM card(Q`nodes)<=N AND Edge(Q)(u,v) AND
    dagPaths.Acyclic(dagPaths.reverseArc(Edge(Q),u,v)) AND M(u`1)=v`1 AND u`1/=v`1 AND
    Y(matchPair(M,u`1),cliqueRank(Q,matchPair(M,u`1),u))=v`1 IMPLIES
      orientationScore(M,Y,N,Q)<orientationScore(M,Y,N,reverse(Q,u,v))

END ppg_hls_orientation_score
