% The history records the states visited through the current time.
% A running event only inspects preceding states. Composing a measurable
% state potential with the current observation and restricting it to
% that running event gives the stopped potential.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% Sterling K. Berberian, Fundamentals of Real Analysis, Springer, 1999.
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Section 2.
ppg_mt_observed_history[C,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_mt_coordinate_laws[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),fallback:C,
  eventOrder:{e:list[C]|FORALL(c:C):member(c,e)}]: THEORY
BEGIN
  IMPORTING ppg_mt_random_process[C,V,Value,domain] AS slots,
    ppg_mt_semantics[C,V,Value,domain] AS semantics,
    ppg_mt_selection[C,V,Value,domain] AS selection,
    ppg_mt_native_spaces[C,V,Value,domain] AS nativeSpaces,
    ppg_mt_trajectory_measurable[C,V,Value,domain] AS trajectories,
    ppg_mt_check_probability[C,V,Value,domain,spaces,laws] AS checks,
    ppg_mt_log_probability[C,V,Value,domain,spaces,laws] AS originalLaw,
    ppg_mt_drift_pointwise[C,V,Value,domain,fallback,eventOrder] AS pointwise

  State: TYPE = semantics.MTState

  ResamplingLog: TYPE = slots.LogSpace

  stateSigma: MACRO ppg_measurable_space[State].MeasurableSpace = nativeSpaces.NativeStateSigma(spaces)

  tableSigma: MACRO ppg_measurable_space[ResamplingLog].MeasurableSpace = nativeSpaces.NativeTableSigma(spaces)

  IMPORTING ppg_measurable_map[ResamplingLog,State] AS stateMaps,
    ppg_measurable_map[State,real] AS potentialMaps,
    ppg_measurable_map[ResamplingLog,real] AS valueMaps,
    ppg_measurable_compose[ResamplingLog,State,real] AS composition,
    ppg_filtration[ResamplingLog,State,tableSigma] AS historyLaws,
    ppg_observed_filtration[ResamplingLog,State,tableSigma,stateSigma] AS observations,
    ppg_bounded_nonnegative_integral[ResamplingLog,tableSigma,originalLaw.logMeasure] AS bounded,
    ppg_finite_events[State,C,stateSigma] AS goodEvents,
    ppg_list_sets[C] AS labels,
    ppg_measurable_sequence[ResamplingLog] AS eventSequences,
    ppg_measurable_space[State] AS stateSets,
    ppg_measurable_space[ResamplingLog] AS logSets

  Initializer: TYPE = {f:[ResamplingLog->State]|stateMaps.measurable(tableSigma,stateSigma,f)}

  MeasurablePotential: TYPE = {f:[State->nnreal]|potentialMaps.measurable(stateSigma,bounded.borelSigma,f)}

  vars: VAR [C->finite_set[V]]
  B: VAR checks.NativeBad
  init: VAR Initializer
  Phi: VAR MeasurablePotential
  n,k,t: VAR nat
  c: VAR C
  M: VAR nnreal
  omega: VAR ResamplingLog

  process(vars,B,init)(n)(omega): State =
    slots.randTraj(vars,B,fallback,eventOrder,init(omega),omega,n)

  process_measurable: LEMMA observations.processMeasurable(process(vars,B,init))

  observedProcess(vars,B,init): observations.MeasurableProcess = process(vars,B,init)

  mtHistory(vars,B,init,n): ppg_measurable_space[ResamplingLog].MeasurableSpace =
    observations.history(process(vars,B,init),n)

  mtFiltration(vars,B,init): historyLaws.Filtration =
    observations.observedFiltration(observedProcess(vars,B,init))

  history_exact: LEMMA mtFiltration(vars,B,init)(n)=mtHistory(vars,B,init,n)

  history_ambient: LEMMA subset?(mtHistory(vars,B,init,n),tableSigma)

  measurable_randTraj_history: THEOREM k<=n IMPLIES stateMaps.measurable(
    mtHistory(vars,B,init,n),stateSigma,process(vars,B,init)(k))

  eventLabels: finite_set[C] = labels.listSet(eventOrder)

  event_labels_full: LEMMA eventLabels(c)

  goodSet(B): set[State] = {s:State|selection.MTGood(B,s)}

  goodLabels(B)(c): set[State] = {s:State|NOT B(c,s)}

  good_as_finite_meet: LEMMA goodSet(B)=goodEvents.finiteMeet(eventLabels,goodLabels(B))

  good_label_measurable: LEMMA stateSigma(goodLabels(B)(c))

  measurableSet_MTGood: THEOREM stateSigma(goodSet(B))

  badSet(B): set[State] = complement(goodSet(B))

  bad_set_measurable: LEMMA stateSigma(badSet(B))

  runningFamily(vars,B,init,t)(k): set[ResamplingLog] =
    IF k<t THEN stateMaps.inverseImage(process(vars,B,init)(k),badSet(B))
      ELSE fullset[ResamplingLog] ENDIF

  running_family_measurable: LEMMA t<=n+1 IMPLIES
    mtHistory(vars,B,init,n)(runningFamily(vars,B,init,t)(k))

  running_as_intersection: LEMMA pointwise.mtRunningEvent(vars,B,init,t)=
    eventSequences.countableIntersection(runningFamily(vars,B,init,t))

  measurableSet_mtRunningEvent_history: THEOREM t<=n+1 IMPLIES
    mtHistory(vars,B,init,n)(pointwise.mtRunningEvent(vars,B,init,t))

  state_value_measurable: LEMMA valueMaps.measurable(mtHistory(vars,B,init,n),bounded.borelSigma,
    LAMBDA(omega:ResamplingLog):Phi(process(vars,B,init)(n)(omega)))

  stoppedNN(vars,B,init,Phi,n)(omega): nnreal = IF pointwise.mtRunningEvent(vars,B,init,n)(omega)
    THEN Phi(process(vars,B,init)(n)(omega)) ELSE 0 ENDIF

  stopped_function_eq: LEMMA stoppedNN(vars,B,init,Phi,n)=
    (LAMBDA(omega:ResamplingLog):pointwise.mtStoppedPotential(vars,B,init,Phi,n,omega))

  stopped_branch: LEMMA stoppedNN(vars,B,init,Phi,n)=valueMaps.branch(
    pointwise.mtRunningEvent(vars,B,init,n),
    LAMBDA(omega:ResamplingLog):Phi(process(vars,B,init)(n)(omega)),LAMBDA(omega:ResamplingLog):0)

  stopped_measurable: LEMMA valueMaps.measurable(mtHistory(vars,B,init,n),bounded.borelSigma,
    stoppedNN(vars,B,init,Phi,n))

  measurable_mtStoppedPotential_history: THEOREM valueMaps.measurable(mtHistory(vars,B,init,n),
    bounded.borelSigma,LAMBDA(omega:ResamplingLog):pointwise.mtStoppedPotential(vars,B,init,Phi,n,omega))

  stopped_ambient_measurable: LEMMA valueMaps.measurable(tableSigma,bounded.borelSigma,
    stoppedNN(vars,B,init,Phi,n))

  stopped_bounded: LEMMA (FORALL(s:State):Phi(s)<=M) IMPLIES stoppedNN(vars,B,init,Phi,n)(omega)<=M

  integrable_mtStoppedPotential_of_bounded: THEOREM (FORALL(s:State):Phi(s)<=M) IMPLIES
    bounded.nativeIntegrable?(LAMBDA(omega:ResamplingLog):pointwise.mtStoppedPotential(vars,B,init,Phi,n,omega))

END ppg_mt_observed_history
