% The orientation coin is the actual half-and-half law on Boolean values.
% FALSE represents keep and TRUE represents flip in the source coin type.
% Its construction uses two point measures, so no coin law is supplied
% as an additional premise to the augmented-space theorems.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Section 3.1. https://arxiv.org/abs/2111.06527
ppg_hls_fair_orientation: THEORY
BEGIN
  OrientationCoin: TYPE = (fullset[bool])

  orientationKeep: OrientationCoin = FALSE

  orientationFlip: OrientationCoin = TRUE

  IMPORTING ppg_measurable_space[OrientationCoin] AS fairSets

  OrientationSigma: fairSets.MeasurableSpace = fullset[set[OrientationCoin]]

  IMPORTING ppg_probability_convex[OrientationCoin,OrientationSigma] AS fairMixture,
    ppg_probability_dirac[OrientationCoin,OrientationSigma] AS fairPoints

  fairOrientation: ppg_probability_measure[OrientationCoin,OrientationSigma].Probability =
    fairMixture.mixture(1/2,fairPoints.dirac(FALSE),fairPoints.dirac(TRUE))

  A: VAR set[OrientationCoin]

  fair_orientation_mass: LEMMA fairOrientation(A)=
    (IF A(FALSE) THEN 1/2 ELSE 0 ENDIF)+(IF A(TRUE) THEN 1/2 ELSE 0 ENDIF)

  fair_orientation_false: LEMMA fairOrientation(singleton(FALSE))=1/2

  fair_orientation_true: LEMMA fairOrientation(singleton(TRUE))=1/2

END ppg_hls_fair_orientation
