% The native integral of the accepted potential equals its exact
% rational local expectation. On a finite measurable-singleton space,
% finite_sigma_full identifies the source sigma-algebra with fullSigma.
%
% Johannes Lengler, "Drift Analysis", arXiv:1712.00964.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% Lean counterpart: rowPMF_integral in PPGraphFiniteDrift.lean.
ppg_finite_drift_row_integral[State: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  (IMPORTING ppg_finite_drift_row[State,universe])
  M:Model,W:checkedWitness(M),s:State]: THEORY
BEGIN
  IMPORTING ppg_finite_atomic_integral[State,universe,rowVector(M,W,s)]
  nativePotential: NativeFunction = finiteIntegrable(potentialWeights(M,W))
  native_potential_at: LEMMA FORALL(t:State):nativePotential(t)=W`potential(t)
  native_potential_eq: LEMMA nativePotential=(LAMBDA(t:State):W`potential(t))
  potential_product_eq: LEMMA
    (LAMBDA(t:State):potentialWeights(M,W)(t)*rowVector(M,W,s)(t))=
    (LAMBDA(t:State):M`transition(s,t)*W`potential(t))
  rowPMF_integral: THEOREM expectation(nativePotential)=localExpectation(M,W,s)
END ppg_finite_drift_row_integral
