% Expected potential pays for every active step of a realized process.
% The finite-horizon budget retains the terminal potential; passing to
% increasing event counts yields the full bound without a termination
% premise. The measure is finite and need not have total mass one.
%
% Johannes Lengler, "Drift Analysis", arXiv:1712.00964, additive drift.
% Lean counterparts: expectedActiveCount_le and expectedActiveCount_lt_top
% in PPGraphFiniteDriftProcess.lean.
ppg_finite_process_expectation[State,Omega: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  (IMPORTING ppg_nasa_sigma[Omega]) S:MeasurableSpace,
  (IMPORTING ppg_finite_law_view[Omega,S]) measureLaw:FiniteLaw,
  (IMPORTING ppg_filtration[Omega,State,S]) history:Filtration]: THEORY
BEGIN
  IMPORTING ppg_finite_process_realization[State,Omega,universe,S,measureLaw,history],
    ppg_finite_count_budget[Omega,S,measureLaw]
  AcceptedWitness(M:Model): TYPE = {W:Witness|check(M,W)}
  M: VAR Model
  X: VAR AdaptedProcess
  W: VAR Witness
  n: VAR nat
  omega: VAR Omega
  positiveRate(M:Model,W:AcceptedWitness(M)): posreal = rate(W)
  checked_potential_nonnegative: LEMMA FORALL(M:Model,W:AcceptedWitness(M),
    X:AdaptedProcess,n:nat,omega:Omega):0<=potentialValue(W,X,n)(omega)
  potentialMean(M:Model,W:AcceptedWitness(M),X:AdaptedProcess,n:nat): nonneg_real =
    integral(potentialValue(W,X,n))
  activeSchedule(M,X): [nat->(S)] = LAMBDA(n:nat):activeProcessEvent(M,X,n)
  active_schedule_at: LEMMA activeSchedule(M,X)(n)(omega) IFF NOT M`good(X(n)(omega))
  realized_integrated_step: LEMMA FORALL(M:Model,W:AcceptedWitness(M),X:Realization(M),n:nat):
    positiveRate(M,W)*mass(activeSchedule(M,X)(n))+potentialMean(M,W,X,n+1)
      <=potentialMean(M,W,X,n)
  realized_budget: LEMMA FORALL(M:Model,W:AcceptedWitness(M),X:Realization(M)):
    BudgetLaw(activeSchedule(M,X),(LAMBDA(n:nat):potentialMean(M,W,X,n)),positiveRate(M,W))
  expectedActiveCount_le: THEOREM FORALL(M:Model,W:AcceptedWitness(M),X:Realization(M)):
    ele(expectedCount(activeSchedule(M,X)),ennFinite(potentialMean(M,W,X,0)/positiveRate(M,W)))
  expectedActiveCount_lt_top: THEOREM FORALL(M:Model,W:AcceptedWitness(M),X:Realization(M)):
    ennFinite?(expectedCount(activeSchedule(M,X)))
END ppg_finite_process_expectation
