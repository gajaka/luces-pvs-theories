% Selected matching arcs have disjoint endpoint sets. A finite monoid
% product over those sets is therefore the product over selected pairs.
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Proposition 3.2. https://arxiv.org/abs/2111.06527
% Lean counterpart: PPGraphHLSProductDiscount.prod_selected_endpoints.
ppg_hls_selected_monoid[C,R:TYPE,G:{A:[C,C->bool]|(FORALL(i:C):NOT A(i,i)) AND
  (FORALL(i,j:C):A(i,j)=A(j,i))},unit:R,
  op:{f:[R,R->R]|identity?(f)(unit) AND associative?(f) AND commutative?(f)}]: THEORY
BEGIN
  IMPORTING ppg_hls_matching_support[C,G],
    ppg_bind_sum[[[C,nat],[C,nat]],[C,nat],R,unit,op] AS endpointFolds,
    ppg_monoid_sum[[C,nat],R,unit,op] AS nodeFold,
    ppg_monoid_sum[[[C,nat],[C,nat]],R,unit,op] AS edgeFold

  M: VAR DependencyMatching
  D: VAR WitnessDAG
  e: VAR Arc
  f: VAR [WNode->R]

  selected_endpoints_distinct: LEMMA selectedArcs(M,D)(e) IMPLIES e`1/=e`2

  selected_endpoints_disjoint: LEMMA Valid(D) IMPLIES
    arcEndpoints.disjointFamily(selectedArcs(M,D),parity.edgeVertices)

  endpoint_product: LEMMA e`1/=e`2 IMPLIES
    nodeFold.sum(parity.edgeVertices(e),f)=op(f(e`1),f(e`2))

  prod_selected_endpoints: THEOREM Valid(D) IMPLIES
    edgeFold.sum(selectedArcs(M,D),LAMBDA(e:Arc):op(f(e`1),f(e`2)))=
      nodeFold.sum(arcNodes(selectedArcs(M,D)),f)

END ppg_hls_selected_monoid
