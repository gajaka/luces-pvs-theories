% An unordered nonnegative sum is the supremum of all finite partial sums.
ppg_nonneg_tsum[T: TYPE]: THEORY
BEGIN
  IMPORTING ppg_enn_sup, ppg_nonneg_order[T], ppg_increasing_finite[T]
  F: VAR finite_set[T]
  f: VAR [T -> nonneg_real]
  g: VAR [T -> ENN]
  b: VAR nonneg_real
  u: VAR [nat -> nonneg_real]
  E: VAR [nat -> finite_set[T]]

  esum(F,g): RECURSIVE ENN = IF empty?(F) THEN ennFinite(0)
    ELSE eadd(g(choose(F)),esum(rest(F),g)) ENDIF MEASURE card(F)

  esum_embed: LEMMA esum(F,LAMBDA(t:T):ennFinite(f(t)))=ennFinite(sums.sum(F,f))

  finiteValues(f): set[nonneg_real] = {r:nonneg_real | EXISTS(F:finite_set[T]):r=sums.sum(F,f)}

  tsum(f): ENN = sSup(finiteValues(f))

  sequenceValues(u): set[nonneg_real] = {r:nonneg_real | EXISTS(n:nat):r=u(n)}

  iSupNN(u): ENN = sSup(sequenceValues(u))

  finite_values_member: LEMMA finiteValues(f)(sums.sum(F,f))

  sequence_values_member: LEMMA FORALL(n:nat):sequenceValues(u)(u(n))

  tsum_finite_bound: LEMMA ele(tsum(f),ennFinite(b)) IFF
    FORALL(F:finite_set[T]):sums.sum(F,f)<=b

  isup_finite_bound: LEMMA ele(iSupNN(u),ennFinite(b)) IFF FORALL(n:nat):u(n)<=b

  isup_unbounded: LEMMA (FORALL(b:nonneg_real):EXISTS(n:nat):b<u(n)) IMPLIES iSupNN(u)=ennInfinity

  supportIn(f,E): bool = FORALL(t:T):NOT family(E)(t) IMPLIES f(t)=0

  sequence_upper: LEMMA increasing(E) AND supportIn(f,E) AND
    (FORALL(n:nat):sums.sum(E(n),f)<=b) IMPLIES sums.sum(F,f)<=b

  tsum_eq_iSup: THEOREM increasing(E) AND supportIn(f,E) IMPLIES
    tsum(f)=iSupNN(LAMBDA(n:nat):sums.sum(E(n),f))

  tsum_zero: LEMMA (FORALL(t:T):f(t)=0) IMPLIES tsum(f)=ennFinite(0)

END ppg_nonneg_tsum
