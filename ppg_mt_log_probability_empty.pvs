% The time-variable product remains normalized when the variable and value types are empty.
ppg_mt_log_probability_empty: THEORY
BEGIN
  IMPORTING ppg_probability_finite_empty,
            ppg_mt_log_probability[Empty, Empty, Empty, domain, spaces, coins]
  empty_log_probability: THEOREM logMeasure(fullset[LogSpace]) = 1
END ppg_mt_log_probability_empty
