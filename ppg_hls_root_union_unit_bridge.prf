    (|left| ADT-ACCESSOR-DECL "[(inl?) -> T1]" |union_adt| NIL)
    (|inl?| ADT-RECOGNIZER-DECL "[union -> boolean]" |union_adt| NIL)
    (IF CONST-DECL
        "[boolean, T, T -> T]"
        |if_def|
        NIL)
    (|TaggedValue| TYPE-EQ-DECL NIL |ppg_probability_tagged_left| NIL)
    (|AugValue| TYPE-EQ-DECL NIL |ppg_hls_augmented_space| NIL)
    (|AugVariable| TYPE-EQ-DECL NIL |ppg_hls_augmented_space| NIL)
    (TRUE CONST-DECL "bool" |booleans| NIL)
    (|every| ADT-DEF-DECL "boolean" |union_adt| NIL)
    (PRED TYPE-EQ-DECL NIL |defined_types| NIL)
    (|union| TYPE-DECL NIL |union_adt| NIL)
    (|LogSpace| TYPE-EQ-DECL NIL |ppg_mt_random_process| NIL)
    (|TableDomain| CONST-DECL "set[Value]" |ppg_mt_random_process| NIL)
    (|int| NONEMPTY-TYPE-EQ-DECL NIL |integers| NIL)
    (|integer_pred| CONST-DECL "[rational -> boolean]" |integers| NIL)
    (|rational| NONEMPTY-TYPE-FROM-DECL NIL |rationals| NIL)
