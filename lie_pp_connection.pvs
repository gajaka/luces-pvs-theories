%------------------------------------------------------------------------------
% Connection between Lie Generator Structure and PP-Graph Theory
%
% This theory bridges the spectral transport formalism
% (lie_generator_structure) with the proof-preserving graph framework
% (proof_preserving_graphs). It formalizes the geometric relationship
% between path curvature and generator coherence.
%
% Key empirical law:
%   Higher curvature (tangent field instability) implies lower
%   generator coherence. Verified on 11/11 boot logs.
%
% Mathematical interpretation:
%   - Curvature measures how fast the tangent field X(t) rotates in g
%   - Coherence measures directional stability of X(t) over the path
%   - Hall Thm 2.14: constant X(t) <=> exp(tX), zero curvature
%   - Reversal (C22 FAIL) corresponds to curvature exceeding threshold
%
% Dependencies:
%   - lie_generator_structure
%   - proof_preserving_graphs[T]
%
% Author: Dragan Stosic
%------------------------------------------------------------------------------

lie_pp_connection[T: TYPE+]: THEORY
BEGIN

  IMPORTING proof_preserving_graphs[T]
  IMPORTING lie_generator_structure

  %% ═══════════════════════════════════════════════════════════════════
  %% Section 1: Geometric Measures (Axiomatic)
  %% ═══════════════════════════════════════════════════════════════════

  % Curvature of a pp-path in a graph: measures rate of tangent field rotation
  % Depends on the graph context (edge structure affects tangent estimation)
  % Empirical: derived from consecutive shape-direction cosines
  % Low curvature = nearly constant tangent = close to exponential
  curvature: [graph[T], prewalk -> nonneg_real]

  % Curvature depends only on the path geometry, not the surrounding graph
  % (tangent field is computed from vertex sequence, not from edges)
  curvature_graph_independent: AXIOM
    FORALL (G1, G2: graph[T], pw: prewalk):
      pp_path?(G1, pw) AND pp_path?(G2, pw)
        IMPLIES curvature(G1, pw) = curvature(G2, pw)

  % Generator coherence of a pp-path: directional stability measure
  % Empirical: C20 cos_full value (cosine between first and last segments)
  % High coherence = stable generator direction
  generator_coherence: [prewalk -> nonneg_real]

  % Coherence is bounded [0, 1]
  coherence_bounded: AXIOM
    FORALL (pw: prewalk): generator_coherence(pw) <= 1

  %% ═══════════════════════════════════════════════════════════════════
  %% Section 2: Curvature-Coherence Inverse Law
  %% ═══════════════════════════════════════════════════════════════════

  % E1: Fundamental empirical law — curvature and coherence are
  %     inversely monotone on observed paths.
  %     Verified: 11/11 boot logs show strict inverse correlation.
  coherence_curvature_inverse: AXIOM
    FORALL (G: graph[T], pw1, pw2: prewalk):
      pp_path?(G, pw1) AND pp_path?(G, pw2) AND
      curvature(G, pw1) >= curvature(G, pw2)
        IMPLIES generator_coherence(pw1) <= generator_coherence(pw2)

  %% ═══════════════════════════════════════════════════════════════════
  %% Section 3: Curvature Thresholds and Classification
  %% ═══════════════════════════════════════════════════════════════════

  % Curvature threshold for coherence (empirical: cos_full = 0.7)
  coherence_threshold: nonneg_real

  % Curvature threshold for strong coherence (empirical: cos_full = 0.85)
  strong_coherence_threshold: nonneg_real

  % Threshold ordering
  threshold_ordering: AXIOM
    strong_coherence_threshold <= coherence_threshold

  % E2: Below coherence threshold curvature => path is coherent
  low_curvature_coherent: AXIOM
    FORALL (G: graph[T], pw: prewalk):
      pp_path?(G, pw) AND curvature(G, pw) <= coherence_threshold
        IMPLIES generator_coherence(pw) >= 0.7

  % E3: Below strong threshold curvature => path is strongly coherent
  low_curvature_strong: AXIOM
    FORALL (G: graph[T], pw: prewalk):
      pp_path?(G, pw) AND curvature(G, pw) <= strong_coherence_threshold
        IMPLIES generator_coherence(pw) >= 0.85

  %% ═══════════════════════════════════════════════════════════════════
  %% Section 4: Connection to lie_generator_structure predicates
  %% ═══════════════════════════════════════════════════════════════════

  % Bridge: a pp-path maps to a TransportPath
  transport_of: [prewalk -> TransportPath]

  % E4: Observed pp-path maps to continuously observed transport path
  observed_bridge: AXIOM
    FORALL (G: graph[T], pw: prewalk):
      pp_path?(G, pw) IMPLIES
        continuously_observed?(transport_of(pw))

  % E5: High curvature (above threshold) implies shape direction reversal
  %     Empirical: curvature > threshold <=> C22 FAIL <=> min_cos < 0
  high_curvature_reversal: AXIOM
    FORALL (G: graph[T], pw: prewalk):
      curvature(G, pw) > coherence_threshold IMPLIES
        shape_direction_reversal?(transport_of(pw))

  % E5b: Shape direction reversal implies curvature above threshold
  %      (converse of E5 — the equivalence)
  reversal_high_curvature: AXIOM
    FORALL (G: graph[T], pw: prewalk):
      shape_direction_reversal?(transport_of(pw)) IMPLIES
        curvature(G, pw) > coherence_threshold

  % E6: No reversal implies curvature bounded by threshold
  no_reversal_bounded: AXIOM
    FORALL (G: graph[T], pw: prewalk):
      NOT shape_direction_reversal?(transport_of(pw)) IMPLIES
        curvature(G, pw) <= coherence_threshold

  %% ═══════════════════════════════════════════════════════════════════
  %% Section 5: Derived Theorems
  %% ═══════════════════════════════════════════════════════════════════

  % T1: Zero curvature path has maximum coherence
  zero_curvature_max_coherence: THEOREM
    FORALL (G: graph[T], pw1, pw2: prewalk):
      pp_path?(G, pw1) AND pp_path?(G, pw2) AND
      curvature(G, pw1) = 0
        IMPLIES generator_coherence(pw1) >= generator_coherence(pw2)

  % T2: pp-path with reversal has lower coherence than any non-reversing path
  reversal_lower_coherence: THEOREM
    FORALL (G: graph[T], pw1, pw2: prewalk):
      pp_path?(G, pw1) AND pp_path?(G, pw2) AND
      shape_direction_reversal?(transport_of(pw1)) AND
      NOT shape_direction_reversal?(transport_of(pw2))
        IMPLIES generator_coherence(pw1) <= generator_coherence(pw2)

  % T3: Observed path without reversal is coherent
  %     (connects lie_generator_structure axiom A4 to pp-graph paths)
  observed_no_reversal_coherent: THEOREM
    FORALL (G: graph[T], pw: prewalk):
      pp_path?(G, pw) AND
      NOT shape_direction_reversal?(transport_of(pw))
        IMPLIES coherent?(transport_of(pw))

  % T4: pp-path coherence implies generator estimation is stable
  pp_path_coherence_stable: THEOREM
    FORALL (G: graph[T], pw: prewalk):
      pp_path?(G, pw) AND curvature(G, pw) <= coherence_threshold
        IMPLIES coherent?(transport_of(pw))

  % T5: pp-path with reversal breaks coherence
  pp_path_reversal_incoherent: THEOREM
    FORALL (G: graph[T], pw: prewalk):
      pp_path?(G, pw) AND
      shape_direction_reversal?(transport_of(pw))
        IMPLIES NOT coherent?(transport_of(pw))

  % T6: Curvature is preserved along pp-transform
  %     If path persists, curvature is unchanged (path geometry is the same)
  %     Curvature depends on the sequence of vertices, not the surrounding graph
  curvature_preserved_under_transform: THEOREM
    FORALL (G1, G2: graph[T], pw: prewalk):
      pp_transform?(G1, G2) AND pp_path?(G1, pw) AND pp_path?(G2, pw)
        IMPLIES curvature(G2, pw) = curvature(G1, pw)

  %% ═══════════════════════════════════════════════════════════════════
  %% Empirical verification summary
  %% ═══════════════════════════════════════════════════════════════════
  %%
  %% Boot log | C14  | C22      | curvature | C20      | coherence
  %% ─────────┼──────┼──────────┼───────────┼──────────┼──────────
  %% boot320  | PASS | STRONG   | 0.03      | STRONG   | 0.94
  %% boot321  | PASS | PASS     | 0.12      | PASS     | 0.78
  %% boot334  | PASS | FAIL     | 1.47      | FAIL     | 0.31
  %% boot335  | PASS | FAIL     | 2.10      | FAIL     | 0.22
  %%
  %% Pattern: curvature↑ => coherence↓ (strict inverse monotonicity)
  %% Threshold: curvature > ~0.5 correlates with C22 FAIL
  %%
  %% ═══════════════════════════════════════════════════════════════════

END lie_pp_connection
