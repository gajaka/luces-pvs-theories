% The project real sum is the real instance of the generic monoid sum.
ppg_real_sum[T: TYPE]: THEORY
BEGIN
  IMPORTING ppg_finite_sum[T]
  IMPORTING ppg_monoid_sum[T, real, 0, LAMBDA (a,b: real): a + b] AS additive
  S, A, B: VAR finite_set[T]
  f: VAR [T -> real]
  x: VAR T

  fsum_eq_sum: LEMMA fsum(S, f) = additive.sum(S, f)

  fsum_diff_subset: LEMMA subset?(A, B) IMPLIES
    fsum(B, f) = fsum(A, f) + fsum(difference(B, A), f)

  fsum_add: LEMMA fsum(add(x, S), f) = fsum(S, f) + IF S(x) THEN 0 ELSE f(x) ENDIF

  fsum_disj_union: LEMMA disjoint?(A, B) IMPLIES fsum(union(A, B), f) = fsum(A, f) + fsum(B, f)

END ppg_real_sum
