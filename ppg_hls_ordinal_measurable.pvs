% Equality of two selected labels is a finite union of label fibers.
% The earlier-occurrence rank is therefore a measurable finite prefix
% count. Its ordinal event is a countable union of measurable fibers.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley,
% 1995, measurable functions and countable unions of events.
% Lean counterpart: PPGraphHLSOrdinalOccurrence.lean.
ppg_hls_ordinal_measurable[C,V,Value:TYPE,domain:[V->set[Value]],
  footprint:[C->finite_set[V]],
  (IMPORTING ppg_mt_semantics[C,V,Value,domain])bad:[C,MTState->bool],
  universe:{S:finite_set[C]|FORALL(a:C):S(a)},
  (IMPORTING ppg_mt_log_measurable[C,V,Value,domain])
  coordinates:[V->ppg_measurable_space[Value].MeasurableSpace]]: THEORY
BEGIN
  IMPORTING ppg_hls_ordinal_occurrence[C,V,Value,domain,footprint,bad],
    ppg_finite_events[LogSpace,C,TableSigma(coordinates)] AS ordinalLabelEvents,
    ppg_measurable_map[LogSpace,nat] AS ordinalNatMaps
  fallback,a: VAR C
  enumeration: VAR list[C]
  omega: VAR LogSpace
  s,t,r: VAR nat

  sameLabelTime(fallback,enumeration,t)(s): set[LogSpace] = {omega:LogSpace|
    realSchedule(fallback,enumeration,omega)(s)=realSchedule(fallback,enumeration,omega)(t)}

  sameLabelComplement(fallback,enumeration,s,t)(a): set[LogSpace] = complement(intersection(
    labelEvent(footprint,bad,fallback,enumeration,initialStateFromLog,a,s),
    labelEvent(footprint,bad,fallback,enumeration,initialStateFromLog,a,t)))

  same_label_complement_meet: LEMMA sameLabelTime(fallback,enumeration,t)(s)=
    complement(ordinalLabelEvents.finiteMeet(universe,
      sameLabelComplement(fallback,enumeration,s,t)))

  measurable_same_label_complement: LEMMA measurableBad(coordinates,bad) IMPLIES
    TableSigma(coordinates)(sameLabelComplement(fallback,enumeration,s,t)(a))

  measurable_same_label_family: LEMMA measurableBad(coordinates,bad) IMPLIES
    FORALL(a:C):TableSigma(coordinates)(sameLabelComplement(fallback,enumeration,s,t)(a))

  measurable_same_label_time: LEMMA measurableBad(coordinates,bad) IMPLIES
    TableSigma(coordinates)(sameLabelTime(fallback,enumeration,t)(s))

  earlier_count_prefix: LEMMA earlierLabelCount(realSchedule(fallback,enumeration,omega),t)=
    countPrefix(sameLabelTime(fallback,enumeration,t),omega,t)

  earlier_count_prefix_function: LEMMA
    (LAMBDA(omega:LogSpace):earlierLabelCount(realSchedule(fallback,enumeration,omega),t))=
    (LAMBDA(omega:LogSpace):countPrefix(sameLabelTime(fallback,enumeration,t),omega,t))

  measurable_earlierLabelCount: THEOREM measurableBad(coordinates,bad) IMPLIES
    ordinalNatMaps.measurable(TableSigma(coordinates),fullset[set[nat]],
      LAMBDA(omega:LogSpace):earlierLabelCount(realSchedule(fallback,enumeration,omega),t))

  ordinal_rank_preimage: LEMMA ordinalRankFiber(fallback,enumeration,t,r)=
    ordinalNatMaps.inverseImage(
      LAMBDA(omega:LogSpace):earlierLabelCount(realSchedule(fallback,enumeration,omega),t),
      singleton[nat](r))

  measurable_ordinal_rank_fiber: LEMMA measurableBad(coordinates,bad) IMPLIES
    TableSigma(coordinates)(ordinalRankFiber(fallback,enumeration,t,r))

  measurable_ordinal_component: LEMMA measurableBad(coordinates,bad) IMPLIES
    TableSigma(coordinates)(intersection(
      randomInitResamplingEvent(footprint,bad,fallback,enumeration,a,t),
      ordinalRankFiber(fallback,enumeration,t,r)))

  measurable_ordinal_family: LEMMA measurableBad(coordinates,bad) IMPLIES
    FORALL(t:nat):TableSigma(coordinates)(intersection(
      randomInitResamplingEvent(footprint,bad,fallback,enumeration,a,t),
      ordinalRankFiber(fallback,enumeration,t,r)))

  measurableSet_ordinalOccurrence: THEOREM measurableBad(coordinates,bad) IMPLIES
    TableSigma(coordinates)(ordinalOccurrence(fallback,enumeration,a,r))

END ppg_hls_ordinal_measurable
