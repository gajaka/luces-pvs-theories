% A solution of the hitting-time equations has no negative minimum:
% stochastic averaging cannot fall below the minimum, whereas a bad
% state requires an additional unit. At good states the solution is zero.
% Absorption then makes the same solution an accepted drift witness.
%
% Michael Mitzenmacher and Eli Upfal, Probability and Computing,
% second edition, Section 7.1.1 and Exercise 7.25.
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, Exercise 10.22.
% Lean counterparts: solution_nonnegative and solution_checked in
% PPGraphFinitePotential.lean.
ppg_finite_potential_order[State: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)}]: THEORY
BEGIN
  IMPORTING ppg_finite_potential_system[State,universe],ppg_real_minimum[State]
  M: VAR Model
  f: VAR Vector
  s,t: VAR State
  c: VAR rat
  a,b,w: VAR real

  Stochastic(M): bool =
    (FORALL(s,t:State):0<=M`transition(s,t)) AND
    (FORALL(s:State):rational.sum(universe,LAMBDA(t:State):M`transition(s,t))=1)

  Absorbing(M): bool = FORALL(s,t:State):M`good(s) AND NOT M`good(t) IMPLIES
    M`transition(s,t)=0

  nonnegative_scale_monotone: LEMMA 0<=w AND a<=b IMPLIES w*a<=w*b

  full_minimum_exists: LEMMA universe(s) IMPLIES
    EXISTS(m:State):FORALL(t:State):f(m)<=f(t)

  row_lower_bound: LEMMA Stochastic(M) AND (FORALL(t:State):c<=f(t)) IMPLIES
    c<=successorValue(M,f,s)

  solution_nonnegative: THEOREM Stochastic(M) AND Equations(M,f) IMPLIES 0<=f(s)

  absorbing_good_product: LEMMA Absorbing(M) AND Equations(M,f) AND M`good(s) IMPLIES
    M`transition(s,t)*f(t)=0

  absorbing_good_expectation: LEMMA Absorbing(M) AND Equations(M,f) AND M`good(s) IMPLIES
    successorValue(M,f,s)=0

  solution_checked: THEOREM Stochastic(M) AND Absorbing(M) AND Equations(M,f) IMPLIES
    check(M,(# potential:=f,delta:=1 #))

END ppg_finite_potential_order
