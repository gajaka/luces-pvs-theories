%%% categorical_pp_graphs.pvs
%%% Categorical Structure of Proof-Preserving Graphs
%%%
%%% Port of PPGraphCategorical.lean to PVS.
%%% Morphisms between PP-graphs of potentially different types.
%%% Formalizes structure-preserving maps, embeddings, quotients,
%%% refinement between graphs, and simulation relations.
%%%
%%% Refinement at the GRAPH level is the natural
%%% generalization of rr_rel at the ELEMENT level. A concrete
%%% graph refines an abstract graph via a quotient morphism.
%%%
%%% Author: Dragan Stosic, 2026

categorical_pp_graphs[T: TYPE, U: TYPE]: THEORY
BEGIN

%% ═══════════════════════════════════════════════════════════════════
%% Types
%% ═══════════════════════════════════════════════════════════════════

  IMPORTING directed_pp_graph[T], directed_pp_graph[U]

  Graph_T: TYPE = directed_pp_graph[T].Graph

  Graph_U: TYPE = directed_pp_graph[U].Graph

  rr_T: [T, T -> bool]

  rr_U: [U, U -> bool]

  inv_T: [T -> bool]

  inv_U: [U -> bool]

  G1: Graph_T

  G2: Graph_U

%% ═══════════════════════════════════════════════════════════════════
%% Definitions
%% ═══════════════════════════════════════════════════════════════════

  % PP-edge: refinement-compatible edge with invariant
  pp_edge_T(x, y: T): bool =
    x /= y AND inv_T(x) AND inv_T(y) AND rr_T(x, y)

  pp_edge_U(x, y: U): bool =
    x /= y AND inv_U(x) AND inv_U(y) AND rr_U(x, y)

  % PP-validity: all edges are pp-edges
  pp_valid_T(G: Graph_T): bool =
    FORALL (x, y: T): G`edges(x, y) IMPLIES pp_edge_T(x, y)

  pp_valid_U(G: Graph_U): bool =
    FORALL (x, y: U): G`edges(x, y) IMPLIES pp_edge_U(x, y)

  % Explicit graph and predicate arguments allow composition across types.
  morphism(f: [T -> U], source: Graph_T, target: Graph_U,
           rel_T: [T, T -> bool], pred_T: [T -> bool],
           rel_U: [U, U -> bool], pred_U: [U -> bool]): bool =
    (FORALL (x: T): source`vertices(x) IMPLIES target`vertices(f(x))) AND
    (FORALL (x, y: T): source`edges(x, y) AND
      directed_pp_graph[T].pp_edge(rel_T, pred_T, x, y) IMPLIES
        target`edges(f(x), f(y)) AND
        directed_pp_graph[U].pp_edge(rel_U, pred_U, f(x), f(y)))

  embedding(f: [T -> U], source: Graph_T, target: Graph_U,
            rel_T: [T, T -> bool], pred_T: [T -> bool],
            rel_U: [U, U -> bool], pred_U: [U -> bool]): bool =
    morphism(f, source, target, rel_T, pred_T, rel_U, pred_U) AND
    (FORALL (x, y: T): f(x) = f(y) IMPLIES x = y)

  % The original interface remains an instance with fixed graph data.
  pp_morphism?(f: [T -> U]): bool =
    morphism(f, G1, G2, rr_T, inv_T, rr_U, inv_U)

  % PP-Embedding: injective morphism
  pp_embedding?(f: [T -> U]): bool =
    pp_morphism?(f) AND
    (FORALL (x, y: T): f(x) = f(y) IMPLIES x = y)

  % PP-Quotient: surjective morphism (abstraction)
  pp_quotient?(f: [T -> U]): bool =
    pp_morphism?(f) AND
    (FORALL (u: U): EXISTS (x: T): f(x) = u)

  % Graph-Level Refinement: G1 refines G2 via some quotient
  pp_refines?: bool =
    EXISTS (f: [T -> U]): pp_quotient?(f)

  % Simulation: abstraction-concretization pair with round-trip
  simulation?(f: [T -> U], g: [U -> T]): bool =
    pp_morphism?(f) AND
    (FORALL (u: U): G2`vertices(u) IMPLIES G1`vertices(g(u))) AND
    (FORALL (x: T): G1`vertices(x) IMPLIES g(f(x)) = x)

%% ═══════════════════════════════════════════════════════════════════
%% Theorems
%% ═══════════════════════════════════════════════════════════════════

  % T1: Embedding is a morphism
  thm_embedding_is_morphism: THEOREM
    FORALL (f: [T -> U]):
      pp_embedding?(f) IMPLIES pp_morphism?(f)

  % T2: Quotient is a morphism
  thm_quotient_is_morphism: THEOREM
    FORALL (f: [T -> U]):
      pp_quotient?(f) IMPLIES pp_morphism?(f)

  % T3: Morphism preserves pp-edges
  thm_morphism_preserves_pp_edges: THEOREM
    FORALL (f: [T -> U], x, y: T):
      pp_morphism?(f) AND pp_valid_T(G1) AND G1`edges(x, y)
      IMPLIES pp_edge_U(f(x), f(y))

  % T4: Simulation implies morphism
  thm_simulation_is_morphism: THEOREM
    FORALL (f: [T -> U], g: [U -> T]):
      simulation?(f, g) IMPLIES pp_morphism?(f)

  % T5: Simulation + surjective implies refinement
  thm_simulation_implies_refinement: THEOREM
    FORALL (f: [T -> U], g: [U -> T]):
      simulation?(f, g) AND
      (FORALL (u: U): EXISTS (x: T): f(x) = u)
      IMPLIES pp_refines?

  % T6: Simulation round-trip: g(f(x)) = x for all vertices
  thm_simulation_roundtrip: THEOREM
    FORALL (f: [T -> U], g: [U -> T], x: T):
      simulation?(f, g) AND G1`vertices(x)
      IMPLIES g(f(x)) = x

  embedding_agrees: LEMMA
    FORALL (f: [T -> U]): pp_embedding?(f) =
      embedding(f, G1, G2, rr_T, inv_T, rr_U, inv_U)

END categorical_pp_graphs
