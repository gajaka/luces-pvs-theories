% Finite real products use the choose/rest recursion of the PVS
% finite_sets_product theory. The cardinality measure proves termination.
% Algebraic lemmas for this product are proved in the importing theories.

ppg_finite_product[T: TYPE]: THEORY
BEGIN
  product(S: finite_set[T], f: [T -> real]): RECURSIVE real =
    IF empty?(S) THEN 1 ELSE f(choose(S)) * product(rest(S), f) ENDIF
    MEASURE card(S)
END ppg_finite_product
