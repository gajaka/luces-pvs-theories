% The state-prefix history is the inverse-image sigma algebra of the
% finite path space. Longer prefixes refine its fibers, so these histories
% form a filtration. The current state is its final coordinate.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_finite_table_history[V,Value:TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]],
  (IMPORTING ppg_mt_native_spaces[bool,V,Value,LAMBDA(v:V):domains(v)],
    ppg_finite_table_core[V,Value,variables,domains])
  spaces:{S:VariableSpaces|FORALL(v:V,x:(domains(v))):S(v)(singleton[(domains(v))](x))},
  F:ppg_finite_table_core[V,Value,variables,domains].Footprint,
  init:{f:ppg_finite_table_core[V,Value,variables,domains].Initializer|
    ppg_measurable_map[LogSpace,MTState].measurable(NativeTableSigma(spaces),NativeStateSigma(spaces),f)}]: THEORY
BEGIN
  State: TYPE = ppg_finite_table_core[V,Value,variables,domains].State

  ResamplingLog: TYPE = ppg_finite_table_core[V,Value,variables,domains].ResamplingLog

  IMPORTING ppg_finite_table_paths[V,Value,variables,domains] AS historyPaths,
    ppg_finite_table_spaces[V,Value,variables,domains,spaces] AS historySpaces,
    ppg_finite_table_measurable_prefix[V,Value,variables,domains,spaces] AS historyPrefix,
    ppg_finite_path_space,
    ppg_discrete_comap,
    ppg_filtration[ResamplingLog,State,NativeTableSigma(spaces)] AS historyFiltration

  n,m: VAR nat
  omega1,omega2: VAR ResamplingLog

  prefixMap(n): [ResamplingLog->historyPaths.Path(n)] = historyPrefix.prefixMap(F,init,n)

  history(n): ppg_measurable_space[ResamplingLog].MeasurableSpace =
    ppg_discrete_comap[ResamplingLog,historyPaths.Path(n)].comap(prefixMap(n))

  initial_measurable: LEMMA ppg_measurable_map[ResamplingLog,State].measurable(
    historySpaces.tableSigma,historySpaces.stateSigma,init)

  prefix_full_measurable: LEMMA ppg_measurable_map[ResamplingLog,historyPaths.Path(n)].measurable(
    NativeTableSigma(spaces),fullset[set[historyPaths.Path(n)]],prefixMap(n))

  history_representation: LEMMA FORALL(A:set[ResamplingLog]):history(n)(A) IFF
    EXISTS(B:set[historyPaths.Path(n)]):
      historyPrefix.pathSigma(n)(B) AND
      A=ppg_measurable_map[ResamplingLog,historyPaths.Path(n)].inverseImage(prefixMap(n),B)

  history_ambient: LEMMA subset?(history(n),NativeTableSigma(spaces))

  prefix_determines_current: LEMMA
    historyPaths.statePrefix(F,init,n,omega1)=historyPaths.statePrefix(F,init,n,omega2) IMPLIES
      trajectory(F,init,n,omega1)=trajectory(F,init,n,omega2)

  prefix_fibers_refine: LEMMA m<=n AND
    historyPaths.statePrefix(F,init,n,omega1)=historyPaths.statePrefix(F,init,n,omega2) IMPLIES
      historyPaths.statePrefix(F,init,m,omega1)=historyPaths.statePrefix(F,init,m,omega2)

  history_increasing: LEMMA m<=n IMPLIES subset?(history(m),history(n))

  tableHistory: historyFiltration.Filtration = LAMBDA(n:nat):history(n)

  trajectory_adapted: THEOREM ppg_measurable_map[ResamplingLog,State].measurable(
    history(n),NativeStateSigma(spaces),LAMBDA(omega:ResamplingLog):trajectory(F,init,n,omega))

END ppg_finite_table_history
