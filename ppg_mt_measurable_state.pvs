% Coordinate measurability is preserved by fixed and measurably chosen footprints.
ppg_mt_measurable_state[A, C, V, Value: TYPE, domain: [V -> set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_mt_log_measurable[C, V, Value, domain],
            ppg_measurable_product[A, V, Value, domain],
            ppg_measurable_compose[A, MTState, Value], ppg_measurable_map[A, C]
  SA: VAR ppg_measurable_space[A].MeasurableSpace
  coordinates: VAR [V -> ppg_measurable_space[Value].MeasurableSpace]
  f, g: VAR [A -> MTState]
  choice: VAR [A -> C]
  vars: VAR CertVars
  F: VAR finite_set[V]
  v: VAR V

  measurable_state_coordinate: LEMMA measurable(SA, StateSigma(coordinates), f) IMPLIES
    measurable(SA, coordinates(v), LAMBDA (a: A): f(a)(v))

  measurable_state_from_coordinates: LEMMA
    (FORALL (v: V): measurable(SA, coordinates(v), LAMBDA (a: A): f(a)(v))) IMPLIES
      measurable(SA, StateSigma(coordinates), f)

  measurable_resample_maps: LEMMA measurable(SA, StateSigma(coordinates), f) AND
    measurable(SA, StateSigma(coordinates), g) IMPLIES
      measurable(SA, StateSigma(coordinates), LAMBDA (a: A): resample(F, f(a), g(a)))

  footprintEvent(vars, choice, v): set[A] = {a: A | vars(choice(a))(v)}

  measurable_footprint_event: LEMMA measurable(SA, fullset[set[C]], choice) IMPLIES
    SA(footprintEvent(vars, choice, v))

  measurable_resample_selected: LEMMA measurable(SA, StateSigma(coordinates), f) AND
    measurable(SA, StateSigma(coordinates), g) AND measurable(SA, fullset[set[C]], choice)
    IMPLIES measurable(SA, StateSigma(coordinates),
      LAMBDA (a: A): resample(vars(choice(a)), f(a), g(a)))

END ppg_mt_measurable_state
