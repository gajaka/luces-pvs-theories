% A successful finite rational drift check bounds the existing MT TLog
% from slot-zero initialization. The initializer is constructed here; its
% measurability and locality are not additional premises.
%
% Johannes Lengler, "Drift Analysis", arXiv:1712.00964.
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Section 2.
ppg_finite_mt_checked_random[I,V,Value:TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]],
  events:{U:finite_set[I]|FORALL(i:I):U(i)},
  fallback:I,eventOrder:{e:list[I]|FORALL(i:I):member(i,e)},
  (IMPORTING ppg_finite_resampling_core[V,Value,variables,domains],
    ppg_resampling_selection[I,V,Value,variables,domains,events])
  Q:{Q:Marginals|Valid(Q)},B:ppg_resampling_selection[I,V,Value,variables,domains,events].Problem]: THEORY
BEGIN
  IMPORTING ppg_finite_table_core[V,Value,variables,domains]

  State: TYPE = ppg_finite_resampling_core[V,Value,variables,domains].State

  ResamplingLog: TYPE = ppg_finite_table_core[V,Value,variables,domains].ResamplingLog

  plainDomain: MACRO [V->set[Value]] = LAMBDA(v:V):domains(v)

  IMPORTING ppg_resampling_table_init[V,Value,variables,domains,Q] AS randomInit,
    ppg_finite_mt_legacy[I,V,Value,variables,domains,events,fallback,eventOrder] AS randomLegacy,
    ppg_resampling_table_product[V,Value,variables,domains,Q] AS randomLaws,
    ppg_resampling_product_law[V,Value,variables,domains,Q] AS randomProduct,
    ppg_resampling_update[V,Value,variables,domains] AS randomCheck,
    ppg_resampling_state_finite[V,Value,variables,domains] AS randomStates,
    ppg_finite_resampling_core[V,Value,variables,domains] AS randomCore

  ambient: MACRO ppg_measurable_space[ResamplingLog].MeasurableSpace = randomLaws.tableAmbient

  IMPORTING ppg_finite_mt_table_expectation[I,V,Value,variables,domains,events,
      fallback,eventOrder,Q,B,randomInit.randomInit] AS randomMean,
    ppg_resampling_table_execution[V,Value,variables,domains,Q,randomLegacy.firstPolicy(B),
      randomInit.randomInit] AS randomExecution,
    ppg_finite_drift[State,randomStates.allStates] AS randomDrift,
    ppg_finite_update[State,State,randomStates.allStates,randomStates.allStates] AS randomUpdate,
    ppg_mt_time_expectation[I,V,Value,plainDomain,randomProduct.spaces,randomProduct.coins] AS randomOldTime,
    ppg_mt_random_process[I,V,Value,plainDomain] AS randomSlots,
    ppg_mt_selection[I,V,Value,plainDomain] AS randomSelection,
    ppg_mt_native_spaces[I,V,Value,plainDomain] AS randomOldSpaces,
    ppg_mt_log_probability[I,V,Value,plainDomain,randomProduct.spaces,randomProduct.coins] AS randomOldLaw,
    ppg_mt_table_label[bool,I,V,Value,plainDomain,randomProduct.spaces,randomProduct.coins] AS randomLabels,
    ppg_probability_integral[randomSlots.LogSpace,randomOldSpaces.NativeTableSigma(randomProduct.spaces),
      randomOldLaw.logMeasure] AS randomOldIntegral,
    ppg_extended_integral[randomSlots.LogSpace,randomOldSpaces.NativeTableSigma(randomProduct.spaces),
      randomOldLaw.logMeasure] AS randomOldExtended

  history: MACRO ppg_filtration[ResamplingLog,State,ambient].Filtration = randomExecution.tableH

  IMPORTING ppg_finite_process_expectation[State,ResamplingLog,randomStates.allStates,ambient,
      randomExecution.tableMeasure,history] AS randomExpected,
    ppg_finite_measure_integral[ResamplingLog,ambient,randomExecution.tableMeasure] AS randomFunctions,
    ppg_finite_expectation[ResamplingLog,ambient,randomExecution.tableMeasure] AS randomExpectation,
    ppg_probability_finite_view[ResamplingLog,ambient] AS randomView,
    measure_integration@integral[ResamplingLog,ppg_nasa_sigma[ResamplingLog].asNasa(ambient),
      randomExecution.tableMeasure] AS randomIntegral,
    measure_integration@measure_theory[randomSlots.LogSpace,
      ppg_nasa_sigma[randomSlots.LogSpace].asNasa(randomOldSpaces.NativeTableSigma(randomProduct.spaces)),
      randomOldIntegral.nasaLaw] AS randomOldAE

  CheckedWitness: TYPE = {w:randomDrift.Witness|randomCheck.resamplingCheck(Q,randomLegacy.firstPolicy(B),w)}

  W: VAR CheckedWitness

  accepted(W): randomExpected.AcceptedWitness(randomUpdate.model(randomCore.rule(Q,randomLegacy.firstPolicy(B)))) = W

  checkedRate(W): posrat = W`delta

  old_expectation_eq: LEMMA randomOldTime.randomInitETLog(
    B`footprint,B`bad,fallback,eventOrder)=randomMean.legacyExpected

  legacyPotentialValue(W)(omega:randomSlots.LogSpace): rat =
    W`potential(randomSlots.initialStateFromLog(omega))

  initial_function_eq: LEMMA randomExecution.initialPotential(accepted(W))=legacyPotentialValue(W)

  legacyPotential(W): randomOldExtended.NonnegativeFunction = legacyPotentialValue(W)

  initial_integral_eq: LEMMA randomIntegral.integral(randomExecution.initialPotential(accepted(W)))=
    randomOldIntegral.expectation(legacyPotential(W))

  rate_eq: LEMMA randomExpected.positiveRate(
    randomUpdate.model(randomCore.rule(Q,randomLegacy.firstPolicy(B))),accepted(W))=checkedRate(W)

  checked_randomInitETLog_le: THEOREM
    ele(randomOldTime.randomInitETLog(B`footprint,B`bad,fallback,eventOrder),
      ennFinite(randomOldIntegral.expectation(legacyPotential(W))/checkedRate(W)))

  checked_randomInitETLog_lt_top: THEOREM FORALL(W:CheckedWitness):
    ennFinite?(randomOldTime.randomInitETLog(B`footprint,B`bad,fallback,eventOrder))

  oldSuccess: set[randomSlots.LogSpace] = {omega:randomSlots.LogSpace|EXISTS(T:nat):
    randomSelection.MTGood(B`bad,randomSlots.randTraj(B`footprint,B`bad,fallback,eventOrder,randomSlots.initialStateFromLog(omega),omega,T))}

  success_event_eq: LEMMA randomMean.rawSuccess=oldSuccess

  checked_randomInit_randTraj_ae_exists_good: THEOREM FORALL(W:CheckedWitness):randomOldAE.ae?(oldSuccess)

END ppg_finite_mt_checked_random
