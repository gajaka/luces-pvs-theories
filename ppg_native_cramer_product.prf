      EXISTS (i: below(length(M))): length(nth(M, i)) = c)}"
     |matrices| |matrices|)
    (|PosFullMatrix| TYPE-EQ-DECL NIL |matrices| |matrices|)
    (|Square| TYPE-EQ-DECL NIL |matrices| |matrices|))
   SHOSTAK)))

