%------------------------------------------------------------------------------
% OpenTitan Boot Chain — Concrete Instantiation
%
% Instantiation of lowrisc_boot_verification for the OpenTitan
% secure boot flow: ROM --> ROM_EXT --> BL0 --> Kernel
%
% Concrete instantiation: the abstract pp-graph framework applied
% directly to hardware root-of-trust verification.
%
% OpenTitan boot stages:
%   ROM      - Immutable mask ROM, hardware root of trust
%   ROM_EXT  - First mutable code, verified by ROM via signature
%   BL0      - Owner bootloader, verified by ROM_EXT via manifest hash
%   KERNEL   - Operating system, verified by BL0 via secure boot policy
%
% Each verification step is a pp-edge:
%   - invariant_holds(verifier): verifier stage is authentic
%   - invariant_holds(verified): verified stage passes check
%   - rr_rel(verifier, verified): implementation refines specification
%
% Dependencies:
%   - lowrisc_boot_verification[BootStage]
%   - proof_preserving_graphs[BootStage] (via import chain)
%   - sets_aux@rr_rel[BootStage, BootStage] (via import chain)
%
% Author: Dragan Stosic
%------------------------------------------------------------------------------

opentitan_boot_instance: THEORY
BEGIN

  %% ═══════════════════════════════════════════════════════════════════
  %% Section 1: Concrete Boot Stage Type
  %% ═══════════════════════════════════════════════════════════════════

  % The four boot stages of OpenTitan
  BootStage: TYPE = {ROM, ROM_EXT, BL0, KERNEL}

  IMPORTING lowrisc_boot_verification[BootStage]

  %% ═══════════════════════════════════════════════════════════════════
  %% Section 2: Level Assignment
  %% ═══════════════════════════════════════════════════════════════════

  % Concrete level function for OpenTitan stages
  ot_level(s: BootStage): nat =
    CASES s OF
      ROM: 0,
      ROM_EXT: 1,
      BL0: 2,
      KERNEL: 3
    ENDCASES

  %% ═══════════════════════════════════════════════════════════════════
  %% Section 3: Invariant Interpretation
  %% ═══════════════════════════════════════════════════════════════════

  % ROM invariant: always holds (immutable hardware)
  % ROM_EXT invariant: ECDSA signature valid against ROM public key
  % BL0 invariant: SHA-256 hash matches manifest signed by ROM_EXT
  % KERNEL invariant: secure boot policy satisfied (measurements match)

  % Predicate: signature verification passed
  signature_valid: PRED[BootStage]

  % Predicate: hash matches manifest
  hash_valid: PRED[BootStage]

  % Predicate: secure boot policy met
  policy_valid: PRED[BootStage]

  % ROM is always valid (hardware root)
  rom_always_valid: AXIOM signature_valid(ROM)

  %% ═══════════════════════════════════════════════════════════════════
  %% Section 4: Concrete Invariant
  %% ═══════════════════════════════════════════════════════════════════

  % Concrete invariant: each stage has its own verification criterion
  ot_invariant(s: BootStage): bool =
    CASES s OF
      ROM: TRUE,
      ROM_EXT: signature_valid(ROM_EXT),
      BL0: hash_valid(BL0),
      KERNEL: policy_valid(KERNEL)
    ENDCASES

  %% ═══════════════════════════════════════════════════════════════════
  %% Section 5: Concrete Refinement Relation
  %% ═══════════════════════════════════════════════════════════════════

  % The refinement relation for boot stages:
  % Each stage implements the specification expected by its verifier
  % Concrete: ROM_EXT implements ROM's boot protocol spec
  %           BL0 implements ROM_EXT's loader spec
  %           KERNEL implements BL0's OS loading spec
  ot_refines(x, y: BootStage): bool =
    (x = ROM AND y = ROM_EXT) OR
    (x = ROM_EXT AND y = BL0) OR
    (x = BL0 AND y = KERNEL)

  %% ═══════════════════════════════════════════════════════════════════
  %% Section 6: Concrete Boot Graph
  %% ═══════════════════════════════════════════════════════════════════

  % The OpenTitan boot graph has exactly 3 edges:
  %   ROM --> ROM_EXT --> BL0 --> KERNEL
  ot_edges(x, y: BootStage): bool =
    (x = ROM AND y = ROM_EXT) OR
    (x = ROM_EXT AND y = BL0) OR
    (x = BL0 AND y = KERNEL)

  %% ═══════════════════════════════════════════════════════════════════
  %% Section 7: Properties of Concrete Instance
  %% ═══════════════════════════════════════════════════════════════════

  % T1: Level function is strictly increasing along edges
  ot_levels_increasing: THEOREM
    FORALL (x, y: BootStage):
      ot_edges(x, y) IMPLIES ot_level(x) < ot_level(y)

  % T2: Each level has exactly one stage (boot chain property)
  ot_unique_levels: THEOREM
    FORALL (x, y: BootStage):
      ot_level(x) = ot_level(y) IMPLIES x = y

  % T3: ROM is the only root (level 0)
  ot_rom_is_root: THEOREM
    FORALL (s: BootStage):
      ot_level(s) = 0 IMPLIES s = ROM

  % T4: Every non-ROM stage has exactly one verifier
  ot_single_verifier: THEOREM
    FORALL (y: BootStage):
      y /= ROM IMPLIES
        EXISTS (x: BootStage):
          ot_edges(x, y) AND ot_level(x) + 1 = ot_level(y)

  % T5: Refinement matches edge structure
  ot_edges_refine: THEOREM
    FORALL (x, y: BootStage):
      ot_edges(x, y) IMPLIES ot_refines(x, y)

  % T6: No backward edges (DAG)
  ot_no_backward: THEOREM
    FORALL (x, y: BootStage):
      ot_edges(x, y) IMPLIES NOT ot_edges(y, x)

  % T7: If ROM_EXT signature is invalid, BL0 and KERNEL are unreachable
  %     (concrete instance of boot_failure_blocks)
  ot_signature_failure_blocks: THEOREM
    NOT signature_valid(ROM_EXT) IMPLIES
      NOT ot_invariant(ROM_EXT)

  % T8: If all invariants hold, the full chain is valid
  ot_full_chain_valid: THEOREM
    signature_valid(ROM_EXT) AND hash_valid(BL0) AND policy_valid(KERNEL)
      IMPLIES ot_invariant(ROM) AND ot_invariant(ROM_EXT) AND
              ot_invariant(BL0) AND ot_invariant(KERNEL)

  %% ═══════════════════════════════════════════════════════════════════
  %% Connection to abstract theory
  %% ═══════════════════════════════════════════════════════════════════
  %%
  %% The abstract lowrisc_boot_verification[BootStage] provides:
  %%   - layered_acyclic: no cycles in the boot graph
  %%   - boot_failure_blocks: failure halts boot
  %%   - secure_boot_all_invariants: all reachable stages are valid
  %%   - failed_stage_isolated: invalid stages have no edges
  %%
  %% These are INHERITED by this instance. The concrete theorems above
  %% verify that our specific OpenTitan configuration satisfies the
  %% preconditions needed to invoke the abstract guarantees.
  %%
  %% To complete the instantiation:
  %%   1. Show ot_invariant = invariant_holds (interpretation)
  %%   2. Show ot_refines implies rr_rel (interpretation)
  %%   3. Show ot_edges defines a valid graph (TCC)
  %%   4. Apply layered_acyclic, boot_failure_blocks, etc.
  %%
  %% ═══════════════════════════════════════════════════════════════════

END opentitan_boot_instance
