    (/= CONST-DECL "boolean" |notequal| NIL)
    (NOT CONST-DECL "[bool -> bool]" |booleans| NIL)
    (V FORMAL-TYPE-DECL NIL |ppg_hls_root_union_measure| NIL)
    (|Value| FORMAL-TYPE-DECL NIL |ppg_hls_root_union_measure| NIL)
    (|set| TYPE-EQ-DECL NIL |sets| NIL)
    (|domain| FORMAL-CONST-DECL "[V -> set[Value]]"
     |ppg_hls_root_union_measure| NIL)
    (|Event| TYPE-EQ-DECL NIL |ppg_measurable_space| NIL)
    (|sigma?| CONST-DECL "bool" |ppg_measurable_space| NIL)
    (|MeasurableSpace| NONEMPTY-TYPE-EQ-DECL NIL |ppg_measurable_space| NIL)
    (|VariableSpaces| TYPE-EQ-DECL NIL |ppg_mt_coordinate_laws| NIL)
    (|spaces| FORMAL-CONST-DECL "VariableSpaces" |ppg_hls_root_union_measure|
     NIL)
    (|number| NONEMPTY-TYPE-DECL NIL |numbers| NIL)
    (|number_field_pred| CONST-DECL "[number -> boolean]" |number_fields| NIL)
    (|number_field| NONEMPTY-TYPE-FROM-DECL NIL |number_fields| NIL)
    (|real_pred| CONST-DECL "[number_field -> boolean]" |reals| NIL)
    (|real| NONEMPTY-TYPE-FROM-DECL NIL |reals| NIL)
    (>= CONST-DECL "bool" |reals| NIL)
    (|nnreal| TYPE-EQ-DECL NIL |real_types| NIL)
    (|Mass| TYPE-EQ-DECL NIL |ppg_probability_measure| NIL)
    (|probability?| CONST-DECL "bool" |ppg_probability_measure| NIL)
    (|Probability| TYPE-EQ-DECL NIL |ppg_probability_measure| NIL)
    (|VariableLaws| TYPE-EQ-DECL NIL |ppg_mt_coordinate_laws| NIL)
    (|laws| FORMAL-CONST-DECL "VariableLaws(spaces)"
     |ppg_hls_root_union_measure| NIL)
    (|State| TYPE-EQ-DECL NIL |ppg_mt_native_process| NIL)
    (|finite_set| TYPE-EQ-DECL NIL |finite_sets| NIL)
    (|ProcessData| TYPE-EQ-DECL NIL |ppg_mt_native_process| NIL)
    (|ProcessLocal| CONST-DECL "bool" |ppg_mt_native_process| NIL)
    (|MTProcess| TYPE-EQ-DECL NIL |ppg_mt_native_process| NIL)
    (|MTState| TYPE-EQ-DECL NIL |ppg_mt_semantics| NIL)
    (|NativeStateSigma| CONST-DECL
     "ppg_measurable_space[MTState[C, V, Value, domain]].MeasurableSpace"
     |ppg_mt_native_spaces| NIL)
    (|process| FORMAL-CONST-DECL
     "{p: MTProcess | FORALL (i: C): NativeStateSigma(spaces)(p`bad(i))}"
     |ppg_hls_root_union_measure| NIL)
    (|SimpleDependencyGraph| TYPE-EQ-DECL NIL |ppg_shearer_bdd| NIL)
    (|dependencyGraph| CONST-DECL "SimpleDependencyGraph" |ppg_shearer_bdd|
     NIL)
    (|DependencyMatching| TYPE-EQ-DECL NIL |ppg_hls_pair_keys| NIL))
   NIL)))

