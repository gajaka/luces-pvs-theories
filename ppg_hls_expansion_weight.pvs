% The canonical name is injective on the actual expanded nodes.
% Reindexing their product transports both labels and down colors.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Appendix C. https://arxiv.org/abs/2111.06527
% Lean counterpart: coloredExpansion_weight in PPGraphHLSExpansionWeight.lean.
ppg_hls_expansion_weight[C:TYPE,G:{A:[C,C->bool]|(FORALL(i:C):NOT A(i,i)) AND
  (FORALL(i,j:C):A(i,j)=A(j,i))},
  universe:{S:finite_set[C]|FORALL(i:C):S(i)}]: THEORY
BEGIN
  IMPORTING ppg_hls_choice_weights[C,G],ppg_hls_expansion_down_subset[C,G,universe],
    ppg_monoid_image[ExpandedVertex,WNode,ENN,ennFinite(1),emul] AS nameReindex

  M: VAR DependencyMatching
  Q: VAR (Valid)
  choice: VAR [WNode->ppg_hls_expansion_vertices[C,G].ExpansionChoice]
  up,down: VAR [C->ENN]
  x: VAR ExpandedVertex

  colored_nodes_image: LEMMA coloredExpansion(M,Q,choice)`1`nodes=
    image(expansionName(M,Q,choice),expandedNodes(Q,choice))

  nameFactor_at: LEMMA expandedNodes(Q,choice)(x) IMPLIES
    (IF coloredExpansion(M,Q,choice)`2(expansionName(M,Q,choice)(x))
      THEN down(expansionName(M,Q,choice)(x)`1)
      ELSE up(expansionName(M,Q,choice)(x)`1) ENDIF)=nodeFactor(M,choice,up,down)(x)

  colored_node_product: LEMMA wnProducts.eprod(coloredExpansion(M,Q,choice)`1`nodes,
    LAMBDA(w:WNode):IF coloredExpansion(M,Q,choice)`2(w) THEN down(w`1) ELSE up(w`1) ENDIF)=
      evProducts.eprod(expandedNodes(Q,choice),nodeFactor(M,choice,up,down))

  coloredExpansion_weight: THEOREM
    decorationWeight(up,down)(coloredExpansion(M,Q,choice)`1)(coloredExpansion(M,Q,choice)`2)=
      wnProducts.eprod(Q`nodes,LAMBDA(u:WNode):choiceWeight(M,up,down,u`1,choice(u)))

END ppg_hls_expansion_weight
