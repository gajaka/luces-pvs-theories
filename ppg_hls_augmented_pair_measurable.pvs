% The pair read is the product of its relative-coin coordinate and four
% data-block coordinates. Both maps are measurable for every witness DAG.
% Measurability of the check uses exactly measurability of the bad events.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995:
% composition and product maps. Kun He, Qian Li and Xiaoming Sun,
% "Moser-Tardos Algorithm: Beyond Shearer's Bound", proof of Lemma 3.4.
% Lean counterpart: PPGraphHLSAugmentedPair.lean.
ppg_hls_augmented_pair_measurable[C,V,Value:TYPE,domain:[V->set[Value]],
  default:C,universe:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:ppg_mt_coordinate_laws[C,V,Value,domain].VariableSpaces,
  laws:ppg_mt_coordinate_laws[C,V,Value,domain].VariableLaws(spaces),
  (IMPORTING ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:ppg_mt_native_process[C,V,Value,domain,spaces,laws].MTProcess,
  (IMPORTING ppg_hls_table_coordinates[C,V,process`footprint])
  u,v:ppg_hls_witness_dag[C,
    ppg_shearer_bdd[C,V,process`footprint].dependencyGraph].WNode]: THEORY
BEGIN
  IMPORTING ppg_hls_augmented_dependence[C,V,Value,domain,default,universe,
      spaces,laws,process,u,v] AS reads,
    ppg_hls_pair_probability[C,V,Value,domain,spaces,laws,process,u,v] AS blocks,
    ppg_hls_pair_block_queries[C,V,Value,domain,spaces,laws,process,u,v] AS queries,
    ppg_hls_augmented_pair_events[C,V,Value,domain,default,universe,
      spaces,laws,process] AS pairs,
    ppg_hls_unit_event_measurable[C,V,Value,domain,default,universe,
      spaces,laws,process] AS unitMeas,
    ppg_hls_augmented_space[C,V,Value,domain,spaces,laws] AS aug,
    ppg_hls_table_events[C,V,Value,domain,spaces,laws,process] AS tables,
    ppg_shearer_bdd[C,V,process`footprint] AS graph,
    ppg_hls_pair_keys[C,graph.dependencyGraph] AS keys,
    ppg_hls_fair_orientation AS fair

  F: MACRO finite_set[V] = blocks.F

  H: MACRO finite_set[V] = blocks.H

  Z: MACRO finite_set[V] = blocks.Z

  IMPORTING ppg_probability_four_product[(F),(H),(Z),Value,
      LAMBDA(a:(F)):domain(a),LAMBDA(a:(H)):domain(a),LAMBDA(a:(Z)):domain(a),
      blocks.universeF,blocks.universeH,blocks.universeZ,
      LAMBDA(a:(F)):spaces(a),LAMBDA(a:(H)):spaces(a),LAMBDA(a:(Z)):spaces(a),
      LAMBDA(a:(F)):laws(a),LAMBDA(a:(H)):laws(a),LAMBDA(a:(Z)):laws(a)] AS four,
    ppg_measurable_pair[aug.AugTable,fair.OrientationCoin,blocks.FourValue] AS pairing,
    ppg_measurable_compose[aug.AugTable,aug.OriginalTable,blocks.FourValue] AS compose,
    ppg_measurable_map[aug.AugTable,blocks.FourValue] AS dataMaps,
    ppg_measurable_map[aug.AugTable,fair.OrientationCoin] AS coinMaps,
    ppg_measurable_map[aug.AugTable,reads.CoinFourValue] AS readMaps

  CoinFourSigma: MACRO ppg_measurable_space[reads.CoinFourValue].MeasurableSpace =
    pairing.pairSigma(fair.OrientationSigma,four.ResultSigma)

  M: VAR keys.DependencyMatching

  D: VAR WitnessDAG

  eta: VAR aug.AugTable

  coinRead(M,D)(eta):fair.OrientationCoin = pairs.pairCoin(M,D,(u,v),eta)

  dataRead(D)(eta):blocks.FourValue = blocks.pairBlockRead(D)(aug.originalTable(eta))

  source_private_identical: LEMMA queries.F=blocks.F

  shared_identical: LEMMA queries.H=blocks.H

  target_private_identical: LEMMA queries.Z=blocks.Z

  pair_block_read_eq: LEMMA blocks.pairBlockRead(D)=queries.pairBlockRead(D)

  coin_component_measurable: LEMMA coinMaps.measurable(
    aug.AugSigma,fair.OrientationSigma,coinRead(M,D))

  data_component_measurable: LEMMA dataMaps.measurable(
    aug.AugSigma,four.ResultSigma,dataRead(D))

  pair_read_function: LEMMA reads.augmentedPairRead(M,D)=
    (LAMBDA(eta:aug.AugTable):(coinRead(M,D)(eta),dataRead(D)(eta)))

  measurable_augmentedPairRead: THEOREM readMaps.measurable(
    aug.AugSigma,CoinFourSigma,reads.augmentedPairRead(M,D))

  measurableSet_augmentedPairCheck: THEOREM tables.badMeasurable IMPLIES
    aug.AugSigma(reads.augmentedPairCheck(M,D))

END ppg_hls_augmented_pair_measurable
