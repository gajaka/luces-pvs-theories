% Mapping child trees preserves the pointwise sum of their depth multisets.
ppg_depth_children_map[A, C, V: TYPE]: THEORY
BEGIN
  IMPORTING ppg_rose_depth_labels[C, V]
  xs: VAR list[A]
  f: VAR [A -> WTree]
  d: VAR nat
  labelsAtDepthChildren_map_eq_sum: THEOREM labelsAtDepthChildren(map(f)(xs), d) =
    LAMBDA (b: C): ppg_tree_lists[WTree].natSum(map(LAMBDA (x: A): labelsAtDepth(f(x), d)(b))(xs))
END ppg_depth_children_map
