% A complete dependency graph has only empty and singleton independent
% sets, so its signed polynomial is one minus the weight sum. The HLS
% overlap constraints leave each reduced weight above p-p^2/17. When
% these floors sum to at least one, every admitted matching fails the
% strict polynomial test.
%
% Nicholas J. A. Harvey and Jan Vondrak, "Short proofs for generalizations
% of the Lovasz Local Lemma: Shearer's condition and cluster expansion",
% arXiv:1711.06797, Section 2, Claim 2.
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", arXiv:2111.06527, Section 2.3.
% Ronald L. Graham, Donald E. Knuth and Oren Patashnik, Concrete
% Mathematics, second edition, Addison-Wesley, 1994, Chapter 2.
ppg_complete_graph_region[C:TYPE,
  G:{A:[C,C->bool]|(FORALL(i:C):NOT A(i,i)) AND (FORALL(i,j:C):A(i,j)=A(j,i))},
  universe:{U:finite_set[C]|FORALL(i:C):U(i)},p:[C->real]]: THEORY
BEGIN
  IMPORTING ppg_shearer_sets[C,G] AS graphSets,
    ppg_shearer_polynomial[C,G] AS polynomial,
    ppg_finite_sum[C] AS sums,
    ppg_real_sum[C] AS sumRules,
    ppg_hls_matching[C,G,p] AS hls,
    ppg_hls_parameters AS weights,
    reals@sq AS squares

  q: VAR [C->real]
  T: VAR finite_set[C]
  a,i: VAR C
  D: VAR hls.OverlapBounds

  Complete: bool = FORALL(a,b:C):a/=b IMPLIES G(a,b)

  floorWeight(i): real = p(i)-p(i)*p(i)/17

  remote_eq_empty_of_complete: THEOREM Complete IMPLIES graphSets.remote(T,a)=emptyset[C]

  polynomial_eq_one_sub_sum_of_complete: THEOREM Complete IMPLIES polynomial.polynomial(q,T)=1-sums.fsum(T,q)

  not_strictCriterion_of_complete_sum: THEOREM Complete AND 1<=sums.fsum(universe,q) IMPLIES
    NOT polynomial.StrictCriterion(q,universe)

  hls_reduced_ge_floor: THEOREM floorWeight(i)<=hls.reduced(D)(i)

  floor_le_weight: LEMMA floorWeight(i)<=p(i)

  floor_sum_le_weight_sum: LEMMA sums.fsum(universe,floorWeight)<=sums.fsum(universe,p)

  floor_sum_le_reduced_sum: LEMMA sums.fsum(universe,floorWeight)<=sums.fsum(universe,hls.reduced(D))

  not_hlsCriterion_of_complete_floor_sum: THEOREM Complete AND 1<=sums.fsum(universe,floorWeight) IMPLIES
    NOT polynomial.StrictCriterion(hls.reduced(D),universe)

END ppg_complete_graph_region
