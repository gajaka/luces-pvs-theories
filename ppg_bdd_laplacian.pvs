% The graph Laplacian acts on vectors supported in the finite blocking
% set B. Its kernel consists exactly of vectors constant on each connected
% component. Component values and component indicator vectors give inverse
% coordinate maps, proving that the kernel dimension is the component count.
%
% Lean counterpart: PPGraphBDDLaplacian.lean. The Lean proof transfers
% Mathlib's graph Laplacian theorem; the PVS proof uses propagation of a
% component maximum and an explicit finite coordinate isomorphism.

ppg_bdd_laplacian[C, V: TYPE, vars: [C -> finite_set[V]], B: finite_set[C]]: THEORY
BEGIN
  IMPORTING ppg_bdd_count[C, V], ppg_sum_order[C], ppg_real_minimum[C],
    ppg_finite_dimension[C, finite_set[C]]
  x, y: VAR Vector
  c, d, m, u: VAR C
  K: VAR finite_set[C]
  a, b: VAR Coefficients
  r: VAR real
  lapTerm(x, c, d): real = IF bddAdj(vars, B)(c, d) THEN x(c) - x(d) ELSE 0 ENDIF
  lapMatrixAction(x, c): real = fsum(B, LAMBDA (d: C): lapTerm(x, c, d))
  LaplacianKernel: set[Vector] = {x: Vector |
    (FORALL c: NOT B(c) IMPLIES x(c) = 0) AND (FORALL c: B(c) IMPLIES lapMatrixAction(x, c) = 0)}
  ComponentConstant(x): bool =
    FORALL c, d: B(c) AND SameComponent(vars, B)(c, d) IMPLIES x(c) = x(d)
  component_edge_closed: LEMMA compOf(vars, B, c)(m) AND bddAdj(vars, B)(m, d) IMPLIES compOf(vars, B, c)(d)
  component_maximum_exists: LEMMA B(c) IMPLIES
    EXISTS m: compOf(vars, B, c)(m) AND FORALL d: compOf(vars, B, c)(d) IMPLIES x(d) <= x(m)
  maximal_row_nonnegative: LEMMA compOf(vars, B, c)(m) AND
    (FORALL (z: C): compOf(vars, B, c)(z) IMPLIES x(z) <= x(m)) AND
    compOf(vars, B, c)(u) AND x(u) = x(m) AND B(d) IMPLIES lapTerm(x, u, d) >= 0
  kernel_zero_row: LEMMA LaplacianKernel(x) AND B(c) AND
    (FORALL (z: C): B(z) IMPLIES lapTerm(x, c, z) >= 0) AND B(d) IMPLIES lapTerm(x, c, d) = 0
  maximum_propagates: LEMMA LaplacianKernel(x) AND compOf(vars, B, c)(m) AND
    (FORALL d: compOf(vars, B, c)(d) IMPLIES x(d) <= x(m)) IMPLIES
      InductiveSet(bddAdj(vars, B), {d: C | compOf(vars, B, c)(d) AND x(d) = x(m)})
  component_connected: LEMMA compOf(vars, B, c)(m) AND compOf(vars, B, c)(d) IMPLIES
    Reach(bddAdj(vars, B))(m, d)
  kernel_component_constant: THEOREM LaplacianKernel(x) IMPLIES ComponentConstant(x)
  constant_in_kernel: THEOREM ComponentConstant(x) AND (FORALL c: NOT B(c) IMPLIES x(c) = 0) IMPLIES LaplacianKernel(x)
  componentEncode(x)(K): real = IF nonempty?(K) THEN x(choose(K)) ELSE 0 ENDIF
  componentDecode(a)(c): real = IF B(c) THEN a(compOf(vars, B, c)) ELSE 0 ENDIF
  decode_in_kernel: LEMMA LaplacianKernel(componentDecode(a))
  decode_encode: LEMMA LaplacianKernel(x) IMPLIES componentDecode(componentEncode(x)) = x
  encode_decode: LEMMA connectedComponents(vars, B)(K) IMPLIES componentEncode(componentDecode(a))(K) = a(K)
  decode_congr: LEMMA
    (FORALL K: connectedComponents(vars, B)(K) IMPLIES a(K) = b(K)) IMPLIES componentDecode(a) = componentDecode(b)
  encode_linear: LEMMA componentEncode(LAMBDA (c: C): x(c) + r * y(c)) =
    (LAMBDA (K: finite_set[C]): componentEncode(x)(K) + r * componentEncode(y)(K))
  decode_linear: LEMMA componentDecode(LAMBDA (K: finite_set[C]): a(K) + r * b(K)) =
    (LAMBDA (c: C): componentDecode(a)(c) + r * componentDecode(b)(c))
  component_coordinate_isomorphism: THEOREM CoordinateIsomorphism(LaplacianKernel, connectedComponents(vars, B), componentEncode, componentDecode)
  card_bddComponents_eq_finrank_ker_lapMatrix: THEOREM
    HasFiniteDimension(LaplacianKernel, card(connectedComponents(vars, B)))
END ppg_bdd_laplacian
