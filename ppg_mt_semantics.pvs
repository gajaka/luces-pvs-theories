% Coordinate domains encode the variable-dependent spaces of the Lean process.
ppg_mt_semantics[C, V, Value: TYPE, domain: [V -> set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_bdd[C, V]
  MTState: TYPE = [v: V -> (domain(v))]
  MTLog: TYPE = [nat -> [C, MTState]]
  vars: VAR CertVars
  bad: VAR [C, MTState -> bool]
  log: VAR MTLog
  om, fresh, initial: VAR MTState
  F, G: VAR finite_set[V]
  c, j: VAR C
  t: VAR nat
  mt_wf(vars, bad): bool = FORALL c, om, fresh:
    (FORALL (v: V): vars(c)(v) IMPLIES om(v) = fresh(v)) IMPLIES
      (bad(c, om) IFF bad(c, fresh))
  resample(F, om, fresh): MTState = LAMBDA (v: V): IF F(v) THEN fresh(v) ELSE om(v) ENDIF
  trajectory(vars, log, initial, t): RECURSIVE MTState =
    IF t = 0 THEN initial ELSE
      resample(vars(log(t - 1)`1), trajectory(vars, log, initial, t - 1), log(t - 1)`2)
    ENDIF MEASURE t
  trajectory_zero: LEMMA trajectory(vars, log, initial, 0) = initial
  trajectory_step: LEMMA trajectory(vars, log, initial, t + 1) =
    resample(vars(log(t)`1), trajectory(vars, log, initial, t), log(t)`2)
  mt_step_preserves_unrelated: THEOREM
    mt_wf(vars, bad) AND disjoint?(vars(log(t)`1), vars(j)) IMPLIES
      (bad(j, trajectory(vars, log, initial, t)) IFF
        bad(j, trajectory(vars, log, initial, t + 1)))
  mt_new_violation_overlaps: THEOREM
    mt_wf(vars, bad) AND NOT bad(j, trajectory(vars, log, initial, t)) AND
      bad(j, trajectory(vars, log, initial, t + 1)) IMPLIES
        NOT disjoint?(vars(log(t)`1), vars(j))
END ppg_mt_semantics
