% A finite fiber partition gives the dependent sum formula for ENN.
% Exactness of the supplied fibers is an explicit premise of this
% generic lemma and is proved for the expansion-family instance.
% Neither carrier nor the union of all fibers need be finite.
ppg_enn_finite_partition[I,R:TYPE,first:[R->I],fullFiber:[I->finite_set[R]]]: THEORY
BEGIN
  IMPORTING ppg_enn_finite_order[I] AS outerOrder,
    ppg_enn_finite_order[R] AS flatOrder,
    ppg_nonneg_tsum[I] AS outerFinite,
    ppg_nonneg_tsum[R] AS flatFinite,
    ppg_enn_finite[I] AS outerFolds,
    ppg_enn_finite[R] AS flatFolds,
    ppg_enn_unrestricted_sum[I] AS outerSums,
    ppg_enn_unrestricted_sum[R] AS flatSums,
    ppg_finite_fiber_fold[R,I,ENN,ennFinite(0),eadd] AS partition,
    ppg_finite_bind[I,R] AS familySets,
    ppg_bind_sum[I,R,ENN,ennFinite(0),eadd] AS fiberBind

  H: VAR finite_set[R]
  K: VAR finite_set[I]
  f: VAR [R->ENN]
  i: VAR I

  exactFibers: bool = FORALL(i:I,r:R):fullFiber(i)(r) IFF first(r)=i

  fiberWeight(f)(i): ENN = flatFinite.esum(fullFiber(i),f)

  partialFiber_subset: LEMMA exactFibers IMPLIES
    subset?(partition.fiber(H,first,i),fullFiber(i))

  partialFiber_bound: LEMMA exactFibers IMPLIES
    ele(flatFinite.esum(partition.fiber(H,first,i),f),fiberWeight(f)(i))

  partial_sum_partition: LEMMA flatFinite.esum(H,f)=
    outerFinite.esum(image(first,H),LAMBDA(i:I):flatFinite.esum(partition.fiber(H,first,i),f))

  partial_sum_bound: LEMMA exactFibers IMPLIES
    ele(flatFinite.esum(H,f),outerSums.eTsum(fiberWeight(f)))

  fullFiber_disjoint: LEMMA exactFibers IMPLIES familySets.disjointFamily(K,fullFiber)

  finite_family_sum: LEMMA exactFibers IMPLIES
    flatFinite.esum(familySets.biUnion(K,fullFiber),f)=outerFinite.esum(K,fiberWeight(f))

  finite_family_bound: LEMMA exactFibers IMPLIES
    ele(outerFinite.esum(K,fiberWeight(f)),flatSums.eTsum(f))

  flat_sum_upper: LEMMA exactFibers IMPLIES
    ele(flatSums.eTsum(f),outerSums.eTsum(fiberWeight(f)))

  outer_sum_upper: LEMMA exactFibers IMPLIES
    ele(outerSums.eTsum(fiberWeight(f)),flatSums.eTsum(f))

  tsum_finite_partition: THEOREM exactFibers IMPLIES
    flatSums.eTsum(f)=outerSums.eTsum(fiberWeight(f))

END ppg_enn_finite_partition
