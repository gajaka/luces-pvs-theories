% Distinct labels with disjoint footprints at every depth give
% same-depth independence of the corresponding address tree. The proof
% uses depth-label multiplicities, not just membership in a label set.
%
% Lean counterpart: PPGraphMoserTardosWTreeToGrowingTree.lean.

ppg_rose_depth_independence[C, V: TYPE]: THEORY
BEGIN
  IMPORTING ppg_rose_depth_labels[C, V], ppg_mt_check_order[C, V]
  t: VAR WTree
  vars: VAR CertVars
  u, v: VAR Addr
  d: VAR nat
  depthNodup(t): bool = FORALL (d: nat): Nodup(labelsAtDepth(t, d))
  depthSeparated(vars, t): bool = FORALL (d: nat, a, b: C):
    labelsAtDepth(t, d)(a) > 0 AND labelsAtDepth(t, d)(b) > 0 AND a /= b
      IMPLIES NOT dependent?(vars)(a, b)
  depth_label_member: LEMMA toGT_dom(t)(u) IMPLIES
    labelsAtDepth(t, length(u))(toGT_lab(t, u)) > 0
  depth_label_injective: LEMMA Nodup(labelsAtDepth(t, d)) AND
    toGT_dom(t)(u) AND toGT_dom(t)(v) AND length(u) = d AND length(v) = d AND u /= v
      IMPLIES toGT_lab(t, u) /= toGT_lab(t, v)
  toGrowingTree_sameDepthIndependent_of_labelsAtDepth: THEOREM
    depthNodup(t) AND depthSeparated(vars, t) IMPLIES SameDepthIndependent(vars, toGrowingTree(t))
END ppg_rose_depth_independence
