% Exact finite checking and enumeration of minimal conflicting obligation sets.
ppg_finite_core[State: TYPE, C: TYPE,
  universe: {s: finite_set[State] | FORALL (z: State): s(z)}]: THEORY
BEGIN
  IMPORTING ppg_finite_count[State, C, universe], ppg_unsatisfiable_core[State, C]
  allowed: VAR set[State]
  sat: VAR [C, State -> bool]
  B, K: VAR finite_set[C]
  coreCheck(allowed, sat, K): bool =
    goodCount(allowed, sat, K) = 0 AND
      FORALL (c: C): K(c) IMPLIES goodCount(allowed, sat, remove(c, K)) > 0
  minimalCores(allowed, sat, B): finite_set[finite_set[C]] =
    intersection(powerset(B), {K: finite_set[C] | coreCheck(allowed, sat, K)})
  coreCheck_eq_true_iff: THEOREM coreCheck(allowed, sat, K) IFF MinimalCore(allowed, sat, K)
  mem_minimalCores_iff: THEOREM
    minimalCores(allowed, sat, B)(K) IFF subset?(K, B) AND MinimalCore(allowed, sat, K)
  minimalCores_nonempty_iff: THEOREM nonempty?(minimalCores(allowed, sat, B)) IFF Infeasible(allowed, sat, B)
END ppg_finite_core
