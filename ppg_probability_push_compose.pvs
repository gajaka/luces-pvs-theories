% Successive measurable pushforwards agree with the pushforward of the composition.
ppg_probability_push_compose[X, Y, Z: TYPE,
  (IMPORTING ppg_measurable_space)
  SX: ppg_measurable_space[X].MeasurableSpace,
  SY: ppg_measurable_space[Y].MeasurableSpace,
  SZ: ppg_measurable_space[Z].MeasurableSpace]: THEORY
BEGIN
  IMPORTING ppg_probability_map[X, Y, SX, SY], ppg_probability_map[Y, Z, SY, SZ],
            ppg_probability_map[X, Z, SX, SZ], ppg_measurable_compose[X, Y, Z]
  mu: VAR ppg_probability_measure[X, SX].Probability
  f: VAR {f: [X -> Y] | ppg_measurable_map[X, Y].measurable(SX, SY, f)}
  g: VAR {g: [Y -> Z] | ppg_measurable_map[Y, Z].measurable(SY, SZ, g)}
  pushforward_compose: THEOREM
    ppg_probability_map[Y, Z, SY, SZ].pushforward(
      ppg_probability_map[X, Y, SX, SY].pushforward(mu, f), g) =
    ppg_probability_map[X, Z, SX, SZ].pushforward(mu, LAMBDA (x: X): g(f(x)))
END ppg_probability_push_compose
