% Empty coordinate and value types still give a normalized cylinder content.
ppg_probability_cylinder_empty: THEORY
BEGIN
  IMPORTING ppg_probability_finite_empty,
            ppg_probability_cylinder_content[Empty, Empty, domain, spaces, coins]
  empty_table_exists: LEMMA EXISTS (x: FullBlock): x = anchor
  empty_table_unique: LEMMA FORALL (x, y: FullBlock): x = y
  empty_content_normalized: LEMMA content(fullset[FullBlock]) = 1
  empty_content_zero: LEMMA content(emptyset[FullBlock]) = 0
END ppg_probability_cylinder_empty
