% The MT budget gives finite expectation for slot-zero initialization,
% hence a good target. A separate constant-table descent proves an
% existential path from every initial state to a good state.
%
% Finite variables are needed for that descent. No almost-sure claim
% about arbitrary fixed starts follows from this repair theorem.
% fallback supplies the source's nonempty event-label assumption.
% Lean counterparts: PPGraphMoserTardosTermination.lean and
% PPGraphMoserTardosRepairBridge.lean.

ppg_mt_budget_repair[C,V,Value:TYPE,domain:[V->set[Value]],
  universe:{F:finite_set[V]|F=fullset[V]},
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),fallback:C]: THEORY
BEGIN
  IMPORTING ppg_mt_total_budget[C,V,Value,domain,universe,spaces,laws],
    ppg_mt_termination[C,V,Value,domain,spaces,laws],
    ppg_mt_repair_target[C,V,Value,domain,universe]
  vars: VAR CertVars
  bad: VAR NativeBad
  enumeration: VAR {xs:list[C]|completeEnumeration(xs)}
  p,x: VAR [C->nonneg_real]
  edges: VAR [MTState,MTState->bool]
  s: VAR MTState
  exists_MTGood_of_mt_budget: THEOREM mt_wf(vars,bad) AND
    (FORALL(c:C):baseProbability(bad)(c)<=p(c)) AND
    budget(vars,labelUniverse(enumeration),p,x) IMPLIES
    EXISTS(z:MTState):MTGood(bad,z)
  mtRepairGraph_globally_repairable_of_randomInitETLog_lt_top: THEOREM
    mt_wf(vars,bad) AND ennFinite?(randomInitETLog(vars,bad,fallback,enumeration)) IMPLIES
    globally_repairable(mtRepairGraph(vars,bad,fallback,enumeration,edges))
  mtRepairGraph_globally_repairable: THEOREM mt_wf(vars,bad) AND
    (FORALL(c:C):baseProbability(bad)(c)<=p(c)) AND
    budget(vars,labelUniverse(enumeration),p,x) IMPLIES
    globally_repairable(mtRepairGraph(vars,bad,fallback,enumeration,edges))
  mtRepairGraph_repair_possible: THEOREM mt_wf(vars,bad) AND
    (FORALL(c:C):baseProbability(bad)(c)<=p(c)) AND
    budget(vars,labelUniverse(enumeration),p,x) AND
    isolated(mtRepairGraph(vars,bad,fallback,enumeration,edges),s) IMPLIES
    repair_possible(mtRepairGraph(vars,bad,fallback,enumeration,edges),s)
END ppg_mt_budget_repair
