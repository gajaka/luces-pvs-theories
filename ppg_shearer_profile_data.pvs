% A layer profile records its depth through its length. Reading beyond
% the final layer returns the empty set, as does the address-depth slice.
% Equal profiles therefore determine every layer and the greatest depth.
% Same-depth independence makes the label map injective on each slice.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", Section 2. https://arxiv.org/abs/0903.0544v3
% Lean counterpart: PPGraphShearerLayerProfile.lean.
ppg_shearer_profile_data[C,V:TYPE,(IMPORTING ppg_bdd[C,V]) vars:CertVars]: THEORY
BEGIN
  IMPORTING ppg_shearer_tree_layers[C,V,vars]
  T,U: VAR GTree
  L: VAR LayerSeq
  d,n,k: VAR nat
  f: VAR [nat->Layer]
  a,b: VAR Addr

  layerGetD(L,d): RECURSIVE Layer = CASES L OF null:emptyset[C],
    cons(J,M):IF d=0 THEN J ELSE layerGetD(M,d-1) ENDIF ENDCASES
    MEASURE d

  window_getD_offset: LEMMA layerGetD(layerWindow(f,n,k),d)=IF d<=n THEN f(k+d) ELSE emptyset[C] ENDIF

  window_getD: LEMMA layerGetD(layerWindow(f,n,0),d)=IF d<=n THEN f(d) ELSE emptyset[C] ENDIF

  treeLayers_length: LEMMA length[Layer](treeLayers(T))=treeDepth(T)+1

  treeLayers_getD: THEOREM layerGetD(treeLayers(T),d)=treeLayer(T,d)

  treeLayers_eq_imp_layer_eq: THEOREM treeLayers(T)=treeLayers(U) IMPLIES treeLayer(T,d)=treeLayer(U,d)

  treeLayers_eq_imp_depth_eq: THEOREM treeLayers(T)=treeLayers(U) IMPLIES treeDepth(T)=treeDepth(U)

  lab_injOn_depth: THEOREM SameDepthIndependent(vars,T) AND treeSlice(T,d)(a) AND treeSlice(T,d)(b) AND
    T`lab(a)=T`lab(b) IMPLIES a=b

END ppg_shearer_profile_data
