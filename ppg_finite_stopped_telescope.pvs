% Integrating the exact conditional decrease charges one running-event
% mass per step. Summing over a finite horizon retains the terminal
% stopped potential. The measure is finite, without normalization.
%
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, Exercise 10.22(a), American Mathematical Society, 2017.
% Michael Mitzenmacher and Eli Upfal, Probability and Computing,
% second edition, Section 7.1.1, Cambridge University Press, 2017.
ppg_finite_stopped_telescope[State,Omega: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  (IMPORTING ppg_nasa_sigma[Omega]) S:MeasurableSpace,
  (IMPORTING ppg_finite_law_view[Omega,S]) measureLaw:FiniteLaw,
  (IMPORTING ppg_filtration[Omega,State,S]) history:Filtration]: THEORY
BEGIN
  IMPORTING ppg_finite_stopped_conditional[State,Omega,universe,S,measureLaw,history],
    ppg_finite_count_budget[Omega,S,measureLaw],ppg_enn_ofreal
  M: VAR Model
  f: VAR Vector
  X: VAR AdaptedProcess
  n,N: VAR nat

  stoppedMean(M,f,X,n): real = integral(stoppedNativeValue(M,f,X,n))

  runningSchedule(M,X): [nat->(S)] = LAMBDA(n:nat):runningAmbient(M,X,n)

  stopped_mean_nonnegative: LEMMA Stochastic(M) AND Equations(M,f) IMPLIES
    0<=stoppedMean(M,f,X,n)

  integrated_real_exact: LEMMA FORALL(M:Model,f:SolvingVector(M),X:Realization(M),n:nat):
    mass(runningAmbient(M,X,n))+stoppedMean(M,f,X,n+1)=stoppedMean(M,f,X,n)

  horizon_real_exact: LEMMA FORALL(M:Model,f:SolvingVector(M),X:Realization(M),N:nat):
    massPrefix(runningSchedule(M,X),N)+stoppedMean(M,f,X,N)=stoppedMean(M,f,X,0)

  stoppedValue_integrated_exact: THEOREM FORALL(M:Model,f:SolvingVector(M),X:Realization(M),n:nat):
    Stochastic(M) IMPLIES
      eadd(ennFinite(mass(runningAmbient(M,X,n))),ofReal(stoppedMean(M,f,X,n+1)))=
        ofReal(stoppedMean(M,f,X,n))

  finite_horizon_exact: THEOREM FORALL(M:Model,f:SolvingVector(M),X:Realization(M),N:nat):
    Stochastic(M) IMPLIES
      eadd(ennFinite(massPrefix(runningSchedule(M,X),N)),ofReal(stoppedMean(M,f,X,N)))=
        ofReal(integral(integrableValue(f,ambientState(X,0))))

END ppg_finite_stopped_telescope
