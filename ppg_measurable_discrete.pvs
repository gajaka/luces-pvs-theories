% Every inverse image is measurable when the source sigma algebra is full.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_measurable_discrete[X,Y: TYPE]: THEORY
BEGIN
  IMPORTING ppg_measurable_map[X,Y] AS discreteMaps

  SY: VAR ppg_measurable_space[Y].MeasurableSpace
  f: VAR [X->Y]

  full_source_measurable: THEOREM discreteMaps.measurable(fullset[set[X]],SY,f)

END ppg_measurable_discrete
