% A random-initialization witness is the canonical form of its backward
% execution tree. That tree is well formed and separated at every depth,
% so each occurring shape lies in Pegden's smaller finite-depth family.
% This statement uses no probability or termination hypothesis.
%
% Wesley Pegden, "An extension of the Moser-Tardos algorithmic local
% lemma", Theorem 1.4. https://arxiv.org/abs/1102.2853
% Lean counterpart: witnessOccurrence_nonempty_mem_treesUpTo in
% PPGraphMoserTardosPegden.lean.
ppg_pegden_occurrence[C,V,Value:TYPE,domain:[V->set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_pegden_canonical[C,V],ppg_mt_occurrence_bridge[C,V,Value,domain]
  vars: VAR CertVars
  bad: VAR [C,MTState->bool]
  fallback,a: VAR C
  enumeration: VAR list[C]
  omega: VAR LogSpace
  s: VAR nat
  U: VAR finite_set[C]
  W: VAR WTree

  actual_raw_separated: LEMMA depthSeparated(vars,rawShape(vars,bad,fallback,enumeration,omega,s))

  actual_raw_properties: LEMMA
    wellFormed(vars)(rawShape(vars,bad,fallback,enumeration,omega,s)) AND
    roseLabel(rawShape(vars,bad,fallback,enumeration,omega,s))=
      realC(vars,bad,fallback,enumeration,initialStateFromLog(omega),omega,s)

  actual_witness_pegden: LEMMA fullUniverse(U) IMPLIES
    pegdenTreesUpTo(vars,U,depth(rawShape(vars,bad,fallback,enumeration,omega,s)),
      realC(vars,bad,fallback,enumeration,initialStateFromLog(omega),omega,s))
      (randomInitWitness(vars,bad,fallback,enumeration,omega,s))

  witnessOccurrence_nonempty_mem_treesUpTo: THEOREM fullUniverse(U) AND
    nonempty?(witnessOccurrence(vars,bad,fallback,enumeration,a,W)) IMPLIES
      EXISTS(D:nat):pegdenTreesUpTo(vars,U,D,a)(W)

END ppg_pegden_occurrence
