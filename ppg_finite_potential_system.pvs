% First-step equations give value zero at good states and one plus the
% transition-weighted successor values at bad states. The rational system
% matrix expresses these equations as a matrix-vector equality. Its
% homogeneous system expresses the corresponding harmonic equations.
%
% Mitzenmacher and Upfal, Probability and Computing, second edition,
% Section 7.1.1 and Exercise 7.25.
% Levin and Peres, Markov Chains and Mixing Times, second edition,
% Exercise 10.22.
% Lean counterparts: systemMatrix_mulVec, matrix_equations_iff and
% matrix_harmonic_iff in PPGraphFinitePotential.lean.
ppg_finite_potential_system[State: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)}]: THEORY
BEGIN
  IMPORTING ppg_finite_drift[State,universe],ppg_finite_point_sum[State]

  Matrix: TYPE = [State,State->rat]

  Vector: TYPE = [State->rat]

  A: VAR finite_set[State]
  f,g: VAR Vector
  M: VAR Model
  s: VAR State
  matrix: VAR Matrix

  matVec(matrix,f): Vector = LAMBDA(s:State):rational.sum(universe,
    LAMBDA(t:State):matrix(s,t)*f(t))

  successorValue(M,f,s): rat = rational.sum(universe,
    LAMBDA(t:State):M`transition(s,t)*f(t))

  Equations(M,f): bool = (FORALL(s:State):M`good(s) IMPLIES f(s)=0) AND
    (FORALL(s:State):NOT M`good(s) IMPLIES f(s)=1+successorValue(M,f,s))

  Harmonic(M,f): bool = (FORALL(s:State):M`good(s) IMPLIES f(s)=0) AND
    (FORALL(s:State):NOT M`good(s) IMPLIES f(s)=successorValue(M,f,s))

  systemMatrix(M): Matrix = LAMBDA(s,t:State):IF M`good(s) THEN
    (IF s=t THEN 1 ELSE 0 ENDIF) ELSE
    (IF s=t THEN 1 ELSE 0 ENDIF)-M`transition(s,t) ENDIF

  systemRHS(M): Vector = LAMBDA(s:State):IF M`good(s) THEN 0 ELSE 1 ENDIF

  rational_sub_sum: LEMMA rational.sum(A,LAMBDA(t:State):f(t)-g(t))=
    rational.sum(A,f)-rational.sum(A,g)

  rational_point_sum: LEMMA rational.sum(universe,
    LAMBDA(t:State):IF t=s THEN f(t) ELSE 0 ENDIF)=f(s)

  system_row_coefficients: LEMMA (LAMBDA(t:State):systemMatrix(M)(s,t)*f(t))=
    IF M`good(s) THEN (LAMBDA(t:State):IF t=s THEN f(t) ELSE 0 ENDIF)
    ELSE (LAMBDA(t:State):(IF t=s THEN f(t) ELSE 0 ENDIF)-M`transition(s,t)*f(t)) ENDIF

  vector_eq_iff: LEMMA f=g IFF (FORALL(s:State):f(s)=g(s))

  systemMatrix_mulVec: THEOREM matVec(systemMatrix(M),f)(s)=
    IF M`good(s) THEN f(s) ELSE f(s)-successorValue(M,f,s) ENDIF

  matrix_equations_iff: THEOREM matVec(systemMatrix(M),f)=systemRHS(M) IFF Equations(M,f)

  matrix_harmonic_iff: THEOREM matVec(systemMatrix(M),f)=(LAMBDA(s:State):0) IFF Harmonic(M,f)

END ppg_finite_potential_system
