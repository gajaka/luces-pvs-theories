% The expected first-hit count is the extended integral of the actual
% running-event count under the constructed input IID measure. The
% expectation may be infinite.
%
% Johannes Lengler, "Drift Analysis", arXiv:1712.00964.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_update_expected_count[State,Input: TYPE,
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)},
  (IMPORTING ppg_finite_input_update[State,Input,inputs])
  R:{R:Rule|Valid(R)}]: THEORY
BEGIN
  IMPORTING ppg_update_input_law[State,Input,inputs,R] AS updateMeanLaw,
    ppg_input_update_stopping[State,Input,inputs] AS updateMeanStopping,
    ppg_finite_input_history[Input] AS updateMeanHistory,
    ppg_finite_extended_integral[updateMeanHistory.Sample,updateMeanHistory.ambientSigma,
      updateMeanLaw.iidMeasure] AS updateMeanIntegral,
    ppg_enn_sup

  s0: VAR State
  omega: VAR updateMeanHistory.Sample

  hitFunction(s0): [updateMeanHistory.Sample->ENN] =
    LAMBDA(omega:updateMeanHistory.Sample):updateMeanStopping.hitCount(R,s0,omega)

  expectedHitCount(s0): ENN = updateMeanIntegral.lintegral(hitFunction(s0))

  hit_function_at: LEMMA hitFunction(s0)(omega)=updateMeanStopping.hitCount(R,s0,omega)

END ppg_update_expected_count
