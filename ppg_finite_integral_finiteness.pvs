% A finite nonnegative extended integral forces the infinite-value
% event to have mass zero. Scaled indicators would otherwise violate
% its finite bound. All null-set and almost-everywhere predicates are
% those of the original native finite measure.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% Sterling K. Berberian, Fundamentals of Real Analysis, Springer, 1999.
ppg_finite_integral_finiteness[X: TYPE,
  (IMPORTING ppg_nasa_sigma[X]) S:MeasurableSpace,
  (IMPORTING ppg_finite_law_view[X,S]) measureLaw:FiniteLaw]: THEORY
BEGIN
  IMPORTING ppg_finite_extended_integral[X,S,measureLaw], ppg_enn_finiteness[X],
    ppg_positive_integral_mass[X,S,measureLaw]
  f: VAR [X->ENN]
  A: VAR (S)
  c,b,m: VAR nonneg_real
  scaledIndicator(c,A): NonnegativeFunction = c*nnIndicator(A)
  scaled_indicator_value: LEMMA FORALL(x:X):scaledIndicator(c,A)(x)=
    IF A(x) THEN c ELSE 0 ENDIF
  scaled_indicator_mean: LEMMA mean(scaledIndicator(c,A))=c*mass(A)
  scaled_infinite_minorant: LEMMA subset?(A,infiniteEvent(f)) IMPLIES
    minorant(scaledIndicator(c,A),f)
  infinite_mass_bound: LEMMA ele(lintegral(f),ennFinite(b)) AND
    subset?(A,infiniteEvent(f)) IMPLIES c*mass(A)<=b
  bounded_scaled_mass_zero: LEMMA (FORALL(c:nonneg_real):c*m<=b) IMPLIES m=0
  null_measurable_infinite_subset: THEOREM ennFinite?(lintegral(f)) AND
    subset?(A,infiniteEvent(f)) IMPLIES mass(A)=0
  measurable_zero_negligible: LEMMA mass(A)=0 IMPLIES
    negligible_set?[X,asNasa(S),measureLaw](A)
  zero_complement_ae: LEMMA mass(A)=0 IMPLIES
    ae?[X,asNasa(S),measureLaw](complement(A))
  finite_integral_ae: THEOREM measurable(S,ENNSigma,f) AND ennFinite?(lintegral(f)) IMPLIES
    ae?[X,asNasa(S),measureLaw](finiteEvent(f))
END ppg_finite_integral_finiteness
