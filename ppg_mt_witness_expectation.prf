    (|NativeTableSigma| CONST-DECL
     "ppg_measurable_space[LogSpace[C, V, Value, domain]].MeasurableSpace"
     |ppg_mt_native_spaces| NIL)
    (|WTree| TYPE-EQ-DECL NIL |ppg_rose_size| NIL)
    (|ppg_mt_rose| TYPE-DECL NIL |ppg_mt_rose_adt| NIL)
    (|LogSpace| TYPE-EQ-DECL NIL |ppg_mt_random_process| NIL)
    (|TableDomain| CONST-DECL "set[Value]" |ppg_mt_random_process| NIL)
    (|int| NONEMPTY-TYPE-EQ-DECL NIL |integers| NIL)
    (|integer_pred| CONST-DECL "[rational -> boolean]" |integers| NIL)
    (|rational| NONEMPTY-TYPE-FROM-DECL NIL |rationals| NIL)
    (|rational_pred| CONST-DECL "[real -> boolean]" |rationals| NIL)
    (|nat| NONEMPTY-TYPE-EQ-DECL NIL |naturalnumbers| NIL)
    (|witnessCode| CONST-DECL "Code" |ppg_mt_witness_expectation| NIL)
    (|Code| TYPE-EQ-DECL NIL |ppg_coded_event_integral| NIL)
    (|injective?| CONST-DECL "bool" |functions| NIL)
    (|occurrenceEvents| CONST-DECL "[WTree -> (NativeTableSigma(spaces))]"
     |ppg_mt_witness_expectation| NIL)
    (|lintegral_tsum_indicators| FORMULA-DECL NIL |ppg_coded_event_integral|
     NIL)
    (|randomInitExpectedResamplingCount| CONST-DECL "ENN"
     |ppg_mt_time_expectation| NIL))
   SHOSTAK)))

