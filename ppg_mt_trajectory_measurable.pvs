% Induction proves measurability of each state and local counter.
% A measurable counter selects a table entry, then the measurable scan
% chooses the footprint to update. The initializer may itself be a
% measurable function of the table, including its slot-zero state.
%
% Lean counterparts: PPGraphMoserTardosRandomTrajectory.lean and
% PPGraphMoserTardosRandomInitialization.lean.

ppg_mt_trajectory_measurable[C, V, Value: TYPE, domain: [V -> set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_mt_policy_measurable[C, V, Value, domain],
    ppg_mt_measurable_state[LogSpace, C, V, Value, domain],
    ppg_measurable_compose[LogSpace, MTState, C]
  coordinates: VAR [V -> ppg_measurable_space[Value].MeasurableSpace]
  vars: VAR CertVars
  bad: VAR [C, MTState -> bool]
  fallback: VAR C
  enumeration: VAR list[C]
  initial: VAR MTState
  init: VAR [LogSpace -> MTState]
  steps: VAR [LogSpace -> StepState]
  counts: VAR [LogSpace -> Counter]
  idx: VAR [LogSpace -> nat]
  v: VAR V
  t: VAR nat
  measurable_succ_index: LEMMA measurable(TableSigma(coordinates), fullset[set[nat]], idx)
    IMPLIES measurable(TableSigma(coordinates), fullset[set[nat]],
      LAMBDA (omega: LogSpace): idx(omega) + 1)
  measurable_drawFrom_counts: LEMMA
    (FORALL (v: V): measurable(TableSigma(coordinates), fullset[set[nat]],
      LAMBDA (omega: LogSpace): counts(omega)(v))) IMPLIES
    measurable(TableSigma(coordinates), StateSigma(coordinates),
      LAMBDA (omega: LogSpace): drawFrom(omega, counts(omega)))
  stepMeasurable(coordinates, steps): bool =
    measurable(TableSigma(coordinates), StateSigma(coordinates),
      LAMBDA (omega: LogSpace): steps(omega)`1) AND
    (FORALL (v: V): measurable(TableSigma(coordinates), fullset[set[nat]],
      LAMBDA (omega: LogSpace): steps(omega)`2(v)))
  advance(vars, bad, fallback, enumeration, steps)(omega: LogSpace): StepState =
    LET prev = steps(omega), F = vars(pickFirstViolated(bad, fallback, enumeration, prev`1)) IN
    (resample(F, prev`1, drawFrom(omega, LAMBDA (v: V): prev`2(v) + 1)),
      LAMBDA (v: V): IF F(v) THEN prev`2(v) + 1 ELSE prev`2(v) ENDIF)
  measurable_step_choice: LEMMA measurableBad(coordinates, bad) AND stepMeasurable(coordinates, steps)
    IMPLIES measurable(TableSigma(coordinates), fullset[set[C]],
      LAMBDA (omega: LogSpace): pickFirstViolated(bad, fallback, enumeration, steps(omega)`1))
  measurable_next_draw: LEMMA stepMeasurable(coordinates, steps) IMPLIES
    measurable(TableSigma(coordinates), StateSigma(coordinates), LAMBDA (omega: LogSpace):
      drawFrom(omega, LAMBDA (v: V): steps(omega)`2(v) + 1))
  measurable_advanced_counter: LEMMA measurableBad(coordinates, bad) AND stepMeasurable(coordinates, steps)
    IMPLIES measurable(TableSigma(coordinates), fullset[set[nat]],
      LAMBDA (omega: LogSpace): advance(vars, bad, fallback, enumeration, steps)(omega)`2(v))
  advance_measurable: LEMMA measurableBad(coordinates, bad) AND stepMeasurable(coordinates, steps)
    IMPLIES stepMeasurable(coordinates, advance(vars, bad, fallback, enumeration, steps))
  randStep_advance: LEMMA
    (LAMBDA (omega: LogSpace): randStep(vars, bad, fallback, enumeration, init(omega), omega, t + 1)) =
    advance(vars, bad, fallback, enumeration,
      LAMBDA (omega: LogSpace): randStep(vars, bad, fallback, enumeration, init(omega), omega, t))
  measurable_randStep_of_measurable_init: THEOREM measurableBad(coordinates, bad) AND
    measurable(TableSigma(coordinates), StateSigma(coordinates), init) IMPLIES
    stepMeasurable(coordinates,
      LAMBDA (omega: LogSpace): randStep(vars, bad, fallback, enumeration, init(omega), omega, t))
  measurable_randStep: THEOREM measurableBad(coordinates, bad) IMPLIES
    stepMeasurable(coordinates,
      LAMBDA (omega: LogSpace): randStep(vars, bad, fallback, enumeration, initial, omega, t))
  measurable_randTraj: THEOREM measurableBad(coordinates, bad) IMPLIES
    measurable(TableSigma(coordinates), StateSigma(coordinates),
      LAMBDA (omega: LogSpace): randTraj(vars, bad, fallback, enumeration, initial, omega, t))
  measurable_randStep_from_slot_zero: LEMMA measurableBad(coordinates, bad) IMPLIES
    stepMeasurable(coordinates, LAMBDA (omega: LogSpace):
      randStep(vars, bad, fallback, enumeration, initialStateFromLog(omega), omega, t))
END ppg_mt_trajectory_measurable
