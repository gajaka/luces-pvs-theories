% A finite intersection of complements is measurable under any sigma
% algebra. No probability law is needed for this closure statement.
%
% Noga Alon and Joel H. Spencer, The Probabilistic Method, fourth edition,
% Wiley, 2016, Lemma 5.1.1. Lean counterpart: PPGraphLLL.lean.
ppg_lll_pass_measurable[X,C:TYPE,
  (IMPORTING ppg_measurable_space[X]) S:MeasurableSpace]: THEORY
BEGIN
  IMPORTING ppg_event_avoidance[X,C],ppg_finite_events[X,C,S]
  A: VAR BadEvents
  T: VAR finite_set[C]
  i: VAR C

  AllMeasurable(A): bool = FORALL(i:C):S(A(i))

  measurable_pass_family: LEMMA AllMeasurable(A) IMPLIES FORALL(i:C):S(complement(A(i)))

  all_pass_finite_meet: LEMMA all_pass(A,T)=finiteMeet(T,LAMBDA(i:C):complement(A(i)))

  all_pass_measurable: THEOREM AllMeasurable(A) IMPLIES S(all_pass(A,T))
END ppg_lll_pass_measurable
