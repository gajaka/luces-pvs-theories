% The actual unit event factors over its disjoint coordinate blocks.
% The original marginal and the actual pair saving bound each factor;
% the selected endpoint half-cover then gives the refined DAG weight.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Lemma 3.4 and Proposition 3.2, arXiv:2111.06527.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% Lean: PPGraphHLSRefinedProbability.lean.
ppg_hls_refined_probability[C,V,Value:TYPE,domain:[V->set[Value]],
  variableUniverse:{U:finite_set[V]|U=fullset[V]},
  default:C,universe:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:{q:MTProcess|FORALL(i:C):
    ppg_mt_native_spaces[C,V,Value,domain].NativeStateSigma(spaces)(q`bad(i))},
  (IMPORTING ppg_shearer_bdd[C,V,process`footprint])
  p:[C->real],
  (IMPORTING ppg_hls_matching[C,
    ppg_shearer_bdd[C,V,process`footprint].dependencyGraph,p])
  O:OverlapBounds,
  (IMPORTING ppg_hls_table_coordinates[C,V,process`footprint])
  dag:WitnessDAG]: THEORY
BEGIN
  IMPORTING ppg_hls_refined_single_probability[C,V,Value,domain,
      variableUniverse,spaces,laws,process] AS marginal,
    ppg_hls_unit_probability[C,V,Value,domain,default,universe,
      spaces,laws,process] AS unitProbability,
    ppg_hls_unit_checks[C,V,Value,domain,default,universe,
      spaces,laws,process] AS units,
    ppg_hls_unit_event_measurable[C,V,Value,domain,default,universe,
      spaces,laws,process] AS measurableUnits,
    ppg_hls_augmented_pair_events[C,V,Value,domain,default,universe,
      spaces,laws,process] AS pairs,
    ppg_hls_augmented_space[C,V,Value,domain,spaces,laws] AS aug,
    ppg_hls_table_events[C,V,Value,domain,spaces,laws,process] AS tables,
    ppg_mt_state_probability[C,V,Value,domain,variableUniverse,
      spaces,laws] AS stateLaw,
    ppg_shearer_bdd[C,V,process`footprint] AS graph,
    ppg_hls_witness_dag[C,graph.dependencyGraph],
    ppg_hls_matching[C,graph.dependencyGraph,p] AS overlap,
    ppg_hls_matching_selection[C,graph.dependencyGraph] AS selection,
    ppg_hls_product_discount[C,graph.dependencyGraph,p,universe] AS discount,
    ppg_hls_refined_weight[C,graph.dependencyGraph,p] AS refined,
    ppg_finite_product[WNode] AS nodeProduct,
    ppg_real_product[WNode] AS nodeAlgebra,
    ppg_real_product_order[WNode] AS nodeOrder,
    ppg_finite_product[pairs.Arc] AS arcProduct,
    ppg_real_product_identities[pairs.Arc] AS arcProducts,
    ppg_enn_ofreal,
    ppg_hls_augmented_pair_public_saving[C,V,Value,domain,variableUniverse,
      default,universe,spaces,laws,process]

  % These are the original probability and intersection hypotheses.
  % The desired event mass, independence and saving are not hypotheses.
  hprob: bool = FORALL(i:C):stateLaw.stateMeasure(process`bad(i))=p(i)

  hp: bool = FORALL(i:C):0<p(i)

  hInt: bool = FORALL(i:C):O`delta(i)<=stateLaw.stateMeasure(
    intersection(process`bad(i),process`bad(O`mate(i))))

  e: VAR pairs.Arc

  u: VAR WNode

  singleMass(u): real = aug.augmentedMeasure(marginal.originalSingle(dag,u))

  pairMass(e): real = aug.augmentedMeasure(pairs.augmentedPairCheck(O`mate,dag,e))

  pairDiscount(e): real = p(e`1`1)*p(e`2`1)*
    (1-2*overlap.discount(O)(e`1`1))*(1-2*overlap.discount(O)(e`2`1))

  selected_arc_data: LEMMA selection.selectedArcs(O`mate,dag)(e) IMPLIES
    Edge(dag)(e`1,e`2) AND O`mate(e`1`1)=e`2`1 AND
    O`mate(e`2`1)=e`1`1 AND O`delta(e`2`1)=O`delta(e`1`1)

  selected_overlap_lower: LEMMA hInt AND
    selection.selectedArcs(O`mate,dag)(e) IMPLIES
      O`delta(e`1`1)<=stateLaw.stateMeasure(
        intersection(process`bad(e`1`1),process`bad(e`2`1)))

  pair_saving_bound: LEMMA tables.badMeasurable AND hprob AND hInt AND
    Valid(dag) AND selection.selectedArcs(O`mate,dag)(e) IMPLIES
      pairMass(e)<=p(e`1`1)*p(e`2`1)-O`delta(e`1`1)*O`delta(e`1`1)/2

  pair_discount_nonnegative: LEMMA hp IMPLIES 0<=pairDiscount(e)

  pair_probability_discount: LEMMA tables.badMeasurable AND hprob AND hp AND
    hInt AND Valid(dag) AND selection.selectedArcs(O`mate,dag)(e) IMPLIES
      pairMass(e)<=pairDiscount(e)

  measure_augmentedPairCheck_le_discount: THEOREM
    tables.badMeasurable AND hprob AND hp AND hInt AND Valid(dag) AND
    selection.selectedArcs(O`mate,dag)(e) IMPLIES
      ele(ofReal(pairMass(e)),ofReal(pairDiscount(e)))

  single_probability_value: LEMMA tables.badMeasurable AND hprob IMPLIES
    singleMass(u)=p(u`1)

  unit_probability_split: LEMMA tables.badMeasurable AND Valid(dag) IMPLIES
    aug.augmentedMeasure(units.unitCheck(O`mate,dag))=
      nodeProduct.product(difference(dag`nodes,
        selection.arcNodes(selection.selectedArcs(O`mate,dag))),singleMass)*
      arcProduct.product(selection.selectedArcs(O`mate,dag),pairMass)

  unit_probability_real_bound: LEMMA
    tables.badMeasurable AND hprob AND hp AND hInt AND Valid(dag) IMPLIES
      aug.augmentedMeasure(units.unitCheck(O`mate,dag))<=
        nodeProduct.product(difference(dag`nodes,
          selection.arcNodes(selection.selectedArcs(O`mate,dag))),
          LAMBDA(u:WNode):p(u`1))*
        arcProduct.product(selection.selectedArcs(O`mate,dag),pairDiscount)

  logMeasure_unitCheck_le_refinedWeight: THEOREM
    tables.badMeasurable AND hprob AND hp AND hInt AND Valid(dag) IMPLIES
      ele(ofReal(aug.augmentedMeasure(units.unitCheck(O`mate,dag))),
        refined.refinedWeight(O)(dag))

END ppg_hls_refined_probability
