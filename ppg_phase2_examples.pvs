% Small models distinguish witnesses, conflicts, partial searches, and zero weights.
ppg_phase2_examples: THEORY
BEGIN

  BOOL_U: finite_set[bool] = add(TRUE, singleton(FALSE))

  IMPORTING ppg_infeasibility_counting[bool, bool, BOOL_U],
    ppg_finite_abstraction_repair[bool, bool, BOOL_U]

  allowAll: set[bool] = fullset[bool]

  requireValue: [bool, bool -> bool] = LAMBDA (c, z: bool): c = z

  advance: [bool, bool -> bool] = LAMBDA (v, w: bool): NOT v AND w

  accept: set[bool] = LAMBDA (z: bool): z

  realizeStep: [bool, bool -> bool] = LAMBDA (v, a: bool): a

  projectState: [bool -> bool] = LAMBDA (z: bool): z

  conflicting_obligations: LEMMA Infeasible(allowAll, requireValue, BOOL_U)

  conflicting_count_zero: THEOREM exactGoodCount(allowAll, requireValue, BOOL_U) = 0

  one_obligation_feasible: THEOREM Satisfiable(allowAll, requireValue, singleton(TRUE))

  zero_weight_feasible: THEOREM
    Satisfiable(allowAll, requireValue, singleton(TRUE)) AND
    goodMass(allowAll, requireValue, singleton(TRUE), LAMBDA (z: bool): 0) = 0

  duplicate_enumeration_search: THEOREM
    search(accept, requireValue, emptyset[bool], cons(FALSE, cons(TRUE, cons(TRUE, null)))) = some(TRUE)

  partial_enumeration_is_insufficient: THEOREM
    search(accept, requireValue, emptyset[bool], null) = none AND Satisfiable(accept, requireValue, emptyset[bool])

  one_step_executable_abstraction: THEOREM
    ExecutableAbstraction(advance, accept, advance, accept, projectState, realizeStep)

  returned_trace_reaches_good: THEOREM
    GoodPath(advance, accept, FALSE, executeAbstractPath(realizeStep, FALSE, cons(TRUE, null))) AND
    pathTarget(FALSE, executeAbstractPath(realizeStep, FALSE, cons(TRUE, null))) = TRUE

  stationary_state_refuted: THEOREM
    checker.invariantCheck(LAMBDA (v,w: bool): FALSE, accept, FALSE, singleton(FALSE))

END ppg_phase2_examples
