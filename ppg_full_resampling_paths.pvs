% Full-footprint resampling consumes a fresh complete table row at each
% step. These identities concern the existing local counters and raw MT
% trajectory, before any probability calculation.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Section 2.
ppg_full_resampling_paths[C,V,Value:TYPE,domain:[V->set[Value]],
  universe:{U:finite_set[V]|FORALL(v:V):U(v)}]: THEORY
BEGIN
  IMPORTING ppg_mt_random_process[C,V,Value,domain] AS slots,
    ppg_mt_semantics[C,V,Value,domain] AS semantics,
    ppg_mt_selection[C,V,Value,domain] AS selection,
    ppg_mt_stopped_events[C,V,Value,domain] AS stopped,
    ppg_mt_correspondence[C,V,Value,domain] AS correspondence

  State: TYPE = semantics.MTState

  ResamplingLog: TYPE = slots.LogSpace

  vars: VAR [C->finite_set[V]]
  bad: VAR [C,State->bool]
  fallback: VAR C
  enumeration: VAR list[C]
  initial: VAR State
  omega,omega1,omega2: VAR ResamplingLog
  n,k,N: VAR nat
  v: VAR V
  p: VAR [nat,V]

  Full(vars): bool = FORALL(c:C):vars(c)=universe

  counter(vars,bad,fallback,enumeration,initial,omega,n)(v): nat =
    slots.randStep(vars,bad,fallback,enumeration,initial,omega,n)`2(v)

  counter_zero: LEMMA counter(vars,bad,fallback,enumeration,initial,omega,0)(v)=0

  counter_step: LEMMA Full(vars) IMPLIES counter(vars,bad,fallback,enumeration,initial,omega,n+1)(v)=
    counter(vars,bad,fallback,enumeration,initial,omega,n)(v)+1

  fullResampling_count: THEOREM Full(vars) IMPLIES counter(vars,bad,fallback,enumeration,initial,omega,n)(v)=n

  next_row: LEMMA Full(vars) IMPLIES slots.randTraj(vars,bad,fallback,enumeration,initial,omega,n+1)=
    slots.freshState(omega,n+1)

  fullResampling_randTraj_randomInit: THEOREM Full(vars) IMPLIES
    slots.randTraj(vars,bad,fallback,enumeration,slots.initialStateFromLog(omega),omega,n)=slots.freshState(omega,n)

  mtSlotBlock(n): finite_set[[nat,V]] = image(LAMBDA(v:V):(n,v),universe)

  slot_member: LEMMA mtSlotBlock(n)(p) IFF p`1=n

  mtBadSlotEvent(bad,n): set[ResamplingLog] =
    {omega:ResamplingLog|NOT selection.MTGood(bad,slots.freshState(omega,n))}

  row_agreement: LEMMA (FORALL(p:[nat,V]):mtSlotBlock(n)(p) IMPLIES omega1(p)=omega2(p)) IMPLIES
    slots.freshState(omega1,n)=slots.freshState(omega2,n)

  mtBadSlotEvent_dependsOn: THEOREM (FORALL(p:[nat,V]):mtSlotBlock(n)(p) IMPLIES omega1(p)=omega2(p)) IMPLIES
    (mtBadSlotEvent(bad,n)(omega1) IFF mtBadSlotEvent(bad,n)(omega2))

  mtSlotBlock_disjoint: THEOREM n/=k IMPLIES disjoint?(mtSlotBlock(n),mtSlotBlock(k))

  badPrefix(bad,N): set[ResamplingLog] = {omega:ResamplingLog|FORALL(n:nat):n<N IMPLIES mtBadSlotEvent(bad,n)(omega)}

  selected_bad_good: LEMMA selection.completeEnumeration(enumeration) IMPLIES
    (bad(selection.realC(vars,bad,fallback,enumeration,initial,omega,n),
      slots.randStep(vars,bad,fallback,enumeration,initial,omega,n)`1) IFF
      NOT selection.MTGood(bad,slots.randTraj(vars,bad,fallback,enumeration,initial,omega,n)))

  running_prefix: LEMMA selection.completeEnumeration(enumeration) IMPLIES
    (correspondence.RunningUntil(vars,bad,fallback,enumeration,initial,omega,N) IFF
      (FORALL(n:nat):n<N IMPLIES NOT selection.MTGood(bad,
        slots.randTraj(vars,bad,fallback,enumeration,initial,omega,n))))

  fullResampling_runningEvent_eq: THEOREM Full(vars) AND selection.completeEnumeration(enumeration) IMPLIES
    stopped.randomInitRunningEvent(vars,bad,fallback,enumeration,N)=badPrefix(bad,N)

END ppg_full_resampling_paths
