% Homogeneous refinement and directed PPG configurations.
ppg_config[V: TYPE]: THEORY
BEGIN
  IMPORTING directed_pp_graph[V], ppg_refinement[V, V]

  PPGConfig: TYPE = [# le_eq: equivalence[V], f_abs: [V -> V],
                       g_con: [V -> V], invariant: [V -> bool] #]

  cfg: VAR PPGConfig
  le_eq: VAR [V, V -> bool]
  f_abs, g_con: VAR [V -> V]
  x, y: VAR V
  G: VAR Graph

  rr_rel_hom(le_eq, f_abs, g_con, x, y): bool =
    RR(le_eq, le_eq, f_abs, g_con)((x, y))

  config_rr(cfg, x, y): bool = rr_rel_hom(cfg`le_eq, cfg`f_abs, cfg`g_con, x, y)

  config_valid(cfg, G): bool =
    pp_valid(G, LAMBDA (x, y: V): config_rr(cfg, x, y), cfg`invariant)

  pp_edge_concrete(cfg, x, y): bool =
    x /= y AND cfg`invariant(x) AND cfg`invariant(y) AND config_rr(cfg, x, y)

  rr_rel_id: THEOREM
    reflexive?(le_eq) AND le_eq(x, y) IMPLIES
      rr_rel_hom(le_eq, LAMBDA (v: V): v, LAMBDA (v: V): v, x, y)

  config_id_reduces: THEOREM
    cfg`f_abs = (LAMBDA (v: V): v) AND cfg`g_con = (LAMBDA (v: V): v) AND
    cfg`le_eq(x, y) IMPLIES config_rr(cfg, x, y)

  g_consistent_pp_edge: THEOREM
    x /= y AND cfg`invariant(x) AND cfg`invariant(y) AND cfg`le_eq(x, cfg`g_con(y))
      IMPLIES pp_edge_concrete(cfg, x, y)

  f_consistent_pp_edge: THEOREM
    x /= y AND cfg`invariant(x) AND cfg`invariant(y) AND cfg`le_eq(y, cfg`f_abs(x))
      IMPLIES pp_edge_concrete(cfg, x, y)

  pp_edge_concrete_is_pp_edge: THEOREM
    pp_edge_concrete(cfg, x, y) IMPLIES
      pp_edge(LAMBDA (a, b: V): config_rr(cfg, a, b), cfg`invariant, x, y)

  graph_valid_of_concrete_edges: THEOREM
    (FORALL (x, y: V): G`edges(x, y) IMPLIES pp_edge_concrete(cfg, x, y))
      IMPLIES config_valid(cfg, G)

END ppg_config
