   "default" "enumeration" "eventOrder" "s" "s!1"))
 (EXPAND "regions.Gap") (EXPAND "selection.completeEnumeration")
 (GRIND :DEFS NIL :IF-MATCH ALL))
    NIL NIL)
   NIL NIL))
 (|feasibility_TCC1| 0
  (|feasibility_TCC1-current-explicit-TCC-proposal| NIL 0
   (""
