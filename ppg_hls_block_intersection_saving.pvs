% The private and shared blocks represent the two endpoint events.
% Their overlap yields the quadratic saving for the state probabilities.
% Patrick Billingsley, Probability and Measure, third edition.
ppg_hls_block_intersection_saving[V,Value:TYPE,domain:[V->set[Value]],
  universe:{U:finite_set[V]|U=fullset[V]},F,H,Z:finite_set[V],
  (IMPORTING ppg_mt_native_spaces[bool,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces)]: THEORY
BEGIN

  IMPORTING ppg_measurable_block[V,Value,domain,spaces] AS blocks,
    ppg_probability_finite_product[V,Value,domain,spaces,laws] AS finiteBlocks,
    ppg_hls_block_intersection_mass[V,Value,domain,universe,F,H,Z,spaces,laws] AS blockMass,
    ppg_hls_join_blocks_probability[V,Value,domain,universe,F,H,spaces,laws] AS sourceProbability,
    ppg_hls_join_blocks_probability[V,Value,domain,universe,H,Z,spaces,laws] AS targetProbability,
    ppg_hls_join_three_probability[V,Value,domain,universe,F,H,Z,spaces,laws] AS tripleProbability,
    ppg_mt_state_probability[bool,V,Value,domain,universe,spaces,laws] AS stateProbability,
    ppg_probability_finite_native_triple[blocks.Block(F),blocks.Block(H),blocks.Block(Z),
      blocks.blockSigma(F),blocks.blockSigma(H),blocks.blockSigma(Z),
      finiteBlocks.finiteLaw(F),finiteBlocks.finiteLaw(H),finiteBlocks.finiteLaw(Z)] AS nativeTriple,
    ppg_probability_finite_coin_saving[blocks.Block(F),blocks.Block(H),blocks.Block(Z),
      blocks.blockSigma(F),blocks.blockSigma(H),blocks.blockSigma(Z),
      finiteBlocks.finiteLaw(F),finiteBlocks.finiteLaw(H),finiteBlocks.finiteLaw(Z)] AS saving,
    ppg_native_intersection_measurable[blocks.Block(F),blocks.Block(H),blocks.Block(Z),
      ppg_nasa_sigma[blocks.Block(F)].asNasa(blocks.blockSigma(F)),
      ppg_nasa_sigma[blocks.Block(H)].asNasa(blocks.blockSigma(H)),
      ppg_nasa_sigma[blocks.Block(Z)].asNasa(blocks.blockSigma(Z))] AS nativeEvents

  A,B: VAR blockMass.StateEvent

  delta: VAR real

  joint_block_native_event_eq: LEMMA blockMass.jointAsBlockEvent(A,B)=
    nativeEvents.jointAsEvent(blockMass.sourceBlock(A),blockMass.targetBlock(B))

  triple_law_eq: LEMMA nativeTriple.tripleLaw=tripleProbability.tripleProductLaw

  overlap_mass_eq: LEMMA
    disjoint?(F,H) AND disjoint?(H,Z) AND disjoint?(F,Z) AND
    disjoint?(union(F,Z),H) AND
    sourceProbability.stateDepends(union(F,H),A) AND
    targetProbability.stateDepends(union(H,Z),B) IMPLIES
      nativeTriple.tripleLaw(nativeEvents.jointAsEvent(
        blockMass.sourceBlock(A),blockMass.targetBlock(B)))=
          stateProbability.stateMeasure(intersection(A,B))

  coin_block_intersection_saving: THEOREM
    disjoint?(F,H) AND disjoint?(H,Z) AND disjoint?(F,Z) AND
    disjoint?(union(F,Z),H) AND
    sourceProbability.stateDepends(union(F,H),A) AND
    targetProbability.stateDepends(union(H,Z),B) AND
    delta>=0 AND delta<=stateProbability.stateMeasure(intersection(A,B)) IMPLIES
      saving.finiteCoinMass(blockMass.sourceBlock(A),blockMass.targetBlock(B))<=
        stateProbability.stateMeasure(A)*stateProbability.stateMeasure(B)-delta*delta/2

END ppg_hls_block_intersection_saving
