% Upper-indexed Shearer coefficients are alternating sums over disjoint
% extensions of the root layer. For an independent root, factoring its
% product leaves the avoidance polynomial outside its closed neighborhood.
% The definition is zero when the root is not contained in the ambient set.
%
% Nicholas J. A. Harvey and Jan Vondrak, "An Algorithmic Proof of the
% Lovasz Local Lemma via Resampling Oracles", Claims 5.14--5.16 and
% Lemma 5.17. https://arxiv.org/abs/1504.02044
% Lean counterpart: PPGraphShearerStable.lean.
ppg_shearer_coefficients[C:TYPE,G:{H:[C,C->bool]|(FORALL(a:C):NOT H(a,a)) AND
  (FORALL(a,b:C):H(a,b)=H(b,a))}]: THEORY
BEGIN
  IMPORTING ppg_shearer_closed[C,G],ppg_shearer_polynomial[C,G],
            ppg_alternating_subsets[C]
  p: VAR [C->real]
  B,J,K,U: VAR finite_set[C]
  a: VAR C
  setWeight(p)(J): real = IF Independent(J) THEN product(J,p) ELSE 0 ENDIF
  coefficientTerm(p,J)(K): real = paritySign(card(K))*setWeight(p)(union(J,K))
  coefficient(p,B,J): real = IF subset?(J,B) THEN
    fsum(subsets(difference(B,J)),coefficientTerm(p,J)) ELSE 0 ENDIF
  parity_sign_power: LEMMA FORALL(n:nat):paritySign(n)=(-1)^n
  swap_factors: LEMMA FORALL(x,y,z:real):x*(y*z)=y*(x*z)
  rotate_negative: LEMMA FORALL(x,y,z:real):(-x)*(y*z)=(-y)*(x*z)
  negate_product: LEMMA FORALL(x,y:real):(-x)*y=-(x*y)
  union_insert_move: LEMMA union(J,add(a,K))=union(add(a,J),K)
  extension_fresh: LEMMA NOT B(a) AND subset?(K,difference(B,J)) IMPLIES NOT K(a)
  product_insert: LEMMA NOT J(a) IMPLIES product(add(a,J),p)=p(a)*product(J,p)
  term_sign: LEMMA term(p)(K)=paritySign(card(K))*product(K,p)
  lifted_sign: LEMMA lifted(p)(K)=paritySign(card(K))*setWeight(p)(K)
  union_weight_zero: LEMMA NOT Independent(J) IMPLIES setWeight(p)(union(J,K))=0
  coefficient_term_zero_function: LEMMA NOT Independent(J) IMPLIES
    coefficientTerm(p,J)=(LAMBDA(K:finite_set[C]):0)
  coefficient_eq_zero_of_not_independent: THEOREM
    NOT Independent(J) IMPLIES coefficient(p,B,J)=0
  extension_disjoint: LEMMA subset?(K,difference(B,J)) IMPLIES disjoint?(J,K)
  coefficient_factor_term: LEMMA subset?(K,difference(B,J)) AND
    Independent(J) AND Independent(union(J,K)) IMPLIES
      coefficientTerm(p,J)(K)=product(J,p)*term(p)(K)
  coefficient_mask: LEMMA mask(LAMBDA(K:finite_set[C]):Independent(union(J,K)),
    coefficientTerm(p,J))=coefficientTerm(p,J)
  coefficient_filtered: LEMMA coefficient(p,B,J)=IF subset?(J,B) THEN
    fsum(intersection(subsets(difference(B,J)),
      LAMBDA(K:finite_set[C]):Independent(union(J,K))),coefficientTerm(p,J)) ELSE 0 ENDIF
  coefficient_factor: THEOREM subset?(J,B) AND Independent(J) IMPLIES
    coefficient(p,B,J)=product(J,p)*polynomial(p,outside(B,J))
  coefficient_empty: THEOREM coefficient(p,B,emptyset[C])=polynomial(p,B)
  insert_differences: LEMMA NOT B(a) AND subset?(J,B) IMPLIES
    difference(add(a,B),J)=add(a,difference(B,J)) AND
    difference(add(a,B),add(a,J))=difference(B,J)
  inserted_coefficient_term: LEMMA NOT B(a) AND subset?(J,B) AND
    subset?(K,difference(B,J)) IMPLIES
      coefficientTerm(p,J)(add(a,K))=-coefficientTerm(p,add(a,J))(K)
  insert_context: LEMMA NOT B(a) AND subset?(J,B) IMPLIES
    subset?(J,add(a,B)) AND subset?(add(a,J),add(a,B)) AND NOT difference(B,J)(a)
  inserted_coefficient_sum: LEMMA NOT B(a) AND subset?(J,B) IMPLIES
    fsum(subsets(difference(B,J)),LAMBDA(K:finite_set[C]):coefficientTerm(p,J)(add(a,K)))=
      -fsum(subsets(difference(B,J)),coefficientTerm(p,add(a,J)))
  coefficient_insert_split: THEOREM NOT B(a) AND subset?(J,B) IMPLIES
    coefficient(p,add(a,B),J)+coefficient(p,add(a,B),add(a,J))=coefficient(p,B,J)
  coefficient_remove_split: LEMMA B(a) AND subset?(J,remove(a,B)) IMPLIES
    coefficient(p,B,J)+coefficient(p,B,add(a,J))=coefficient(p,remove(a,B),J)
  erase_difference: LEMMA difference(remove(a,B),U)=difference(B,add(a,U))
  erase_insert_subset: LEMMA subset?(add(a,U),B) AND NOT U(a) IMPLIES
    B(a) AND subset?(U,remove(a,B))
  sum_coefficient_step: LEMMA NOT U(a) AND subset?(add(a,U),B) AND
    fsum(subsets(U),LAMBDA(J:finite_set[C]):coefficient(p,remove(a,B),J))=
      polynomial(p,difference(remove(a,B),U)) IMPLIES
    fsum(subsets(add(a,U)),LAMBDA(J:finite_set[C]):coefficient(p,B,J))=
      polynomial(p,difference(B,add(a,U)))
  sum_coefficient: THEOREM subset?(U,B) IMPLIES
    fsum(subsets(U),LAMBDA(J:finite_set[C]):coefficient(p,B,J))=polynomial(p,difference(B,U))
  coefficient_recurrence: THEOREM subset?(J,B) AND Independent(J) IMPLIES
    coefficient(p,B,J)=product(J,p)*
      fsum(subsets(closed(B,J)),LAMBDA(K:finite_set[C]):coefficient(p,B,K))
END ppg_shearer_coefficients
