% Avoidance of a finite event family reads only the union of its footprints.
% No probability law or finite variable universe is needed for this fact.
% Lean counterpart: PPGraphShearerMT.lean, mt_all_pass_depends_on.
ppg_mt_state_footprints[C,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_mt_semantics[C,V,Value,domain]) vars:CertVars]: THEORY
BEGIN
  IMPORTING ppg_event_dependence[MTState,C,V,vars],ppg_mt_selection[C,V,Value,domain]
  bad: VAR [C,MTState->bool]
  B,J: VAR finite_set[C]
  a,j: VAR C
  s,t: VAR MTState
  F: VAR set[V]
  A: VAR set[MTState]
  stateEvents(bad): BadEvents = LAMBDA(a:C): {s:MTState|bad(a,s)}
  footprintUnion(J): set[V] = {v:V|EXISTS(j:C):J(j) AND vars(j)(v)}
  stateDepends(F,A): bool = FORALL(s,t:MTState):
    (FORALL(v:V):F(v) IMPLIES s(v)=t(v)) IMPLIES A(s)=A(t)
  bad_state_depends: LEMMA mt_wf(vars,bad) IMPLIES stateDepends(vars(a),stateEvents(bad)(a))
  footprint_subset_union: LEMMA J(a) IMPLIES subset?(vars(a),footprintUnion(J))
  bad_equiv_under_union: LEMMA mt_wf(vars,bad) AND J(a) AND
    (FORALL(v:V):footprintUnion(J)(v) IMPLIES s(v)=t(v)) IMPLIES bad(a,s)=bad(a,t)
  nonneighbor_not_dependent: LEMMA independent_side(B,a,J) AND J(j) IMPLIES
    NOT dependent(vars,a,j)
  mt_all_pass_depends_on: THEOREM mt_wf(vars,bad) IMPLIES
    stateDepends(footprintUnion(J),all_pass(stateEvents(bad),J))
  independent_footprints_disjoint: LEMMA independent_side(B,a,J) IMPLIES
    disjoint?(vars(a),footprintUnion(J))
  mt_good_event_univ_eq: THEOREM B=fullset[C] IMPLIES
    all_pass(stateEvents(bad),B)={s:MTState|MTGood(bad,s)}
END ppg_mt_state_footprints
