% A dense optimum is a counterexample to universal vertex-sparsity claims.
% With constant zero cost, every feasible coupling is optimal. The uniform
% product coupling has 100 positive entries, exceeding the 19-entry bound.
% Its mass on any single assignment is only 1/10. None of these calculations
% asserts that a sparse optimizer cannot also exist.

transport_structure_v2: THEORY
BEGIN

  IMPORTING transport_structure

  T: VAR TransportMap

  dense_plan: Plan = LAMBDA (i,j: Bin): 1/(N*N)

  zero_cost: Cost = LAMBDA (i,j: Bin): 0

  dense_plan_feasible: THEOREM feasible?(uniform,uniform,dense_plan)

  dense_plan_zero_cost: LEMMA kant_cost(zero_cost,dense_plan) = 0

  dense_plan_optimal: THEOREM optimal_plan?(zero_cost,uniform,uniform,dense_plan)

  dense_support_count: THEOREM nnz(dense_plan) = N*N

  dense_selected_mass: THEOREM mass_on_map(dense_plan,T) = 1/N

  dense_not_near_monge: THEOREM NOT near_monge(dense_plan,T)

  optimal_does_not_imply_sparsity: THEOREM optimal_plan?(zero_cost,uniform,uniform,dense_plan) AND
    NOT has_vertex_sparsity_bound?(dense_plan) AND dense_plan(0,0) > 0

END transport_structure_v2
