% Finite Shannon entropy and source provenance are different observables.
%
% Shannon entropy is -sum p log p, with 0 log 0 = 0. The displacement-convex
% functional in McCann (1997), A Convexity Principle for Interacting Gases,
% and Villani (2009), Chapter 17, has the opposite sign, +integral rho log rho.
% No Wasserstein geodesic is defined here and no geodesic detector is claimed.
%
% The concrete two-channel example below has positive Shannon excess while
% every observation has zero lamp contribution. It refutes the former
% universal pure-path bound and the resulting hybrid-source detector.

 displacement_concavity: THEORY
BEGIN

  N: posnat = 10

  Channel: TYPE = below(N)

  IMPORTING reals@sigma_below[N], lnexp@ln_exp

  Spectrum: TYPE = [Channel -> nonneg_real]

  UnitInterval: TYPE = {t: real | 0 <= t AND t <= 1}

  Observation: TYPE = [# spectrum: Spectrum, lamp_fraction: UnitInterval #]

  mu, mu0, mu1: VAR Spectrum
  a, b: VAR Observation
  t: VAR UnitInterval
  k: VAR Channel

  probability?(mu): bool = sigma[Channel](0, N-1, mu) = 1

  xlogx(x: nonneg_real): real = IF x = 0 THEN 0 ELSE x * ln(x) ENDIF

  H(mu): real = -sigma[Channel](0, N-1, LAMBDA (k: Channel): xlogx(mu(k)))

  linear_interp(mu0, mu1, t): Spectrum =
    LAMBDA (k: Channel): (1-t) * mu0(k) + t * mu1(k)

  is_pure?(a): bool = a`lamp_fraction = 0

  is_hybrid?(a): bool = a`lamp_fraction > 0

  valid?(a): bool = probability?(a`spectrum)

  unit_mix_bounds: LEMMA
    FORALL (a, b, t: UnitInterval):
      0 <= (1-t)*a+t*b AND (1-t)*a+t*b <= 1

  mix(a, b, t): Observation =
    (# spectrum := linear_interp(a`spectrum, b`spectrum, t),
       lamp_fraction := (1-t) * a`lamp_fraction + t * b`lamp_fraction #)

  H_bound(mu0, mu1, t): real = (1-t) * H(mu0) + t * H(mu1)

  excess(a, b, t): real = H(mix(a, b, t)`spectrum) - H_bound(a`spectrum, b`spectrum, t)

  point_mass(k): Spectrum = LAMBDA (j: Channel): IF j = k THEN 1 ELSE 0 ENDIF

  solar_a: Observation = (# spectrum := point_mass(0), lamp_fraction := 0 #)

  solar_b: Observation = (# spectrum := point_mass(1), lamp_fraction := 0 #)

  % Source metadata is explicit. It cannot be recovered from entropy alone.
  relabelled_a: Observation = (# spectrum := point_mass(0), lamp_fraction := 1/2 #)

  point_mass_probability: LEMMA probability?(point_mass(k))

  point_mass_entropy: LEMMA H(point_mass(k)) = 0

  pure_mix_stays_pure: THEOREM is_pure?(a) AND is_pure?(b) IMPLIES is_pure?(mix(a, b, t))

  linear_interp_endpoints: THEOREM linear_interp(mu0, mu1, 0) = mu0 AND linear_interp(mu0, mu1, 1) = mu1

  binary_midpoint_probability: LEMMA probability?(mix(solar_a, solar_b, 1/2)`spectrum)

  binary_midpoint_entropy: THEOREM H(mix(solar_a, solar_b, 1/2)`spectrum) = ln(2)

  binary_midpoint_excess: THEOREM excess(solar_a, solar_b, 1/2) = ln(2)

  positive_excess_pure_counterexample: THEOREM
    valid?(solar_a) AND valid?(solar_b) AND valid?(mix(solar_a, solar_b, 1/2)) AND
    is_pure?(solar_a) AND is_pure?(solar_b) AND is_pure?(mix(solar_a, solar_b, 1/2)) AND
    excess(solar_a, solar_b, 1/2) > 0

  positive_excess_not_hybrid_certificate: THEOREM
    NOT (FORALL (a, b: Observation, t: UnitInterval):
      valid?(a) AND valid?(b) AND is_pure?(a) AND is_pure?(b) AND excess(a, b, t) > 0
        IMPLIES is_hybrid?(mix(a, b, t)))

  entropy_does_not_determine_source: THEOREM
    valid?(solar_a) AND valid?(relabelled_a) AND
    H(solar_a`spectrum) = H(relabelled_a`spectrum) AND
    is_pure?(solar_a) AND is_hybrid?(relabelled_a)

END displacement_concavity
