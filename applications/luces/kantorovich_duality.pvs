% Finite Kantorovich certificates over the same ten-bin feasible set as the
% Monge comparison. Feasibility includes BOTH normalized marginals. Prices
% are checked pointwise, and complementary slackness is checked on support.
% Algebraic sum identities are proved, rather than postulated as axioms.
% The diagonal uniform plan supplies a nonzero feasible certificate.
%
% This is a finite certificate theorem, not an unverified claim that a
% particular 867-by-205 empirical LP already satisfies exact real constraints.
% Villani, Optimal Transport: Old and New (2009), Chapter 5.

kantorovich_duality: THEORY
BEGIN

  IMPORTING monge_kantorovich_equivalence

  Price: TYPE = [Bin -> real]

  cost: VAR Cost
  mu, nu: VAR Mass
  P, Q: VAR Plan
  psi, phi, ps, ph: VAR Price
  i, j: VAR Bin

  value(mu, nu, psi, phi): real =
    sigma[Bin](0, N-1, LAMBDA (j: Bin): phi(j) * nu(j)) -
    sigma[Bin](0, N-1, LAMBDA (i: Bin): psi(i) * mu(i))

  integrated_price(P, psi, phi): real =
    sigma[Bin](0, N-1, LAMBDA (i: Bin):
      sigma[Bin](0, N-1, LAMBDA (j: Bin): P(i, j) * (phi(j) - psi(i))))

  dual_feasible?(cost, psi, phi): bool =
    FORALL (i, j: Bin): phi(j) - psi(i) <= cost(i, j)

  complementary_slack?(cost, P, psi, phi): bool =
    FORALL (i, j: Bin): P(i, j) > 0 IMPLIES phi(j) - psi(i) = cost(i, j)

  price_decomposition: LEMMA integrated_price(P, psi, phi) =
    sigma[Bin](0, N-1, LAMBDA (j: Bin): phi(j) * col_mass(P, j)) -
    sigma[Bin](0, N-1, LAMBDA (i: Bin): psi(i) * row_mass(P, i))

  weighted_marginal_sums: LEMMA feasible?(mu, nu, P) IMPLIES
    sigma[Bin](0, N-1, LAMBDA (i: Bin): psi(i) * row_mass(P,i)) =
      sigma[Bin](0, N-1, LAMBDA (i: Bin): psi(i) * mu(i)) AND
    sigma[Bin](0, N-1, LAMBDA (j: Bin): phi(j) * col_mass(P,j)) =
      sigma[Bin](0, N-1, LAMBDA (j: Bin): phi(j) * nu(j))

  value_as_double_sum: LEMMA feasible?(mu, nu, P)
    IMPLIES value(mu, nu, psi, phi) = integrated_price(P, psi, phi)

  pointwise_dual_bound: LEMMA dual_feasible?(cost, psi, phi)
    IMPLIES P(i, j) * (phi(j) - psi(i)) <= cost(i, j) * P(i, j)

  row_dual_bound: LEMMA dual_feasible?(cost, psi, phi) IMPLIES
    sigma[Bin](0, N-1, LAMBDA (j: Bin): P(i, j) * (phi(j) - psi(i))) <=
    sigma[Bin](0, N-1, LAMBDA (j: Bin): cost(i, j) * P(i, j))

  integrated_dual_bound: LEMMA dual_feasible?(cost, psi, phi)
    IMPLIES integrated_price(P, psi, phi) <= kant_cost(cost, P)

  lem_weak_duality: THEOREM feasible?(mu, nu, P) AND dual_feasible?(cost, psi, phi)
    IMPLIES value(mu, nu, psi, phi) <= kant_cost(cost, P)

  pointwise_tight_weighted: LEMMA complementary_slack?(cost, P, psi, phi)
    IMPLIES P(i, j) * (phi(j) - psi(i)) = cost(i, j) * P(i, j)

  row_tight: LEMMA complementary_slack?(cost, P, psi, phi) IMPLIES
    sigma[Bin](0, N-1, LAMBDA (j: Bin): P(i, j) * (phi(j) - psi(i))) =
    sigma[Bin](0, N-1, LAMBDA (j: Bin): cost(i, j) * P(i, j))

  lem_sum_tight: LEMMA complementary_slack?(cost, P, psi, phi)
    IMPLIES integrated_price(P, psi, phi) = kant_cost(cost, P)

  thm_certificate_gap_zero: THEOREM feasible?(mu, nu, P) AND
    complementary_slack?(cost, P, psi, phi)
    IMPLIES kant_cost(cost, P) = value(mu, nu, psi, phi)

  thm_primal_optimal: THEOREM feasible?(mu, nu, P) AND
    dual_feasible?(cost, psi, phi) AND complementary_slack?(cost, P, psi, phi)
    IMPLIES optimal_plan?(cost, mu, nu, P)

  thm_dual_optimal: THEOREM feasible?(mu, nu, P) AND
    dual_feasible?(cost, psi, phi) AND complementary_slack?(cost, P, psi, phi) AND
    dual_feasible?(cost, ps, ph) IMPLIES value(mu, nu, ps, ph) <= value(mu, nu, psi, phi)

  zero_price: Price = LAMBDA (i: Bin): 0

  diagonal_certificate: THEOREM feasible?(uniform, uniform, diagonal_plan) AND
    dual_feasible?(diagonal_cost, zero_price, zero_price) AND
    complementary_slack?(diagonal_cost, diagonal_plan, zero_price, zero_price) AND
    kant_cost(diagonal_cost, diagonal_plan) = value(uniform, uniform, zero_price, zero_price) AND
    diagonal_plan(0, 0) > 0

END kantorovich_duality
