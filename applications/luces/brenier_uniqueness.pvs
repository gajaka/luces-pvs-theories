% Monotonicity of a finite one-dimensional quadratic argmin map.
%
% The proof compares the two crossed minimization inequalities. It does not
% assume a continuous Brenier theorem, absolute continuity, existence of a
% transport map for arbitrary marginals or uniqueness of a discrete argmin.
% Villani, Optimal Transport: Old and New (2009), Chapter 10, provides the
% continuous context. The identity map with zero potential is a checked
% nonempty instance of the finite conditions used here.

brenier_uniqueness: THEORY
BEGIN

  IMPORTING reals@sq

  N: posnat

  Bin: TYPE = below(N)

  TransportMap: TYPE = [Bin -> Bin]

  Potential: TYPE = [Bin -> real]

  T: VAR TransportMap
  phi: VAR Potential
  i, j, a, b: VAR Bin

  cost(i, j): nonneg_real = sq(i-j)

  convex?(phi): bool = FORALL (i: Bin): i > 0 AND i < N-1 IMPLIES
    phi(i+1) + phi(i-1) >= 2*phi(i)

  induced_by?(T, phi): bool = FORALL (i, j: Bin):
    cost(i, T(i)) - phi(T(i)) <= cost(i, j) - phi(j)

  monotone?(T): bool = FORALL (i, j: Bin): i < j IMPLIES T(i) <= T(j)

  strictly_monotone?(T): bool = FORALL (i, j: Bin): i < j IMPLIES T(i) < T(j)

  quadratic_swap_gap: LEMMA
    cost(i,a) + cost(j,b) - cost(i,b) - cost(j,a) = 2*(j-i)*(a-b)

  % Convexity is unnecessary for this finite order consequence: the shared
  % target potential cancels when the two optimality inequalities are added.
  induced_implies_monotone: THEOREM induced_by?(T, phi) IMPLIES monotone?(T)

  T_opt: TransportMap = LAMBDA (i: Bin): i

  phi_opt: Potential = LAMBDA (i: Bin): 0

  identity_instance: THEOREM convex?(phi_opt) AND induced_by?(T_opt, phi_opt)

  thm_optimal_is_monotone: THEOREM monotone?(T_opt)

  thm_strict_monotone_injective: THEOREM strictly_monotone?(T) IMPLIES
    FORALL (i, j: Bin): i /= j IMPLIES T(i) /= T(j)

END brenier_uniqueness
