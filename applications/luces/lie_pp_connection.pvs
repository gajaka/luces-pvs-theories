% Curvature and endpoint-direction coherence computed from one ordered walk.
% The coordinate map is fixed for the theory instance. Reports are accepted
% only when BOTH fields equal the computations and the actual PPG path passes
% the geometric and alignment bounds. No independent C20 field is used here.
%
% Endpoint-direction coherence is not C20 coupling alignment. Captured C20
% observations and their finite checks are in lie_captured_observations.pvs.
% Sensor calibration, binary64 evaluation and a physical Lie representation
% remain separate obligations.
%
% Author: Dragan Stosic, 2026.

lie_pp_connection[T: TYPE+, coordinate_map: [T -> [below(10) -> real]]]: THEORY
BEGIN

  IMPORTING pp_walk_coherence[T]

  WalkMeasurements: TYPE =
    [# curvature: nonneg_real, endpoint_alignment: real_abs_le1 #]

  UntrustedWalkReport: TYPE = [# walk: Prewalk, reported: WalkMeasurements #]

  G, G1, G2: VAR Graph
  RR: VAR [T, T -> bool]
  invariant: VAR [T -> bool]
  pw: VAR Prewalk
  p: VAR UntrustedWalkReport
  bound: VAR nonneg_real
  coherence_floor: VAR real

  measurements_of(pw): WalkMeasurements =
    (# curvature := measured_curvature(coordinate_map, pw),
       endpoint_alignment := endpoint_coherence(coordinate_map, pw) #)

  report_matches_walk?(p): bool = p`reported = measurements_of(p`walk)

  BoundWalkReport: TYPE = {p: UntrustedWalkReport | report_matches_walk?(p)}

  observe_walk(pw): BoundWalkReport =
    (# walk := pw, reported := measurements_of(pw) #)

  accept_report?(G, RR, invariant, p, bound, coherence_floor): bool =
    report_matches_walk?(p) AND
    combined_certificate?(G, RR, invariant, coordinate_map, p`walk, bound, coherence_floor)

  accepted_report_sound: THEOREM
    accept_report?(G, RR, invariant, p, bound, coherence_floor) IMPLIES
      pp_path(G, RR, invariant, p`walk) AND p`walk`length >= 3 AND
      active_steps?(coordinate_map, p`walk) AND
      (FORALL (i: below(p`walk`length)): invariant(p`walk`seq(i))) AND
      p`reported`curvature = measured_curvature(coordinate_map, p`walk) AND
      p`reported`endpoint_alignment = endpoint_coherence(coordinate_map, p`walk) AND
      p`reported`curvature <= bound AND p`reported`endpoint_alignment > coherence_floor

  computed_report_accepted: THEOREM
    combined_certificate?(G, RR, invariant, coordinate_map, pw, bound, coherence_floor)
      IMPLIES accept_report?(G, RR, invariant, observe_walk(pw), bound, coherence_floor)

  accepted_report_preserved: THEOREM
    pp_transform(G1, G2, RR, invariant) AND
    accept_report?(G1, RR, invariant, p, bound, coherence_floor)
      IMPLIES accept_report?(G2, RR, invariant, p, bound, coherence_floor)

  forged_curvature_rejected: THEOREM
    p`reported`curvature /= measured_curvature(coordinate_map, p`walk)
      IMPLIES NOT accept_report?(G, RR, invariant, p, bound, coherence_floor)

  forged_coherence_rejected: THEOREM
    p`reported`endpoint_alignment /= endpoint_coherence(coordinate_map, p`walk)
      IMPLIES NOT accept_report?(G, RR, invariant, p, bound, coherence_floor)

END lie_pp_connection
