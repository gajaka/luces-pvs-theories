% Transport observations and repair under a fixed certificate specification.
%
% Regime paths and the PPG repair graph are different objects. Regime edges
% carry measured certificate data. PPG nodes are complete observation snapshots;
% a repair replaces one observation and preserves already certified edges.
% Correlation is a supplied measurement, not a proved Spearman implementation.
% The boolean fields are supplied certificate results; their extraction from
% raw transport couplings remains an independent implementation obligation.
%
% Background: Dragan Stosic, Proof-Preserving Graphs, 2026.

transport_ppg: THEORY
BEGIN

  Regime: TYPE = {NIGHT, DAWN, DAY, DUSK}

  CertificateData: TYPE =
    [# present: bool, duality: bool, vertex: bool, monge: bool,
       correlation: real #]

  Snapshot: TYPE =
    [# epoch: nat, data: [Regime, Regime -> CertificateData] #]

  IMPORTING ppg_core@directed_pp_graph[Snapshot] AS ppg

  s, before, after: VAR Snapshot
  x, y, u, v: VAR Regime
  candidate: VAR CertificateData
  K: VAR [Regime, Regime -> bool]

  rho_threshold: posreal = 99/100

  cycle_edge?(x, y): bool =
    (x = NIGHT AND y = DAWN) OR (x = DAWN AND y = DAY) OR
    (x = DAY AND y = DUSK) OR (x = DUSK AND y = NIGHT)

  candidate_certified?(candidate): bool =
    candidate`present AND candidate`duality AND candidate`vertex AND
    candidate`monge AND candidate`correlation > rho_threshold

  pp_transport_edge?(s, x, y): bool =
    cycle_edge?(x, y) AND candidate_certified?(s`data(x, y))

  isolated_edge?(s, x, y): bool =
    cycle_edge?(x, y) AND s`data(x, y)`present AND
    NOT pp_transport_edge?(s, x, y)

  repair_edge(s, u, v, candidate): Snapshot =
    s WITH [data := (LAMBDA (x, y: Regime):
      IF x = u AND y = v THEN candidate ELSE s`data(x, y) ENDIF)]

  protected?(K, s): bool =
    FORALL x, y: K(x, y) IMPLIES pp_transport_edge?(s, x, y)

  % The repair relation keeps provenance fixed. Actual directed operations
  % are described by repair_step?, separately from this equivalence relation.
  same_epoch?(before, after): bool = before`epoch = after`epoch

  same_epoch_equivalence: LEMMA
    (FORALL (a: Snapshot): same_epoch?(a, a)) AND
    (FORALL (a, b: Snapshot): same_epoch?(a, b) IMPLIES same_epoch?(b, a)) AND
    (FORALL (a, b, c: Snapshot):
      same_epoch?(a, b) AND same_epoch?(b, c) IMPLIES same_epoch?(a, c))

  repair_step?(before, after): bool =
    EXISTS (u, v: Regime, candidate: CertificateData):
      isolated_edge?(before, u, v) AND candidate_certified?(candidate) AND
      after = repair_edge(before, u, v, candidate)

  repair_graph(K): ppg.Graph =
    (# vertices := (LAMBDA (s: Snapshot): protected?(K, s)),
       edges := (LAMBDA (before, after: Snapshot):
         before /= after AND protected?(K, before) AND protected?(K, after)
         AND repair_step?(before, after)) #)

  thm_repair_frame: THEOREM
    x /= u OR y /= v IMPLIES
      repair_edge(s, u, v, candidate)`data(x, y) = s`data(x, y)

  thm_repair_restores_edge: THEOREM
    isolated_edge?(s, u, v) AND candidate_certified?(candidate) IMPLIES
      pp_transport_edge?(repair_edge(s, u, v, candidate), u, v)

  thm_certification_monotone: THEOREM
    candidate_certified?(candidate) AND pp_transport_edge?(s, x, y) IMPLIES
      pp_transport_edge?(repair_edge(s, u, v, candidate), x, y)

  thm_repair_changes_failed_edge: THEOREM
    isolated_edge?(s, u, v) AND candidate_certified?(candidate) IMPLIES
      repair_edge(s, u, v, candidate) /= s

  thm_dusk_isolation_local: THEOREM
    pp_transport_edge?(s, NIGHT, DAWN) IMPLIES
      pp_transport_edge?(repair_edge(s, DAY, DUSK, candidate), NIGHT, DAWN)

  repair_same_epoch: LEMMA same_epoch?(s, repair_edge(s, u, v, candidate))

  repair_preserves_protected: LEMMA
    candidate_certified?(candidate) AND protected?(K, s) IMPLIES
      protected?(K, repair_edge(s, u, v, candidate))

  thm_repair_is_pp_edge: THEOREM
    protected?(K, s) AND isolated_edge?(s, u, v) AND
    candidate_certified?(candidate) IMPLIES
      ppg.pp_edge(same_epoch?, LAMBDA (z: Snapshot): protected?(K, z),
                  s, repair_edge(s, u, v, candidate))

  thm_repair_graph_valid: THEOREM
    ppg.pp_valid(repair_graph(K), same_epoch?,
                 LAMBDA (z: Snapshot): protected?(K, z))

  reaches_in(s: Snapshot, x, y: Regime, n: nat): RECURSIVE bool =
    IF n = 0 THEN x = y ELSE
      EXISTS (middle: Regime):
        pp_transport_edge?(s, x, middle) AND reaches_in(s, middle, y, n - 1)
    ENDIF
    MEASURE n

  reachable?(s, x, y): bool = EXISTS (n: nat): reaches_in(s, x, y, n)

  % A broken directed cycle retains this certified prefix. It does not retain
  % all-pairs reachability: DAY has no outgoing certified edge when its link fails.
  thm_one_failure_reachable: THEOREM
    pp_transport_edge?(s, NIGHT, DAWN) AND
    pp_transport_edge?(s, DAWN, DAY) AND isolated_edge?(s, DAY, DUSK) IMPLIES
      reaches_in(s, NIGHT, DAY, 2)

  thm_broken_cycle_blocks: THEOREM
    NOT pp_transport_edge?(s, DAY, DUSK) IMPLIES
      NOT reachable?(s, DAY, DUSK)

  good_data: CertificateData =
    (# present := TRUE, duality := TRUE, vertex := TRUE, monge := TRUE,
       correlation := 1 #)

  bad_data: CertificateData = good_data WITH [monge := FALSE]

  initial: Snapshot =
    (# epoch := 0,
       data := (LAMBDA (x, y: Regime):
         IF x = DAY AND y = DUSK THEN bad_data ELSE good_data ENDIF) #)

  sunrise_protected(x, y): bool =
    (x = NIGHT AND y = DAWN) OR (x = DAWN AND y = DAY)

  % A concrete failed-to-certified transition witnesses satisfiable premises.
  thm_repair_witness: THEOREM
    isolated_edge?(initial, DAY, DUSK) AND
    pp_transport_edge?(repair_edge(initial, DAY, DUSK, good_data), DAY, DUSK) AND
    ppg.pp_edge(same_epoch?,
      LAMBDA (z: Snapshot): protected?(sunrise_protected, z),
      initial, repair_edge(initial, DAY, DUSK, good_data))

END transport_ppg
