% A finite cost-family example built from actual normalized couplings.
% The first two costs favor the identity assignment; the other two favor
% reversal. Every displayed plan is feasible, nonzero, optimal and exactly
% deterministic. Only the first pair preserves order on the source grid.
% This is an explicit mathematical witness, not a claim about four empirical
% ground metrics or a proof that every optimal coupling is an extreme point.
%
% The sparsity predicate is the calculated nnz bound, not extremality.
% Near-Monge uses the actual mass carried by the displayed assignment.
% Villani, Optimal Transport: Old and New (2009), Chapters 1 and 5.

transport_structure: THEORY
BEGIN

  IMPORTING monge_kantorovich_equivalence

  CostIndex: TYPE = below(4)
  k: VAR CostIndex
  P: VAR Plan
  T: VAR TransportMap
  i, j: VAR Bin

  identity_cost_class?(k): bool = k < 2

  reverse_map: TransportMap = LAMBDA (i: Bin): N-1-i

  witness_map(k): TransportMap = IF identity_cost_class?(k) THEN identity_map ELSE reverse_map ENDIF

  witness_plan(k): Plan = induced_plan(uniform, witness_map(k))

  witness_cost(k): Cost = LAMBDA (i,j: Bin):
    IF j = witness_map(k)(i) THEN 0 ELSIF k = 1 OR k = 3 THEN 2 ELSE 1 ENDIF

  mass_on_map(P, T): real = sigma[Bin](0,N-1,LAMBDA (i: Bin): P(i,T(i)))

  near_monge(P, T): bool = mass_on_map(P,T) > 93/100

  rank_preserving(T): bool = FORALL (i,j: Bin): i <= j IMPLIES T(i) <= T(j)

  reverse_compatible: LEMMA compatible_map?(uniform,uniform,reverse_map)

  witness_plan_feasible: THEOREM feasible?(uniform,uniform,witness_plan(k))

  witness_plan_zero_cost: LEMMA kant_cost(witness_cost(k),witness_plan(k)) = 0

  witness_plan_optimal: THEOREM optimal_plan?(witness_cost(k),uniform,uniform,witness_plan(k))

  mass_on_induced_uniform_map: LEMMA mass_on_map(induced_plan(uniform,T),T) = 1

  witness_plan_sparsity: THEOREM has_vertex_sparsity_bound?(witness_plan(k))

  identity_rank_preserving: LEMMA rank_preserving(identity_map)

  reverse_not_rank_preserving: LEMMA NOT rank_preserving(reverse_map)

  witness_rank_classification: THEOREM rank_preserving(witness_map(k)) IFF identity_cost_class?(k)

  finite_cost_family_certificate: THEOREM feasible?(uniform,uniform,witness_plan(k)) AND
    optimal_plan?(witness_cost(k),uniform,uniform,witness_plan(k)) AND
    has_vertex_sparsity_bound?(witness_plan(k)) AND near_monge(witness_plan(k),witness_map(k)) AND
    (rank_preserving(witness_map(k)) IFF identity_cost_class?(k))

  structure_without_rank: THEOREM has_vertex_sparsity_bound?(witness_plan(2)) AND
    near_monge(witness_plan(2),witness_map(2)) AND NOT rank_preserving(witness_map(2)) AND
    witness_plan(2)(0,witness_map(2)(0)) > 0

END transport_structure
