% Additive cost accounting for two segments of the same oriented path.
%
% Independent costs assigned to unrelated state pairs cannot justify a
% claim about one physical trajectory. Here the full cost is the sum of
% its two segment costs. Each segment has a nonnegative extra cost above
% its geodesic distance. Zero full excess therefore excludes positive
% segment excess. A small positive global ratio can coexist with a larger
% local ratio when that segment is short; the concrete example gives23%
% locally and4.6% globally. This is not an empirical assertion about a log.
% These are additive path-length costs, not an identification with a raw
% squared-cost Kantorovich objective.

 global_optimality[D: TYPE+]: THEORY
BEGIN

  IMPORTING wasserstein_metric[D]

  Run: TYPE = [# model: GeodesicModel, start, finish: D, split: UnitInterval,
    extra_first, extra_second: nonneg_real #]

  R: VAR Run

  mid(R): D = interp(R`model)(R`start, R`finish, R`split)

  first_distance(R): nonneg_real = distance(R`model)(R`start, mid(R))

  second_distance(R): nonneg_real = distance(R`model)(mid(R), R`finish)

  full_distance(R): nonneg_real = distance(R`model)(R`start, R`finish)

  first_cost(R): nonneg_real = first_distance(R) + R`extra_first

  second_cost(R): nonneg_real = second_distance(R) + R`extra_second

  physical_cost(R): nonneg_real = first_cost(R) + second_cost(R)

  full_gap(R): real = physical_cost(R) - full_distance(R)

  % Ratios are totalized by zero at zero reference distance. The weighted
  % ratio identity below requires strictly positive segment distances.
  first_ratio(R): nonneg_real = IF first_distance(R) > 0
    THEN R`extra_first / first_distance(R) ELSE 0 ENDIF

  second_ratio(R): nonneg_real = IF second_distance(R) > 0
    THEN R`extra_second / second_distance(R) ELSE 0 ENDIF

  full_ratio(R): nonneg_real = IF full_distance(R) > 0
    THEN (R`extra_first + R`extra_second) / full_distance(R) ELSE 0 ENDIF

  cost_gap_identity: THEOREM geodesic_laws?(R`model) IMPLIES
    full_gap(R) = R`extra_first + R`extra_second

  costs_geodesic_lower_bound: THEOREM geodesic_laws?(R`model) IMPLIES
    physical_cost(R) >= full_distance(R)

  individual_extra_bounds: THEOREM geodesic_laws?(R`model) IMPLIES
    R`extra_first <= full_gap(R) AND R`extra_second <= full_gap(R)

  zero_full_gap_no_segment_extras: THEOREM
    geodesic_laws?(R`model) AND full_gap(R) = 0 IMPLIES R`extra_first = 0 AND R`extra_second = 0

  weighted_ratio_identity: THEOREM geodesic_laws?(R`model) AND
    R`split > 0 AND R`split < 1 AND full_distance(R) > 0 IMPLIES
    full_ratio(R) = R`split*first_ratio(R) + (1-R`split)*second_ratio(R)

END global_optimality


global_optimality_example: THEORY
BEGIN

  IMPORTING global_optimality[real], wasserstein_real_model

  example_run: Run = (# model := real_model, start := 0, finish := 10, split := 1/5,
    extra_first := 23/50, extra_second := 0 #)

  example_valid: THEOREM geodesic_laws?(example_run`model)

  exact_segment_costs: THEOREM first_distance(example_run) = 2 AND
    second_distance(example_run) = 8 AND physical_cost(example_run) = 523/50

  exact_excess_ratios: THEOREM first_ratio(example_run) = 23/100 AND full_ratio(example_run) = 23/500

  thm_coexistence: THEOREM first_ratio(example_run) > 1/20 AND full_ratio(example_run) <= 1/20

END global_optimality_example
