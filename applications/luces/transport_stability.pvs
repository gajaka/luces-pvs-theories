% Exact finite rank stability, with no empirical Spearman axioms.
% Inputs are permutations of twenty distinct ranks; this formula does not
% implement tie correction for arbitrary raw transport-map outputs.
% Identity and a single adjacent swap are different maps with rho=664/665.
% Reversal has rho=-1, showing that persistence is not a universal property.
% These are constructed examples, not inferred measurements of boot291/293
% and not a theorem about a controller's physical learnability.

transport_stability: THEORY
BEGIN

  RankCount: posnat = 20
  Bin: TYPE = below(RankCount)
  IMPORTING reals@sigma_below[RankCount], reals@sq

  RankMap: TYPE = {T: [Bin -> Bin] | injective?(T)}
  T, U: VAR RankMap
  tolerance, threshold: VAR real

  squared_rank_distance(T,U): nonneg_real =
    sigma[Bin](0,RankCount-1,LAMBDA (i: Bin): sq(T(i)-U(i)))

  spearman_rho(T,U): real = 1 - 6*squared_rank_distance(T,U)/(RankCount*(RankCount*RankCount-1))

  rho_reflexive: THEOREM spearman_rho(T,T) = 1

  rho_symmetric: THEOREM spearman_rho(T,U) = spearman_rho(U,T)

  rho_upper_bound: THEOREM spearman_rho(T,U) <= 1

  identity_map: RankMap = LAMBDA (i: Bin): i

  adjacent_swap: RankMap = LAMBDA (i: Bin): IF i = 0 THEN 1 ELSIF i = 1 THEN 0 ELSE i ENDIF

  reverse_map: RankMap = LAMBDA (i: Bin): RankCount-1-i

  adjacent_swap_distance: LEMMA squared_rank_distance(identity_map,adjacent_swap) = 2

  adjacent_swap_rho: THEOREM spearman_rho(identity_map,adjacent_swap) = 664/665

  reverse_rho: THEOREM spearman_rho(identity_map,reverse_map) = -1

  BootIndex: TYPE = below(2)

  example_maps(k: BootIndex): RankMap = IF k = 0 THEN identity_map ELSE adjacent_swap ENDIF

  map_persistent?(threshold): bool =
    FORALL (k1,k2: BootIndex): spearman_rho(example_maps(k1),example_maps(k2)) > threshold

  reference_agreement?(T,tolerance): bool =
    FORALL (k: BootIndex): spearman_rho(example_maps(k),T) > 1-tolerance

  finite_example_persistent: THEOREM map_persistent?(99/100)

  finite_example_reference: THEOREM reference_agreement?(identity_map,1/100)

  finite_stability_certificate: THEOREM map_persistent?(99/100) AND
    reference_agreement?(identity_map,1/100) AND example_maps(0)(0) /= example_maps(1)(0)

  persistence_is_not_universal: THEOREM spearman_rho(identity_map,reverse_map) < 99/100

END transport_stability
