% Arithmetic checks on the conditioning values recorded in the original
% LUCES case study: passive28.7, hybrid6.5 and excited2.8.
% These entered values are data, not a theorem about every mixed Fisher
% matrix. Their provenance and the numerical estimation are not proved here.

hybrid_observability: THEORY
BEGIN

  kappa_passive: posreal = 287/10

  kappa_hybrid: posreal = 65/10

  kappa_excited: posreal = 28/10

  thm_excitation_improves: THEOREM kappa_excited < kappa_passive

  thm_hybrid_intermediate: THEOREM
    kappa_excited < kappa_hybrid AND kappa_hybrid < kappa_passive

  diagonal_condition(a, b: posreal): real = max(a, b) / min(a, b)

  % Mixing diag(1,100) with diag(100,1) equally gives (101/2)I.
  % Its condition number1 lies below both endpoint condition numbers100.
  mixing_need_not_be_intermediate: THEOREM
    diagonal_condition(1, 100) = 100 AND diagonal_condition(100, 1) = 100 AND
    diagonal_condition(101/2, 101/2) = 1

END hybrid_observability
