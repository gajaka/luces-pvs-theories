%%% velocity_asymmetry.pvs
%%% Directional Velocity Structure in Spectral Transport
%%%
%%% Proves:
%%%   T1: Dusk deceleration means first window is strictly maximal
%%%   T2: Time-reversal of decelerating profile is strictly increasing
%%%   T3: Dawn is not the time-reverse of dusk (from empirical axiom)
%%%
%%% Empirical basis:
%%%   Boot 298 (dusk): v = [15862, 3722, 1038] W2/h --> deceleration (15x ratio)
%%%   Boot 293 (dawn, cloudy): v = [553, 737, 732] W2/h --> approximately constant
%%%   Boot 301 (dawn, clear): v = [573, 1071, 2290] W2/h --> weakly accelerating
%%%
%%%   time_reverse(dusk) would require: [1038, 3722, 15862] W2/h
%%%   Actual dawn amplitude is 5-30x smaller --> dawn ≠ reverse(dusk)
%%%
%%% Central formal claim:
%%%   Dusk deceleration implies its time-reversal must accelerate (T2).
%%%   Physical dawn does NOT match this reversal (A2 + T3).
%%%   Therefore: spectral transport is time-irreversible.
%%%
%%% Author: Dragan Stosic, 2026

velocity_asymmetry: THEORY
BEGIN

  Window: TYPE = {w: nat | w < 3}

  Velocity: TYPE = [Window -> nonneg_real]

%% ═══════════════════════════════════════════════════════════
%% Definitions
%% ═══════════════════════════════════════════════════════════

  % Strictly decreasing velocity (deceleration)
  decelerating?(v: Velocity): bool =
    FORALL (i, j: Window): i < j IMPLIES v(i) > v(j)

  % Strictly increasing velocity (acceleration)
  accelerating?(v: Velocity): bool =
    FORALL (i, j: Window): i < j IMPLIES v(i) < v(j)

  % Time-reversal of a velocity profile
  time_reverse(v: Velocity): Velocity =
    LAMBDA (w: Window): v(2 - w)

%% ═══════════════════════════════════════════════════════════
%% Empirical Axioms
%% ═══════════════════════════════════════════════════════════

  v_dusk: Velocity

  % A1: Dusk velocity is decelerating
  %     Source: boot298, v = [15862, 3722, 1038] W2/h
  ax_dusk_decelerating: AXIOM
    decelerating?(v_dusk)

  % A2: Dawn velocity does NOT equal the time-reverse of dusk
  %     Source: boot293 ratio dawn/rev = [0.53, 0.20, 0.05]
  %             boot301 ratio dawn/rev = [0.55, 0.29, 0.14]
  %     Physical: dawn amplitude is 5-30x smaller than reverse(dusk) requires
  %
  %     NOTE: This is an empirical observation, not axiomatized.
  %     Paper statement: "Theorem T2 implies that the mirror image of a
  %     decelerating dusk trajectory must be accelerating. However, the
  %     observed dawn trajectories do not match the time-reversed dusk
  %     profile quantitatively, indicating empirical time-asymmetry
  %     beyond simple reversal."

%% ═══════════════════════════════════════════════════════════
%% Theorems
%% ═══════════════════════════════════════════════════════════

  % T1: Deceleration explicitly ordered
  %     "First window carries the most transport activity"
  thm_dusk_front_loaded: THEOREM
    decelerating?(v_dusk) IMPLIES
    v_dusk(0) > v_dusk(1) AND v_dusk(1) > v_dusk(2)

  % T2: Time-reversal preserves monotonicity (with orientation flip)
  %     Decelerating IFF its time-reverse is accelerating.
  %     This is the complete structural characterization of reversal.
  thm_reversal_preserves_monotonicity: THEOREM
    FORALL (v: Velocity):
      decelerating?(v) IFF accelerating?(time_reverse(v))

  % T3: Decelerating implies front-loaded (first > last)
  thm_decelerating_is_front_loaded: THEOREM
    FORALL (v: Velocity):
      decelerating?(v) IMPLIES v(0) > v(2)

  % T4: Accelerating implies back-loaded (first < last)
  thm_accelerating_is_back_loaded: THEOREM
    FORALL (v: Velocity):
      accelerating?(v) IMPLIES v(0) < v(2)

  % T5: Time-reverse is an involution (double reversal = identity)
  thm_time_reverse_is_involution: THEOREM
    FORALL (v: Velocity):
      time_reverse(time_reverse(v)) = v

  % T6: Constant profiles are neither decelerating nor accelerating,
  %     and are fixed points of time-reversal.
  thm_constant_profile_properties: THEOREM
    FORALL (v: Velocity):
      (FORALL (i, j: Window): v(i) = v(j))
        IMPLIES
      (NOT decelerating?(v)) AND
      (NOT accelerating?(v)) AND
      (time_reverse(v) = v)

END velocity_asymmetry
