% Stability of a finite map selector under a checked objective-gap certificate.
%
% Villani (2009), Theorem5.20, concerns analytic stability of optimal plans;
% it does not supply the former universal discrete map-distance bound.
% Here a concrete finite argmin algorithm is used. A positive gap and a
% pointwise objective perturbation smaller than half that gap preserve the
% selected candidate, and hence its complete map. Relating changes in
% measured distributions to this objective bound remains a separate task.

stability_of_maps: THEORY
BEGIN

  IMPORTING structures@max_array_def[10, real, >=]

  Candidate: TYPE = below(10)

  Bin: TYPE = below(10)

  TransportMap: TYPE = [Bin -> Bin]

  Bank: TYPE = [Candidate -> TransportMap]

  Objective: TYPE = [Candidate -> real]

  f, g, h: VAR Objective
  winner, c: VAR Candidate
  gap: VAR posreal
  eps, eps1, eps2: VAR nonneg_real
  bank: VAR Bank

  % Reversing the comparison in imax_rec gives a constructive minimum.
  argmin(f): Candidate = imax_rec(f,0,9)

  selected_map(bank,f): TransportMap = bank(argmin(f))

  minimizes?(f,winner): bool = FORALL (c: Candidate): f(winner) <= f(c)

  gap_certified?(f,winner,gap): bool = FORALL (c: Candidate): c /= winner
    IMPLIES f(winner)+gap <= f(c)

  perturbation_bounded?(f,g,eps): bool = FORALL (c: Candidate): abs(g(c)-f(c)) <= eps

  argmin_optimal: THEOREM minimizes?(f,argmin(f))

  gap_survives_perturbation: THEOREM gap_certified?(f,winner,gap) AND
    perturbation_bounded?(f,g,eps) IMPLIES
      FORALL (c: Candidate): c /= winner IMPLIES g(winner)+gap-2*eps <= g(c)

  stable_argmin: THEOREM gap_certified?(f,winner,gap) AND perturbation_bounded?(f,g,eps) AND
    2*eps < gap IMPLIES argmin(g) = winner

  stable_selected_map: THEOREM gap_certified?(f,winner,gap) AND perturbation_bounded?(f,g,eps) AND
    2*eps < gap IMPLIES selected_map(bank,f) = selected_map(bank,g)

  perturbation_triangle: THEOREM perturbation_bounded?(f,g,eps1) AND
    perturbation_bounded?(g,h,eps2) IMPLIES perturbation_bounded?(f,h,eps1+eps2)

  two_step_argmin_stable: THEOREM gap_certified?(f,winner,gap) AND
    perturbation_bounded?(f,g,eps1) AND perturbation_bounded?(g,h,eps2) AND 2*(eps1+eps2) < gap
      IMPLIES argmin(h) = winner

  before_objective: Objective = LAMBDA (c: Candidate): IF c = 0 THEN 0 ELSE 2 ENDIF

  close_objective: Objective = LAMBDA (c: Candidate): IF c = 0 THEN 1/4 ELSE 7/4 ENDIF

  changed_objective: Objective = LAMBDA (c: Candidate): IF c = 0 THEN 5/4 ELSE 3/4 ENDIF

  candidate_bank: Bank = LAMBDA (c: Candidate): LAMBDA (b: Bin): c

  example_gap: THEOREM gap_certified?(before_objective,0,2)

  example_close: THEOREM perturbation_bounded?(before_objective,close_objective,1/4)

  example_stable_map: THEOREM selected_map(candidate_bank,before_objective) =
    selected_map(candidate_bank,close_objective)

  example_large_change: THEOREM argmin(before_objective) = 0 AND argmin(changed_objective) = 1 AND
    selected_map(candidate_bank,before_objective) /= selected_map(candidate_bank,changed_objective)

END stability_of_maps
