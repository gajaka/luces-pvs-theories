% Every active sampled walk satisfies a lower bound from its endpoint angle.
% The length maximum includes precisely the denominators of the N-2 local
% curvature terms: steps 0 through N-3, excluding the final observed step.
% No equal-length, planar or monotone-turning condition is required.
%
% Author: Dragan Stosic, 2026.

pp_walk_curvature_bound[T: TYPE+]: THEORY
BEGIN

  IMPORTING pp_walk_coherence[T], unit_spherical_angle

  coordinate_map: VAR SampleMap
  pw: VAR Prewalk
  i, n: VAR nat
  L: VAR posreal

  turn_angle(coordinate_map, pw, i): nnreal_le_pi =
    vector_angle(unit_delta(coordinate_map, pw, i), unit_delta(coordinate_map, pw, i+1))

  turn_prefix(coordinate_map, pw, n): RECURSIVE nonneg_real =
    IF n = 0 THEN 0 ELSE turn_prefix(coordinate_map, pw, n-1) + turn_angle(coordinate_map, pw, n-1) ENDIF
    MEASURE n

  length_max_prefix(coordinate_map, pw, n): RECURSIVE nonneg_real =
    IF n = 0 THEN 0 ELSE max(length_max_prefix(coordinate_map, pw, n-1), step_length(coordinate_map, pw, n-1)) ENDIF
    MEASURE n

  curvature_lmax(coordinate_map, pw): nonneg_real =
    IF pw`length >= 3 THEN length_max_prefix(coordinate_map, pw, pw`length-2) ELSE 0 ENDIF

  curvature_steps_bounded?(coordinate_map, pw, L): bool =
    FORALL (i: nat): i+2 < pw`length IMPLIES step_length(coordinate_map, pw, i) <= L

  active_step_positive: LEMMA active_steps?(coordinate_map, pw) AND i+1 < pw`length IMPLIES
    step_length(coordinate_map, pw, i) > step_cutoff

  active_unit_direction: LEMMA active_steps?(coordinate_map, pw) AND i+1 < pw`length IMPLIES
    sphere_unit?(unit_delta(coordinate_map, pw, i))

  actual_angle_bridge: LEMMA
    vector_angle(unit_delta(coordinate_map, pw, i), unit_delta(coordinate_map, pw, n)) =
      acos(clip_cosine(unit_delta(coordinate_map, pw, i) * unit_delta(coordinate_map, pw, n)))

  active_curvature_term: LEMMA active_steps?(coordinate_map, pw) AND i+2 < pw`length IMPLIES
    curvature_term(coordinate_map, pw, i) = turn_angle(coordinate_map, pw, i)/step_length(coordinate_map, pw, i)

  endpoint_prefix_angle: LEMMA active_steps?(coordinate_map, pw) AND n+1 < pw`length IMPLIES
    vector_angle(unit_delta(coordinate_map, pw, 0), unit_delta(coordinate_map, pw, n)) <= turn_prefix(coordinate_map, pw, n)

  endpoint_angle_le_turn_sum: THEOREM pw`length >= 3 AND active_steps?(coordinate_map, pw) IMPLIES
    acos(endpoint_coherence(coordinate_map, pw)) <= turn_prefix(coordinate_map, pw, pw`length-2)

  weighted_term_lower_bound: LEMMA active_steps?(coordinate_map, pw) AND i+2 < pw`length AND
    step_length(coordinate_map, pw, i) <= L IMPLIES turn_angle(coordinate_map, pw, i)/L <= curvature_term(coordinate_map, pw, i)

  bounded_step_at: LEMMA curvature_steps_bounded?(coordinate_map, pw, L) AND i+2 < pw`length IMPLIES
    step_length(coordinate_map, pw, i) <= L

  weighted_prefix_lower_bound: LEMMA active_steps?(coordinate_map, pw) AND
    curvature_steps_bounded?(coordinate_map, pw, L) AND n <= pw`length-2 IMPLIES
      turn_prefix(coordinate_map, pw, n)/L <= curvature_prefix(coordinate_map, pw, n)

  universal_curvature_bound_with_upper: THEOREM pw`length >= 3 AND active_steps?(coordinate_map, pw) AND
    curvature_steps_bounded?(coordinate_map, pw, L) IMPLIES
      acos(endpoint_coherence(coordinate_map, pw))/((pw`length-2)*L) <= measured_curvature(coordinate_map, pw)

  length_max_prefix_bounds: LEMMA i < n IMPLIES
    step_length(coordinate_map, pw, i) <= length_max_prefix(coordinate_map, pw, n)

  curvature_lmax_positive: LEMMA pw`length >= 3 AND active_steps?(coordinate_map, pw) IMPLIES
    curvature_lmax(coordinate_map, pw) > step_cutoff

  curvature_lmax_bounds: LEMMA pw`length >= 3 AND i+2 < pw`length IMPLIES
    step_length(coordinate_map, pw, i) <= curvature_lmax(coordinate_map, pw)

  universal_curvature_lower_bound: THEOREM pw`length >= 3 AND active_steps?(coordinate_map, pw) IMPLIES
    acos(endpoint_coherence(coordinate_map, pw))/((pw`length-2)*curvature_lmax(coordinate_map, pw)) <=
      measured_curvature(coordinate_map, pw)

END pp_walk_curvature_bound

% The final observed step is twice as long as the two denominators. The bound
% is nevertheless tight, which also checks that Lmax excludes that final step.
pp_walk_curvature_bound_example: THEORY
BEGIN

  IMPORTING pp_walk_curvature_bound[below(5)], pp_walk_coherence_example

  low_denominator_maximum: THEOREM
    curvature_lmax(sample_coordinates, low_walk) = small_length AND
    step_length(sample_coordinates, low_walk, 2) = 2*curvature_lmax(sample_coordinates, low_walk)

  tight_unequal_step_example: THEOREM
    pp_path(common_graph, common_rr, spectrum_invariant, low_walk) AND
    active_steps?(sample_coordinates, low_walk) AND
    measured_curvature(sample_coordinates, low_walk) =
      acos(endpoint_coherence(sample_coordinates, low_walk))/
        ((low_walk`length-2)*curvature_lmax(sample_coordinates, low_walk)) AND
    measured_curvature(sample_coordinates, low_walk) > 0

END pp_walk_curvature_bound_example
