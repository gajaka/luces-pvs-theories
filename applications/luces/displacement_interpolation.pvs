% Consequences of a supplied metric-geodesic model.
% Wasserstein applications require a separate proof that the concrete
% interpolation and distance satisfy the imported model laws. Endpoint
% consistency and full constant speed do not imply uniqueness of geodesics.
% The imported real-line construction witnesses these assumptions.

 displacement_interpolation[D: TYPE+]: THEORY
BEGIN

  IMPORTING wasserstein_metric[D]

  M: VAR GeodesicModel
  p, q: VAR D
  t, t1, t2: VAR UnitInterval

  thm_complementary_distance: THEOREM geodesic_laws?(M) IMPLIES
    distance(M)(interp(M)(p,q,t),q) = (1-t)*distance(M)(p,q)

  % Additivity is the imported thm_geodesic_additive, not a second proof.
  thm_position_monotone: THEOREM geodesic_laws?(M) AND t1 < t2 AND distance(M)(p,q) > 0
    IMPLIES distance(M)(p,interp(M)(p,q,t1)) < distance(M)(p,interp(M)(p,q,t2))

  thm_midpoint_balanced: THEOREM geodesic_laws?(M) IMPLIES
    distance(M)(p,interp(M)(p,q,1/2)) = distance(M)(interp(M)(p,q,1/2),q)

  thm_degenerate_geodesic: THEOREM geodesic_laws?(M) AND distance(M)(p,q) = 0
    IMPLIES interp(M)(p,q,t) = p

END displacement_interpolation
