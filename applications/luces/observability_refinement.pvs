% A constructive finite maximum gives the sensitivity-to-cutoff margin.
% One channel's response ratio does not prove independence: two entire
% profiles can be proportional. The explicit proportional table below is a
% counterexample. Independence can instead be checked by a nonzero minor.

observability_refinement: THEORY
BEGIN

  IMPORTING observability_geometry, structures@max_array_def[10, nonneg_real, <=]

  E: VAR Experiment
  e: VAR Excitation
  ch: VAR Channel
  k: VAR posreal

  snr(E,e,ch): nonneg_real = response(E)(e,ch) / cutoff(E)

  best_channel(E,e): Channel = imax_rec(LAMBDA (ch: Channel): snr(E,e,ch), 0, 9)

  margin(E,e): nonneg_real = snr(E,e,best_channel(E,e))

  lem_snr_responsive_equiv: LEMMA responsive(E,e,ch) IFF snr(E,e,ch) > 1

  margin_upper_bound: THEOREM snr(E,e,ch) <= margin(E,e)

  margin_attained: THEOREM EXISTS (ch: Channel): snr(E,e,ch) = margin(E,e)

  thm_margin_implies_observable: THEOREM margin(E,e) > 1 IMPLIES spectral_observable(E,e)

  thm_margin_robustness: THEOREM margin(E,e) > k AND k >= 1 IMPLIES
    EXISTS (ch: Channel): response(E)(e,ch) > k*cutoff(E)

  discrimination(E,ch): nonneg_real = IF response(E)(brightness,ch) > 0
    THEN response(E)(cct,ch) / response(E)(brightness,ch) ELSE 0 ENDIF

  proportional_experiment: Experiment = synthetic_experiment WITH
    [response := LAMBDA (e: Excitation, ch: Channel): IF e = brightness THEN 1 ELSE 2 ENDIF,
     cutoff := 1/2]

  single_ratio_does_not_prove_rank: THEOREM
    discrimination(proportional_experiment,0) = 2 AND
    spectral_observable(proportional_experiment,brightness) AND
    spectral_observable(proportional_experiment,cct) AND NOT rank_condition?(proportional_experiment)

  synthetic_margins: THEOREM margin(synthetic_experiment,brightness) = 2 AND margin(synthetic_experiment,cct) = 3

END observability_refinement
