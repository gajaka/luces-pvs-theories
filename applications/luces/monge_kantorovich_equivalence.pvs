% Finite transport over ten spectral bins.
%
% A feasible plan has normalized source and target marginals. Optimization
% ranges over this feasible set, never over arbitrary nonnegative matrices.
% A map is compared with plans only when its push-forward is the target.
% Discrete maps need not exist for an arbitrary pair of distributions.
%
% Villani, Optimal Transport: Old and New (2009), Chapters 1 and 10.
% The continuous Monge existence theorem is not asserted for this model.

monge_kantorovich_equivalence: THEORY
BEGIN

  N: posnat = 10

  Bin: TYPE = below(N)

  IMPORTING reals@sigma_below[N]

  Mass: TYPE = [Bin -> nonneg_real]

  Plan: TYPE = [Bin, Bin -> nonneg_real]

  TransportMap: TYPE = [Bin -> Bin]

  Cost: TYPE = [Bin, Bin -> nonneg_real]

  mu, nu: VAR Mass
  P, Q: VAR Plan
  T: VAR TransportMap
  cost: VAR Cost
  i, j, k: VAR Bin
  value: VAR nonneg_real

  probability?(mu): bool = sigma[Bin](0, N-1, mu) = 1

  full_support?(mu): bool = FORALL (i: Bin): mu(i) > 0

  row_mass(P, i): real = sigma[Bin](0, N-1, LAMBDA (j: Bin): P(i, j))

  col_mass(P, j): real = sigma[Bin](0, N-1, LAMBDA (i: Bin): P(i, j))

  feasible?(mu, nu, P): bool =
    probability?(mu) AND probability?(nu) AND
    (FORALL (i: Bin): row_mass(P, i) = mu(i)) AND
    (FORALL (j: Bin): col_mass(P, j) = nu(j))

  induced_plan(mu, T): Plan =
    LAMBDA (i, j: Bin): IF j = T(i) THEN mu(i) ELSE 0 ENDIF

  compatible_map?(mu, nu, T): bool =
    probability?(mu) AND probability?(nu) AND
    (FORALL (j: Bin): col_mass(induced_plan(mu, T), j) = nu(j))

  monge_cost(cost, mu, T): real =
    sigma[Bin](0, N-1, LAMBDA (i: Bin): cost(i, T(i)) * mu(i))

  kant_cost(cost, P): real =
    sigma[Bin](0, N-1, LAMBDA (i: Bin):
      sigma[Bin](0, N-1, LAMBDA (j: Bin): cost(i, j) * P(i, j)))

  optimal_plan?(cost, mu, nu, P): bool =
    feasible?(mu, nu, P) AND
    (FORALL (Q: Plan): feasible?(mu, nu, Q) IMPLIES kant_cost(cost, P) <= kant_cost(cost, Q))

  optimal_map?(cost, mu, nu, T): bool =
    compatible_map?(mu, nu, T) AND
    (FORALL (U: TransportMap): compatible_map?(mu, nu, U)
      IMPLIES monge_cost(cost, mu, T) <= monge_cost(cost, mu, U))

  row_nnz(P, i): nat =
    sigma[Bin](0, N-1, LAMBDA (j: Bin): IF P(i, j) > 0 THEN 1 ELSE 0 ENDIF)

  nnz(P): nat = sigma[Bin](0, N-1, LAMBDA (i: Bin): row_nnz(P, i))

  % This is a sparsity bound, not a definition of an extreme point.
  has_vertex_sparsity_bound?(P): bool = nnz(P) <= 2 * N - 1

  sigma_singleton: LEMMA
    sigma[Bin](0, N-1, LAMBDA (j: Bin): IF j = k THEN value ELSE 0 ENDIF) = value

  induced_row_mass: LEMMA row_mass(induced_plan(mu, T), i) = mu(i)

  induced_row_cost: LEMMA
    sigma[Bin](0, N-1, LAMBDA (j: Bin): cost(i, j) * induced_plan(mu, T)(i, j)) =
      cost(i, T(i)) * mu(i)

  identity_col_mass: LEMMA
    col_mass(induced_plan(mu, LAMBDA (i: Bin): i), j) = mu(j)

  thm_induced_cost: THEOREM
    kant_cost(cost, induced_plan(mu, T)) = monge_cost(cost, mu, T)

  thm_induced_feasible: THEOREM
    compatible_map?(mu, nu, T) IMPLIES feasible?(mu, nu, induced_plan(mu, T))

  thm_relaxation_tighter: THEOREM
    optimal_plan?(cost, mu, nu, P) AND compatible_map?(mu, nu, T)
      IMPLIES kant_cost(cost, P) <= kant_cost(cost, induced_plan(mu, T))

  thm_relaxation_value: THEOREM
    optimal_plan?(cost, mu, nu, P) AND compatible_map?(mu, nu, T)
      IMPLIES kant_cost(cost, P) <= monge_cost(cost, mu, T)

  induced_row_nnz: LEMMA
    row_nnz(induced_plan(mu, T), i) = IF mu(i) > 0 THEN 1 ELSE 0 ENDIF

  induced_nnz_bound: THEOREM nnz(induced_plan(mu, T)) <= N

  induced_nnz_full_support: THEOREM
    full_support?(mu) IMPLIES nnz(induced_plan(mu, T)) = N

  thm_induced_sparsity: THEOREM has_vertex_sparsity_bound?(induced_plan(mu, T))

  kant_cost_nonneg: LEMMA kant_cost(cost, P) >= 0

  zero_plan: Plan = LAMBDA (i, j: Bin): 0

  zero_plan_not_feasible: THEOREM NOT feasible?(mu, nu, zero_plan)

  % A nonzero feasible optimal instance: the uniform distribution is
  % transported to itself by the identity map, with zero diagonal cost.
  uniform: Mass = LAMBDA (i: Bin): 1 / N

  identity_map: TransportMap = LAMBDA (i: Bin): i

  diagonal_cost: Cost = LAMBDA (i, j: Bin): IF i = j THEN 0 ELSE 1 ENDIF

  diagonal_plan: Plan = induced_plan(uniform, identity_map)

  uniform_probability: LEMMA probability?(uniform)

  identity_compatible: LEMMA compatible_map?(uniform, uniform, identity_map)

  diagonal_plan_feasible: THEOREM feasible?(uniform, uniform, diagonal_plan)

  diagonal_plan_zero_cost: LEMMA kant_cost(diagonal_cost, diagonal_plan) = 0

  diagonal_plan_optimal: THEOREM optimal_plan?(diagonal_cost, uniform, uniform, diagonal_plan)

  diagonal_plan_nonzero: THEOREM diagonal_plan(0, 0) = 1 / N AND diagonal_plan(0, 0) > 0

END monge_kantorovich_equivalence
