% Metric geodesics and a convex energy: an explicit model interface.
%
% Villani, Optimal Transport: Old and New (2009), Chapters 6,7 and17,
% motivate the intended Wasserstein application. The contract below does
% not construct probability measures or prove that a supplied distance is
% W2. The real-line instance implements every operation and proves every
% law, with squared energy. It is not a Shannon-entropy model.

wasserstein_metric[D: TYPE+]: THEORY
BEGIN

  UnitInterval: TYPE = {t: real | 0 <= t AND t <= 1}

  GeodesicModel: TYPE = [#
    distance: [D, D -> nonneg_real],
    interp: [D, D, UnitInterval -> D],
    energy: [D -> real]
  #]

  M: VAR GeodesicModel
  p, q, r: VAR D
  s, t: VAR UnitInterval

  metric_laws?(M): bool =
    (FORALL (p, q: D): distance(M)(p,q) = 0 IFF p = q) AND
    (FORALL (p, q: D): distance(M)(p,q) = distance(M)(q,p)) AND
    (FORALL (p, q, r: D): distance(M)(p,r) <= distance(M)(p,q) + distance(M)(q,r))

  geodesic_laws?(M): bool = metric_laws?(M) AND
    (FORALL (p, q: D): interp(M)(p,q,0) = p AND interp(M)(p,q,1) = q) AND
    (FORALL (p, q: D, s, t: UnitInterval):
      distance(M)(interp(M)(p,q,s), interp(M)(p,q,t)) = abs(t-s)*distance(M)(p,q)) AND
    (FORALL (p, q: D, t: UnitInterval):
      energy(M)(interp(M)(p,q,t)) <= (1-t)*energy(M)(p) + t*energy(M)(q))

  endpoint_distances: THEOREM geodesic_laws?(M) IMPLIES
    distance(M)(p,interp(M)(p,q,t)) = t*distance(M)(p,q) AND
    distance(M)(interp(M)(p,q,t),q) = (1-t)*distance(M)(p,q)

  thm_subpath_bound: THEOREM metric_laws?(M) IMPLIES
    distance(M)(p,q) <= distance(M)(p,r) + distance(M)(r,q)

  thm_geodesic_additive: THEOREM geodesic_laws?(M) IMPLIES
    distance(M)(p,q) = distance(M)(p,interp(M)(p,q,t)) + distance(M)(interp(M)(p,q,t),q)

  thm_midpoint_equidistant: THEOREM geodesic_laws?(M) IMPLIES
    distance(M)(p,interp(M)(p,q,1/2)) = distance(M)(p,q)/2

  thm_energy_bounded_on_geodesic: THEOREM geodesic_laws?(M) IMPLIES
    energy(M)(interp(M)(p,q,t)) <= (1-t)*energy(M)(p) + t*energy(M)(q)

  thm_separation: THEOREM metric_laws?(M) AND p /= q IMPLIES distance(M)(p,q) > 0

END wasserstein_metric


wasserstein_real_model: THEORY
BEGIN

  IMPORTING wasserstein_metric[real], reals@sq

  x, y: VAR real
  s, t: VAR UnitInterval

  real_distance: [real, real -> nonneg_real] = LAMBDA (x,y: real): abs(x-y)

  real_interp: [real, real, UnitInterval -> real] = LAMBDA (x,y: real, t: UnitInterval): (1-t)*x+t*y

  real_model: GeodesicModel =
    (# distance := real_distance, interp := real_interp, energy := LAMBDA (x: real): sq(x) #)

  affine_energy_gap: LEMMA
    (1-t)*sq(x)+t*sq(y)-sq((1-t)*x+t*y) = t*(1-t)*sq(x-y)

  affine_energy_convex: THEOREM sq((1-t)*x+t*y) <= (1-t)*sq(x)+t*sq(y)

  real_metric_laws: THEOREM metric_laws?(real_model)

  real_endpoints: LEMMA FORALL (x,y: real):
    interp(real_model)(x,y,0) = x AND interp(real_model)(x,y,1) = y

  real_constant_speed: LEMMA FORALL (x,y: real, s,t: UnitInterval):
    distance(real_model)(interp(real_model)(x,y,s),interp(real_model)(x,y,t)) =
      abs(t-s)*distance(real_model)(x,y)

  real_geodesic_laws: THEOREM geodesic_laws?(real_model)

  nondegenerate_example: THEOREM
    distance(real_model)(0,2) = 2 AND interp(real_model)(0,2,1/2) = 1 AND
    energy(real_model)(1) < (energy(real_model)(0)+energy(real_model)(2))/2

END wasserstein_real_model
