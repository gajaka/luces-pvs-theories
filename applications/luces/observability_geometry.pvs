% Controlled-excitation sensitivity, not a raw-channel signal proxy.
% Responses and the positive detection cutoff are explicit experiment data.
% Theorems apply to checked response witnesses; none assumes that all night
% or overlap states are observable. A nonzero2x2 minor is derived from the
% two opposing strict channel preferences. The concrete table below is a
% synthetic consistency witness, not a reconstruction of a measured boot.
% The original reports give brightness r=0.829 over1028samples (boot279)
% and CCT r=0.876 over726samples (boot281). Those summaries do not supply
% the complete controlled-response table needed to instantiate this model.

observability_geometry: THEORY
BEGIN

  IMPORTING interval_arith@allen_interval

  Channel: TYPE = below(10)

  Excitation: TYPE = {brightness, cct}

  Experiment: TYPE = [# response: [Excitation, Channel -> nonneg_real],
    cutoff: posreal, lux: nonneg_real,
    night_regime, spectral_active, intensity_recovery: StrictInterval #]

  E: VAR Experiment
  e: VAR Excitation
  ch, cb, cc: VAR Channel

  responsive(E,e,ch): bool = response(E)(e,ch) > cutoff(E)

  intensity_observable(E): bool = lux(E) > 0

  spectral_observable(E,e): bool = EXISTS (ch: Channel): responsive(E,e,ch)

  globally_unobservable(E): bool = NOT intensity_observable(E) AND
    NOT spectral_observable(E,brightness) AND NOT spectral_observable(E,cct)

  dominant_pair?(E,cb,cc): bool = cb /= cc AND
    responsive(E,brightness,cb) AND responsive(E,cct,cc) AND
    response(E)(brightness,cb) > response(E)(cct,cb) AND
    response(E)(cct,cc) > response(E)(brightness,cc)

  has_controlled_witness?(E): bool = EXISTS (cb,cc: Channel): dominant_pair?(E,cb,cc)

  rank_condition?(E): bool = EXISTS (cb,cc: Channel): cb /= cc AND
    response(E)(brightness,cb)*response(E)(cct,cc) /=
      response(E)(brightness,cc)*response(E)(cct,cb)

  temporal_stratified?(E): bool = during(spectral_active(E),night_regime(E)) AND
    spectral_active(E) < intensity_recovery(E)

  night_experiment?(E): bool = lux(E) = 0 AND has_controlled_witness?(E) AND temporal_stratified?(E)

  b0, c0, b1, c1: VAR nonneg_real

  crossed_product_separation: LEMMA b0 > c0 AND c1 > b1 IMPLIES b0*c1 > b1*c0

  thm_local_not_global: THEOREM NOT intensity_observable(E) AND spectral_observable(E,brightness)
    IMPLIES NOT globally_unobservable(E)

  thm_observability_persists: THEOREM has_controlled_witness?(E) IMPLIES NOT globally_unobservable(E)

  thm_universal_persistence: THEOREM has_controlled_witness?(E)
    IMPLIES FORALL (e: Excitation): spectral_observable(E,e)

  thm_rank_condition: THEOREM has_controlled_witness?(E) IMPLIES rank_condition?(E)

  thm_temporal_chart_stratification: THEOREM night_experiment?(E) IMPLIES
    during(spectral_active(E),night_regime(E)) AND spectral_active(E) < intensity_recovery(E)

  synthetic_experiment: Experiment =
    (# response := LAMBDA (e: Excitation, ch: Channel):
         IF e = brightness AND ch = 0 THEN 2 ELSIF e = cct AND ch = 1 THEN 3 ELSE 0 ENDIF,
       cutoff := 1, lux := 0,
       night_regime := (# lb := -10, ub := -4 #),
       spectral_active := (# lb := -8, ub := -6 #),
       intensity_recovery := (# lb := -3, ub := -1 #) #)

  synthetic_night_model: THEOREM night_experiment?(synthetic_experiment)

  synthetic_nonzero_minor: THEOREM
    response(synthetic_experiment)(brightness,0)*response(synthetic_experiment)(cct,1) -
      response(synthetic_experiment)(brightness,1)*response(synthetic_experiment)(cct,0) = 6

END observability_geometry
