% Captured C20 observations and finite numerical comparisons.
% These records carry externally measured scalars, without an attached walk.
% Their C20 coupling alignment is distinct from endpoint coherence computed
% from the vertex coordinates of a PPG walk.
%
% The finite inverse-order check concerns only the three captured C20 rows.
% The separate DEV operator observations show that an inverse ordering does
% not hold for every numerical metric. No universal curvature/coherence law
% or extraction of transport couplings is asserted here.
%
% Author: Dragan Stosic, 2026.

lie_captured_observations: THEORY
BEGIN

  IMPORTING lie_generator_structure

  p: VAR TransportPath
  n: VAR posnat
  observations: VAR [nat -> TransportPath]
  i, j: VAR nat

  attached_c20_alignment(p): Cosine = p`global_alignment

  attached_c20_alignment_bounded: THEOREM
    -1 <= attached_c20_alignment(p) AND attached_c20_alignment(p) <= 1

  attached_c20_threshold: THEOREM
    coherent?(p) IFF attached_c20_alignment(p) > 7/10

  attached_c20_strong_threshold: THEOREM
    strongly_coherent?(p) IFF attached_c20_alignment(p) > 17/20

  inverse_pair?(a, b: TransportPath): bool =
    a`path_curvature >= b`path_curvature IMPLIES a`global_alignment <= b`global_alignment

  finite_inverse_check?(n, observations): bool =
    FORALL (i, j: below(n)): inverse_pair?(observations(i), observations(j))

  checked_inverse_pair: THEOREM finite_inverse_check?(n, observations) AND i < n AND j < n
    IMPLIES inverse_pair?(observations(i), observations(j))

  captured_c20_table: [nat -> TransportPath] =
    LAMBDA (i: nat): IF i = 0 THEN boot320 ELSIF i = 1 THEN boot334 ELSE boot347 ENDIF

  captured_c20_inverse_check: THEOREM finite_inverse_check?(3, captured_c20_table)

  % External observations may have increasing curvature and alignment.
  % A universal inverse law would exclude these values by assumption.
  high_curvature_high_coherence: TransportPath =
    (# global_alignment := 9/10, pair_alignment := 9/10,
       shape_min_cosine := 9/10, speed_ratio := 1,
       path_curvature := 2, observability := unmeasured #)

  lower_curvature_lower_coherence: TransportPath =
    (# global_alignment := 4/5, pair_alignment := 4/5,
       shape_min_cosine := 4/5, speed_ratio := 1,
       path_curvature := 1, observability := unmeasured #)

  inverse_is_not_universal: THEOREM
    NOT inverse_pair?(high_curvature_high_coherence, lower_curvature_lower_coherence)

  OperatorObservation: TYPE = [# path_curvature: nonneg_real, operator_alignment: Cosine #]

  boot320_operator: OperatorObservation =
    (# path_curvature := 80110968750647/274877906944,
       operator_alignment := 764509825823707/1125899906842624 #)

  boot347_operator: OperatorObservation =
    (# path_curvature := 7424867465924789/17592186044416,
       operator_alignment := 6503979892704485/9007199254740992 #)

  captured_operator_inverse_counterexample: THEOREM
    boot347_operator`path_curvature > boot320_operator`path_curvature AND
      boot347_operator`operator_alignment > boot320_operator`operator_alignment

END lie_captured_observations
