% An abstract chart and metric interface with an implemented finite selector.
%
% Amari and Nagaoka, Methods of Information Geometry (2000), Chapter 2,
% motivate the statistical application. This theory does not construct a
% Fisher-Rao metric, smooth manifold, geodesic distance or equivalent topology.
% Its model laws state exactly the chart, metric and separation assumptions
% used below. The second theory constructs a five-state model satisfying all
% laws, including a point with four equally near centroids.

fisher_atlas[State: TYPE+]: THEORY
BEGIN

  N: posnat = 10

  Coordinate: TYPE = [below(N) -> real]

  K: posnat = 4

  Regime: TYPE = below(K)

  AtlasModel: TYPE = [#
    chart: [Regime -> [State -> Coordinate]],
    chart_domain: [Regime -> [State -> bool]],
    chart_inv: [Regime -> [Coordinate -> State]],
    d_F: [State, State -> nonneg_real],
    centroid: [Regime -> State],
    d_W2: [State, State -> nonneg_real]
  #]

  A: VAR AtlasModel
  s, s1, s2: VAR State
  r, r1, r2: VAR Regime
  c: VAR Coordinate

  atlas_laws?(A): bool =
    (FORALL (s: State): EXISTS (r: Regime): chart_domain(A)(r)(s)) AND
    (FORALL (r: Regime, s: State): chart_domain(A)(r)(s)
      IMPLIES chart_inv(A)(r)(chart(A)(r)(s)) = s) AND
    (FORALL (r: Regime, c: Coordinate): chart_domain(A)(r)(chart_inv(A)(r)(c))) AND
    (FORALL (s: State): d_F(A)(s, s) = 0) AND
    (FORALL (s1, s2: State): s1 /= s2 IMPLIES d_F(A)(s1, s2) > 0) AND
    (FORALL (s1, s2: State): d_F(A)(s1, s2) = d_F(A)(s2, s1)) AND
    (FORALL (s1, s2, s3: State): d_F(A)(s1, s3) <= d_F(A)(s1, s2) + d_F(A)(s2, s3)) AND
    (FORALL (r: Regime): chart_domain(A)(r)(centroid(A)(r))) AND
    (FORALL (r1, r2: Regime): r1 /= r2 IMPLIES centroid(A)(r1) /= centroid(A)(r2)) AND
    (FORALL (s1, s2: State): d_F(A)(s1, s2) > 0 IFF d_W2(A)(s1, s2) > 0)

  transition_map(A, r1, r2)(c): Coordinate = chart(A)(r2)(chart_inv(A)(r1)(c))

  overlap?(A, r1, r2, s): bool = chart_domain(A)(r1)(s) AND chart_domain(A)(r2)(s)

  % Lower indices win equal-distance comparisons, so tied minima are allowed.
  choose_nearer(distance: [Regime -> nonneg_real], a, b: Regime): Regime =
    IF distance(a) <= distance(b) THEN a ELSE b ENDIF

  min4(distance: [Regime -> nonneg_real]): Regime =
    choose_nearer(distance, choose_nearer(distance, 0, 1), choose_nearer(distance, 2, 3))

  nearest_regime(A, s): Regime = min4(LAMBDA (r: Regime): d_F(A)(s, centroid(A)(r)))

  regime_cases: LEMMA r = 0 OR r = 1 OR r = 2 OR r = 3

  min4_correct: THEOREM
    FORALL (distance: [Regime -> nonneg_real], r: Regime): distance(min4(distance)) <= distance(r)

  min4_tie_break: THEOREM
    FORALL (distance: [Regime -> nonneg_real], r: Regime):
      distance(min4(distance)) = distance(r) IMPLIES min4(distance) <= r

  min4_tie_example: THEOREM
    min4(LAMBDA (r: Regime): IF r = 0 OR r = 1 THEN 1 ELSE 2 ENDIF) = 0

  nearest_correct: LEMMA nearest_regime(A, s) = r IMPLIES
    FORALL (r2: Regime): d_F(A)(s, centroid(A)(r)) <= d_F(A)(s, centroid(A)(r2))

  transition_consistent: LEMMA atlas_laws?(A) AND overlap?(A, r1, r2, s) IMPLIES
    transition_map(A, r2, r1)(transition_map(A, r1, r2)(chart(A)(r1)(s))) = chart(A)(r1)(s)

  thm_atlas_covers: THEOREM atlas_laws?(A) IMPLIES
    FORALL (s: State): EXISTS (r: Regime): chart_domain(A)(r)(s)

  thm_transition_invertible: THEOREM atlas_laws?(A) AND overlap?(A, r1, r2, s) IMPLIES
    chart_inv(A)(r2)(transition_map(A, r1, r2)(chart(A)(r1)(s))) = s

  thm_centroids_separated: THEOREM atlas_laws?(A) AND r1 /= r2 IMPLIES
    d_F(A)(centroid(A)(r1), centroid(A)(r2)) > 0

  thm_regime_assignment_total: THEOREM EXISTS (r: Regime): nearest_regime(A, s) = r

  thm_domain_nearest_centroid: THEOREM chart_domain(A)(r)(s) AND nearest_regime(A, s) = r
    IMPLIES FORALL (r2: Regime): d_F(A)(s, centroid(A)(r)) <= d_F(A)(s, centroid(A)(r2))

  thm_chart_roundtrip: THEOREM atlas_laws?(A) AND chart_domain(A)(r)(s)
    IMPLIES chart_inv(A)(r)(chart(A)(r)(s)) = s

  thm_overlap_symmetric: THEOREM overlap?(A, r1, r2, s) IMPLIES overlap?(A, r2, r1, s)

  thm_fisher_implies_wasserstein_sep: THEOREM atlas_laws?(A) AND d_F(A)(s1, s2) > 0
    IMPLIES d_W2(A)(s1, s2) > 0

  thm_centroids_wasserstein_separated: THEOREM atlas_laws?(A) AND r1 /= r2
    IMPLIES d_W2(A)(centroid(A)(r1), centroid(A)(r2)) > 0

  thm_regime_change_positive_distance: THEOREM
    atlas_laws?(A) AND nearest_regime(A, s1) /= nearest_regime(A, s2) IMPLIES d_W2(A)(s1, s2) > 0

END fisher_atlas


% A concrete nonempty model of the entire interface, with genuine ties.
fisher_atlas_finite: THEORY
BEGIN

  FiniteState: TYPE = below(5)

  IMPORTING fisher_atlas[FiniteState]

  finite_chart: [Regime -> [FiniteState -> Coordinate]] =
    LAMBDA (r: Regime): LAMBDA (s: FiniteState):
      LAMBDA (j: below(N)): IF j = 0 THEN s ELSE 0 ENDIF

  finite_inverse: [Regime -> [Coordinate -> FiniteState]] =
    LAMBDA (r: Regime): LAMBDA (c: Coordinate):
      IF c(0) < 1/2 THEN 0 ELSIF c(0) < 3/2 THEN 1 ELSIF c(0) < 5/2 THEN 2
      ELSIF c(0) < 7/2 THEN 3 ELSE 4 ENDIF

  finite_distance: [FiniteState, FiniteState -> nonneg_real] =
    LAMBDA (s1, s2: FiniteState): IF s1 = s2 THEN 0 ELSE 1 ENDIF

  finite_atlas: AtlasModel =
    (# chart := finite_chart,
       chart_domain := LAMBDA (r: Regime): LAMBDA (s: FiniteState): TRUE,
       chart_inv := finite_inverse,
       d_F := finite_distance,
       centroid := LAMBDA (r: Regime): r,
       d_W2 := finite_distance #)

  finite_state_cases: LEMMA FORALL (s: FiniteState): s = 0 OR s = 1 OR s = 2 OR s = 3 OR s = 4

  finite_atlas_laws: THEOREM atlas_laws?(finite_atlas)

  finite_tie_distances: THEOREM FORALL (r: Regime): d_F(finite_atlas)(4, centroid(finite_atlas)(r)) = 1

  finite_tie_selected: THEOREM nearest_regime(finite_atlas, 4) = 0

END fisher_atlas_finite
