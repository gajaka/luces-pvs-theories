% A diagonal weighted quadratic form can change a two-center bisector.
% The weights are explicit positive parameters; non-conformality is a
% premise of the general theorem, not an empirical axiom.
% Amari and Nagaoka (2000), Chapter 2, motivate the metric application.
% No identification with an estimated Fisher matrix is proved here.

fisher_boundary[w1, w2: posreal]: THEORY
BEGIN

  IMPORTING reals@sq

  Point2: TYPE = [below(2) -> real]

  dist_w(x, y: Point2): nonneg_real = w1 * sq(x(0)-y(0)) + w2 * sq(x(1)-y(1))

  dist_e(x, y: Point2): nonneg_real = sq(x(0)-y(0)) + sq(x(1)-y(1))

  c1: Point2 = LAMBDA (k: below(2)): 0

  c2: Point2 = LAMBDA (k: below(2)): 1

  % One of (0,1) and (1,0) has a different weak nearest-center comparison.
  thm_boundary_displacement: THEOREM w1 /= w2 IMPLIES
    EXISTS (x: Point2):
      (dist_e(x, c1) <= dist_e(x, c2)) /= (dist_w(x, c1) <= dist_w(x, c2))

END fisher_boundary


fisher_boundary_example: THEORY
BEGIN

  IMPORTING fisher_boundary[2, 1]

  example_point: Point2 = LAMBDA (k: below(2)): IF k = 0 THEN 1 ELSE 0 ENDIF

  exact_boundary_witness: THEOREM
    dist_e(example_point, c1) = dist_e(example_point, c2) AND
    dist_w(example_point, c1) > dist_w(example_point, c2)

  nonconformal_instance: THEOREM
    EXISTS (x: Point2):
      (dist_e(x, c1) <= dist_e(x, c2)) /= (dist_w(x, c1) <= dist_w(x, c2))

END fisher_boundary_example
