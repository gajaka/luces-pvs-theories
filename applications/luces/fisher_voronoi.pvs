% Voronoi properties of the explicit atlas/metric interface.
% A change between two cells does not imply those cells share a boundary.
% The real-line instance below has four centers0,2,4,6: its outer cells are
% not adjacent, and the segment from0to6 crosses three adjacent boundaries.
% No continuity theorem about arbitrary observed trajectories is assumed.

fisher_voronoi[State: TYPE+]: THEORY
BEGIN

  IMPORTING fisher_atlas[State]

  A: VAR AtlasModel
  s: VAR State
  r, r1, r2: VAR Regime

  in_interior?(A, s, r): bool = FORALL (q: Regime): q /= r
    IMPLIES d_F(A)(s, centroid(A)(r)) < d_F(A)(s, centroid(A)(q))

  % This is a strict two-cell boundary. Multiple ties are not included.
  on_boundary?(A, s, r1, r2): bool = r1 /= r2 AND
    d_F(A)(s, centroid(A)(r1)) = d_F(A)(s, centroid(A)(r2)) AND
    (FORALL (q: Regime): q /= r1 AND q /= r2
      IMPLIES d_F(A)(s, centroid(A)(q)) > d_F(A)(s, centroid(A)(r1)))

  centroid_in_own_cell: LEMMA atlas_laws?(A) IMPLIES in_interior?(A, centroid(A)(r), r)

  thm_centroid_self_membership: THEOREM atlas_laws?(A) IMPLIES nearest_regime(A, centroid(A)(r)) = r

  thm_regimes_separated: THEOREM atlas_laws?(A) AND r1 /= r2
    IMPLIES d_F(A)(centroid(A)(r1), centroid(A)(r2)) > 0

  thm_interior_unique: THEOREM in_interior?(A, s, r1) AND in_interior?(A, s, r2) IMPLIES r1 = r2

  thm_boundary_equidistant: THEOREM on_boundary?(A, s, r1, r2)
    IMPLIES d_F(A)(s, centroid(A)(r1)) = d_F(A)(s, centroid(A)(r2))

END fisher_voronoi


fisher_voronoi_line: THEORY
BEGIN

  IMPORTING fisher_voronoi[real]

  line_distance: [real, real -> nonneg_real] = LAMBDA (x, y: real): abs(x-y)

  line_atlas: AtlasModel =
    (# chart := LAMBDA (r: Regime): LAMBDA (s: real):
         LAMBDA (j: below(N)): IF j = 0 THEN s ELSE 0 ENDIF,
       chart_domain := LAMBDA (r: Regime): LAMBDA (s: real): TRUE,
       chart_inv := LAMBDA (r: Regime): LAMBDA (c: Coordinate): c(0),
       d_F := line_distance,
       centroid := LAMBDA (r: Regime): 2*r,
       d_W2 := line_distance #)

  line_atlas_laws: THEOREM atlas_laws?(line_atlas)

  outer_cells_have_interiors: THEOREM in_interior?(line_atlas, 0, 0) AND in_interior?(line_atlas, 6, 3)

  outer_cells_not_adjacent: THEOREM NOT EXISTS (s: real): on_boundary?(line_atlas, s, 0, 3)

  direct_pair_boundary_claim_false: THEOREM
    NOT (FORALL (s1, s2: real, r1, r2: Regime):
      in_interior?(line_atlas, s1, r1) AND in_interior?(line_atlas, s2, r2) AND r1 /= r2
        IMPLIES EXISTS (s: real): on_boundary?(line_atlas, s, r1, r2))

  three_adjacent_boundaries: THEOREM
    on_boundary?(line_atlas, 1, 0, 1) AND on_boundary?(line_atlas, 3, 1, 2) AND
    on_boundary?(line_atlas, 5, 2, 3)

END fisher_voronoi_line
