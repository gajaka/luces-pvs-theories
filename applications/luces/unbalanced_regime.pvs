% Numerical classification of measured transport observations.
% Calibration is a check on positive weights and numerical thresholds.
% No empirical implication is introduced as an AXIOM. Geometry, sensor
% extraction and agreement with physical measurements require separate proofs.
%
% Author: Dragan Stosic, 2026.

unbalanced_regime: THEORY
BEGIN

  Observation: TYPE =
    [# curvature: nonneg_real, coherent: bool, reversal: bool,
       source_strength: nonneg_real, sink_strength: nonneg_real #]

  Weights: TYPE =
    [# alpha: posreal, beta: posreal, gamma: posreal, delta: posreal #]

  Thresholds: TYPE =
    [# epsilon: posreal, eta: posreal, kappa_low: nonneg_real,
       kappa_high: posreal, sigma_low: nonneg_real, sigma_high: posreal #]

  p: VAR Observation
  w: VAR Weights
  t: VAR Thresholds

  % This consistency check is explicit evidence, not an empirical axiom.
  observations_consistent?(p): bool = p`reversal IMPLIES NOT p`coherent

  Dev(w, p): nonneg_real =
    w`alpha * p`curvature +
    w`beta * (IF p`coherent THEN 0 ELSE 1 ENDIF) +
    w`gamma * (IF p`reversal THEN 1 ELSE 0 ENDIF) +
    w`delta * (p`source_strength + p`sink_strength)

  calibrated?(w, t): bool =
    t`epsilon < t`eta AND t`kappa_low < t`kappa_high AND
    t`sigma_low < t`sigma_high AND
    t`epsilon <= w`alpha * t`kappa_high AND
    t`eta < w`gamma AND t`epsilon < w`beta AND
    w`alpha * t`kappa_low + 2 * w`delta * t`sigma_low <= t`epsilon AND
    t`eta <= w`delta * t`sigma_high

  balanced_regime?(w, t, p): bool = Dev(w, p) <= t`epsilon

  transitional_regime?(w, t, p): bool =
    t`epsilon < Dev(w, p) AND Dev(w, p) <= t`eta

  unbalanced_regime?(w, t, p): bool = Dev(w, p) > t`eta

  has_source?(p): bool = p`source_strength > 0

  has_sink?(p): bool = p`sink_strength > 0

  % This is the observed source/sink imbalance; entropy is not inferred.
  excess_mass(p): nonneg_real = abs(p`source_strength - p`sink_strength)

  dawn_source?(p): bool = has_source?(p) AND p`sink_strength = 0

  dusk_sink?(p): bool = has_sink?(p) AND p`source_strength = 0

  default_weights: Weights = (# alpha := 1, beta := 2, gamma := 3, delta := 1 #)

  default_thresholds: Thresholds =
    (# epsilon := 1, eta := 2, kappa_low := 1/4,
       kappa_high := 2, sigma_low := 1/4, sigma_high := 3 #)

  default_calibration_valid: THEOREM calibrated?(default_weights, default_thresholds)

  % Bounds on actual score contributions support the calibration theorems.
  curvature_contribution_le: LEMMA w`alpha * p`curvature <= Dev(w, p)

  source_sink_contribution_le: LEMMA
    w`delta * (p`source_strength + p`sink_strength) <= Dev(w, p)

  thm_high_curvature_not_balanced: THEOREM
    calibrated?(w, t) AND p`curvature > t`kappa_high
      IMPLIES NOT balanced_regime?(w, t, p)

  thm_reversal_forces_unbalanced: THEOREM
    calibrated?(w, t) AND p`reversal IMPLIES unbalanced_regime?(w, t, p)

  thm_consistent_reversal_not_coherent: THEOREM
    observations_consistent?(p) AND p`reversal IMPLIES NOT p`coherent

  thm_coherent_low_curvature_balanced: THEOREM
    calibrated?(w, t) AND observations_consistent?(p) AND p`coherent AND
    p`curvature <= t`kappa_low AND p`source_strength <= t`sigma_low AND
    p`sink_strength <= t`sigma_low IMPLIES balanced_regime?(w, t, p)

  thm_source_or_sink_raises_dev: THEOREM
    has_source?(p) OR has_sink?(p) IMPLIES Dev(w, p) > 0

  thm_strong_source_or_sink_unbalanced: THEOREM
    calibrated?(w, t) AND
    (p`source_strength > t`sigma_high OR p`sink_strength > t`sigma_high)
      IMPLIES unbalanced_regime?(w, t, p)

  thm_balanced_unbalanced_disjoint: THEOREM
    calibrated?(w, t) IMPLIES
      NOT (balanced_regime?(w, t, p) AND unbalanced_regime?(w, t, p))

  thm_regime_partition: THEOREM
    t`epsilon < t`eta IMPLIES balanced_regime?(w, t, p) OR
      transitional_regime?(w, t, p) OR unbalanced_regime?(w, t, p)

  thm_dawn_excess_from_source: THEOREM dawn_source?(p) IMPLIES excess_mass(p) > 0

  thm_dusk_excess_from_sink: THEOREM dusk_sink?(p) IMPLIES excess_mass(p) > 0

  % Nonvacuous observations under the concrete valid calibration.
  balanced_example: THEOREM
    balanced_regime?(default_weights, default_thresholds,
      (# curvature := 0, coherent := TRUE, reversal := FALSE,
         source_strength := 0, sink_strength := 0 #))

  reversal_example: THEOREM
    observations_consistent?((# curvature := 0, coherent := FALSE, reversal := TRUE,
      source_strength := 0, sink_strength := 0 #)) AND
    unbalanced_regime?(default_weights, default_thresholds,
      (# curvature := 0, coherent := FALSE, reversal := TRUE,
         source_strength := 0, sink_strength := 0 #))

END unbalanced_regime
