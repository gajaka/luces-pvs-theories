% Finite Monge representability and interpolation diagnostics.
%
% A deterministic map on a finite grid cannot reach every mass vector.
% Compatibility is defined by its actual finite pushforward.
% Interpolation laws are explicit hypotheses, not global axioms.
%
% This is an endpoint and discrepancy contract, not a construction of the
% Wasserstein tangent bundle or a proof of Brenier differentiability.
% Background: V. M. Panaretos and Y. Zemel, An Invitation to Statistics in
% Wasserstein Space, Springer, 2020, Sections 1.5 and 2.3.

tangent_bundle[N: posnat]: THEORY
BEGIN

  Index: TYPE = below(N)
  Distr: TYPE = [Index -> nonneg_real]
  Vector: TYPE = [Index -> real]
  Coupling: TYPE = [Index, Index -> nonneg_real]
  Time: TYPE = {t: nonneg_real | t <= 1}
  Map: TYPE = [Index -> Index]

  prefix_sum(k: upto(N), f: [Index -> nonneg_real]): RECURSIVE nonneg_real =
    IF k = 0 THEN 0 ELSE prefix_sum(k - 1, f) + f(k - 1) ENDIF
    MEASURE k

  pushforward(mu: Distr, transport: Map)(j: Index): nonneg_real =
    prefix_sum(N, LAMBDA (i: Index):
      IF transport(i) = j THEN mu(i) ELSE 0 ENDIF)

  Model: TYPE =
    [# brenier: [Distr, Distr -> Map],
       exp_map: [Distr, Vector, Time -> Distr],
       kantorovich: [Distr, Distr, Time -> Distr],
       coupling: [Distr, Distr -> Coupling],
       fraction: [Coupling -> Time],
       discrepancy: [Distr, Distr -> nonneg_real] #]

  m: VAR Model
  mu, nu, p, q: VAR Distr
  i, j: VAR Index
  t: VAR Time

  log_map(m, mu, nu): Vector =
    LAMBDA (i: Index): m`brenier(mu, nu)(i) - i

  monge_compatible?(m, mu, nu): bool =
    pushforward(mu, m`brenier(mu, nu)) = nu

  gap_at(m, mu, nu, t): nonneg_real =
    m`discrepancy(m`exp_map(mu, log_map(m, mu, nu), t),
                  m`kantorovich(mu, nu, t))

  approx_gap(m, mu, nu): nonneg_real = gap_at(m, mu, nu, 1/2)

  % Supplied functions must meet these laws. Arbitrary finite data need not
  % admit a deterministic transport or an exact Monge roundtrip.
  admissible_model?(m): bool =
    (FORALL p: m`discrepancy(p, p) = 0) AND
    (FORALL mu, nu: monge_compatible?(m, mu, nu) IMPLIES
      m`exp_map(mu, log_map(m, mu, nu), 0) = mu AND
      m`exp_map(mu, log_map(m, mu, nu), 1) = nu) AND
    (FORALL mu, nu:
      m`kantorovich(mu, nu, 0) = mu AND
      m`kantorovich(mu, nu, 1) = nu) AND
    (FORALL mu, nu: m`fraction(m`coupling(mu, nu)) = 1 IMPLIES
      monge_compatible?(m, mu, nu) AND
      (FORALL t:
        m`exp_map(mu, log_map(m, mu, nu), t) =
        m`kantorovich(mu, nu, t))) AND
    (FORALL mu, nu, i, j:
      i < j IMPLIES m`brenier(mu, nu)(i) <= m`brenier(mu, nu)(j))

  thm_log_exp_roundtrip: THEOREM
    admissible_model?(m) AND monge_compatible?(m, mu, nu) IMPLIES
      m`exp_map(mu, log_map(m, mu, nu), 1) = nu

  thm_gap_zero_at_endpoints: THEOREM
    admissible_model?(m) AND monge_compatible?(m, mu, nu) IMPLIES
      gap_at(m, mu, nu, 0) = 0 AND gap_at(m, mu, nu, 1) = 0

  % Pure transport gives equality at every parameter, not merely the midpoint.
  thm_pure_monge_zero_gap: THEOREM
    admissible_model?(m) AND m`fraction(m`coupling(mu, nu)) = 1 IMPLIES
      gap_at(m, mu, nu, t) = 0

  thm_local_monotonicity: THEOREM
    admissible_model?(m) AND i + 1 < N IMPLIES
      m`brenier(mu, nu)(i) <= m`brenier(mu, nu)(i + 1)

  thm_gap_nonneg: THEOREM approx_gap(m, mu, nu) >= 0

  thm_gap_certifies_splitting: THEOREM
    admissible_model?(m) AND approx_gap(m, mu, nu) > 0 IMPLIES
      m`fraction(m`coupling(mu, nu)) < 1

END tangent_bundle

% A fully defined one-atom model establishes that the explicit law package is
% inhabited. Unequal mass vectors are not Monge-compatible on this grid.
% The non-pure positive-gap example prevents an all-zero diagnostic witness.
tangent_bundle_witness: THEORY
BEGIN

  IMPORTING tangent_bundle[1]

  identity_map(mu, nu: Distr)(i: Index): Index = i

  stationary_exp(mu: Distr, v: Vector, t: Time): Distr = mu

  affine_interpolation(mu, nu: Distr, t: Time)(i: Index): nonneg_real =
    (1 - t) * mu(i) + t * nu(i)

  zero_coupling(mu, nu: Distr)(i, j: Index): nonneg_real = 0

  nonpure_fraction(pi: Coupling): Time = 0

  scalar_discrepancy(p, q: Distr): nonneg_real = abs(p(0) - q(0))

  witness: Model =
    (# brenier := identity_map,
       exp_map := stationary_exp,
       kantorovich := affine_interpolation,
       coupling := zero_coupling,
       fraction := nonpure_fraction,
       discrepancy := scalar_discrepancy #)

  zero_mass: Distr = LAMBDA (i: Index): 0

  unit_mass: Distr = LAMBDA (i: Index): 1

  witness_pushforward: THEOREM
    FORALL (mu, nu: Distr): pushforward(mu, identity_map(mu, nu)) = mu

  witness_admissible: THEOREM admissible_model?(witness)

  witness_compatible: THEOREM monge_compatible?(witness, unit_mass, unit_mass)

  witness_nonrepresentable: THEOREM
    NOT monge_compatible?(witness, zero_mass, unit_mass)

  witness_positive_gap: THEOREM
    approx_gap(witness, zero_mass, unit_mass) = 1/2 AND
    witness`fraction(witness`coupling(zero_mass, unit_mass)) = 0

  % Regression for the removed universal endpoint assumption: the same
  % source and finite log cannot reconstruct two unequal target masses.
  witness_log_collision: THEOREM
    log_map(witness, zero_mass, zero_mass) =
      log_map(witness, zero_mass, unit_mass)

  witness_roundtrip_conflict: THEOREM
    FORALL (E: [Distr, Vector, Time -> Distr]):
      NOT (E(zero_mass, log_map(witness, zero_mass, zero_mass), 1) = zero_mass AND
           E(zero_mass, log_map(witness, zero_mass, unit_mass), 1) = unit_mass)

END tangent_bundle_witness
