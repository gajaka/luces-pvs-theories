% Bounds for the convex energy of an explicit metric-geodesic model.
%
% McCann (1997) and Villani (2009), Chapter17, concern the positive entropy
% integral rho log rho under their stated geometric assumptions. Shannon
% entropy has the opposite sign. This interface proves consequences of its
% supplied energy law; it does not identify an arbitrary energy with entropy
% or prove a Ricci-curvature characterization. The imported real-line model
% supplies a nonempty example with the convex energy x^2.

entropy_along_geodesic[D: TYPE+]: THEORY
BEGIN

  IMPORTING wasserstein_metric[D]

  M: VAR GeodesicModel
  p, q: VAR D
  t: VAR UnitInterval
  x, y: VAR real

  weighted_le_max: LEMMA (1-t)*x+t*y <= max(x,y)

  thm_endpoint_energy: THEOREM geodesic_laws?(M) IMPLIES
    energy(M)(interp(M)(p,q,0)) = energy(M)(p) AND
    energy(M)(interp(M)(p,q,1)) = energy(M)(q)

  thm_energy_max_bound: THEOREM geodesic_laws?(M) IMPLIES
    energy(M)(interp(M)(p,q,t)) <= max(energy(M)(p),energy(M)(q))

  thm_equal_endpoint_bound: THEOREM geodesic_laws?(M) AND energy(M)(p) = energy(M)(q)
    IMPLIES energy(M)(interp(M)(p,q,t)) <= energy(M)(p)

  thm_midpoint_bound: THEOREM geodesic_laws?(M) IMPLIES
    energy(M)(interp(M)(p,q,1/2)) <= (energy(M)(p)+energy(M)(q))/2

  % This is an upper bound, not monotonicity of energy along the path.
  thm_upper_endpoint_bound: THEOREM geodesic_laws?(M) AND energy(M)(p) <= energy(M)(q)
    IMPLIES energy(M)(interp(M)(p,q,t)) <= energy(M)(q)

END entropy_along_geodesic
