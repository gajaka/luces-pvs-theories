% C20/C21/C22 are numerical screens from paper3/scripts/lie_group_transport_v2.py.
% C20 uses mean cosine of coupling displacement fields against the full field:
% PASS iff > 0.7; STRONG iff > 0.85. C21 uses pairwise mean cosine > 0.85
% and speed ratio < 5. C22 uses the minimum active shape-direction cosine.
% These are distinct metrics; C_GEN's signed-flow threshold is not C20.
%
% A passed C21 screen does not prove a Lie exponential representation.
% Hall, Lie Groups, Lie Algebras, and Representations (2015), discusses the
% mathematical one-parameter subgroup theorem; it is not formalized here.
% C14 is not measured by this script, so captured rows retain unmeasured
% observability evidence. No numeric coherence value supplies that evidence.
%
% data/lie_observations.json and scripts/check_lie_observations.py bind the
% finite floating-point replay to the exact rational observation values below.
% This validates the extraction on the recorded files, not all Python/C code.

lie_generator_structure: THEORY
BEGIN

  Cosine: TYPE = {x: real | -1 <= x AND x <= 1}

  ObservabilityEvidence: TYPE = {unmeasured, c14_pass, c14_fail}

  MeasuredPathObservation: TYPE =
    [# global_alignment: Cosine, pair_alignment: Cosine,
       shape_min_cosine: Cosine, speed_ratio: nonneg_real,
       path_curvature: nonneg_real, observability: ObservabilityEvidence #]

  TransportPath: TYPE = MeasuredPathObservation

  p: VAR TransportPath

  continuously_observed?(p): bool = p`observability = c14_pass

  shape_direction_reversal?(p): bool = p`shape_min_cosine < 0

  kinematically_smooth?(p): bool = p`speed_ratio < 5

  coherent?(p): bool = p`global_alignment > 7/10

  strongly_coherent?(p): bool = p`global_alignment > 17/20

  c21_screen?(p): bool = p`pair_alignment > 17/20 AND p`speed_ratio < 5

  c22_pass?(p): bool = p`shape_min_cosine >= 0

  strong_implies_coherent: THEOREM strongly_coherent?(p) IMPLIES coherent?(p)

  c21_requires_speed_screen: THEOREM c21_screen?(p) IMPLIES kinematically_smooth?(p)

  c22_pass_iff_no_reversal: THEOREM c22_pass?(p) IFF NOT shape_direction_reversal?(p)

  c20_boundary_is_not_pass: THEOREM p`global_alignment = 7/10 IMPLIES NOT coherent?(p)

  % Two unit directions (119, +/-120)/169 both align with (1,0) by >0.7,
  % while their mutual cosine is negative. This is a realizable directional
  % counterexample to inferring a global-alignment failure from reversal alone.
  rational_direction_witness: LEMMA
    (119/169)^2 + (120/169)^2 = 1 AND
    (119/169)^2 - (120/169)^2 = -239/28561 AND 119/169 > 7/10

  reversal_coherence_witness: TransportPath =
    (# global_alignment := 119/169, pair_alignment := -239/28561,
       shape_min_cosine := -239/28561, speed_ratio := 1,
       path_curvature := 1, observability := c14_pass #)

  reversal_can_be_coherent: THEOREM
    shape_direction_reversal?(reversal_coherence_witness) AND coherent?(reversal_coherence_witness)

  observed_noncoherent_witness: TransportPath =
    (# global_alignment := 0, pair_alignment := 0,
       shape_min_cosine := 1/2, speed_ratio := 1,
       path_curvature := 1, observability := c14_pass #)

  observed_no_reversal_is_not_sufficient: THEOREM
    continuously_observed?(observed_noncoherent_witness) AND
    NOT shape_direction_reversal?(observed_noncoherent_witness) AND
    NOT coherent?(observed_noncoherent_witness)

  % boot320_merged_dawn.csv, SHA256 23ce5e3c2ac8bd932c1452ebdf4d73ad8dbb6129e211972c884d6c406ad9dc83.
  boot320: TransportPath =
    (# global_alignment := 8267935708351987/9007199254740992,
       pair_alignment := 4233711247314265/4503599627370496,
       shape_min_cosine := 4412105695696701/4503599627370496,
       speed_ratio := 5640839059168775/1125899906842624,
       path_curvature := 965274198876551/140737488355328,
       observability := unmeasured #)

  % boot334_dawn.csv, SHA256 4e58ea61256f5ef131e2c61a4001e6238eb513d9877fb0486d6fb52a38d3b3ca.
  boot334: TransportPath =
    (# global_alignment := 4518619484292101/9007199254740992,
       pair_alignment := 6999036323056715/36028797018963968,
       shape_min_cosine := -6754005230439663/9007199254740992,
       speed_ratio := 8518198750150271/1125899906842624,
       path_curvature := 4905491170745759/140737488355328,
       observability := unmeasured #)

  % boot347_dawn.csv, SHA256 3ef6638d83059b273a174e04cb4523557c9064e4a44bc741a05a50a4a8ae14ab.
  boot347: TransportPath =
    (# global_alignment := 6408342148523869/9007199254740992,
       pair_alignment := 4109727489367045/9007199254740992,
       shape_min_cosine := 8131291427195087/9007199254740992,
       speed_ratio := 7090288686913043/1125899906842624,
       path_curvature := 2682668942632627/140737488355328,
       observability := unmeasured #)

  measured_boot_classifications: THEOREM
    strongly_coherent?(boot320) AND NOT c21_screen?(boot320) AND c22_pass?(boot320) AND
    NOT coherent?(boot334) AND shape_direction_reversal?(boot334) AND
    coherent?(boot347) AND NOT strongly_coherent?(boot347) AND c22_pass?(boot347)

  coherence_does_not_supply_observability_evidence: THEOREM
    coherent?(boot320) AND NOT continuously_observed?(boot320) AND
      boot320`observability = unmeasured

END lie_generator_structure
