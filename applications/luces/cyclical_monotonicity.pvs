% Checked dual prices and complementary slackness imply the two- and
% three-cycle inequalities by telescoping. No feasible prices or empirical
% plan are postulated. For the explicitly defined quadratic cost, the
% two-cycle inequality forbids crossed support pairs on the ordered grid.
% These finite results do not assert the full all-cycle converse theorem.
%
% Villani, Optimal Transport: Old and New (2009), Chapter 5.

cyclical_monotonicity: THEORY
BEGIN

  IMPORTING kantorovich_duality, reals@sq

  cost: VAR Cost
  P: VAR Plan
  psi, phi: VAR Price
  i1, i2, j1, j2: VAR Bin

  two_cyclic_monotone?(cost, P): bool =
    FORALL (i1, i2, j1, j2: Bin): P(i1, j1) > 0 AND P(i2, j2) > 0 IMPLIES
      cost(i1, j1) + cost(i2, j2) <= cost(i1, j2) + cost(i2, j1)

  three_cyclic_monotone?(cost, P): bool =
    FORALL (i1, i2, i3, j1, j2, j3: Bin):
      P(i1, j1) > 0 AND P(i2, j2) > 0 AND P(i3, j3) > 0 IMPLIES
      cost(i1, j1) + cost(i2, j2) + cost(i3, j3) <=
      cost(i1, j2) + cost(i2, j3) + cost(i3, j1)

  thm_cs_implies_2cyclic: THEOREM
    complementary_slack?(cost, P, psi, phi) AND dual_feasible?(cost, psi, phi)
      IMPLIES two_cyclic_monotone?(cost, P)

  thm_cs_implies_3cyclic: THEOREM
    complementary_slack?(cost, P, psi, phi) AND dual_feasible?(cost, psi, phi)
      IMPLIES three_cyclic_monotone?(cost, P)

  quadratic_cost: Cost = LAMBDA (i, j: Bin): sq(i-j)

  quadratic_swap_identity: LEMMA
    quadratic_cost(i1,j1) + quadratic_cost(i2,j2) -
      quadratic_cost(i1,j2) - quadratic_cost(i2,j1) = 2*(i2-i1)*(j1-j2)

  thm_2cyclic_quadratic_implies_monotone: THEOREM
    P(i1,j1) > 0 AND P(i2,j2) > 0 AND two_cyclic_monotone?(quadratic_cost, P) AND i1 < i2
      IMPLIES j1 <= j2

  diagonal_plan_cycle_witness: THEOREM feasible?(uniform, uniform, diagonal_plan) AND
    diagonal_plan(0,0) > 0 AND two_cyclic_monotone?(quadratic_cost, diagonal_plan)

END cyclical_monotonicity
