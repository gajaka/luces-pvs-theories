% A directed four-stage boot policy over explicit verification outcomes.
% The PPG graph contains the prefix whose checks have succeeded. This
% verifies the abstract sequencing policy, not a cryptographic implementation.
% The legacy undirected lowrisc_boot_verification graph is not used here.
%
% Author: Dragan Stosic, 2026.

opentitan_boot_instance: THEORY
BEGIN

  BootStage: TYPE = {ROM, ROM_EXT, BL0, KERNEL}

  IMPORTING ppg_core@directed_pp_graph[BootStage]

  BootChecks: TYPE = [# signature_ok: bool, hash_ok: bool, policy_ok: bool #]

  checks: VAR BootChecks
  x, y, s: VAR BootStage
  pw: VAR Prewalk

  ot_level(s): nat =
    CASES s OF ROM: 0, ROM_EXT: 1, BL0: 2, KERNEL: 3 ENDCASES

  ot_invariant(checks, s): bool =
    CASES s OF
      ROM: TRUE,
      ROM_EXT: checks`signature_ok,
      BL0: checks`hash_ok,
      KERNEL: checks`policy_ok
    ENDCASES

  % A stage is enabled only after every verification up to it has passed.
  ot_enabled(checks, s): bool =
    CASES s OF
      ROM: TRUE,
      ROM_EXT: checks`signature_ok,
      BL0: checks`signature_ok AND checks`hash_ok,
      KERNEL: checks`signature_ok AND checks`hash_ok AND checks`policy_ok
    ENDCASES

  % This relation expresses forward stage order, not software equivalence.
  ot_refines(x, y): bool = ot_level(x) < ot_level(y)

  ot_edges(x, y): bool =
    (x = ROM AND y = ROM_EXT) OR
    (x = ROM_EXT AND y = BL0) OR
    (x = BL0 AND y = KERNEL)

  ot_graph(checks): Graph =
    (# vertices := LAMBDA (s: BootStage): ot_enabled(checks, s),
       edges := LAMBDA (x, y: BootStage):
         ot_edges(x, y) AND ot_enabled(checks, x) AND ot_enabled(checks, y) #)

  ot_full_walk: Prewalk =
    (# length := 4,
       seq := LAMBDA (i: below(4)):
         IF i = 0 THEN ROM ELSIF i = 1 THEN ROM_EXT
         ELSIF i = 2 THEN BL0 ELSE KERNEL ENDIF #)

  ot_reachable(checks, s): bool =
    EXISTS (pw: Prewalk): is_walk(ot_graph(checks), pw) AND
      pw_start(pw) = ROM AND pw_end(pw) = s

  ot_levels_increasing: THEOREM
    ot_edges(x, y) IMPLIES ot_level(x) < ot_level(y)

  ot_unique_levels: THEOREM ot_level(x) = ot_level(y) IMPLIES x = y

  ot_rom_is_root: THEOREM ot_level(s) = 0 IMPLIES s = ROM

  ot_single_verifier: THEOREM
    y /= ROM IMPLIES EXISTS (x: BootStage):
      ot_edges(x, y) AND ot_level(x) + 1 = ot_level(y)

  ot_edges_refine: THEOREM ot_edges(x, y) IMPLIES ot_refines(x, y)

  ot_no_backward: THEOREM ot_edges(x, y) IMPLIES NOT ot_edges(y, x)

  ot_enabled_implies_invariant: LEMMA
    ot_enabled(checks, s) IMPLIES ot_invariant(checks, s)

  ot_graph_pp_valid: THEOREM
    pp_valid(ot_graph(checks), ot_refines,
      LAMBDA (s: BootStage): ot_invariant(checks, s))

  ot_walk_end_enabled: LEMMA
    is_walk(ot_graph(checks), pw) IMPLIES ot_enabled(checks, pw_end(pw))

  % Failure blocks actual directed reachability, including through other stages.
  ot_signature_failure_blocks: THEOREM
    NOT checks`signature_ok IMPLIES
      NOT ot_reachable(checks, BL0) AND NOT ot_reachable(checks, KERNEL)

  ot_full_chain_valid: THEOREM
    checks`signature_ok AND checks`hash_ok AND checks`policy_ok IMPLIES
      pp_path(ot_graph(checks), ot_refines,
        LAMBDA (s: BootStage): ot_invariant(checks, s), ot_full_walk)

  ot_success_reaches_kernel: THEOREM
    checks`signature_ok AND checks`hash_ok AND checks`policy_ok IMPLIES
      ot_reachable(checks, KERNEL)

  % Both successful and failed checks have concrete, axiom-free instances.
  ot_success_instance: THEOREM
    ot_reachable((# signature_ok := TRUE, hash_ok := TRUE, policy_ok := TRUE #), KERNEL)

  ot_failure_instance: THEOREM
    ot_graph((# signature_ok := FALSE, hash_ok := TRUE, policy_ok := TRUE #))`vertices(ROM) AND
    NOT ot_reachable((# signature_ok := FALSE, hash_ok := TRUE, policy_ok := TRUE #), KERNEL)

END opentitan_boot_instance
