% Among bounded consistent rooted DAGs, first minimize node count and
% then maximize the natural orientation score. A passing flipped prefix
% would either have fewer nodes or a larger score, contradicting that
% choice. No termination property of an arc-flipping procedure is used.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Lemma 3.1. https://arxiv.org/abs/2111.06527
% Lean counterpart: PPGraphHLSAugmentedExistence.lean.
ppg_hls_augmented_existence[C,V,Value:TYPE,domain:[V->set[Value]],
  footprint:[C->finite_set[V]],
  (IMPORTING ppg_mt_semantics[C,V,Value,domain])bad:[C,MTState->bool],
  universe:{U:finite_set[C]|FORALL(c:C):U(c)}]: THEORY
BEGIN
  IMPORTING ppg_hls_prefix_check[C,V,Value,domain,footprint,bad],
    ppg_hls_orientation_score[C,coordinateGraph.dependencyGraph],
    ppg_hls_bounded_dags[C,coordinateGraph.dependencyGraph,universe],
    ppg_real_minimum[WitnessDAG] AS dagMinimum
  D,D0,K: VAR WitnessDAG
  r,u,v: VAR WNode
  M: VAR DependencyMatching
  Y: VAR [finite_set[C],nat->C]
  N: VAR nat
  omega: VAR rawSlots.LogSpace
  F: VAR finite_set[WitnessDAG]

  AugmentedCheck(M,Y,r,D,omega): bool = tableCheck(D)(omega) AND
    (FORALL(u,v:WNode):Edge(D)(u,v) AND
      dagPaths.Acyclic(dagPaths.reverseArc(Edge(D),u,v)) AND M(u`1)=v`1 AND u`1/=v`1 AND
      Y(matchPair(M,u`1),cliqueRank(D,matchPair(M,u`1),u))=v`1 IMPLIES
        NOT tableCheck(ancestorPrefix(reverse(D,u,v),r))(omega))

  candidates(N,r,omega): finite_set[WitnessDAG] = intersection(boundedDAGs(N),
    LAMBDA(D:WitnessDAG):RootedCanonical(D,r) AND card(D`nodes)<=N AND tableCheck(D)(omega))

  Extremal(F,M,Y,N,D): bool = F(D) AND
    (FORALL(K:WitnessDAG):F(K) IMPLIES card(D`nodes)<=card(K`nodes) AND
      (card(K`nodes)=card(D`nodes) IMPLIES
        orientationScore(M,Y,N,K)<=orientationScore(M,Y,N,D)))

  minimum_cardinality: LEMMA NOT empty?(F) IMPLIES
    EXISTS(D:WitnessDAG):F(D) AND
      FORALL(K:WitnessDAG):F(K) IMPLIES card(D`nodes)<=card(K`nodes)

  maximum_orientation: LEMMA NOT empty?(F) IMPLIES
    EXISTS(D:WitnessDAG):F(D) AND
      FORALL(K:WitnessDAG):F(K) IMPLIES
        orientationScore(M,Y,N,K)<=orientationScore(M,Y,N,D)

  same_size_nonempty: LEMMA F(D) IMPLIES
    NOT empty?(intersection(F,LAMBDA(K:WitnessDAG):card(K`nodes)=card(D`nodes)))

  extremal_exists: LEMMA NOT empty?(F) IMPLIES
    EXISTS(D:WitnessDAG):Extremal(F,M,Y,N,D)

  rooted_bounded: LEMMA RootedCanonical(D,r) AND card(D`nodes)<=N IMPLIES
    boundedDAGs(N)(D)

  candidates_member: LEMMA candidates(N,r,omega)(D) IFF
    RootedCanonical(D,r) AND card(D`nodes)<=N AND tableCheck(D)(omega)

  initial_candidate: LEMMA RootedCanonical(D0,r) AND tableCheck(D0)(omega) IMPLIES
    candidates(card(D0`nodes),r,omega)(D0)

  initial_candidates_nonempty: LEMMA RootedCanonical(D0,r) AND tableCheck(D0)(omega) IMPLIES
    NOT empty?(candidates(card(D0`nodes),r,omega))

  flipped_nodes_subset: LEMMA subset?(ancestorPrefix(reverse(D,u,v),r)`nodes,D`nodes)

  flipped_prefix_eq_reverse: LEMMA RootedCanonical(D,r) AND Edge(D)(u,v) AND
    dagPaths.Acyclic(dagPaths.reverseArc(Edge(D),u,v)) AND
    card(D`nodes)<=card(ancestorPrefix(reverse(D,u,v),r)`nodes) IMPLIES
      ancestorPrefix(reverse(D,u,v),r)=reverse(D,u,v)

  passing_flip_candidate: LEMMA candidates(N,r,omega)(D) AND Edge(D)(u,v) AND
    dagPaths.Acyclic(dagPaths.reverseArc(Edge(D),u,v)) AND u`1/=v`1 AND
    tableCheck(ancestorPrefix(reverse(D,u,v),r))(omega) IMPLIES
      candidates(N,r,omega)(ancestorPrefix(reverse(D,u,v),r))

  extremal_is_augmented: LEMMA Extremal(candidates(N,r,omega),M,Y,N,D) IMPLIES
    AugmentedCheck(M,Y,r,D,omega)

  augmented_tableCheck: LEMMA AugmentedCheck(M,Y,r,D,omega) IMPLIES tableCheck(D)(omega)

  exists_augmented_same_root: THEOREM RootedCanonical(D0,r) AND tableCheck(D0)(omega) IMPLIES
    EXISTS(D:WitnessDAG):RootedCanonical(D,r) AND card(D`nodes)<=card(D0`nodes) AND
      AugmentedCheck(M,Y,r,D,omega)

  exists_tableCheck_iff_exists_augmented: THEOREM
    (EXISTS(D:WitnessDAG):RootedCanonical(D,r) AND tableCheck(D)(omega)) IFF
    (EXISTS(D:WitnessDAG):RootedCanonical(D,r) AND AugmentedCheck(M,Y,r,D,omega))

END ppg_hls_augmented_existence
