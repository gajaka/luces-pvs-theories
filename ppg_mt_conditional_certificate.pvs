% The certificate refers to the original stopped MT potential and the
% original table measure. Integrability and the local conditional decrease
% are its only fields; adaptation and nonnegativity follow from the process.
%
% Robin A. Moser and Gabor Tardos, A constructive proof of the general
% Lovasz Local Lemma, Journal of the ACM 57(2), 2010, Section 2.
% Johannes Lengler, Drift Analysis, arXiv:1712.00964, Theorem 1.
% K. Chatterjee, H. Fu and P. Novotny, Foundations of Probabilistic
% Programming, Definition 7.4 and Proposition 7.5.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_mt_conditional_certificate[C,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_mt_coordinate_laws[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),fallback:C,
  eventOrder:{e:list[C]|FORALL(c:C):member(c,e)},
  (IMPORTING ppg_mt_observed_history[C,V,Value,domain,spaces,laws,fallback,eventOrder])
  vars:[C->finite_set[V]],
  B:ppg_mt_check_probability[C,V,Value,domain,spaces,laws].NativeBad,
  init:Initializer,Phi:MeasurablePotential]: THEORY
BEGIN
  IMPORTING ppg_mt_observed_history[C,V,Value,domain,spaces,laws,fallback,eventOrder] AS mtObserved,
    ppg_mt_drift_pointwise[C,V,Value,domain,fallback,eventOrder] AS mtPointwise,
    ppg_mt_random_process[C,V,Value,domain] AS mtSlots,
    ppg_mt_native_spaces[C,V,Value,domain] AS mtSpaces,
    ppg_mt_log_probability[C,V,Value,domain,spaces,laws] AS mtOriginal,
    ppg_probability_finite_view[mtSlots.LogSpace,mtSpaces.NativeTableSigma(spaces)] AS mtFiniteView,
    ppg_probability_integral[mtSlots.LogSpace,mtSpaces.NativeTableSigma(spaces),mtOriginal.logMeasure] AS mtProbabilityIntegral,
    ppg_filtration[mtSlots.LogSpace,real,mtSpaces.NativeTableSigma(spaces)] AS mtRealHistory

  ResamplingLog: TYPE = mtSlots.LogSpace

  tableSigma: MACRO ppg_measurable_space[mtSlots.LogSpace].MeasurableSpace = mtSpaces.NativeTableSigma(spaces)

  nativeLaw: MACRO ppg_finite_law_view[mtSlots.LogSpace,tableSigma].FiniteLaw = mtFiniteView.nativeLaw(mtOriginal.logMeasure)

  history: mtRealHistory.Filtration = mtObserved.mtFiltration(vars,B,init)

  IMPORTING ppg_additive_conditional_certificate[mtSlots.LogSpace,tableSigma,nativeLaw,history] AS mtAdditive,
    measure_integration@integral[mtSlots.LogSpace,asNasa(tableSigma),nativeLaw] AS mtNativeIntegral,
    measure_integration@measure_theory[mtSlots.LogSpace,asNasa(tableSigma),nativeLaw] AS mtNativeAE,
    ppg_measurable_map[mtSlots.LogSpace,real] AS mtValueMaps,
    measure_integration@real_borel AS mtBorel,
    ppg_nasa_sigma[real] AS mtRealBridge,
    ppg_mt_selection[C,V,Value,domain] AS mtSelection,
    ppg_mt_count_termination[C,V,Value,domain] AS mtTermination,
    ppg_mt_raw_active_expectation[C,V,Value,domain,spaces,laws,fallback,eventOrder] AS mtRaw,
    ppg_probability_extended_view[mtSlots.LogSpace,tableSigma,mtOriginal.logMeasure] AS mtIntegralView,
    ppg_additive_certificate_expectation[mtSlots.LogSpace,tableSigma,nativeLaw,history] AS mtBound,
    ppg_event_count[mtSlots.LogSpace] AS mtEventCount,
    ppg_enn_simple_sup

  NativeFunction: TYPE = mtNativeIntegral.integrable

  mean(f:NativeFunction): real = mtNativeIntegral.integral(f)

  constant(c:real): NativeFunction = mtProbabilityIntegral.constant(c)

  constant_value: LEMMA FORALL(c:real,omega:ResamplingLog):constant(c)(omega)=c

  mean_constant: LEMMA FORALL(c:real):mean(constant(c))=c

  n: VAR nat
  omega: VAR ResamplingLog
  delta: VAR nonneg_real
  F: VAR [nat->mtNativeIntegral.integrable]

  active(n): set[mtSlots.LogSpace] = mtPointwise.mtRunningEvent(vars,B,init,n+1)

  active_measurable_history: LEMMA history(n)(active(n))

  activeSchedule: mtAdditive.HistorySchedule = active

  stopped(n): [ResamplingLog->real] = LAMBDA(omega:ResamplingLog):
    mtPointwise.mtStoppedPotential(vars,B,init,Phi,n,omega)

  stopped_value_nonnegative: LEMMA 0<=stopped(n)(omega)

  actualFamily(F): bool = FORALL(n:nat):F(n)=stopped(n)

  StoppedFamily: TYPE = (actualFamily)

  family_value: LEMMA FORALL(F:StoppedFamily):F(n)=stopped(n)

  family_pointwise_nonnegative: LEMMA FORALL(F:StoppedFamily):0<=F(n)(omega)

  family_nonnegative_ae: LEMMA FORALL(F:StoppedFamily):mtNativeAE.ae_nonneg?(F(n))

  family_history_measurable: LEMMA FORALL(F:StoppedFamily):
    ppg_conditional_versions[mtSlots.LogSpace,tableSigma,nativeLaw,mtAdditive.historyAt(n)].historyMeasurable(F(n))

  localDecrease(F:StoppedFamily,delta): bool = FORALL(n:nat):
    mtNativeAE.ae_le?(mtAdditive.conditionalNext(F,n)+mtAdditive.activeCharge(activeSchedule,delta,n),F(n))

  MTCertificate(delta): TYPE = {F:StoppedFamily|localDecrease(F,delta)}

  certificate_value: LEMMA FORALL(delta:nonneg_real,T:MTCertificate(delta)):T(n)=stopped(n)

  certificate_decrease: LEMMA FORALL(delta:nonneg_real,T:MTCertificate(delta)):
    mtNativeAE.ae_le?(mtAdditive.conditionalNext(T,n)+mtAdditive.activeCharge(activeSchedule,delta,n),T(n))

  conditional_law: LEMMA FORALL(delta:nonneg_real,T:MTCertificate(delta)):
    mtAdditive.CertificateLaw(activeSchedule,delta,T)

  toConditional(delta:nonneg_real,T:MTCertificate(delta)): mtAdditive.ConditionalCertificate(activeSchedule,delta) = T

  to_conditional_value: LEMMA FORALL(delta:nonneg_real,T:MTCertificate(delta)):toConditional(delta,T)=T

  PotentialBound: TYPE = {M:nnreal|FORALL(s:mtPointwise.State):Phi(s)<=M}

  bounded_stopped_integrable: LEMMA FORALL(M:PotentialBound):mtNativeIntegral.integrable?(stopped(n))

  boundedFamily(M:PotentialBound): StoppedFamily = LAMBDA(n:nat):stopped(n)

  mtCertificate_of_bounded: THEOREM FORALL(M:PotentialBound,delta:nonneg_real):
    localDecrease(boundedFamily(M),delta) IMPLIES
      EXISTS(T:MTCertificate(delta)):T=boundedFamily(M)

  schedule_event_value: LEMMA mtAdditive.eventSchedule(activeSchedule)(n)=mtRaw.runningSchedule(vars,B,init)(n)

  count_agreement: LEMMA mtBound.activeCount(activeSchedule,omega)=
    mtRaw.activeCount(mtRaw.runningSchedule(vars,B,init),omega)

  count_function_agreement: LEMMA
    (LAMBDA(omega:ResamplingLog):mtBound.activeCount(activeSchedule,omega))=
    (LAMBDA(omega:ResamplingLog):mtRaw.activeCount(mtRaw.runningSchedule(vars,B,init),omega))

  expected_count_agreement: LEMMA mtBound.expectedActiveCount(activeSchedule)=
    mtRaw.expectedActiveCount(mtRaw.runningSchedule(vars,B,init))

  mt_expected_count_bound: LEMMA FORALL(delta:posreal,T:MTCertificate(delta)):
    ele(mtRaw.expectedActiveCount(mtRaw.runningSchedule(vars,B,init)),
      dividePositive(ofReal(mtNativeIntegral.integral(T(0))),delta))

  mt_expected_count_finite: LEMMA FORALL(delta:posreal,T:MTCertificate(delta)):
    ennFinite?(mtRaw.expectedActiveCount(mtRaw.runningSchedule(vars,B,init)))

  finite_count_good_event: LEMMA
    {omega:ResamplingLog|ennFinite?(mtBound.activeCount(activeSchedule,omega))}=
    {omega:ResamplingLog|EXISTS(N:nat):mtSelection.MTGood(B,
      mtSlots.randTraj(vars,B,fallback,eventOrder,init(omega),omega,N))}

  mt_ae_exists_good: LEMMA FORALL(delta:posreal,T:MTCertificate(delta)):
    ae?[mtSlots.LogSpace,asNasa(tableSigma),nativeLaw](
      {omega:ResamplingLog|EXISTS(N:nat):mtSelection.MTGood(B,
        mtSlots.randTraj(vars,B,fallback,eventOrder,init(omega),omega,N))})

END ppg_mt_conditional_certificate
