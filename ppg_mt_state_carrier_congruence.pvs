% Changing the label type leaves the state coordinates, sigma-algebra
% and product measure unchanged.
% Patrick Billingsley, Probability and Measure, third edition.
ppg_mt_state_carrier_congruence[C1,C2,V,Value:TYPE,domain:[V->set[Value]],
  universe:{U:finite_set[V]|U=fullset[V]},
  (IMPORTING ppg_probability_coordinates[V,Value,domain])
  spaces:CoordinateSpaces,laws:ProbabilityFamily(spaces)]: THEORY
BEGIN

  IMPORTING ppg_mt_native_spaces[C1,V,Value,domain] AS firstSpaces,
    ppg_mt_native_spaces[C2,V,Value,domain] AS secondSpaces,
    ppg_mt_read_probability[C1,V,Value,domain,spaces,laws] AS firstReads,
    ppg_mt_read_probability[C2,V,Value,domain,spaces,laws] AS secondReads,
    ppg_mt_state_probability[C1,V,Value,domain,universe,spaces,laws] AS firstLaw,
    ppg_mt_state_probability[C2,V,Value,domain,universe,spaces,laws] AS secondLaw

  state_sigma_eq: LEMMA firstSpaces.NativeStateSigma(spaces)=
    secondSpaces.NativeStateSigma(spaces)

  block_sigma_eq: LEMMA firstReads.StateBlockSigma(universe)=
    secondReads.StateBlockSigma(universe)

  state_decode_eq: LEMMA firstLaw.stateDecode=secondLaw.stateDecode

  state_measures_eq: THEOREM firstLaw.stateMeasure=secondLaw.stateMeasure

END ppg_mt_state_carrier_congruence
