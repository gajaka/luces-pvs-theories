% Reverse chronological finite histories retain exactly the labels they contain.
ppg_label_history[C: TYPE]: THEORY
BEGIN
  IMPORTING ppg_nasa_sigma[C], ppg_nat_list_code, ppg_tree_lists[C], ppg_list_maps[C, nat]
  Clog, Dlog: VAR [nat -> C]
  code: VAR [C -> nat]
  xs, ys: VAR list[C]
  a, fallback: VAR C
  n, k: VAR nat
  firstIndex(a, xs): RECURSIVE nat = CASES xs OF null: 0,
    cons(b, rest): IF a = b THEN 0 ELSE 1 + firstIndex(a, rest) ENDIF ENDCASES MEASURE length(xs)
  firstIndex_bound: LEMMA member(a, xs) IMPLIES firstIndex(a, xs) < length(xs)
  firstIndex_value: LEMMA member(a, xs) IMPLIES nth(xs, firstIndex(a, xs)) = a
  enumeration_code_injective: LEMMA (FORALL(a:C):member(a,xs)) IMPLIES
    injective?(LAMBDA(a:C):firstIndex(a,xs))
  wordCode(code, xs): nat = listCode(map(code)(xs))
  word_code_injective: LEMMA injective?(code) AND wordCode(code, xs) = wordCode(code, ys) IMPLIES xs = ys
  history(Clog, n): RECURSIVE list[C] = IF n = 0 THEN null
    ELSE cons(Clog(n - 1), history(Clog, n - 1)) ENDIF MEASURE n
  history_zero: LEMMA history(Clog, 0) = null
  history_succ: LEMMA history(Clog, n + 1) = cons(Clog(n), history(Clog, n))
  history_length: LEMMA length(history(Clog, n)) = n
  readHistory(fallback, xs, k): RECURSIVE C = CASES xs OF null: fallback,
    cons(a, rest): IF k = length(rest) THEN a ELSE readHistory(fallback, rest, k) ENDIF ENDCASES
    MEASURE length(xs)
  read_history: LEMMA k < n IMPLIES readHistory(fallback, history(Clog, n), k) = Clog(k)
  history_equal_upto: LEMMA history(Clog, n) = history(Dlog, n) AND k < n IMPLIES Clog(k) = Dlog(k)
END ppg_label_history
