% The infinite product of the coordinate laws is transported to LogSpace.
% Every finite block has the specified product marginal; no finite time
% horizon or common variable distribution is imposed.
%
% This constructs the independent resampling table used by Robin A. Moser
% and Gabor Tardos, Section 2: https://arxiv.org/abs/0903.0544v3
% Lean counterpart: PPGraphMoserTardosLogSpace.lean.
% The measure extension is proved in ppg_probability_premeasure_extension.

ppg_mt_log_probability[C, V, Value: TYPE, domain: [V -> set[Value]],
  (IMPORTING ppg_mt_native_spaces[C, V, Value, domain])
  spaces: VariableSpaces, laws: VariableLaws(spaces)]: THEORY
BEGIN

  table_domain_unfold: LEMMA TableDomain = LAMBDA (p: [nat, V]): domain(p`2)

  table_spaces_unfold: LEMMA TableSpaces(spaces) = LAMBDA (p: [nat, V]): spaces(p`2)

  IMPORTING ppg_probability_infinite_marginals[[nat, V], Value, TableDomain,
              TableSpaces(spaces), coinLaw(spaces, laws)],
            ppg_measurable_dependent_product, ppg_measurable_block_map,
            ppg_probability_map

  logProductSigma: ppg_measurable_space[LogSpace].MeasurableSpace =
    ppg_measurable_dependent_product[FullBlock, [nat, V], Value, TableDomain].nativeProduct(TableSpaces(spaces))

  log_target_sigma: LEMMA equalities[set[set[LogSpace]]].=(logProductSigma, NativeTableSigma(spaces))

  logMap(x: FullBlock): LogSpace = LAMBDA (p: [nat, V]): x(p)

  log_map_coordinate: LEMMA FORALL (p: [nat, V]):
    ppg_measurable_map[FullBlock, (TableDomain(p))].measurable(
      tableSigma, TableSpaces(spaces)(p), LAMBDA (x: FullBlock): logMap(x)(p))

  log_map_measurable: LEMMA ppg_measurable_map[FullBlock, LogSpace].measurable(
    tableSigma, NativeTableSigma(spaces), logMap)

  logMeasure: ppg_probability_measure[LogSpace, NativeTableSigma(spaces)].Probability =
    ppg_probability_map[FullBlock, LogSpace, tableSigma, NativeTableSigma(spaces)].pushforward(infiniteLaw, logMap)

  log_coin_event(n: nat, v: V, B: (spaces(v))): (NativeTableSigma(spaces)) =
    {omega: LogSpace | B(omega(n, v))}

  log_coin_preimage: LEMMA FORALL (n: nat, v: V, B: (spaces(v))):
    ppg_measurable_map[FullBlock, LogSpace].inverseImage(logMap, log_coin_event(n, v, B)) =
      blockCylinder(fullset[[nat, V]], (n, v), B)

  log_coin_mass: THEOREM FORALL (n: nat, v: V, B: (spaces(v))):
    logMeasure(log_coin_event(n, v, B)) = laws(v)(B)

  logBlock(F: set[[nat, V]])(omega: LogSpace): Block(F) = LAMBDA (p: (F)): omega(p)

  log_block_measurable: LEMMA FORALL (F: set[[nat, V]]):
    ppg_measurable_map[LogSpace, Block(F)].measurable(
      NativeTableSigma(spaces), blockSigma(F), logBlock(F))

  logFiniteMarginal(F: finite_set[[nat, V]]): BlockLaw(F) =
    ppg_probability_map[LogSpace, Block(F), NativeTableSigma(spaces), blockSigma(F)].pushforward(logMeasure, logBlock(F))

  log_block_preimage: LEMMA FORALL (F: set[[nat, V]], B: (blockSigma(F))):
    ppg_measurable_map[FullBlock, LogSpace].inverseImage(logMap,
      ppg_measurable_map[LogSpace, Block(F)].inverseImage(logBlock(F), B)) = tableCylinder(F, B)

  log_finite_marginal: THEOREM FORALL (F: finite_set[[nat, V]]):
    logFiniteMarginal(F) = finiteLaw(F)

END ppg_mt_log_probability
