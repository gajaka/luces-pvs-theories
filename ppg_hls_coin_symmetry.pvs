% Exchanging the two Boolean outcomes preserves their half-and-half law.
% The proof compares the mass of each actual inverse-image event.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Section 3.1. https://arxiv.org/abs/2111.06527
% Lean counterpart: PPGraphHLSRelativeCoins.lean.
ppg_hls_coin_symmetry: THEORY
BEGIN
  IMPORTING ppg_hls_fair_orientation,
    ppg_measurable_map[OrientationCoin,OrientationCoin] AS coinMaps,
    ppg_probability_map[OrientationCoin,OrientationCoin,
      OrientationSigma,OrientationSigma] AS coinLaw

  swapCoin(c:OrientationCoin): OrientationCoin = NOT c

  c: VAR OrientationCoin

  swapCoin_involutive: LEMMA swapCoin(swapCoin(c))=c

  measurable_swapCoin: THEOREM
    coinMaps.measurable(OrientationSigma,OrientationSigma,swapCoin)

  map_swapCoin: THEOREM coinLaw.pushforward(fairOrientation,swapCoin)=fairOrientation

  swapCoin_eta: LEMMA (LAMBDA(c:OrientationCoin):swapCoin(c))=swapCoin

  coin_identity_law: LEMMA
    coinLaw.pushforward(fairOrientation,LAMBDA(c:OrientationCoin):c)=fairOrientation

END ppg_hls_coin_symmetry
