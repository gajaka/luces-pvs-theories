% The input masses define a finite atomic probability law. Its image
% under the actual update agrees on every event with the atomic law of
% the computed transition row. Checked rows use the same probability law.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% Michael Mitzenmacher and Eli Upfal, Probability and Computing,
% second edition, Chapter 2, Cambridge University Press, 2017.
ppg_finite_update_law[State,Input: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)}]: THEORY
BEGIN
  IMPORTING ppg_finite_update[State,Input,universe,inputs],
    ppg_finite_atomic_probability[Input,inputs] AS inputAtoms,
    ppg_finite_atomic_probability[State,universe] AS stateAtoms,
    ppg_probability_measure[Input,inputAtoms.fullSigma] AS inputLaws,
    ppg_probability_measure[State,stateAtoms.fullSigma] AS stateLaws,
    ppg_probability_map[Input,State,inputAtoms.fullSigma,stateAtoms.fullSigma] AS imageLaw,
    ppg_finite_drift_row[State,universe] AS checkedRows,
    ppg_enn_ofreal

  ValidRule: TYPE = {R:Rule|Valid(R)}

  R: VAR ValidRule
  s,t: VAR State
  a: VAR Input
  B: VAR set[State]

  inputWeights(R): inputAtoms.NormalizedWeights = LAMBDA(a:Input):R`mass(a)

  inputPMF(R): inputLaws.Probability = inputAtoms.atomicLaw(inputWeights(R))

  updateMap(R,s): imageLaw.MeasurableMap = LAMBDA(a:Input):R`update(s,a)

  nextPMF(R,s): stateLaws.Probability = imageLaw.pushforward(inputPMF(R),updateMap(R,s))

  kernelWeights(R,s): stateAtoms.NormalizedWeights = LAMBDA(t:State):kernel(R,s,t)

  kernelLaw(R,s): stateLaws.Probability = stateAtoms.atomicLaw(kernelWeights(R,s))

  law_extensionality: LEMMA FORALL(P,Q:stateLaws.Probability):
    P=Q IFF (FORALL(B:(stateAtoms.fullSigma)):P(B)=Q(B))

  inputPMF_toReal: THEOREM inputPMF(R)(singleton[Input](a))=R`mass(a)

  state_indicator_product: LEMMA
    (LAMBDA(t:State):kernel(R,s,t)*(IF B(t) THEN 1 ELSE 0 ENDIF))=
    (LAMBDA(t:State):IF B(t) THEN kernel(R,s,t) ELSE 0 ENDIF)

  input_indicator_product: LEMMA
    (LAMBDA(a:Input):R`mass(a)*(IF B(R`update(s,a)) THEN 1 ELSE 0 ENDIF))=
    (LAMBDA(a:Input):IF B(R`update(s,a)) THEN R`mass(a) ELSE 0 ENDIF)

  weighted_event_mass: LEMMA
    ppg_finite_sum[State].fsum(universe,LAMBDA(t:State):IF B(t) THEN kernel(R,s,t) ELSE 0 ENDIF)=
    ppg_finite_sum[Input].fsum(inputs,LAMBDA(a:Input):IF B(R`update(s,a)) THEN R`mass(a) ELSE 0 ENDIF)

  next_event_mass: LEMMA nextPMF(R,s)(B)=
    ppg_finite_sum[Input].fsum(inputs,LAMBDA(a:Input):IF B(R`update(s,a)) THEN R`mass(a) ELSE 0 ENDIF)

  kernel_event_mass: LEMMA kernelLaw(R,s)(B)=
    ppg_finite_sum[State].fsum(universe,LAMBDA(t:State):IF B(t) THEN kernel(R,s,t) ELSE 0 ENDIF)

  nextPMF_kernel_law: LEMMA nextPMF(R,s)=kernelLaw(R,s)

  next_point_mass: LEMMA nextPMF(R,s)(singleton[State](t))=kernel(R,s,t)

  nextPMF_apply: THEOREM ennFinite(nextPMF(R,s)(singleton[State](t)))=ofReal(kernel(R,s,t))

  nextPMF_toReal: THEOREM nextPMF(R,s)(singleton[State](t))=kernel(R,s,t)

  checked_row_weights: LEMMA FORALL(R:ValidRule,
    W:checkedRows.checkedWitness(model(R)),s:State):
    checkedRows.rowVector(model(R),W,s)=kernelWeights(R,s)

  nextPMF_eq_checked_row: THEOREM FORALL(R:ValidRule,
    W:checkedRows.checkedWitness(model(R)),s:State):
    nextPMF(R,s)=checkedRows.rowPMF(model(R),W,s)

END ppg_finite_update_law
