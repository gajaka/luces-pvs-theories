% Counts are integrated under the original product-table law. Monotone
% convergence gives the ordinal-event sum, and the finite partition by
% labels gives the expected-work identity, including infinite values.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley,
% 1995, integrals of indicators and the monotone convergence theorem.
% Lean counterpart: PPGraphHLSPolicyCounting.lean, MTPolicy.
ppg_hls_policy_count_integral[C,V,Value:TYPE,domain:[V->set[Value]],
  footprint:[C->finite_set[V]],universe:{S:finite_set[C]|FORALL(a:C):S(a)},
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING ppg_mt_check_probability[C,V,Value,domain,spaces,laws])bad:NativeBad]: THEORY
BEGIN
  IMPORTING ppg_hls_policy_count_measurable[C,V,Value,domain,footprint,bad,universe,
      variableAmbient(spaces)],
    ppg_mt_policy_schedule[C,V,Value,domain,universe,variableAmbient(spaces)] AS integralSchedule,
    ppg_mt_policy_expectation[C,V,Value,domain,universe,spaces,laws] AS workExpectation,
    ppg_count_integral[LogSpace,NativeTableSigma(spaces),logMeasure] AS policyCountIntegral,
    ppg_extended_integral[LogSpace,NativeTableSigma(spaces),logMeasure] AS policyIntegral,
    ppg_event_partition_integral[LogSpace,C,NativeTableSigma(spaces),logMeasure] AS policyPartition,
    ppg_event_count[LogSpace] AS integralCounts

  sig: VAR PolicySchedule
  d: VAR PolicyData
  a: VAR C
  r,t,n: VAR nat
  omega: VAR LogSpace

  native_policy_bad_measurable: LEMMA integralSchedule.BadMeasurable(bad)

  resampling_event_native_measurable: LEMMA
    NativeTableSigma(spaces)(resamplingEvent(sig,a,t))

  ordinal_event_native_measurable: LEMMA NativeTableSigma(spaces)(ordinalOccurrence(sig,a,r))

  active_event_native_measurable: LEMMA NativeTableSigma(spaces)(activeEvents(sig)(t))

  nativeSelectedEvents(sig,a): [nat->(NativeTableSigma(spaces))] =
    selectedEvents(sig,a)

  nativeOrdinalEvents(sig,a): [nat->(NativeTableSigma(spaces))] =
    LAMBDA(r:nat):ordinalOccurrence(sig,a,r)

  nativeActiveEvents(sig): [nat->(NativeTableSigma(spaces))] =
    activeEvents(sig)

  expectedCount(sig,a): ENN = policyIntegral.lintegral(LAMBDA(omega:LogSpace):count(sig,omega,a))

  expected_count_ordinal_integral: LEMMA expectedCount(sig,a)=
    policyIntegral.lintegral(LAMBDA(omega:LogSpace):
      integralCounts.eventCount(nativeOrdinalEvents(sig,a),omega))

  expectedCount_eq_tsum_ordinalOccurrence: THEOREM expectedCount(sig,a)=
    ppg_nonneg_tsum[nat].tsum(LAMBDA(r:nat):logMeasure(nativeOrdinalEvents(sig,a)(r)))

  policy_prefix_partition: LEMMA policyPartition.partitionPrefixes(universe,
    nativeActiveEvents(sig),LAMBDA(a:C):nativeSelectedEvents(sig,a))

  policy_tLog_function: LEMMA
    (LAMBDA(omega:LogSpace):integralSchedule.tLog(footprint,bad,d`select(omega),omega))=
    (LAMBDA(omega:LogSpace):integralCounts.eventCount(activeEvents(d),omega))

  expected_work_integral: LEMMA workExpectation.expectedWork(footprint,bad,sig)=
    policyIntegral.lintegral(LAMBDA(omega:LogSpace):integralCounts.eventCount(nativeActiveEvents(sig),omega))

  expectedWork_eq_sum_expectedCount: THEOREM workExpectation.expectedWork(footprint,bad,sig)=
    ppg_nonneg_tsum[C].esum(universe,LAMBDA(a:C):expectedCount(sig,a))

END ppg_hls_policy_count_integral
