% A finite product of extended nonnegative factors is a commutative fold.
% The empty product is one and zero factors annihilate an infinite product
% factor, in agreement with the nonnegative integration convention.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% Finite products supply the decoration weights in
% PPGraphHLSDecoratedBudget.lean.
ppg_enn_products[T:TYPE]: THEORY
BEGIN
  IMPORTING ppg_enn_semiring,ppg_enn_ofreal,ppg_real_product_order[T],
    ppg_monoid_sum[T,ENN,ennFinite(1),emul] AS ennProducts
  F: VAR finite_set[T]
  f,g: VAR [T->ENN]
  x: VAR T
  h: VAR [T->real]

  eprod(F,f): ENN = ennProducts.sum(F,f)

  eprod_empty: LEMMA eprod(emptyset[T],f)=ennFinite(1)

  eprod_singleton: LEMMA eprod(singleton(x),f)=f(x)

  eprod_add: LEMMA NOT F(x) IMPLIES
    eprod(add(x,F),f)=emul(f(x),eprod(F,f))

  eprod_congr: LEMMA (FORALL(x:T):F(x) IMPLIES f(x)=g(x)) IMPLIES
    eprod(F,f)=eprod(F,g)

  eprod_rest: LEMMA NOT empty?(F) IMPLIES
    eprod(F,f)=emul(f(choose(F)),eprod(rest(F),f))

  ofReal_nonnegative: LEMMA FORALL(r:real):0<=r IMPLIES
    ofReal(r)=ennFinite(r)

  ofReal_times_nonnegative: LEMMA FORALL(r,s:real):0<=r AND 0<=s IMPLIES
    emul(ofReal(r),ofReal(s))=ofReal(r*s)

  eprod_ofReal_nonnegative: THEOREM NonnegativeFactors(h,F) IMPLIES
    eprod(F,LAMBDA(t:T):ofReal(h(t)))=ofReal(product(F,h))

END ppg_enn_products
