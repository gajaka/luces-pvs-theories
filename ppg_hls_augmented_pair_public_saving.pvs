% This public boundary states the saving bound directly for the actual
% augmented pair event. The four-block read and its mass calculations
% remain local dependencies of the saved proof.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Lemma 3.4, arXiv:2111.06527. Patrick Billingsley,
% Probability and Measure, third edition, Wiley, 1995: image measures.
% Lean counterpart: measureReal_augmentedPairCheck_le in
% PPGraphHLSAugmentedPair.lean; used by PPGraphHLSRefinedProbability.lean.
ppg_hls_augmented_pair_public_saving[C,V,Value:TYPE,domain:[V->set[Value]],
  variableUniverse:{U:finite_set[V]|U=fullset[V]},
  default:C,universe:{U:finite_set[C]|FORALL(c:C):U(c)},
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain])
  spaces:ppg_mt_coordinate_laws[C,V,Value,domain].VariableSpaces,
  laws:ppg_mt_coordinate_laws[C,V,Value,domain].VariableLaws(spaces),
  (IMPORTING ppg_mt_native_process[C,V,Value,domain,spaces,laws])
  process:ppg_mt_native_process[C,V,Value,domain,spaces,laws].MTProcess]: THEORY
  EXPORTING ALL WITH CLOSURE

BEGIN
  IMPORTING ppg_hls_augmented_pair_saving,
    ppg_hls_augmented_dependence,
    ppg_hls_augmented_pair_events[C,V,Value,domain,default,universe,
      spaces,laws,process],
    ppg_hls_augmented_space[C,V,Value,domain,spaces,laws],
    ppg_hls_table_events[C,V,Value,domain,spaces,laws,process],
    ppg_mt_state_probability[C,V,Value,domain,variableUniverse,
      spaces,laws],
    ppg_hls_witness_dag[C,
      ppg_shearer_bdd[C,V,process`footprint].dependencyGraph],
    ppg_hls_table_coordinates[C,V,process`footprint],
    ppg_hls_pair_keys[C,
      ppg_shearer_bdd[C,V,process`footprint].dependencyGraph]

  % The saving bound quantifies over the endpoints, matching and witness DAG.
  u,v: VAR ppg_hls_witness_dag[C,
    ppg_shearer_bdd[C,V,process`footprint].dependencyGraph].WNode

  matching: VAR ppg_hls_pair_keys[C,
    ppg_shearer_bdd[C,V,process`footprint].dependencyGraph].DependencyMatching

  dag: VAR ppg_hls_witness_dag[C,
    ppg_shearer_bdd[C,V,process`footprint].dependencyGraph].WitnessDAG

  delta: VAR real

  measureReal_augmentedPairCheck_le: THEOREM
    ppg_hls_witness_dag[C,ppg_shearer_bdd[C,V,process`footprint].dependencyGraph].Valid(dag) AND ppg_hls_witness_dag[C,ppg_shearer_bdd[C,V,process`footprint].dependencyGraph].Edge(dag)(u,v) AND
    ppg_hls_table_events[C,V,Value,domain,spaces,laws,process].badMeasurable AND delta>=0 AND
    delta<=ppg_mt_state_probability[C,V,Value,domain,variableUniverse,spaces,laws].stateMeasure(intersection(process`bad(u`1),process`bad(v`1))) IMPLIES
      ppg_hls_augmented_space[C,V,Value,domain,spaces,laws].augmentedMeasure(ppg_hls_augmented_pair_events[C,V,Value,domain,default,universe,spaces,laws,process].augmentedPairCheck(matching,dag,(u,v)))<=
        ppg_mt_state_probability[C,V,Value,domain,variableUniverse,spaces,laws].stateMeasure(process`bad(u`1))*
          ppg_mt_state_probability[C,V,Value,domain,variableUniverse,spaces,laws].stateMeasure(process`bad(v`1))-delta*delta/2

END ppg_hls_augmented_pair_public_saving
