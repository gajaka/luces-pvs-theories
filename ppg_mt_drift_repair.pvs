% A random-initialization drift certificate supplies a good target.
% For finitely many variables, the existing constant-table descent then
% gives a repair path from every initial state. Graph edges stay arbitrary.
%
% Robin A. Moser and Gabor Tardos, A constructive proof of the general
% Lovasz Local Lemma, Journal of the ACM 57(2), 2010, Section 2.
% Johannes Lengler, Drift Analysis, arXiv:1712.00964, Theorem 1.
ppg_mt_drift_repair[C,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_mt_coordinate_laws[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),fallback:C,
  eventOrder:{e:list[C]|FORALL(c:C):member(c,e)},
  (IMPORTING ppg_mt_observed_history[C,V,Value,domain,spaces,laws,fallback,eventOrder])
  vars:[C->finite_set[V]],
  B:ppg_mt_check_probability[C,V,Value,domain,spaces,laws].NativeBad,
  universe:{U:finite_set[V]|U=fullset[V]},Phi:MeasurablePotential]: THEORY
BEGIN
  IMPORTING ppg_mt_random_init_drift[C,V,Value,domain,spaces,laws,fallback,eventOrder,vars,B,Phi] AS repairDrift,
    ppg_mt_repair_target[C,V,Value,domain,universe] AS repairTarget,
    ppg_mt_reach[C,V,Value,domain] AS repairReach,
    ppg_mt_semantics[C,V,Value,domain] AS repairModel,
    ppg_repair_semantics[repairModel.MTState] AS repairSemantics,
    ppg_mt_termination[C,V,Value,domain,spaces,laws] AS repairTermination,
    ppg_mt_raw_active_expectation[C,V,Value,domain,spaces,laws,fallback,eventOrder] AS repairRaw

  State: TYPE = repairModel.MTState

  delta: VAR posreal
  edges: VAR [State,State->bool]

  mtRepairGraph_globally_repairable_of_drift: THEOREM FORALL(delta:posreal,T:repairDrift.MTCertificate(delta)):
    repairModel.mt_wf(vars,B) IMPLIES
    repairSemantics.globally_repairable(repairReach.mtRepairGraph(vars,B,fallback,repairRaw.nativeEnumeration,edges))

END ppg_mt_drift_repair
