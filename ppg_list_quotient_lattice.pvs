% Meet descends when every listed certificate is closed under meet.
% The quotient operation is the class generated by the meet of any two
% representatives. Its set definition quantifies over those representatives;
% the characterization theorem proves their independence without choice.
%
% B. A. Davey and H. A. Priestley, Introduction to Lattices and Order,
% second edition, Cambridge University Press, 2002. Lean counterpart:
% PPGraphParametricQuotient.lean, Section 7.
%
% Author: Dragan Stosic, 2026.

ppg_list_quotient_lattice[D: TYPE, Th: TYPE, le: (partial_order?[Th]),
  meet: {m: [Th, Th -> Th] | FORALL (a, b, c: Th):
    le(m(a, b), a) AND le(m(a, b), b) AND
    (le(c, a) AND le(c, b) IMPLIES le(c, m(a, b)))},
  join: {j: [Th, Th -> Th] | FORALL (a, b, c: Th):
    le(a, j(a, b)) AND le(b, j(a, b)) AND
    (le(a, c) AND le(b, c) IMPLIES le(j(a, b), c))}]: THEORY
BEGIN

  IMPORTING ppg_list_quotient[D, Th, le], ppg_certificate_lattice[D, Th, le, meet, join]

  F: VAR CertFamily
  d: VAR D
  t1, t2, t1p, t2p: VAR Th

  CertInfClosed(F): bool = meet_closed(F)

  certified_inf_closed_prime: THEOREM CertInfClosed(F) AND
    fully_certified(F)(d, t1) AND fully_certified(F)(d, t2) IMPLIES fully_certified(F)(d, meet(t1, t2))

  cert_inf_respects_equiv_prime: THEOREM CertInfClosed(F) AND
    cert_equiv(F)(t1, t1p) AND cert_equiv(F)(t2, t2p) IMPLIES
      cert_equiv(F)(meet(t1, t2), meet(t1p, t2p))

  meetClassSet(F)(Q1, Q2: set[Th]): set[Th] = {u: Th |
    EXISTS (a, b: Th): Q1(a) AND Q2(b) AND cert_equiv(F)(meet(a, b), u)}

  meet_class_char: LEMMA CertInfClosed(F) IMPLIES
    meetClassSet(F)(SpecClass(F)(t1), SpecClass(F)(t2)) = SpecClass(F)(meet(t1, t2))

  quotient_inf_ic(F: (CertInfClosed))(Q1, Q2: SpecQuotient(F)): SpecQuotient(F) = meetClassSet(F)(Q1, Q2)

  quotient_inf_ic_char: LEMMA FORALL (F: (CertInfClosed), t1, t2: Th):
    quotient_inf_ic(F)(quotient_mk(F)(t1), quotient_mk(F)(t2)) = quotient_mk(F)(meet(t1, t2))

  certified_sup_left: THEOREM fully_certified(F)(d, t1) IMPLIES fully_certified(F)(d, join(t1, t2))

  certified_sup_right: THEOREM fully_certified(F)(d, t2) IMPLIES fully_certified(F)(d, join(t1, t2))

END ppg_list_quotient_lattice
