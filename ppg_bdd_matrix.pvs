% The incidence Gram matrix counts shared variables.
ppg_bdd_matrix[C: TYPE, V: TYPE,
  universe: {s: finite_set[V] | FORALL (v: V): s(v)}]: THEORY
BEGIN
  IMPORTING ppg_bdd[C, V], ppg_finite_sum[V]
  vars: VAR CertVars
  c, d: VAR C
  v: VAR V
  incidenceMatrix(vars, c, v): real = IF vars(c)(v) THEN 1 ELSE 0 ENDIF
  incidenceGram(vars, c, d): real =
    fsum(universe, LAMBDA (v: V): incidenceMatrix(vars, c, v) * incidenceMatrix(vars, d, v))
  universe_intersection: LEMMA FORALL (P: set[V]): intersection(universe, P) = P
  incidenceMatrix_entry_mul: THEOREM
    incidenceMatrix(vars, c, v) * incidenceMatrix(vars, d, v) =
      IF intersection(vars(c), vars(d))(v) THEN 1 ELSE 0 ENDIF
  incidence_mul_transpose_apply: THEOREM incidenceGram(vars, c, d) = card(intersection(vars(c), vars(d)))
  dependent_iff_incidence_pos: THEOREM dependent(vars, c, d) IFF incidenceGram(vars, c, d) > 0
END ppg_bdd_matrix
