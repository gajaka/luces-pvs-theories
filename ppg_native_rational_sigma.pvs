% A finite sum of rational terms remains rational in the native real
% summation operator. This supplies the coefficient-domain obligation
% for the cofactor expansion of a rational matrix.
%
% Sheldon Axler, Linear Algebra Done Right, fourth edition, Springer, 2024.
% https://linear.axler.net/
ppg_native_rational_sigma: THEORY
BEGIN
  IMPORTING reals@sigma[nat] AS ns
  F: VAR [nat->rat]
  N: VAR nat

  nativeSum(F,N): real = ns.sigma(0,N,F)

  native_sum_zero: LEMMA nativeSum(F,0)=F(0)

  native_sum_succ: LEMMA nativeSum(F,N+1)=F(N+1)+nativeSum(F,N)

  native_sum_rational: THEOREM rational_pred(nativeSum(F,N))

END ppg_native_rational_sigma
