% Commuting rules have the same input masses. Their auxiliary finite
% input rules are therefore identical, so both their atomic input laws
% and their full constructed IID measures are equal.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_update_projection_input_law[State,Abstract,Input: TYPE,
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)},
  (IMPORTING ppg_finite_input_update[State,Input,inputs])
  R:{R:Rule|Valid(R)},
  (IMPORTING ppg_finite_input_update[Abstract,Input,inputs])
  Q:{Q:ppg_finite_input_update[Abstract,Input,inputs].Rule|
    ppg_finite_input_update[Abstract,Input,inputs].Valid(Q)}]: THEORY
BEGIN
  IMPORTING ppg_update_input_law[State,Input,inputs,R] AS inputEqSource,
    ppg_update_input_law[Abstract,Input,inputs,Q] AS inputEqTarget,
    ppg_finite_update_projection[State,Abstract,Input,inputs] AS inputEqCommutation

  p: VAR [State->Abstract]

  shadow_rule_equal: LEMMA inputEqCommutation.Commutes(R,Q,p) IMPLIES
    inputEqSource.shadowRule=inputEqTarget.shadowRule

  inputPMF_eq: THEOREM inputEqCommutation.Commutes(R,Q,p) IMPLIES
    inputEqSource.inputPMF=inputEqTarget.inputPMF

  iidMeasure_eq: THEOREM inputEqCommutation.Commutes(R,Q,p) IMPLIES
    inputEqSource.iidMeasure=inputEqTarget.iidMeasure

END ppg_update_projection_input_law
