% Reindexing a finite sum along an injective map preserves every summand.
ppg_sum_image[Source, Target: TYPE]: THEORY
BEGIN
  IMPORTING ppg_finite_sum[Source] AS domain, ppg_finite_sum[Target] AS codomain,
    ppg_real_sum[Target], ppg_real_sum[Source]
  S: VAR finite_set[Source]
  h: VAR [Source -> Target]
  f: VAR [Target -> real]
  x: VAR Source
  image_empty: LEMMA image(h, emptyset[Source]) = emptyset[Target]
  image_add: LEMMA image(h, add(x, S)) = add(h(x), image(h, S))
  fsum_image: THEOREM
    (FORALL (a, b: Source): S(a) AND S(b) AND h(a) = h(b) IMPLIES a = b) IMPLIES
      codomain.fsum(image(h, S), f) = domain.fsum(S, LAMBDA (a: Source): f(h(a)))
END ppg_sum_image
