% The numerical LLL criterion lies inside the strict Shearer region.
% The polynomial deletion ratios therefore bound conditional bad-event
% probabilities under the weaker non-neighbor lopsidependence hypothesis.
% A measurable cut converts the avoidance ratio into the numerator bound.
%
% Noga Alon and Joel H. Spencer, The Probabilistic Method, 4th ed.,
% Wiley, 2016, Lemma 5.1.1. For the lopsided condition, see David G.
% Harris, "Lopsidependency in the Moser-Tardos framework: Beyond the
% Lopsided Lovasz Local Lemma", Section 1.2, https://arxiv.org/abs/1610.02420.
% The Shearer ratio argument follows Nicholas J. A. Harvey and Jan Vondrak,
% "Short proofs for generalizations of the Lovasz Local Lemma: Shearer's
% condition and cluster expansion", Section 2, https://arxiv.org/abs/1711.06797.
% Lean counterpart: the final four results in PPGraphLopsidedLLL.lean.
ppg_lopsided_probability[X,C,V:TYPE,
  (IMPORTING ppg_measurable_space[X]) S:MeasurableSpace,
  (IMPORTING ppg_probability_measure[X,S]) mu:Probability,
  (IMPORTING ppg_bdd[C,V]) vars:CertVars]: THEORY
BEGIN
  IMPORTING ppg_lopsided_numerator[X,C,V,S,mu,vars],
    ppg_shearer_ppg[X,C,V,S,mu,vars],ppg_lll_shearer[C,dependencyGraph]
  A: VAR BadEvents
  B,T: VAR finite_set[C]
  i: VAR C
  x: VAR [C->real]
  eventWeights(A)(i:C): real = mass(A(i))
  avoidanceMass(A)(T:finite_set[C]): real = passProbability(mass,A,T)
  LopsidedConditions(A,x,B): bool = all_measurable(A) AND
    lll_lopsidependence(mass,A,B) AND lll_feasible(eventWeights(A),x,vars,B)
  graph_neighbors_match: LEMMA GraphNeighbors(B,i)=neighbors(vars,B,i)
  feasible_graph: LEMMA lll_feasible(eventWeights(A),x,vars,B) IMPLIES
    GraphFeasible(B,eventWeights(A),x)
  event_weights_on: LEMMA FORALL(i:C):B(i) IMPLIES 0<=eventWeights(A)(i)
  event_weights_upper: LEMMA FORALL(i:C):B(i) IMPLIES mass(A(i))<=eventWeights(A)(i)
  native_graph_lopsi: LEMMA lll_lopsidependence(mass,A,B) IMPLIES
    Lopsidependence(A,eventWeights(A),B)
  native_strict: LEMMA lll_feasible(eventWeights(A),x,vars,B) IMPLIES
    StrictCriterion(eventWeights(A),B)
  native_recurrences: LEMMA LopsidedConditions(A,x,B) IMPLIES
    Recurrences(B,eventWeights(A),avoidanceMass(A),polyFunction(eventWeights(A)),remote)
  added_sets: LEMMA subset?(T,B) AND B(i) AND NOT T(i) IMPLIES
    subset?(add(i,T),B) AND subset?(T,add(i,T)) AND add(i,T)(i) AND remove(i,add(i,T))=T
  native_polynomial_positive: LEMMA lll_feasible(eventWeights(A),x,vars,B) AND
    subset?(T,B) IMPLIES 0<polynomial(eventWeights(A),T)
  native_added_ratio: LEMMA lll_feasible(eventWeights(A),x,vars,B) AND
    subset?(T,B) AND B(i) AND NOT T(i) IMPLIES
      factors(x)(i)*polynomial(eventWeights(A),T)<=polynomial(eventWeights(A),add(i,T))
  native_cross_ratio: LEMMA LopsidedConditions(A,x,B) AND subset?(T,B) AND B(i) AND NOT T(i) IMPLIES
    polynomial(eventWeights(A),add(i,T))*passProbability(mass,A,T)<=
      passProbability(mass,A,add(i,T))*polynomial(eventWeights(A),T)
  native_avoidance_ratio: LEMMA LopsidedConditions(A,x,B) AND subset?(T,B) AND B(i) AND NOT T(i) IMPLIES
    factors(x)(i)*passProbability(mass,A,T)<=passProbability(mass,A,add(i,T))
  avoidance_cut_set: LEMMA difference(all_pass(A,T),A(i))=all_pass(A,add(i,T))
  avoidance_cut: LEMMA all_measurable(A) IMPLIES
    mass(intersection(A(i),all_pass(A,T)))+passProbability(mass,A,add(i,T))=passProbability(mass,A,T)
  lopsided_lll_key_bound: THEOREM all_measurable(A) AND lll_lopsidependence(mass,A,B) AND
    lll_feasible(eventWeights(A),x,vars,B) AND subset?(T,B) AND B(i) AND NOT T(i) IMPLIES
      mass(intersection(A(i),all_pass(A,T)))<=x(i)*passProbability(mass,A,T)
  lopsided_lll_good_event_lower_bound: THEOREM all_measurable(A) AND lll_lopsidependence(mass,A,B) AND
    lll_feasible(eventWeights(A),x,vars,B) IMPLIES product(B,factors(x))<=passProbability(mass,A,B)
  lopsided_lll_positive_probability: THEOREM all_measurable(A) AND lll_lopsidependence(mass,A,B) AND
    lll_feasible(eventWeights(A),x,vars,B) IMPLIES 0<passProbability(mass,A,B)
  lopsided_lll_good_state_exists: THEOREM all_measurable(A) AND lll_lopsidependence(mass,A,B) AND
    lll_feasible(eventWeights(A),x,vars,B) IMPLIES EXISTS(w:X):all_pass(A,B)(w)
END ppg_lopsided_probability
