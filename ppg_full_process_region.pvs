% Full resampling may have finite expected work where the current
% strict Shearer and HLS tests fail. This sufficient region compares
% the actual event probabilities; it makes no completeness claim for
% arbitrary footprints or for the complement of those tests.
%
% Michael Mitzenmacher and Eli Upfal, Probability and Computing,
% second edition, Cambridge University Press, 2017, geometric distribution.
% Nicholas J. A. Harvey and Jan Vondrak, "Short proofs for generalizations
% of the Lovasz Local Lemma: Shearer's condition and cluster expansion",
% arXiv:1711.06797, Section 2.
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", arXiv:2111.06527, Section 2.3.
ppg_full_process_region[C,V,Value:TYPE,domain:[V->set[Value]],
  universe:{U:finite_set[V]|FORALL(v:V):U(v)},
  events:{U:finite_set[C]|FORALL(c:C):U(c)},variables:[C->finite_set[V]],v0:V,
  (IMPORTING ppg_mt_coordinate_laws[C,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),fallback:C,p:[C->real]]: THEORY
BEGIN
  IMPORTING ppg_full_footprint_graph[C,V,universe,variables,v0] AS fullGraph,
    ppg_shearer_bdd[C,V,variables] AS graph,
    ppg_full_resampling_probability[C,V,Value,domain,universe,events,spaces,laws] AS probability,
    ppg_full_resampling_mean[C,V,Value,domain,universe,events,spaces,laws,fallback] AS mean,
    ppg_full_resampling_paths[C,V,Value,domain,universe] AS paths,
    ppg_mt_semantics[C,V,Value,domain] AS semantics,
    ppg_mt_time_expectation[C,V,Value,domain,spaces,laws] AS legacy,
    ppg_mt_native_spaces[C,V,Value,domain] AS nativeSpaces,
    ppg_measurable_block_box[V,Value,domain,spaces] AS boxes,
    ppg_shearer_polynomial[C,graph.dependencyGraph] AS polynomial,
    ppg_complete_graph_region[C,graph.dependencyGraph,events,p] AS region,
    ppg_hls_matching[C,graph.dependencyGraph,p] AS hls,
    ppg_finite_sum[C] AS sums

  universe_full: LEMMA universe=fullset[V]

  IMPORTING ppg_mt_state_probability[C,V,Value,domain,universe,spaces,laws] AS stateLaw

  B: VAR probability.MeasurableBad
  enumeration: VAR legacy.FullEnumeration
  E: VAR boxes.CoordinateEvents

  badEvent(B:probability.MeasurableBad,c:C): (nativeSpaces.NativeStateSigma(spaces)) = {s:semantics.MTState|B(c,s)}

  ActualProbabilities(B): bool = FORALL(c:C):stateLaw.stateMeasure(badEvent(B,c))=p(c)

  dependency_complete: LEMMA paths.Full(variables) IMPLIES region.Complete

  fullResampling_certified_outside_graph_region: THEOREM
    paths.Full(variables) AND 0<probability.mtGoodProbability(B) AND ActualProbabilities(B) AND
    1<=sums.fsum(events,region.floorWeight) IMPLIES
      ennFinite?(mean.expectedWork(variables,B,enumeration)) AND
      NOT polynomial.StrictCriterion(p,events) AND
      (FORALL(D:hls.OverlapBounds):NOT polynomial.StrictCriterion(hls.reduced(D),events))

  fullResampling_box_certified_outside_graph_region: THEOREM
    paths.Full(variables) AND probability.SafeBox(B,E) AND (FORALL(v:V):0<laws(v)(E(v))) AND
    ActualProbabilities(B) AND 1<=sums.fsum(events,region.floorWeight) IMPLIES
      ennFinite?(mean.expectedWork(variables,B,enumeration)) AND
      NOT polynomial.StrictCriterion(p,events) AND
      (FORALL(D:hls.OverlapBounds):NOT polynomial.StrictCriterion(hls.reduced(D),events))

END ppg_full_process_region
