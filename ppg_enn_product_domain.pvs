% Inclusion identifies the finite node subtype with its ambient set.
% The multiplicative fold is therefore the same on both domains,
% including the empty domain and zero or infinite factors.
%
% Paul R. Halmos, Naive Set Theory, Van Nostrand, 1960.
% Multiplicative counterpart of ppg_enn_finite_domain.
ppg_enn_product_domain[T:TYPE,S:finite_set[T]]: THEORY
BEGIN
  IMPORTING ppg_enn_products[T] AS carrierProducts,
    ppg_enn_products[(S)] AS domainProducts,
    ppg_monoid_image[(S),T,ENN,ennFinite(1),emul] AS reindex

  f: VAR [T->ENN]
  H: VAR finite_set[(S)]

  inclusion(x:(S)): T = x

  indexFull: finite_set[(S)] = restrict[T,(S),bool](S)

  indexFull_member: LEMMA FORALL(x:(S)):indexFull(x)

  inclusion_injective: LEMMA injective?(inclusion)

  inclusion_full_image: LEMMA image(inclusion,indexFull)=S

  partial_product_image: LEMMA
    domainProducts.eprod(H,LAMBDA(x:(S)):f(x))=carrierProducts.eprod(image(inclusion,H),f)

  full_product_image: LEMMA
    domainProducts.eprod(indexFull,LAMBDA(x:(S)):f(x))=carrierProducts.eprod(S,f)

END ppg_enn_product_domain
