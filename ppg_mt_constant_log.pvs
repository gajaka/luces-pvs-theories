% A fixed good target supplies every row of a constant resampling table.
% Every active step strictly reduces the finite set of coordinates that
% disagree with the target. A good state is reached within its initial
% cardinality. This is an existential path, with no claim that this
% particular constant table has positive probability.
%
% Lean counterpart: PPGraphMoserTardosConstantLog.lean.

ppg_mt_constant_log[C, V, Value: TYPE, domain: [V -> set[Value]],
  universe: {U: finite_set[V] | FORALL (v: V): U(v)}]: THEORY
BEGIN
  IMPORTING ppg_mt_selection[C, V, Value, domain], ppg_nat_descent
  vars: VAR CertVars
  bad: VAR [C, MTState -> bool]
  fallback, c: VAR C
  enumeration: VAR list[C]
  s, z, initial: VAR MTState
  F: VAR finite_set[V]
  v: VAR V
  t: VAR nat
  mtMismatch(s, z): finite_set[V] = intersection(universe, {v: V | s(v) /= z(v)})
  mem_mtMismatch: THEOREM mtMismatch(s, z)(v) IFF s(v) /= z(v)
  mtMismatch_resample_subset: THEOREM subset?(mtMismatch(resample(F, s, z), z), mtMismatch(s, z))
  mtMismatch_resample_ssubset: THEOREM mt_wf(vars, bad) AND MTGood(bad, z) AND bad(c, s) IMPLIES
    strict_subset?(mtMismatch(resample(vars(c), s, z), z), mtMismatch(s, z))
  mtMismatch_card_randTraj_constantLog_lt: THEOREM mt_wf(vars, bad) AND MTGood(bad, z) AND
    completeEnumeration(enumeration) AND
    NOT MTGood(bad, randTraj(vars, bad, fallback, enumeration, initial, constantLog(z), t)) IMPLIES
    card(mtMismatch(randTraj(vars, bad, fallback, enumeration, initial, constantLog(z), t + 1), z)) <
    card(mtMismatch(randTraj(vars, bad, fallback, enumeration, initial, constantLog(z), t), z))
  exists_good_randTraj_constantLog_le_mismatch: THEOREM mt_wf(vars, bad) AND MTGood(bad, z) AND
    completeEnumeration(enumeration) IMPLIES EXISTS (t: nat): t <= card(mtMismatch(initial, z)) AND
      MTGood(bad, randTraj(vars, bad, fallback, enumeration, initial, constantLog(z), t))
  exists_good_randTraj_constantLog: THEOREM mt_wf(vars, bad) AND MTGood(bad, z) AND
    completeEnumeration(enumeration) IMPLIES EXISTS (t: nat): t <= card(universe) AND
      MTGood(bad, randTraj(vars, bad, fallback, enumeration, initial, constantLog(z), t))
END ppg_mt_constant_log
