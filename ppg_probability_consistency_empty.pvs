% Uniqueness and coherence remain valid when both coordinate and value types are empty.
ppg_probability_consistency_empty: THEORY
BEGIN
  IMPORTING ppg_probability_finite_empty
  emptyPick(F: non_empty_finite_set[Empty]): (F) = choose(F)
  IMPORTING ppg_probability_finite_choice[Empty, Empty, domain, spaces, coins, emptyPick]
  empty_choice: LEMMA selectedLaw(emptyset[Empty]) = emptyLaw
  empty_coherence: LEMMA marginal(emptyset[Empty], emptyset[Empty])(
    selectedLaw(emptyset[Empty])) = emptyLaw
END ppg_probability_consistency_empty
