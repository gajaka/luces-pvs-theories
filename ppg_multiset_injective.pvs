% An injective finite image has multiplicity at most one at every label.
ppg_multiset_injective[A, B: TYPE]: THEORY
BEGIN
  IMPORTING ppg_finite_multiset[A, B]
  S: VAR finite_set[A]
  f: VAR [A -> B]
  mapBag_nodup_of_injective: THEOREM
    (FORALL (x, y: A): S(x) AND S(y) AND f(x) = f(y) IMPLIES x = y)
    IMPLIES Nodup(mapBag(S, f))
END ppg_multiset_injective
