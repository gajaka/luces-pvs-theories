% The observed history is generated by inverse images of measurable
% state events at times already visited. Its least-sigma-algebra
% property identifies the join of those comaps. Ambient measurability
% of every observation makes the history a filtration below the
% original sigma algebra.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_observed_filtration[Omega,State:TYPE,
  (IMPORTING ppg_measurable_space[Omega],ppg_measurable_space[State])
  ambient:ppg_measurable_space[Omega].MeasurableSpace,
  stateSigma:ppg_measurable_space[State].MeasurableSpace]: THEORY
BEGIN
  IMPORTING ppg_measurable_space[Omega] AS setsSigma,
    ppg_measurable_map[Omega,State] AS observations,
    ppg_filtration[Omega,State,ambient] AS histories

  RawProcess: TYPE = [nat->[Omega->State]]

  X: VAR RawProcess
  n,k,i,j: VAR nat
  A: VAR set[Omega]
  B: VAR set[State]
  G,K: VAR set[set[Omega]]
  H: VAR ppg_measurable_space[Omega].MeasurableSpace

  generators(X,n): set[set[Omega]] = {A:set[Omega]|EXISTS(k:nat,B:set[State]):
    k<=n AND stateSigma(B) AND A=observations.inverseImage(X(k),B)}

  history(X,n): ppg_measurable_space[Omega].MeasurableSpace = setsSigma.generated(generators(X,n))

  processMeasurable(X): bool = FORALL(n:nat):observations.measurable(ambient,stateSigma,X(n))

  generated_monotone: LEMMA subset?(G,K) IMPLIES subset?(setsSigma.generated(G),setsSigma.generated(K))

  observation_generator: LEMMA k<=n AND stateSigma(B) IMPLIES
    generators(X,n)(observations.inverseImage(X(k),B))

  observation_event: LEMMA k<=n AND stateSigma(B) IMPLIES
    history(X,n)(observations.inverseImage(X(k),B))

  observation_measurable: LEMMA k<=n IMPLIES observations.measurable(history(X,n),stateSigma,X(k))

  generators_monotone: LEMMA i<=j IMPLIES subset?(generators(X,i),generators(X,j))

  history_increasing: LEMMA i<=j IMPLIES subset?(history(X,i),history(X,j))

  generators_ambient: LEMMA processMeasurable(X) IMPLIES subset?(generators(X,n),ambient)

  history_ambient: LEMMA processMeasurable(X) IMPLIES subset?(history(X,n),ambient)

  history_least: LEMMA (FORALL(k:nat):k<=n IMPLIES observations.measurable(H,stateSigma,X(k))) IMPLIES
    subset?(history(X,n),H)

  MeasurableProcess: TYPE = {X:RawProcess|processMeasurable(X)}

  Y: VAR MeasurableProcess

  observedFiltration(Y): histories.Filtration = LAMBDA(n:nat):history(Y,n)

  observations_adapted: LEMMA histories.adapted(observedFiltration(Y),stateSigma,Y)

END ppg_observed_filtration
