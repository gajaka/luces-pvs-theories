% Count work by its event labels in the same global MT run. The distinct
% full BDD components partition those labels, so their extended counts
% sum to the stopped log length on every table, including infinite runs.
% The partition is Dragan Stosic's blocking dependency decomposition.
% Lean counterpart: PPGraphShearerBDDExpectation.lean.
ppg_shearer_component_counts[C,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_bdd[C,V]) vars:CertVars]: THEORY
BEGIN
  IMPORTING ppg_mt_count_decomposition[C,V,Value,domain],
    ppg_shearer_witness[C,V,vars], ppg_enn_bdd_partition[C,V]

  ComponentEnumeration: TYPE = {xs:list[C]|completeEnumeration(xs)}

  bad: VAR [C,MTState->bool]
  fallback: VAR C
  enumeration: VAR ComponentEnumeration
  omega: VAR LogSpace
  K: VAR finite_set[C]
  B: VAR UniversalLabels

  randomInitSetResamplingCount(bad,fallback,enumeration,K,omega): ENN =
    ppg_nonneg_tsum[C].esum(K,LAMBDA(a:C):randomInitResamplingCount(vars,bad,fallback,enumeration,omega,a))

  component_full_labels: LEMMA labelUniverse(enumeration)=B

  component_count_sum: LEMMA
    (LAMBDA(K:finite_set[C]):randomInitSetResamplingCount(bad,fallback,enumeration,K,omega))=
    (LAMBDA(K:finite_set[C]):ppg_nonneg_tsum[C].esum(K,
      LAMBDA(a:C):randomInitResamplingCount(vars,bad,fallback,enumeration,omega,a)))

  randomInitTLog_eq_sum_componentCounts: THEOREM randomInitTLog(vars,bad,fallback,enumeration,omega)=
    ppg_nonneg_tsum[finite_set[C]].esum(groups(vars,B),
      LAMBDA(K:finite_set[C]):randomInitSetResamplingCount(bad,fallback,enumeration,K,omega))

END ppg_shearer_component_counts
