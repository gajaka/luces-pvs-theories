% The finite Boolean problem defines the same bad sets and footprints
% in the native MT process. Its variable spaces and probability laws
% are precisely the finite marginal laws of the resampling rule.
%
% Robin A. Moser and Gabor Tardos, "A constructive proof of the general
% Lovasz Local Lemma", arXiv:0903.0544v3, Algorithm 1.1.
ppg_resampling_mt_process[I,V,Value: TYPE,
  variables:{U:finite_set[V]|FORALL(v:V):U(v)},
  domains:[V->finite_set[Value]],
  events:{U:finite_set[I]|FORALL(i:I):U(i)},
  (IMPORTING ppg_finite_resampling_core[V,Value,variables,domains])
  Q:{Q:Marginals|Valid(Q)}]: THEORY
BEGIN
  State: TYPE = ppg_finite_resampling_core[V,Value,variables,domains].State

  plainDomain: MACRO [V->set[Value]] = LAMBDA(v:V):domains(v)

  IMPORTING ppg_finite_resampling_core[V,Value,variables,domains] AS mtCore,
    ppg_resampling_selection[I,V,Value,variables,domains,events] AS mtSelection,
    ppg_resampling_product_law[V,Value,variables,domains,Q] AS mtProduct,
    ppg_mt_coordinate_laws[I,V,Value,plainDomain] AS mtCoordinates,
    ppg_mt_semantics[I,V,Value,plainDomain] AS mtSemantics

  varSpaces: MACRO mtCoordinates.VariableSpaces = mtProduct.spaces

  varLaws: MACRO mtCoordinates.VariableLaws(varSpaces) = mtProduct.coins

  IMPORTING ppg_mt_native_process[I,V,Value,plainDomain,varSpaces,varLaws] AS mtInstance

  B: VAR mtSelection.Problem
  choose: VAR [State->I]
  s,fresh: VAR State
  i: VAR I
  F: VAR finite_set[V]

  mtProcess(B): mtInstance.MTProcess =
    (# bad:=LAMBDA(i:I):{s:State|B`bad(i,s)},footprint:=B`footprint #)

  mtProcess_bad_iff: THEOREM mtProcess(B)`bad(i)(s) IFF B`bad(i,s)

  process_footprint: LEMMA mtProcess(B)`footprint=B`footprint

  allGood_iff_no_mt_violation: THEOREM mtSelection.allGood(B,s) IFF
    mtInstance.violated(mtProcess(B),s)=emptyset[I]

  coordinate_resample: LEMMA mtCore.coordinateUpdate(F,s,fresh)=mtSemantics.resample(F,s,fresh)

  selected_update_eq_mt_resample: THEOREM NOT mtSelection.allGood(B,s) IMPLIES
    mtCore.rule(Q,mtSelection.selectedPolicy(B,choose))`update(s,fresh)=
      mtSemantics.resample(mtProcess(B)`footprint(choose(s)),s,fresh)

END ppg_resampling_mt_process
