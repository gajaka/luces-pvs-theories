% Truncating and ordering a well-formed depth-separated tree gives a
% member of Pegden's finite family. Each chosen child inherits depth
% separation, and the immediate child-label set is independent.
%
% Membership needs neither properness of the input nor enough fuel to
% reach its leaves. Taking fuel equal to the depth gives the usual
% canonical representative used in the occurrence argument.
%
% Wesley Pegden, "An extension of the Moser-Tardos algorithmic local
% lemma", Theorem 1.4. https://arxiv.org/abs/1102.2853
% Lean counterpart: canonicalizeFuel_mem_treesUpTo and canonicalize_mem_treesUpTo
% in PPGraphMoserTardosPegden.lean.
ppg_pegden_canonical[C,V:TYPE]: THEORY
BEGIN
  IMPORTING ppg_pegden_depth[C,V],ppg_pegden_enumeration[C,V],ppg_rose_canonical_enum[C,V]
  vars: VAR CertVars
  U: VAR finite_set[C]
  n: VAR nat
  t: VAR WTree
  pegden_fuel_children_valid: LEMMA fullUniverse(U) AND
    (FORALL(c:WTree):fullUniverse(U) AND wellFormed(vars)(c) AND depthSeparated(vars,c) IMPLIES
      pegdenTreesUpTo(vars,U,n,roseLabel(c))(canonicalFuel(n,c))) AND
    wellFormed(vars)(t) AND depthSeparated(vars,t) IMPLIES
      choiceValid(labelSet(t),LAMBDA(b:C):pegdenTreesUpTo(vars,U,n,b),LAMBDA(b:C):canonicalFuel(n,childFor(t,b)))
  canonicalizeFuel_mem_treesUpTo: THEOREM FORALL(n:nat,vars:CertVars,U:finite_set[C]):FORALL(t:WTree):
    fullUniverse(U) AND wellFormed(vars)(t) AND depthSeparated(vars,t) IMPLIES
      pegdenTreesUpTo(vars,U,n,roseLabel(t))(canonicalFuel(n,t))
  canonicalize_mem_treesUpTo: THEOREM fullUniverse(U) AND wellFormed(vars)(t) AND depthSeparated(vars,t) IMPLIES
    pegdenTreesUpTo(vars,U,depth(t),roseLabel(t))(canonicalize(t))
END ppg_pegden_canonical
