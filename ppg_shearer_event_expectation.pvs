% Sequence occurrences have zero mass outside the proper stable family.
% Their unrestricted sum bounds the expected number of resamplings of
% one event. Strict Shearer positivity bounds that sum by its singleton
% coefficient ratio, before any termination or finiteness is known.
%
% Kolipaka--Szegedy bound, presented by Jan Vondrak, MATH233A (2018),
% Lecture 8. https://theory.stanford.edu/~jvondrak/MATH233A-2018/Math233-lec08.pdf
% Lean counterpart: PPGraphShearerExpectation.lean.
ppg_shearer_event_expectation[C,V,Value:TYPE,domain:[V->set[Value]],
  universe:{F:finite_set[V]|F=fullset[V]},
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain]) spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING ppg_bdd[C,V]) vars:CertVars]: THEORY
BEGIN
  IMPORTING ppg_shearer_sequence_probability[C,V,Value,domain,universe,spaces,laws,vars],
    ppg_shearer_family[C,dependencyGraph], ppg_nonneg_tsum_order[LayerSeq], ppg_enn_add
  bad: VAR NativeBad
  fallback,a: VAR C
  enumeration: VAR SeqProbabilityEnumeration
  B: VAR UniversalLabels
  L: VAR LayerSeq
  p: VAR [C->real]

  native_event_prob_bounds: LEMMA (FORALL(c:C):baseProbability(bad)(c)<=p(c)) IMPLIES
    (FORALL(c:C):0<=p(c) AND baseProbability(bad)(c)<=p(c))

  bounds_nonnegative_on: LEMMA (FORALL(c:C):0<=p(c) AND baseProbability(bad)(c)<=p(c)) IMPLIES
    nonnegativeOn(p,B)

  singleton_conditions: LEMMA subset?(sets[C].singleton(a),B) AND
    Independent(sets[C].singleton(a))

  logMeasure_sequenceOccurrence_le_properFamilyWeight: THEOREM mt_wf(vars,bad) AND
    (FORALL(c:C):0<=p(c) AND baseProbability(bad)(c)<=p(c)) IMPLIES
    logMeasure(sequenceEvent(bad,fallback,enumeration,a,L))<=properWeights(p,B,sets[C].singleton(a))(L)

  randomInitExpectedResamplingCount_le_tsum_properFamilyWeight: THEOREM mt_wf(vars,bad) AND
    (FORALL(c:C):0<=p(c) AND baseProbability(bad)(c)<=p(c)) IMPLIES
    ele(randomInitExpectedResamplingCount(vars,bad,fallback,enumeration,a),
      properFamilyTotal(p,B,sets[C].singleton(a)))

  randomInitExpectedResamplingCount_le_stableBudget_of_measure_le: THEOREM mt_wf(vars,bad) AND
    (FORALL(c:C):0<=p(c) AND baseProbability(bad)(c)<=p(c)) AND StrictCriterion(p,B) IMPLIES
    ele(randomInitExpectedResamplingCount(vars,bad,fallback,enumeration,a),
      ennFinite(max(0,stableBudget(p,B,sets[C].singleton(a)))))

  randomInitExpectedResamplingCount_le_stableBudget: THEOREM mt_wf(vars,bad) AND
    (FORALL(c:C):baseProbability(bad)(c)<=p(c)) AND StrictCriterion(p,B) IMPLIES
    ele(randomInitExpectedResamplingCount(vars,bad,fallback,enumeration,a),
      ennFinite(max(0,stableBudget(p,B,sets[C].singleton(a)))))

END ppg_shearer_event_expectation
