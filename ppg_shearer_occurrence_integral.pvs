% An injective natural code makes the layer-sequence family countable.
% The pointwise occurrence count can then be integrated by monotone
% convergence. The resulting identity allows infinite resampling counts
% and expectations; no termination premise is used.
%
% Noga Alon and Joel H. Spencer, The Probabilistic Method, fourth edition
% (2016), Section 5.7. Lean counterpart: PPGraphShearerOccurrence.lean.
ppg_shearer_occurrence_integral[C,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_mt_native_spaces[C,V,Value,domain]) spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING ppg_bdd[C,V]) vars:CertVars]: THEORY
BEGIN
  IMPORTING ppg_shearer_occurrence[C,V,Value,domain,vars],
    ppg_layer_sequence_code[C], ppg_mt_time_expectation[C,V,Value,domain,spaces,laws],
    ppg_coded_event_integral[LogSpace,LayerSeq,NativeTableSigma(spaces),logMeasure]
  bad: VAR NativeBad
  fallback,a: VAR C
  enumeration: VAR FullEnumeration
  L: VAR LayerSeq
  omega: VAR LogSpace

  native_sequence_measurable: LEMMA NativeTableSigma(spaces)(sequenceOccurrence(bad,fallback,enumeration,a,L))

  sequenceEvents(bad,fallback,enumeration,a): [LayerSeq->(NativeTableSigma(spaces))] =
    LAMBDA(L:LayerSeq):sequenceOccurrence(bad,fallback,enumeration,a,L)

  eventLabelCode(enumeration)(c:C): nat = firstIndex(c,enumeration)

  layerSequenceCode(enumeration): Code = sequenceCode(eventLabelCode(enumeration))

  sequence_indicator_event: LEMMA nnEvent(sequenceEvents(bad,fallback,enumeration,a),omega)=
    sequenceWeightsNN(bad,fallback,enumeration,omega,a)

  sequence_count_function: LEMMA
    (LAMBDA(omega:LogSpace):randomInitResamplingCount(vars,bad,fallback,enumeration,omega,a))=
    (LAMBDA(omega:LogSpace):ppg_nonneg_tsum[LayerSeq].tsum(nnEvent(sequenceEvents(bad,fallback,enumeration,a),omega)))

  randomInitExpectedResamplingCount_eq_tsum_sequenceOccurrence: THEOREM
    randomInitExpectedResamplingCount(vars,bad,fallback,enumeration,a)=
      ppg_nonneg_tsum[LayerSeq].tsum(LAMBDA(L:LayerSeq):logMeasure(sequenceEvents(bad,fallback,enumeration,a)(L)))

END ppg_shearer_occurrence_integral
