% A preserved observation can separate the initial state from every good state.
ppg_conserved_quantity[State: TYPE, C: TYPE, Value: TYPE]: THEORY
BEGIN
  IMPORTING ppg_reachability_refutation[State, C]

  conserved_quantity_refutes: THEOREM
    FORALL (step: [State, State -> bool], good: set[State],
      quantity: [State -> Value], target: Value, v: State):
      (FORALL (u, w: State): step(u, w) IMPLIES quantity(w) = quantity(u)) AND
      (FORALL (w: State): good(w) IMPLIES quantity(w) = target) AND quantity(v) /= target
      IMPLIES NOT EXISTS (w: State): Reach(step)(v, w) AND good(w)

END ppg_conserved_quantity
