% A sum over pairwise disjoint finite sets equals the sum over their union.
ppg_partition_sum[T, R: TYPE, zero: R,
  plus: {op: [R, R -> R] |
    identity?[R](op)(zero) AND associative?[R](op) AND commutative?[R](op)}]: THEORY
BEGIN
  IMPORTING ppg_finite_union[T], ppg_finite_induction[finite_set[T]]
  IMPORTING ppg_monoid_sum[T, R, zero, plus] AS elements
  IMPORTING ppg_monoid_sum[finite_set[T], R, zero, plus] AS families
  F: VAR finite_set[finite_set[T]]
  f: VAR [T -> R]
  sum_familyUnion: THEOREM pairwise_disjoint(F) IMPLIES
    families.sum(F, LAMBDA (K: finite_set[T]): elements.sum(K, f)) =
      elements.sum(familyUnion(F), f)
END ppg_partition_sum
