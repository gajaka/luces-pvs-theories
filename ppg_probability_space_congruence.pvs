% Equal sigma algebras give the same probability predicate on a fixed
% carrier. Countable additivity is transported by equality of the event
% predicates, including the typing of disjoint measurable families.
ppg_probability_space_congruence[X:TYPE,
  (IMPORTING ppg_measurable_space) SX,SY:ppg_measurable_space[X].MeasurableSpace,
  (IMPORTING ppg_probability_measure) mu:ppg_probability_measure[X,SX].Probability]: THEORY
BEGIN
  space_probability_target: THEOREM SX=SY IMPLIES
    ppg_probability_measure[X,SY].probability?(mu)

END ppg_probability_space_congruence
