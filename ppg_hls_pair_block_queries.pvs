% The two endpoints read private blocks once and the shared block twice.
% Along an edge, each shared variable has strictly increasing local indices;
% the four complete addresses are therefore distinct. Event reconstruction
% uses the original process locality, including for a raw witness DAG.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Proposition 3.3 and proof of Lemma 3.4.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% Lean counterpart: PPGraphHLSBlockQueries.lean.
ppg_hls_pair_block_queries[I,V,Value:TYPE,domain:[V->set[Value]],
  (IMPORTING ppg_mt_native_spaces[I,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces),
  (IMPORTING ppg_mt_native_process[I,V,Value,domain,spaces,laws])
  process:MTProcess,
  (IMPORTING ppg_hls_table_coordinates[I,V,process`footprint])
  u,v:WNode]: THEORY
BEGIN
  IMPORTING ppg_hls_process_footprint[I,V,Value,domain,spaces,laws] AS blocks,
    ppg_hls_table_events[I,V,Value,domain,spaces,laws,process] AS events,
    ppg_hls_table_coordinates[I,V,process`footprint] AS coordinates

  F:MACRO finite_set[V] = blocks.sourcePrivate(process,u`1,v`1)

  H:MACRO finite_set[V] = blocks.sharedVariables(process,u`1,v`1)

  Z:MACRO finite_set[V] = blocks.targetPrivate(process,u`1,v`1)

  IMPORTING ppg_finite_domain[V,F] AS finiteF,
    ppg_finite_domain[V,H] AS finiteH,
    ppg_finite_domain[V,Z] AS finiteZ,
    ppg_hls_four_block_query[V,F,H,Z] AS addresses

  universeF:{S:finite_set[(F)]|S=fullset[(F)]} = fullset[(F)]

  universeH:{S:finite_set[(H)]|S=fullset[(H)]} = fullset[(H)]

  universeZ:{S:finite_set[(Z)]|S=fullset[(Z)]} = fullset[(Z)]

  IMPORTING ppg_hls_query_four[V,Value,(F),(H),(Z),domain,
      universeF,universeH,universeZ,spaces,laws,
      LAMBDA(a:(F)):a,LAMBDA(a:(H)):a,LAMBDA(a:(Z)):a] AS queries,
    ppg_hls_join_blocks[V,Value,domain,F,H,spaces,laws] AS sourceJoin,
    ppg_hls_join_blocks[V,Value,domain,H,Z,spaces,laws] AS targetJoin

  IMPORTING ppg_mt_log_probability[I,V,Value,domain,spaces,laws] AS originalLog,
    ppg_probability_map[ppg_mt_random_process[I,V,Value,domain].LogSpace,ResultValue,
      NativeTableSigma(spaces),ResultSigma] AS readPush

  D: VAR WitnessDAG

  Q: VAR (Valid)

  omega: VAR ppg_mt_random_process[I,V,Value,domain].LogSpace

  sourceIndex(D):[V->nat] = coordinates.localIndex(D,u)

  targetIndex(D):[V->nat] = coordinates.localIndex(D,v)

  pairBlockRead(D)(omega):ResultValue = queries.readFour(
    LAMBDA(a:(F)):sourceIndex(D)(a),LAMBDA(a:(H)):sourceIndex(D)(a),
    LAMBDA(a:(H)):targetIndex(D)(a),LAMBDA(a:(Z)):targetIndex(D)(a))(omega)

  pair_read_F: LEMMA FORALL(a:(F)):
    pairBlockRead(D)(omega)`1`1(a)=omega(sourceIndex(D)(a),a)

  pair_read_Z: LEMMA FORALL(a:(Z)):
    pairBlockRead(D)(omega)`1`2(a)=omega(targetIndex(D)(a),a)

  pair_read_H_source: LEMMA FORALL(a:(H)):
    pairBlockRead(D)(omega)`2`1(a)=omega(sourceIndex(D)(a),a)

  pair_read_H_target: LEMMA FORALL(a:(H)):
    pairBlockRead(D)(omega)`2`2(a)=omega(targetIndex(D)(a),a)

  table_domain_phantom_eq: LEMMA
    ppg_mt_random_process[I,V,Value,domain].TableDomain=
      ppg_mt_random_process[bool,V,Value,domain].TableDomain

  table_spaces_phantom_eq: LEMMA
    ppg_mt_coordinate_laws[I,V,Value,domain].TableSpaces(spaces)=
      ppg_mt_coordinate_laws[bool,V,Value,domain].TableSpaces(spaces)

  table_sigma_phantom_eq: LEMMA
    equalities[set[set[ppg_mt_random_process[I,V,Value,domain].LogSpace]]].=(
      NativeTableSigma(spaces),
      ppg_mt_native_spaces[bool,V,Value,domain].NativeTableSigma(spaces))

  log_law_phantom_eq: LEMMA originalLog.logMeasure=
    ppg_mt_log_probability[bool,V,Value,domain,spaces,laws].logMeasure

  four_variable_eq: LEMMA queries.fourVariable=addresses.fourVariable

  four_slot_eq: LEMMA queries.fourSlot(
    LAMBDA(a:(F)):sourceIndex(D)(a),LAMBDA(a:(H)):sourceIndex(D)(a),
    LAMBDA(a:(H)):targetIndex(D)(a),LAMBDA(a:(Z)):targetIndex(D)(a))=
    addresses.fourSlot(sourceIndex(D),targetIndex(D))

  shared_index_ne: LEMMA Edge(Q)(u,v) IMPLIES FORALL(a:(H)):
    sourceIndex(Q)(a)/=targetIndex(Q)(a)

  pair_query_injective: LEMMA Edge(Q)(u,v) IMPLIES injectiveQuery(queries.fourSlot(
    LAMBDA(a:(F)):sourceIndex(Q)(a),LAMBDA(a:(H)):sourceIndex(Q)(a),
    LAMBDA(a:(H)):targetIndex(Q)(a),LAMBDA(a:(Z)):targetIndex(Q)(a)))

  pairBlockRead_map: THEOREM Edge(Q)(u,v) IMPLIES
    readPush.pushforward(originalLog.logMeasure,pairBlockRead(Q))=
      nestedLaw

  tableEvent_source_iff_block: THEOREM events.tableEvent(D,u)(omega) IFF
    process`bad(u`1)(sourceJoin.joinBlocks(
      (pairBlockRead(D)(omega)`1`1,pairBlockRead(D)(omega)`2`1)))

  tableEvent_target_iff_block: THEOREM events.tableEvent(D,v)(omega) IFF
    process`bad(v`1)(targetJoin.joinBlocks(
      (pairBlockRead(D)(omega)`2`2,pairBlockRead(D)(omega)`1`2)))

END ppg_hls_pair_block_queries
