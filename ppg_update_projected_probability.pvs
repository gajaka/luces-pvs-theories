% The reduced IID realization gives exact timeouts and hitting-time
% means for the concrete path. A checked drift witness bounds the mean
% and gives success almost everywhere. A checked closed bad class gives
% failure almost everywhere and infinite expected hitting time.
%
% Johannes Lengler, "Drift Analysis", arXiv:1712.00964.
% David A. Levin and Yuval Peres, Markov Chains and Mixing Times,
% second edition, Chapter 1 and Exercise 10.22, American Mathematical Society, 2017.
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_update_projected_probability[State,Abstract,Input: TYPE,
  abstractUniverse:{U:finite_set[Abstract]|FORALL(a:Abstract):U(a)},
  inputs:{U:finite_set[Input]|FORALL(a:Input):U(a)},
  (IMPORTING ppg_finite_input_update[State,Input,inputs])
  R:{R:Rule|Valid(R)},
  (IMPORTING ppg_finite_input_update[Abstract,Input,inputs])
  Q:{Q:ppg_finite_input_update[Abstract,Input,inputs].Rule|
    ppg_finite_input_update[Abstract,Input,inputs].Valid(Q)},
  (IMPORTING ppg_finite_update_projection[State,Abstract,Input,inputs])
  p:{p:[State->Abstract]|Commutes(R,Q,p)},s0:State]: THEORY
BEGIN
  IMPORTING ppg_finite_input_history[Input] AS projResultsHistory,
    ppg_update_projected_process[State,Abstract,Input,abstractUniverse,inputs,R,Q,p,s0] AS projResultsRun,
    ppg_update_projected_expectation[State,Abstract,Input,abstractUniverse,inputs,R,Q,p,s0] AS projResultsMean,
    ppg_update_projected_events[State,Abstract,Input,abstractUniverse,inputs,R,Q,p,s0] AS projResultsEvents,
    ppg_update_expected_count[State,Input,inputs,R] AS projResultsSourceMean,
    ppg_update_input_law[State,Input,inputs,R] AS projResultsSourceLaw,
    ppg_finite_update[Abstract,Input,abstractUniverse,inputs] AS projResultsRule,
    ppg_finite_potential_order[Abstract,abstractUniverse] AS projResultsOrder,
    ppg_finite_potential_system[Abstract,abstractUniverse] AS projResultsSystem,
    ppg_finite_survival[Abstract,abstractUniverse] AS projResultsSurvival,
    ppg_finite_survival_certificate[Abstract,abstractUniverse] AS projResultsCertificate,
    ppg_finite_iid_law[Abstract,Input,abstractUniverse,inputs,Q] AS projResultsOriginalLaw,
    ppg_finite_iid_trajectory[Abstract,Input,abstractUniverse,inputs] AS projResultsTrajectory,
    ppg_finite_iid_execution[Abstract,Input,abstractUniverse,inputs,Q,p(s0)] AS projResultsOriginalExecution,
    ppg_finite_iid_hitting[Abstract,Input,abstractUniverse,inputs,Q,p(s0)] AS projResultsIidHitting,
    ppg_finite_expectation[projResultsHistory.Sample,projResultsHistory.ambientSigma,
      projResultsSourceLaw.iidMeasure] AS projResultsSourceMass,
    measure_integration@measure_theory[projResultsHistory.Sample,asNasa(projResultsHistory.ambientSigma),
      projResultsSourceLaw.iidMeasure] AS projResultsSourceAE,
    ppg_finite_process_hitting[Abstract,projResultsHistory.Sample,abstractUniverse,
      projResultsHistory.ambientSigma,projResultsOriginalLaw.iidMeasure,
      projResultsTrajectory.inputFiltration] AS projResultsOriginalHitting,
    ppg_finite_process_expectation[Abstract,projResultsHistory.Sample,abstractUniverse,
      projResultsHistory.ambientSigma,projResultsOriginalLaw.iidMeasure,
      projResultsTrajectory.inputFiltration] AS projResultsOriginalExpectation,
    ppg_finite_survival_integral[Abstract,projResultsHistory.Sample,abstractUniverse,
      projResultsHistory.ambientSigma,projResultsOriginalLaw.iidMeasure,
      projResultsTrajectory.inputFiltration] AS projResultsSurvivalIntegral,
    ppg_finite_survival_probability[Abstract,projResultsHistory.Sample,abstractUniverse,
      projResultsHistory.ambientSigma,projResultsOriginalLaw.iidMeasure,
      projResultsTrajectory.inputFiltration] AS projResultsSurvivalProbability,
    ppg_finite_potential_expectation[Abstract,projResultsHistory.Sample,abstractUniverse,
      projResultsHistory.ambientSigma,projResultsOriginalLaw.iidMeasure,
      projResultsTrajectory.inputFiltration] AS projResultsPotentialExpectation,
    ppg_finite_closed_bad_tail[Abstract,projResultsHistory.Sample,abstractUniverse,
      projResultsHistory.ambientSigma,projResultsOriginalLaw.iidMeasure,
      projResultsTrajectory.inputFiltration] AS projResultsClosed,
    ppg_enn_order,ppg_enn_ofreal

  n,H,k: VAR nat
  F: VAR projResultsCertificate.SurvivalRows
  f: VAR projResultsSystem.Vector
  b: VAR rat

  timeout_exact: THEOREM
    ennFinite(projResultsSourceMass.mass(projResultsEvents.sourceRunning(n)))=
      ofReal(projResultsSurvival.survival(projResultsRule.model(Q),n,p(s0)))

  checkedTable_timeout_exact: THEOREM
    projResultsCertificate.checkSurvivalTable(projResultsRule.model(Q),F,H) IMPLIES
      ennFinite(projResultsSourceMass.mass(projResultsEvents.sourceRunning(H)))=ofReal(F(H)(p(s0)))

  mean_exact: THEOREM projResultsOrder.Absorbing(projResultsRule.model(Q)) AND
    projResultsSystem.Equations(projResultsRule.model(Q),f) IMPLIES
      projResultsSourceMean.expectedHitCount(s0)=ofReal(f(p(s0)))

  checked_mean_bound: THEOREM
    FORALL(W:projResultsOriginalExpectation.AcceptedWitness(projResultsRule.model(Q))):
      ele(projResultsSourceMean.expectedHitCount(s0),
        ennFinite(projResultsOriginalHitting.potentialAt(projResultsRule.model(Q),W,p(s0))/
          projResultsOriginalExpectation.positiveRate(projResultsRule.model(Q),W)))

  checked_ae_success: THEOREM
    FORALL(W:projResultsOriginalExpectation.AcceptedWitness(projResultsRule.model(Q))):
      projResultsSourceAE.ae?(projResultsEvents.successEvent)

  geometric_timeout_bound: THEOREM 0<=b AND
    (FORALL(a:Abstract):projResultsSurvival.survival(projResultsRule.model(Q),H,a)<=b) IMPLIES
      ele(ennFinite(projResultsSourceMass.mass(projResultsEvents.sourceRunning(k*H))),
        ofReal(expt(b,k)))

  checkedClosedBad_ae_failure: THEOREM
    FORALL(U:projResultsSurvivalProbability.CheckedClass(projResultsRule.model(Q))):
      U(p(s0)) IMPLIES projResultsSourceAE.ae?(projResultsEvents.neverGood)

  checkedClosedBad_mean_infinite: THEOREM
    FORALL(U:projResultsSurvivalProbability.CheckedClass(projResultsRule.model(Q))):
      U(p(s0)) IMPLIES projResultsSourceMean.expectedHitCount(s0)=ennInfinity

END ppg_update_projected_probability
