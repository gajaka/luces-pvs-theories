% The component sum identity is valid for every commutative additive monoid.
ppg_bdd_partition_sum[C, V, R: TYPE, zero: R,
  plus: {op: [R, R -> R] |
    identity?[R](op)(zero) AND associative?[R](op) AND commutative?[R](op)}]: THEORY
BEGIN
  IMPORTING ppg_bdd_partition[C, V], ppg_partition_sum[C, R, zero, plus]
  vars: VAR CertVars
  B: VAR finite_set[C]
  f: VAR [C -> R]

  sum_compOf_groups: THEOREM
    families.sum(groups(vars, B), LAMBDA (K: finite_set[C]): elements.sum(K, f)) =
      elements.sum(B, f)

END ppg_bdd_partition_sum
