% A measurable finite state map pulls singleton indicators back to
% measurable events. Summing their scalar multiples constructs the
% original real state function as a native integrable function.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% Lean counterpart: integrable_finite_value in PPGraphFiniteDriftProcess.lean.
ppg_finite_process_integral[State,Omega: TYPE,
  universe:{U:finite_set[State]|FORALL(s:State):U(s)},
  (IMPORTING ppg_nasa_sigma[Omega]) S:MeasurableSpace,
  (IMPORTING ppg_finite_law_view[Omega,S]) measureLaw:FiniteLaw]: THEORY
BEGIN
  IMPORTING ppg_finite_process_values[State,Omega,universe],
    ppg_finite_sigma[State,universe],ppg_finite_measure_integral[Omega,S,measureLaw]
  fullStateSigma: MACRO ppg_measurable_space[State].MeasurableSpace = fullset[set[State]]
  full_state_sigma: LEMMA ppg_measurable_space[State].sigma?(fullset[set[State]])
  IMPORTING ppg_measurable_map[Omega,State] AS stateMap
  StateMap: TYPE = {X:[Omega->State]|stateMap.measurable(S,fullStateSigma,X)}
  X: VAR StateMap
  f: VAR [State->real]
  t: VAR State
  omega: VAR Omega
  A: VAR finite_set[State]
  stateEvent(X,t): (S) = stateMap.inverseImage(X,singleton[State](t))
  event_indicator_value: LEMMA indicator(stateEvent(X,t))(omega)=stateIndicator(X,t)(omega)
  finiteValue(A,f,X): RECURSIVE NativeFunction =
    IF empty?(A) THEN constant(0)
    ELSE f(choose(A))*indicator(stateEvent(X,choose(A)))+finiteValue(rest(A),f,X) ENDIF
    MEASURE card(A)
  finite_value_at: LEMMA finiteValue(A,f,X)(omega)=
    fsum(A,LAMBDA(t:State):f(t)*stateIndicator(X,t)(omega))
  finite_value_function: LEMMA finiteValue(universe,f,X)=(LAMBDA(omega:Omega):f(X(omega)))
  integrableValue(f,X): NativeFunction = LAMBDA(omega:Omega):f(X(omega))
  integrable_finite_value: THEOREM
    EXISTS(g:NativeFunction):g=(LAMBDA(omega:Omega):f(X(omega)))
END ppg_finite_process_integral
