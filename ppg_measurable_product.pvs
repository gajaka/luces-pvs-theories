% The dependent product carries the sigma algebra generated by coordinate events.
ppg_measurable_product[A, I, Value: TYPE, domain: [I -> set[Value]]]: THEORY
BEGIN

  Pi: TYPE = [i: I -> (domain(i))]

  IMPORTING ppg_measurable_map[A, Pi], ppg_measurable_map[A, Value],
            ppg_measurable_map[Pi, Value]
  SA: VAR ppg_measurable_space[A].MeasurableSpace
  coordinates: VAR [I -> ppg_measurable_space[Value].MeasurableSpace]
  i: VAR I
  B: VAR set[Value]
  f: VAR [A -> Pi]

  cylinder(i, B): set[Pi] = {p: Pi | B(p(i))}

  cylinders(coordinates): set[set[Pi]] =
    {E: set[Pi] | EXISTS (i: I, B: set[Value]): coordinates(i)(B) AND E = cylinder(i, B)}

  productSigma(coordinates): ppg_measurable_space[Pi].MeasurableSpace =
    generated(cylinders(coordinates))

  measurable_cylinder: LEMMA coordinates(i)(B) IMPLIES productSigma(coordinates)(cylinder(i, B))

  measurable_coordinate: LEMMA measurable(productSigma(coordinates), coordinates(i),
    LAMBDA (p: Pi): p(i))

  inverseImage_cylinder: LEMMA inverseImage(f, cylinder(i, B)) =
    inverseImage(LAMBDA (a: A): f(a)(i), B)

  measurable_product: LEMMA
    (FORALL (i: I): measurable(SA, coordinates(i), LAMBDA (a: A): f(a)(i))) IMPLIES
      measurable(SA, productSigma(coordinates), f)

END ppg_measurable_product
