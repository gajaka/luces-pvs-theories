% On a finite carrier, measurable singletons generate every subset.
% Thus the full sigma-algebra represents any source measurable space
% satisfying the finite-state measurable-singleton hypothesis.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
ppg_finite_sigma[T: TYPE,
  universe:{U:finite_set[T]|FORALL(x:T):U(x)}]: THEORY
BEGIN
  IMPORTING ppg_measurable_space[T],ppg_finite_induction[T]
  B: VAR finite_set[T]
  S: VAR MeasurableSpace
  A: VAR set[T]

  nonempty_decomposition: LEMMA NOT empty?(B) IMPLIES
    union(singleton[T](choose(B)),rest(B))=B

  finite_measurable: LEMMA (FORALL(x:T):S(singleton[T](x))) IMPLIES S(B)

  all_events_finite: LEMMA is_finite(A)

  finite_sigma_full: THEOREM (FORALL(x:T):S(singleton[T](x))) IMPLIES
    S=fullset[set[T]]

END ppg_finite_sigma
