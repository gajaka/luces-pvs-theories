% Embed a real number after clipping it at zero. This is ENNReal.ofReal;
% order is preserved even when the original real numbers are negative.
ppg_enn_ofreal: THEORY
BEGIN
  IMPORTING ppg_enn_add
  x,y: VAR real

  ofReal(x): ENN = ennFinite(max(0,x))

  ofReal_mono: THEOREM x<=y IMPLIES ele(ofReal(x),ofReal(y))

END ppg_enn_ofreal
