% Assignments on two disjoint finite blocks are joined and filled outside
% their union with the defaults of the coordinate probability spaces.
% The variable type may be empty or infinite.
%
% Patrick Billingsley, Probability and Measure, third edition, Wiley, 1995.
% Lean counterpart: PPGraphHLSBlockAssembly.lean.
ppg_hls_join_blocks[V,Value:TYPE,domain:[V->set[Value]],F,H:finite_set[V],
  (IMPORTING ppg_mt_native_spaces[bool,V,Value,domain])
  spaces:VariableSpaces,laws:VariableLaws(spaces)]: THEORY
BEGIN
  IMPORTING ppg_measurable_block[V,Value,domain,spaces] AS assemblyBlocks,
    ppg_measurable_cylinder[V,Value,domain,spaces] AS assemblyCylinder,
    ppg_measurable_block_union[V,Value,domain,F,H,spaces] AS assemblyUnion,
    ppg_measurable_block_update[V,Value,domain,spaces] AS assemblyUpdate,
    ppg_probability_cylinder_coherence[V,Value,domain,spaces,laws] AS assemblyDefaults,
    ppg_measurable_compose

  union_carrier_eq: LEMMA assemblyUnion.U=union(F,H)

  AssemblyState: TYPE = MTState

  AssemblyFull: TYPE = assemblyCylinder.FullBlock

  AssemblyPair: TYPE = assemblyUnion.BlockPair

  AssemblyUnionBlock: TYPE = assemblyBlocks.Block(union(F,H))

  AssemblyStateSigma: MACRO ppg_measurable_space[AssemblyState].MeasurableSpace =
    NativeStateSigma(spaces)

  AssemblyFullSigma: MACRO ppg_measurable_space[AssemblyFull].MeasurableSpace =
    assemblyCylinder.tableSigma

  AssemblyPairSigma: MACRO ppg_measurable_space[AssemblyPair].MeasurableSpace =
    assemblyUnion.pairSpace

  AssemblyUnionSigma: MACRO ppg_measurable_space[AssemblyUnionBlock].MeasurableSpace =
    assemblyBlocks.blockSigma(union(F,H))

  IMPORTING ppg_measurable_dependent_product[AssemblyFull,V,Value,domain] AS assemblyDecode

  decodeFull(x:AssemblyFull):AssemblyState = LAMBDA(v:V):x(v)

  decode_coordinate: LEMMA FORALL(v:V):
    ppg_measurable_map[AssemblyFull,(domain(v))].measurable(
      AssemblyFullSigma,spaces(v),LAMBDA(x:AssemblyFull):decodeFull(x)(v))

  decode_target_sigma: LEMMA assemblyDecode.nativeProduct(spaces)=AssemblyStateSigma

  decode_measurable: LEMMA ppg_measurable_map[AssemblyFull,AssemblyState].measurable(
    AssemblyFullSigma,AssemblyStateSigma,decodeFull)

  default_extension_eq: LEMMA assemblyDefaults.extendBlock(union(F,H))=
    assemblyUpdate.putBlock(union(F,H),assemblyDefaults.anchor)

  default_extension_measurable: LEMMA
    ppg_measurable_map[AssemblyUnionBlock,AssemblyFull].measurable(
      AssemblyUnionSigma,AssemblyFullSigma,assemblyDefaults.extendBlock(union(F,H)))

  joined_extension_measurable: LEMMA
    ppg_measurable_map[AssemblyPair,AssemblyFull].measurable(
      AssemblyPairSigma,AssemblyFullSigma,
      LAMBDA(xy:AssemblyPair):assemblyDefaults.extendBlock(union(F,H))(assemblyUnion.join(xy)))

  joinBlocks(xy:AssemblyPair):AssemblyState =
    decodeFull(assemblyDefaults.extendBlock(union(F,H))(assemblyUnion.join(xy)))

  join_blocks_measurable_any: LEMMA
    ppg_measurable_map[AssemblyPair,AssemblyState].measurable(
      AssemblyPairSigma,AssemblyStateSigma,joinBlocks)

  measurable_joinBlocks: THEOREM disjoint?(F,H) IMPLIES
    ppg_measurable_map[AssemblyPair,AssemblyState].measurable(
      AssemblyPairSigma,AssemblyStateSigma,joinBlocks)

  joinBlocks_left: THEOREM FORALL(xy:AssemblyPair,a:(F)):disjoint?(F,H) IMPLIES
    joinBlocks(xy)(a)=xy`1(a)

  joinBlocks_right: THEOREM FORALL(xy:AssemblyPair,a:(H)):disjoint?(F,H) IMPLIES
    joinBlocks(xy)(a)=xy`2(a)

END ppg_hls_join_blocks
