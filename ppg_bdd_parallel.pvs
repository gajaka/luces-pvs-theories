% The component count accompanies the existing noninterference guarantee.
ppg_bdd_parallel[C, V, Value: TYPE]: THEORY
BEGIN
  IMPORTING ppg_bdd_count[C, V], ppg_bdd_locality[C, V, Value]
  vars: VAR CertVars
  B: VAR finite_set[C]
  sat: VAR [C, [V -> Value] -> bool]
  c: VAR C
  i, j: VAR [V -> Value]
  safe_parallel_units: THEOREM Local(vars, sat) AND
    (FORALL (v: V): NOT componentFootprint(vars, B, c)(v) IMPLIES i(v) = j(v)) IMPLIES
      (FORALL (d: C): B(d) AND NOT SameComponent(vars, B)(c, d) IMPLIES (sat(d, i) IFF sat(d, j))) AND
      card(connectedComponents(vars, B)) = card(groups(vars, B))
END ppg_bdd_parallel
