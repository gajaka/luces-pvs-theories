% The binary product sigma algebra is generated by the two projections.
ppg_measurable_pair[A, X, Y: TYPE]: THEORY
BEGIN
  Pair: TYPE = [X, Y]
  IMPORTING ppg_measurable_compose[A, Pair, X],
            ppg_measurable_compose[A, Pair, Y], ppg_measurable_map[A, Pair]
  SA: VAR ppg_measurable_space[A].MeasurableSpace
  SX: VAR ppg_measurable_space[X].MeasurableSpace
  SY: VAR ppg_measurable_space[Y].MeasurableSpace
  B: VAR set[X]
  D: VAR set[Y]
  E: VAR set[Pair]
  f: VAR [A -> X]
  g: VAR [A -> Y]
  leftCylinder(B): set[Pair] = {p: Pair | B(p`1)}
  rightCylinder(D): set[Pair] = {p: Pair | D(p`2)}
  pairGenerators(SX, SY): set[set[Pair]] = {E: set[Pair] |
    (EXISTS (B: set[X]): SX(B) AND E = leftCylinder(B)) OR
    (EXISTS (D: set[Y]): SY(D) AND E = rightCylinder(D))}
  pairSigma(SX, SY): ppg_measurable_space[Pair].MeasurableSpace =
    generated(pairGenerators(SX, SY))
  measurable_left_cylinder: LEMMA SX(B) IMPLIES pairSigma(SX, SY)(leftCylinder(B))
  measurable_right_cylinder: LEMMA SY(D) IMPLIES pairSigma(SX, SY)(rightCylinder(D))
  measurable_fst: LEMMA measurable(pairSigma(SX, SY), SX, LAMBDA (p: Pair): p`1)
  measurable_snd: LEMMA measurable(pairSigma(SX, SY), SY, LAMBDA (p: Pair): p`2)
  measurable_pair: LEMMA measurable(SA, SX, f) AND measurable(SA, SY, g) IMPLIES
    measurable(SA, pairSigma(SX, SY), LAMBDA (a: A): (f(a), g(a)))
END ppg_measurable_pair
