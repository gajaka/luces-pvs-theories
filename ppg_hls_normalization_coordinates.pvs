% Canonical names carry each node's actual prior-reader set to its image.
% Injectivity on the original nodes preserves the reader count, including
% variables outside the footprint, whose counts are handled by the same law.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Section 3.1. https://arxiv.org/abs/2111.06527
% Lean counterpart: PPGraphHLSNormalizationCheck.lean.
ppg_hls_normalization_coordinates[C,V:TYPE,footprint:[C->finite_set[V]]]: THEORY
BEGIN
  IMPORTING ppg_shearer_bdd[C,V,footprint] AS normalizationGraph,
    ppg_hls_table_coordinates[C,V,footprint],
    ppg_hls_normalization[C,normalizationGraph.dependencyGraph],
    ppg_finite_bijection[[C,nat],[C,nat]] AS readerImages
  Q: VAR (Valid)
  u,v,w,x: VAR WNode
  a: VAR V

  priorReaders_normalize: THEOREM Q`nodes(u) IMPLIES
    priorReaders(normalize(Q),canonicalName(Q,u),a)=
      image[WNode,WNode](LAMBDA(w:WNode):canonicalName(Q,w),priorReaders(Q,u,a))

  names_injective_on_readers: LEMMA readerImages.injOn(
    LAMBDA(w:WNode):canonicalName(Q,w),priorReaders(Q,u,a))

  localIndex_normalize: THEOREM Q`nodes(u) IMPLIES
    localIndex(normalize(Q),canonicalName(Q,u))(a)=localIndex(Q,u)(a)

END ppg_hls_normalization_coordinates
