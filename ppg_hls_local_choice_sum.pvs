% At a forced node only the up choice remains. Otherwise all four
% choices contribute their literal ENN weights, including infinite ones.
% The sum is over the genuine local-choice subtype of the given node.
%
% Kun He, Qian Li and Xiaoming Sun, "Moser-Tardos Algorithm: Beyond
% Shearer's Bound", Appendix C. https://arxiv.org/abs/2111.06527
% Lean counterpart: sum_localChoice in PPGraphHLSChoiceSum.lean.
ppg_hls_local_choice_sum[C:TYPE,G:{A:[C,C->bool]|(FORALL(i:C):NOT A(i,i)) AND
  (FORALL(i,j:C):A(i,j)=A(j,i))},
  (IMPORTING ppg_hls_choice_weights[C,G]) M:DependencyMatching,D:WitnessDAG,
  u0:(D`nodes)]: THEORY
BEGIN
  IMPORTING ppg_hls_independent_choices[C,G,M,D],
    ppg_enn_finite_domain[Choice,localDomain(u0)] AS localDomainSums,
    ppg_enn_unrestricted_sum[(localDomain(u0))] AS localWeights

  up,down: VAR [C->ENN]

  sum_localChoice: THEOREM
    localWeights.eTsum(LAMBDA(ch:(localDomain(u0))):choiceWeight(M,up,down,u0`1,ch))=
      IF forcedUp(u0) THEN up(u0`1) ELSE
        eadd(eadd(eadd(up(u0`1),down(u0`1)),emul(down(u0`1),up(M(u0`1)))),
          emul(down(u0`1),down(M(u0`1)))) ENDIF

END ppg_hls_local_choice_sum
