% Marginalization along block inclusion is an identity-preserving composition.
ppg_probability_block_restriction[I, Value: TYPE, domain: [I -> set[Value]],
  (IMPORTING ppg_measurable_space)
  spaces: [i: I -> ppg_measurable_space[(domain(i))].MeasurableSpace]]: THEORY
BEGIN
  IMPORTING ppg_measurable_block_restriction[I, Value, domain, spaces],
            ppg_probability_map

  BlockLaw(F: set[I]): TYPE = ppg_probability_measure[Block(F), blockSigma(F)].Probability

  marginal(F: set[I], G: {G: set[I] | subset?(G, F)})(mu: BlockLaw(F)): BlockLaw(G) =
    ppg_probability_map[Block(F), Block(G), blockSigma(F), blockSigma(G)].pushforward(
      mu, restrictBlock(F, G))

  marginal_apply: LEMMA FORALL (F: set[I], G: {G: set[I] | subset?(G, F)},
    mu: BlockLaw(F), B: (blockSigma(G))):
    marginal(F, G)(mu)(B) = mu({x: Block(F) | B(restrictBlock(F, G)(x))})

  marginal_identity: LEMMA FORALL (F: set[I], mu: BlockLaw(F)):
    marginal(F, F)(mu) = mu

  marginal_compose: LEMMA FORALL (F: set[I], G: {G: set[I] | subset?(G, F)},
    H: {H: set[I] | subset?(H, G)}, mu: BlockLaw(F)):
    marginal(G, H)(marginal(F, G)(mu)) = marginal(F, H)(mu)

END ppg_probability_block_restriction
