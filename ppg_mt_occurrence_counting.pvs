% With the sampled log fixed, active times and occurring witness shapes are in bijection.
ppg_mt_occurrence_counting[C,V,Value:TYPE,domain:[V->set[Value]]]: THEORY
BEGIN
  IMPORTING ppg_mt_occurrence[C,V,Value,domain], ppg_indicator_reindex[nat,WTree] AS witnessCounts
  vars: VAR CertVars
  bad: VAR [C,MTState->bool]
  fallback,a: VAR C
  enumeration: VAR list[C]
  omega: VAR LogSpace
  activeTimes(vars,bad,fallback,enumeration,omega,a): set[nat] = {s:nat|
    randomInitResamplingEvent(vars,bad,fallback,enumeration,a,s)(omega)}
  occurrenceWeightNN(vars,bad,fallback,enumeration,omega,a)(W:WTree): nonneg_real =
    IF witnessOccurrence(vars,bad,fallback,enumeration,a,W)(omega) THEN 1 ELSE 0 ENDIF
  random_witness_injective: LEMMA FORALL(s,t:nat):
    activeTimes(vars,bad,fallback,enumeration,omega,a)(s) AND
    activeTimes(vars,bad,fallback,enumeration,omega,a)(t) AND
    randomInitWitness(vars,bad,fallback,enumeration,omega,s) = randomInitWitness(vars,bad,fallback,enumeration,omega,t)
    IMPLIES s=t
  active_witness_image: LEMMA witnessCounts.supportImage(activeTimes(vars,bad,fallback,enumeration,omega,a),
    LAMBDA(s:nat):randomInitWitness(vars,bad,fallback,enumeration,omega,s)) =
    {W:WTree|witnessOccurrence(vars,bad,fallback,enumeration,a,W)(omega)}
  witness_indicator_function: LEMMA
    (LAMBDA(W:WTree):IF witnessCounts.supportImage(activeTimes(vars,bad,fallback,enumeration,omega,a),
      LAMBDA(s:nat):randomInitWitness(vars,bad,fallback,enumeration,omega,s))(W) THEN 1 ELSE 0 ENDIF) =
    occurrenceWeightNN(vars,bad,fallback,enumeration,omega,a)
  randomInitResamplingCount_eq_tsum_witnessOccurrence: THEOREM
    randomInitResamplingCount(vars,bad,fallback,enumeration,omega,a) =
    ppg_nonneg_tsum[WTree].tsum(occurrenceWeightNN(vars,bad,fallback,enumeration,omega,a))
END ppg_mt_occurrence_counting
